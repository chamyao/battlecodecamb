"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
CLOSE: Bool = False
DANGER: Tiles = None
ECH: Tiles = None

@gene('Z372a', 'value of doing this option now; recall when healing or very low and no enemy champion close (cached); shield/heal when hurt or an enemy champion is close; casts on enemy champions first; dash toward goals unless resting on spawn; focus gem-carrying and weak enemies; fight back awake camps even with gems; tribute when uncontested, long tributes deferred while an enemy champion is close', parents=['Z262a', 'Z245a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if (HEALING or hf < 0.35) and not (me().pos in my_spawn()):
            if CLOSE:
                return 0
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.6 or (CLOSE and hf < 0.95) else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and not HEALING:
                if gems() == 0 or is_awake(o.unit):
                    return 58
        if k == AB_DASH:
            if valid(o.tile) and not (hf < 0.9 and me().pos in my_spawn()):
                if progress(o.tile) >= 2:
                    return 55
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 13 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if gems() == 0 and not HEALING:
            return 60 + 5 * (1 - o.unit.health_frac)
        if is_awake(o.unit) and hf > 0.25:
            return 58 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        if CLOSE and gems() >= 20:
            return 30
        return 70
    if o.kind == MOVE:
        if hf < 0.9 and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar first when carrying many gems (or any gems late in the game), capturable group, altar with gems, else living camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    g0 = gems()
    r = round()
    if g0 > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if size(alt) > 0:
        if g0 >= 40 or (r > 1750 and g0 > 0):
            return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if r < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('Z372b', 'how much closer a step brings me to the goals (cached keep); steps into the cached danger set do not count; with few gems, steps near cached enemy champions count less', parents=['Z245b', 'Z262b'])
def progress(t: Tile) -> Num:
    d = at(GF, me().pos) - at(GF, t)
    if d > 0:
        if t in DANGER:
            return 0
        if gems() > 0 and gems() < 20:
            d -= 0.6 * count(dist(e, t) <= 2 for e in ECH)
    return d

@gene('Z372c', 'track healing (enter ~0.4, earlier with gems); skip while dead; cache enemy champion tiles and whether one is within 4; cache tiles next to seen enemies when carrying many gems; while healing the home field avoids seen enemies and is skipped on spawn; else goal field once per turn', parents=['Z9a', 'Z245c'])
def update() -> None:
    if not alive():
        return
    hf = me().health_frac
    mp = me().pos
    empty = near(tile(-5, -5), 0)
    ECH = empty
    CLOSE = False
    for u in enemies():
        if u.is_champion:
            ECH = ECH | near(u.pos, 0)
            if dist(u.pos, mp) <= 4:
                CLOSE = True
    thr = 0.4 + min(gems(), 50) / 300
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    et = enemy_tiles()
    DANGER = empty
    if not HEALING and gems() >= 20:
        for e in et:
            DANGER = DANGER | near(e, 1)
    if HEALING:
        if not (mp in my_spawn()):
            GF = field_avoid(my_spawn(), et, empty)
    else:
        GF = field(goals())

@gene('Z148a', 'skip listing option kinds the policy never uses (wards, locks) or cannot want now (recall when healthy, tribute without gems) to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == RECALL:
        return HEALING or me().health_frac < 0.35
    if kind == TRIBUTE:
        return gems() > 0
    return True
