"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('Z72a', 'value of doing this option now; heals, casts abilities, avoids bad duels, focuses weak targets, no champion chases while healing; recalls only when no enemy is close; tributes first when uncontested', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if HEALING and not (me().pos in my_spawn()):
            if any(u.is_champion and dist(u.pos, me().pos) <= 4 for u in enemies()):
                return 0
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and gems() == 0 and not HEALING:
                return 58
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if o.unit.health_frac < 0.3 or (hf > 0.3 and not HEALING):
                return 80 + 10 * (1 - o.unit.health_frac)
            return 0
        if gems() == 0 and not HEALING:
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        if any(u.is_champion and dist(u.pos, me().pos) <= 3 for u in enemies()):
            return 70
        return 92
    if o.kind == MOVE:
        if HEALING and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, capturable group first, altar with gems, else living camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if gems() > 0:
        alt = empty
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if size(alt) > 0:
            return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'distance field to the goals (cached in update)')
def goal_field() -> Field:
    return GF

@gene('s4', 'how much closer a step brings me to the goals')
def progress(t: Tile) -> Num:
    f = goal_field()
    return at(f, me().pos) - at(f, t)

@gene('Z9a', 'track healing (enter at 40%, earlier when carrying gems); home field avoids tiles within 2 of seen enemies while healing; fields stop at my own tile to save fuel; skip field while resting on spawn', parents=['s1', 's2', 's3', 's4'])
def update() -> None:
    hf = me().health_frac
    thr = 0.4 + min(gems(), 50) / 300
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    mp = me().pos
    stop = near(mp, 0)
    if HEALING:
        if not (mp in my_spawn()):
            avoid = enemy_tiles()
            for t in enemy_tiles():
                avoid = avoid | near(t, 2)
            avoid = avoid - my_spawn() - near(mp, 1)
            GF = field_avoid(my_spawn(), avoid, stop)
    else:
        empty = near(tile(-5, -5), 0)
        GF = field_avoid(goals(), empty, stop)

@gene('Z72b', 'skip listing option kinds the score never values now (recall only when healing off spawn, tribute only with gems, no moves while channeling, buys only when shopping), to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == RECALL:
        return HEALING and not (me().pos in my_spawn())
    if kind == TRIBUTE:
        return gems() > 0
    if kind == MOVE:
        return not channeling()
    if kind == BUY:
        return can_shop()
    return True
