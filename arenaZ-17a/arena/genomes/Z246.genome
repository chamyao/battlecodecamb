"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None
THREAT: Bool = False
SEEN: Bool = False
ONSP: Bool = False
ECH: Tiles = None

@gene('Z360a', 'value of doing this option now; cached threat/spawn flags; shield when hurt, enemies seen or threat, heal when hurt; casts on enemy champions first, camp-ability use (also on awake camps with gems), dashes toward goals, avoids bad duels, focuses gem carriers and weak camps, fights back awake camps even with gems; tribute above fights when no threat; recalls when healing or very low and no enemy champion close', parents=['Z352a', 'Z291a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if (HEALING or hf < 0.35) and not THREAT and not ONSP:
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            if hf < 0.6:
                return 75
            if k == AB_SHIELD and (THREAT or (SEEN and hf < 0.95)):
                return 72
            if k == AB_HEAL and hf < 0.85:
                return 72
            return 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and not HEALING:
                if gems() == 0 or is_awake(o.unit):
                    return 58
        if k == AB_DASH:
            if valid(o.tile) and not (HEALING and ONSP) and not (hf < 0.9 and ONSP):
                if progress(o.tile) >= 2:
                    return 55
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 15 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if HEALING:
            return 0
        if gems() == 0 or (o.unit.is_camp and is_awake(o.unit)):
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70 if THREAT else 93
    if o.kind == MOVE:
        if (HEALING or hf < 0.9) and ONSP:
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar first when carrying many gems (fewer needed as the game goes on, any gems in the last rounds), capturable group, altar with gems, else living camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    g0 = gems()
    if g0 > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    need = 40
    if round() > 1200:
        need = 25
    if round() > 1800:
        need = 1
    if g0 >= need and size(alt) > 0:
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('Z360b', 'how much closer a step brings me to the goals (cached keep); steps into the cached danger set count less; with any gems or healing, steps beside cached enemy champion tiles count less', parents=['s4', 'Z279b'])
def progress(t: Tile) -> Num:
    d = at(GF, me().pos) - at(GF, t)
    if t in DANGER:
        d -= 1
    if d > 0 and SEEN and (HEALING or gems() > 0):
        d -= 0.6 * count(dist(c, t) <= 2 for c in ECH)
    return d

@gene('Z360c', 'track healing (enter at 40%, earlier when carrying gems); skip while dead; cache seen enemies, enemy champion tiles, close threat, on-spawn and danger tiles near enemy champions (when carrying gems) once per turn; while healing the home field avoids seen enemies and is skipped when resting on spawn; else goal field once per turn', parents=['Z352b', 'Z291b'])
def update() -> None:
    if alive():
        hf = me().health_frac
        thr = 0.4 + min(gems(), 50) / 300
        if hf < thr:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        empty = near(tile(-5, -5), 0)
        DANGER = empty
        ech = empty
        mp = me().pos
        ONSP = mp in my_spawn()
        et = enemy_tiles()
        SEEN = size(et) > 0
        THREAT = False
        if SEEN:
            for u in enemies():
                if u.is_champion:
                    ech = ech | near(u.pos, 0)
            THREAT = any(dist(c, mp) <= 4 for c in ech)
        ECH = ech
        if HEALING:
            if not ONSP:
                GF = field_avoid(my_spawn(), et, empty)
        else:
            GF = field(goals())
            if SEEN and gems() >= 15:
                for c in ech:
                    DANGER = DANGER | near(c, 2)

@gene('Z148a', 'skip listing option kinds the policy never uses (wards, locks) or cannot use now (tribute without gems, buy off shop, move/attack when unable) to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == TRIBUTE and gems() == 0:
        return False
    if kind == BUY and not can_shop():
        return False
    if kind == MOVE and not can_move():
        return False
    if kind == ATTACK and not can_attack():
        return False
    return True
