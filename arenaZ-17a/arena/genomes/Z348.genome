"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
THREAT: Bool = False
SEEN: Bool = False
ONSP: Bool = False
ECH: Tiles
DZ: Tiles = None

@gene('Z376a', 'value of doing this option now; recall when healing (or very low) and no enemy close; casts on enemy champions first; shield/heal when hurt or threatened; camp abilities when empty-handed or on awake camps; dash toward goals; focus gem carriers and weak enemies; fight back awake camps with gems; tribute high when uncontested', parents=['Z239a', 'Z218a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if (HEALING or hf < 0.35) and not THREAT and not ONSP:
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.635 or (SEEN and hf < 0.95) else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 74
            if exists(o.unit) and o.unit.is_camp and not HEALING:
                if gems() == 0 or is_awake(o.unit):
                    return 58
        if k == AB_DASH:
            if valid(o.tile) and not (HEALING and ONSP):
                if progress(o.tile) >= 2:
                    return 55
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3739 or o.unit.health_frac < 0.3:
                return 80 + 19 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if HEALING:
            return 0
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        if is_awake(o.unit) and hf > 0.25:
            return 58 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70 if THREAT else 93
    if o.kind == MOVE:
        if HEALING and ONSP:
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar first with many gems (or any gems late), capturable group, altar with gems, else living camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    g0 = gems()
    if g0 > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if size(alt) > 0 and (g0 >= 40 or (round() > 1800 and g0 > 0)):
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('Z376b', 'how much closer a step brings me to the goals (field keep); stay on spawn while healing; steps into the danger set do not count; with gems or healing, steps beside enemy champions count less', parents=['Z239b', 'Z299a'])
def progress(t: Tile) -> Num:
    if HEALING and ONSP:
        return 0
    d = at(GF, me().pos) - at(GF, t)
    if d > 0 and t in DZ:
        return 0
    if d > 0 and (HEALING or gems() > 0) and size(ECH) > 0:
        d -= 0.6 * count(dist(c, t) <= 2 for c in ECH)
    return d

@gene('Z376c', 'skip while dead; track healing (enter at ~40%, earlier with gems); cache seen enemies, enemy champion tiles, threat, on-spawn and danger set once per turn; healing field avoids enemies and is skipped on spawn; else goal field once per turn', parents=['Z9a', 'Z299b'])
def update() -> None:
    if not alive():
        return
    hf = me().health_frac
    thr = 0.4 + min(gems(), 50) / 445
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    mp = me().pos
    ONSP = mp in my_spawn()
    empty = near(tile(-5, -5), 0)
    et = enemy_tiles()
    SEEN = size(et) > 0
    ech = empty
    th = False
    dz = empty
    if SEEN:
        for u in enemies():
            if u.is_champion:
                ech = ech | near(u.pos, 0)
                if dist(u.pos, mp) <= 3:
                    th = True
        if not HEALING and gems() >= 20:
            for e in et:
                dz = dz | near(e, 1)
    ECH = ech
    THREAT = th
    DZ = dz
    if HEALING:
        if not ONSP:
            GF = field_avoid(my_spawn(), et, empty)
    else:
        GF = field(goals())

@gene('Z148a', 'skip listing option kinds the policy never uses (wards, locks) to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    return True
