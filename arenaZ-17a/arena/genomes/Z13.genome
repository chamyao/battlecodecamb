"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar with enough gems, capturable group, else non-monolith camps')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    g0 = gems()
    if g0 >= 15 or (g0 > 0 and round() > 1700):
        acc = empty
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    safe = acc - type_spawns(MONOLITH)
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'distance field to the goals (cached in update)')
def goal_field() -> Field:
    return GF

@gene('Z10a', 'track healing state (recall ~40%) and compute the goal field once per turn', parents=['s2', 's3'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.38:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    GF = field(goals())

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)
