"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None
SEEN: Bool = False
ONSP: Bool = False
THREAT: Bool = False

@gene('Z291a', 'value of doing this option now; heals on spawn (cached), casts on enemy champions first, shield/heal on cooldown whenever enemies are seen or hurt, fights back awake camps even with gems, dashes toward goals, focuses gem carriers; tribute above fights when no threat; recalls when healing or low and no enemy champion close (cached)', parents=['Z279a', 'Z218a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if (HEALING or hf < 0.35) and not THREAT and not ONSP:
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.95 or SEEN else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and not HEALING:
                if gems() == 0 or is_awake(o.unit):
                    return 58
        if k == AB_DASH:
            if valid(o.tile) and not (hf < 0.851 and ONSP):
                if progress(o.tile) >= 2:
                    return 75
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.5098 or o.unit.health_frac < 0.2314:
                return 80 + 12 * (0.9936 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if HEALING:
            return 0
        if gems() == 0 or (o.unit.is_camp and is_awake(o.unit)):
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70 if THREAT else 93
    if o.kind == MOVE:
        if hf < 0.9 and ONSP:
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar first with many gems (or any gems late), capturable group, altar with gems, else camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    if gems() > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if size(alt) > 0 and (gems() >= 40 or (round() > 1850 and gems() > 0)):
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 494:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('Z279b', 'how much closer a step brings me to the goals (cached keep); steps into the cached danger set do not count; with any gems or healing, steps beside enemy champions count less', parents=['Z245b', 'Z143b'])
def progress(t: Tile) -> Num:
    d = at(GF, me().pos) - at(GF, t)
    if d > 0 and t in DANGER:
        return 0
    if d > 0 and (HEALING or gems() > 0):
        d -= 0.6 * count(u.is_champion and dist(u.pos, t) <= 2 for u in enemies())
    return d

@gene('Z291b', 'track healing (enter ~0.39, earlier with gems); skip while dead; cache seen enemies, on-spawn and threat (enemy champion within 4); cache tiles next to seen enemies when carrying many gems or below half health; while healing the home field avoids seen enemies and is skipped on spawn; else goal field once per turn', parents=['Z245c', 'Z9a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        thr = 0.39 + min(gems(), 44) / 300
        if hf < thr:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        mp = me().pos
        ONSP = mp in my_spawn()
        empty = near(tile(-5, -5), 0)
        et = enemy_tiles()
        SEEN = size(et) > 0
        THREAT = False
        DANGER = empty
        if SEEN:
            THREAT = any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies())
            if not HEALING and (gems() >= 20 or hf < 0.5):
                for e in et:
                    DANGER = DANGER | near(e, 1)
        if HEALING:
            if not ONSP:
                GF = field_avoid(my_spawn(), et, empty)
        else:
            GF = field(goals())

@gene('Z148a', 'skip listing option kinds never used (wards, locks) or not scorable now (recall when not needed, threatened or on spawn; tribute without gems; buy off shop) to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == RECALL:
        if ONSP or THREAT:
            return False
        return HEALING or me().health_frac < 0.35
    if kind == TRIBUTE:
        return gems() > 0
    if kind == BUY:
        return can_shop()
    return True
