"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('s1', 'value of doing this option now; heals on spawn, casts abilities, no camps while healing')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        return 90 if hf < 0.35 and not (me().pos in my_spawn()) else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and gems() == 0 and not HEALING:
                return 58
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 10 * (1 - o.unit.health_frac)
            return 0
        return 60 if gems() == 0 and not HEALING else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if hf < 0.9 and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: capturable cleared group, altar with gems, else living non-monolith camps (no golems early)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if gems() > 0:
        alt = empty
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if size(alt) > 0:
            return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('s4', 'how much closer a step brings me to the goals (cached field keep)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z8a', 'track healing state (earlier with gems); goal field is home avoiding enemies while healing, else the goals', parents=['s1', 's3', 's4'])
def update() -> None:
    hf = me().health_frac
    thr = 0.38 + min(gems(), 50) / 300
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    if HEALING:
        empty = near(tile(-5, -5), 0)
        GF = field_avoid(my_spawn(), enemy_tiles(), empty)
    else:
        GF = field(goals())
