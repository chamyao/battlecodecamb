"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
NEARE: Bool = False

@gene('Z134a', 'value of doing this option now; heals, shields in fights, casts abilities, dashes toward goals, avoids bad duels, recalls only when no enemy is close (cached); finishes hurt and gem-carrying champions; fights back awake camps', parents=['Z72a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if HEALING and not (me().pos in my_spawn()):
            if NEARE:
                return 0
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD:
            return 75 if (hf < 0.6 or (NEARE and hf < 0.95)) else 0
        if k == AB_HEAL:
            return 75 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and gems() == 0 and not HEALING:
                return 58
        if k == AB_DASH:
            if valid(o.tile) and not (HEALING and me().pos in my_spawn()):
                if progress(o.tile) >= 2:
                    return 55
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 14 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if HEALING:
            return 0
        if gems() == 0 or (o.unit.is_camp and is_awake(o.unit)):
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if HEALING and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z157a', 'where to walk: home when hurt, altar first with many gems (35, any gems in the final rounds), capturable group, altar with gems, else camps (no golems before ~690, no monoliths)', parents=['s2'])
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    g0 = gems()
    if g0 > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if size(alt) > 0 and (g0 >= 35 or round() > 1850):
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 690:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'distance field to the goals (cached in update)')
def goal_field() -> Field:
    return GF

@gene('s4', 'how much closer a step brings me to the goals')
def progress(t: Tile) -> Num:
    f = goal_field()
    return at(f, me().pos) - at(f, t)

@gene('Z134b', 'track healing (enter at 40%, earlier with gems); cache whether an enemy champion is within 4; home field avoids seen enemies while healing; skip field while resting on spawn', parents=['Z9a'])
def update() -> None:
    hf = me().health_frac
    thr = 0.4 + min(gems(), 50) / 300
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    mp = me().pos
    NEARE = any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies())
    if HEALING:
        if not (mp in my_spawn()):
            empty = near(tile(-5, -5), 0)
            GF = field_avoid(my_spawn(), enemy_tiles(), empty)
    else:
        GF = field(goals())

@gene('Z72b', 'skip listing option kinds the score never values now (recall only when healing off spawn, tribute only with gems), to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == RECALL:
        return HEALING and not (me().pos in my_spawn())
    if kind == TRIBUTE:
        return gems() > 0
    return True
