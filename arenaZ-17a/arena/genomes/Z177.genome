"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
ET: Tiles = None

@gene('s1', 'value of doing this option now; heals on spawn, casts abilities, dashes toward goals, focuses gem carriers, recalls when healing and no enemy champion close')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if (HEALING or hf < 0.35) and not (me().pos in my_spawn()):
            mp = me().pos
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 0
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and gems() == 0 and not HEALING:
                return 58
        if k == AB_DASH:
            if valid(o.tile) and not (hf < 0.9 and me().pos in my_spawn()):
                if progress(o.tile) >= 2:
                    return 55
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 10 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 and not HEALING else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if hf < 0.9 and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar first with many gems (35, or any gems late), capturable group, altar with gems, else camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    if gems() > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if size(alt) > 0 and (gems() >= 35 or (round() > 1800 and gems() > 0)):
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 650:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('s4', 'how much closer a step brings me to the goals (cached keep); stay on spawn while healing; carrying gems, steps next to cached enemy tiles do not count')
def progress(t: Tile) -> Num:
    if HEALING and me().pos in my_spawn():
        return 0
    d = at(GF, me().pos) - at(GF, t)
    if d > 0 and gems() >= 20:
        if any(dist(e, t) <= 1 for e in ET):
            return 0
    return d

@gene('Z8a', 'track healing state (enter earlier when carrying gems); cache enemy tiles once per turn; home field avoids seen enemies while healing and is skipped resting on spawn; else goal field once per turn', parents=['s1', 's3', 's4'])
def update() -> None:
    hf = me().health_frac
    thr = 0.38 + min(gems(), 50) / 300
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    ET = enemy_tiles()
    if HEALING:
        if not (me().pos in my_spawn()):
            empty = near(tile(-5, -5), 0)
            GF = field_avoid(my_spawn(), ET, empty)
    else:
        GF = field(goals())
