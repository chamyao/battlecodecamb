"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None
THREAT: Bool = False
ONSP: Bool = False
MYD: Num = 0

@gene('Z245a', 'value of doing this option now; heals on spawn, casts abilities, shields when hurt or enemy champion close (cached threat), dashes toward goals, focuses gem carriers, fights back awake camps even with gems, recalls when healing or low and no enemy champion close', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if (HEALING or hf < 0.35) and not ONSP:
            if THREAT:
                return 0
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            if hf < 0.6:
                return 75
            if hf < 0.9 and THREAT:
                return 75
            return 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and gems() == 0 and not HEALING:
                return 58
        if k == AB_DASH:
            if valid(o.tile) and not (hf < 0.9 and ONSP):
                if progress(o.tile) >= 2:
                    return 55
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 12 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if gems() == 0 and not HEALING:
            return 60 + 5 * (1 - o.unit.health_frac)
        if is_awake(o.unit) and hf > 0.25:
            return 58 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if hf < 0.9 and ONSP:
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar first with many gems (or any gems late), capturable group, altar with gems, else camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    if gems() > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if size(alt) > 0 and (gems() >= 40 or (round() > 1850 and gems() > 0)):
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('Z245b', 'how much closer a step brings me to the goals (cached field and own distance); steps into the cached danger set do not count', parents=['s4'])
def progress(t: Tile) -> Num:
    d = MYD - at(GF, t)
    if d > 0 and t in DANGER:
        return 0
    return d

@gene('Z245c', 'track healing (enter ~0.39, earlier with gems); skip while dead; cache on-spawn, enemy-champion threat and tiles next to seen enemies once per turn; while healing the home field avoids seen enemies and is skipped on spawn; else goal field once per turn; cache my own field distance', parents=['Z8a', 'Z9a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        thr = 0.39 + min(gems(), 50) / 300
        if hf < thr:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        mp = me().pos
        ONSP = mp in my_spawn()
        empty = near(tile(-5, -5), 0)
        et = enemy_tiles()
        DANGER = empty
        THREAT = False
        if size(et) > 0:
            THREAT = any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies())
            if not HEALING and gems() >= 20:
                for e in et:
                    DANGER = DANGER | near(e, 1)
        if HEALING:
            if not ONSP:
                GF = field_avoid(my_spawn(), et, empty)
        else:
            GF = field(goals())
        MYD = at(GF, mp)

@gene('Z148a', 'skip listing option kinds the policy never uses (wards, locks) or cannot want now (recall when healthy or threatened, tribute without gems, moves while healing on spawn) to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == RECALL:
        if ONSP or THREAT:
            return False
        return HEALING or me().health_frac < 0.35
    if kind == TRIBUTE:
        return gems() > 0
    if kind == MOVE:
        return not (ONSP and me().health_frac < 0.9)
    if kind == BUY:
        return gold() >= 30
    return True
