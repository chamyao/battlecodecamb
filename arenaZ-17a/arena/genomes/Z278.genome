"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None
ONSP: Bool = False
THREAT: Bool = False

@gene('Z183a', 'value of doing this option now; heals, shields when hurt or an enemy champion is close, casts abilities on enemy champions first, camp-ability use, dashes toward goals, avoids bad duels, prefers gem-carrying targets, fights back awake camps even with gems; recalls when healing and no enemy champion is close', parents=['s1', 'Z72a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if HEALING and not (me().pos in my_spawn()):
            mp = me().pos
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 0
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            if hf < 0.6:
                return 75
            if k == AB_SHIELD and hf < 0.95:
                mp2 = me().pos
                if any(u.is_champion and dist(u.pos, mp2) <= 3 for u in enemies()):
                    return 72
            return 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and not HEALING:
                if gems() == 0 or is_awake(o.unit):
                    return 58
        if k == AB_DASH:
            if valid(o.tile) and not (HEALING and me().pos in my_spawn()):
                if progress(o.tile) >= 2:
                    return 55
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 15 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if HEALING:
            return 0
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        if is_awake(o.unit):
            return 58
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if HEALING and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar first when carrying many gems, capturable group, altar with gems, else living camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    g0 = gems()
    if g0 > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if g0 >= 40 and size(alt) > 0:
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('s4', 'how much closer a step brings me to the goals; while carrying gems, steps near seen enemy champions count less')
def progress(t: Tile) -> Num:
    d = at(GF, me().pos) - at(GF, t)
    if t in DANGER:
        return d - 1
    return d

@gene('Z9a', 'track healing (enter at 40%, earlier when carrying gems); skip while dead; cache on-spawn and close enemy champion; while healing the home field avoids seen enemies and is skipped when resting on spawn; else goal field once per turn; cache tiles near enemy champions when carrying gems', parents=['s1', 's2', 's3', 's4'])
def update() -> None:
    if not alive():
        return
    hf = me().health_frac
    thr = 0.4 + min(gems(), 50) / 300
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    mp = me().pos
    ONSP = mp in my_spawn()
    et = enemy_tiles()
    THREAT = False
    if size(et) > 0:
        THREAT = any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies())
    empty = near(tile(-5, -5), 0)
    DANGER = empty
    if HEALING:
        if not ONSP:
            GF = field_avoid(my_spawn(), et, empty)
    else:
        GF = field(goals())
        if gems() >= 15 and size(et) > 0:
            for u in enemies():
                if u.is_champion:
                    DANGER = DANGER | near(u.pos, 2)

@gene('Z148a', 'skip listing option kinds the policy never uses (wards, locks) or cannot use now (recall when not healing, on spawn or threatened; tribute without gems; buy off shop or without 30 gold; casts with no ability ready; move/attack when unable) to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == RECALL and (not HEALING or ONSP or THREAT):
        return False
    if kind == TRIBUTE and gems() == 0:
        return False
    if kind == BUY and (not can_shop() or gold() < 30):
        return False
    if kind == CAST and not (slot_ready(0) or slot_ready(1) or slot_ready(2)):
        return False
    if kind == MOVE and not can_move():
        return False
    if kind == ATTACK and not can_attack():
        return False
    return True
