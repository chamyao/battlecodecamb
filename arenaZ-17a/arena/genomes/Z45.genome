"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
GSIG: Num = -1

@gene('Z42a', 'value of doing this option now; heals, casts abilities, avoids bad duels, banks gems', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        return 90 if hf < 0.35 and not (me().pos in my_spawn()) else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and gems() == 0 and not HEALING:
                return 58
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 10 * (1 - o.unit.health_frac)
            return 0
        return 60 if gems() == 0 and not HEALING else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if (HEALING or hf < 0.9) and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z42b', 'only list option kinds that score() can value', parents=['s1'])
def consider(kind: Num) -> Bool:
    return kind == PICK or kind == BUY or kind == RECALL or kind == CAST or kind == ATTACK or kind == TRIBUTE or kind == MOVE

@gene('s2', 'where to walk: home when hurt, capture cleared group first with few gems, altar with gems, else camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0 and gems() < 20:
        return rew
    if gems() > 0:
        alt = empty
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if size(alt) > 0:
            return alt
    if size(rew) > 0:
        return rew
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('s4', 'how much closer a step brings me to the goals (cached field)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z9a', 'track healing; goal field rebuilt only when the goal set changes, going home around seen enemies when hurt', parents=['s1', 's2', 's3', 's4'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.38:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    if HEALING:
        GF = field_avoid(my_spawn(), enemy_tiles(), near(tile(-5, -5), 0))
        GSIG = -1
    else:
        g = goals()
        sig = size(g) * 1000003 + sum(t.x * 977 + t.y for t in g)
        if sig != GSIG:
            GF = field(g)
            GSIG = sig
