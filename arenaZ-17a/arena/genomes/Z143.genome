"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
GSIG: Num = -1
ENEAR: Bool = False

@gene('Z147a', 'value of doing this option now; heals, casts abilities, dashes toward goals, avoids bad duels, focuses gem carriers, fights back awake camps, recalls when healing and no enemy close, waits on spawn until healed', parents=['Z88a', 'Z72a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if (HEALING or hf < 0.4) and not (me().pos in my_spawn()):
            if ENEAR:
                return 0
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and progress(o.tile) >= 2:
                return 55
            return 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and gems() == 0 and not HEALING:
                return 58
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 10 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if gems() == 0 and not HEALING:
            return 60 + 5 * (1 - o.unit.health_frac)
        if is_awake(o.unit) and hf > 0.25:
            return 60
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if (HEALING or hf < 0.9) and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z147b', 'skip listing option kinds the score cannot value now (recall only when hurt off spawn, tribute only with gems, buy only at shop)', parents=['Z72b', 'Z42b'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop()
    if kind == TRIBUTE:
        return gems() > 0
    if kind == RECALL:
        return (HEALING or me().health_frac < 0.4) and not (me().pos in my_spawn())
    return True

@gene('s2', 'where to walk: home when hurt, altar first when carrying many gems, capturable group, altar with gems, else living camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    g0 = gems()
    if g0 > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if g0 >= 40 and size(alt) > 0:
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('s4', 'how much closer a step brings me to the goals (cached field), clamped so unreachable tiles cannot produce huge scores')
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    there = at(GF, t)
    if there >= 100000000:
        return -1
    if here >= 100000000:
        return 0
    return max(-1, min(1, here - there))

@gene('Z88b', 'track healing (threshold rises with carried gems); goal field rebuilt only when the goal set changes; home avoids seen enemies while healing; caches whether an enemy champion is close', parents=['Z9a'])
def update() -> None:
    hf = me().health_frac
    thr = 0.38 + min(gems(), 60) / 300
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    mp = me().pos
    ENEAR = any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies())
    if HEALING:
        GF = field_avoid(my_spawn(), enemy_tiles(), near(tile(-5, -5), 0))
        GSIG = -1
    else:
        g = goals()
        sig = size(g) * 1000003 + sum(t.x * 977 + t.y for t in g)
        if sig != GSIG:
            GF = field(g)
            GSIG = sig
