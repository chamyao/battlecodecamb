"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None
ECH: Tiles
THREAT: Bool

@gene('Z388a', 'value of doing this option now; recall when healing or low and no enemy champion close (cached threat); casts on enemy champions first, shield under threat; dash toward goals unless resting on spawn; focus gem carriers and weak enemies; fight back awake camps even with gems; tribute', parents=['Z245a', 'Z239a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if (HEALING or hf < 0.35) and not THREAT and not (me().pos in my_spawn()):
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.6 or (THREAT and hf < 0.9) else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and not HEALING:
                if gems() == 0 or is_awake(o.unit):
                    return 58
        if k == AB_DASH:
            if valid(o.tile) and not (HEALING and me().pos in my_spawn()):
                if progress(o.tile) >= 2:
                    return 55
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.3 or o.unit.health_frac < 0.3:
                return 80 + 13 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if gems() == 0 and not HEALING:
            return 60 + 5 * (1 - o.unit.health_frac)
        if is_awake(o.unit) and hf > 0.25:
            return 58 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if HEALING and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar first with many gems (or any gems late), capturable group, altar with gems, else living camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    g0 = gems()
    if g0 > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if size(alt) > 0 and (g0 >= 40 or (round() > 1800 and g0 > 0)):
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('Z388b', 'how much closer a step brings me to the goals (field keep); stay on spawn while healing; steps into the danger set (beside enemies while carrying many gems) do not count; with gems or healing, steps near enemy champions count less', parents=['Z245b', 'Z239b'])
def progress(t: Tile) -> Num:
    if HEALING and me().pos in my_spawn():
        return 0
    d = at(GF, me().pos) - at(GF, t)
    if d > 0 and t in DANGER:
        return 0
    if d > 0 and (HEALING or gems() > 0) and size(ECH) > 0:
        d -= 0.6 * count(dist(c, t) <= 2 for c in ECH)
    return d

@gene('Z388c', 'skip while dead; track healing (enter ~0.4, earlier with gems); cache enemy champion tiles, close threat, and danger set (with many gems) once per turn; while healing the home field avoids seen enemies and is skipped on spawn; else goal field', parents=['Z245c', 'Z9a'])
def update() -> None:
    if not alive():
        return
    hf = me().health_frac
    thr = 0.4 + min(gems(), 50) / 300
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    empty = near(tile(-5, -5), 0)
    ech = empty
    mp = me().pos
    th = False
    for u in enemies():
        if u.is_champion:
            ech = ech | near(u.pos, 0)
            if dist(u.pos, mp) <= 4:
                th = True
    ECH = ech
    THREAT = th
    et = enemy_tiles()
    dg = empty
    if not HEALING and gems() >= 20:
        for e in et:
            dg = dg | near(e, 1)
    DANGER = dg
    if HEALING:
        if not (mp in my_spawn()):
            GF = field_avoid(my_spawn(), et, empty)
    else:
        GF = field(goals())

@gene('Z148a', 'skip listing option kinds the policy never uses (wards, locks) or cannot want now (recall when healthy, tribute without gems) to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == RECALL:
        return HEALING or me().health_frac < 0.35
    if kind == TRIBUTE:
        return gems() > 0
    return True
