"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('Z239a', 'value of doing this option now; recall when healing and no enemy close; casts on enemy champions first; dash toward goals unless resting on spawn; focus gem-carrying and weak enemies; fight back awake camps even with gems; finish hurt camps first; tribute when uncontested', parents=['Z143a', 'Z183a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        if HEALING and not (me().pos in my_spawn()):
            mp = me().pos
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 0
            return 90
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
                return 78
            if exists(o.unit) and o.unit.is_camp and gems() == 0 and not HEALING:
                return 58
        if k == AB_DASH:
            if valid(o.tile) and not (HEALING and me().pos in my_spawn()):
                if progress(o.tile) >= 3:
                    return 55
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hf > 0.2198 or o.unit.health_frac < 0.3:
                return 80 + 14 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
            return 0
        if gems() == 0 and not HEALING:
            return 60 + 5 * (1 - o.unit.health_frac)
        if is_awake(o.unit) and hf > 0.25:
            return 58 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if HEALING and me().pos in my_spawn():
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar first when carrying many gems, capturable group, altar with gems, else living camps (no golems early, no monoliths)')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if HEALING:
        return my_spawn()
    alt = empty
    g0 = gems()
    if g0 > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
    if g0 >= 40 and size(alt) > 0:
        return alt
    rew = empty
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if size(alt) > 0:
        return alt
    safe = acc - type_spawns(MONOLITH)
    if round() < 600:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    return acc

@gene('Z239b', 'how much closer a step brings me to the goals (reads the field keep directly); stay on spawn while healing; when carrying gems or healing, steps beside enemy champions count less', parents=['Z143b', 's4'])
def progress(t: Tile) -> Num:
    if HEALING and me().pos in my_spawn():
        return 0
    d = at(GF, me().pos) - at(GF, t)
    if d > 0 and (HEALING or gems() > 0):
        d -= 0.5779 * count(u.is_champion and dist(u.pos, t) <= 3 for u in enemies())
    return d

@gene('Z9a', 'track healing (enter at 40%, earlier when carrying gems); while healing the home field avoids seen enemies and is skipped when resting on spawn; else goal field once per turn', parents=['s1', 's2', 's3', 's4'])
def update() -> None:
    hf = me().health_frac
    thr = 0.4 + min(gems(), 50) / 300
    if hf < thr:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    if HEALING:
        if not (me().pos in my_spawn()):
            empty = near(tile(-5, -5), 0)
            GF = field_avoid(my_spawn(), enemy_tiles(), empty)
    else:
        GF = field(goals())

@gene('Z148a', 'skip listing option kinds the policy never uses (wards, locks) or cannot score now (buy off shop, tribute without gems, recall when not healing or on spawn) to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop()
    if kind == TRIBUTE:
        return gems() > 0
    if kind == RECALL:
        return HEALING and not (me().pos in my_spawn())
    return True
