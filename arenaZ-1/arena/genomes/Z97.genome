"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now: pick strong champs, use abilities, focus weak targets, recall not on spawn', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 5
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 109 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.4:
            if me().pos in my_spawn():
                return 0
            return 90
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (0.8564 - o.unit.health_frac)
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: altar if carrying gems, spawn if badly hurt, else cleared groups awaiting capture, else living non-monolith camp groups', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    if me().health_frac < 0.3:
        home = my_spawn()
        if size(home) > 0:
            return home
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    mono = type_spawns(MONOLITH)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    safe = acc - mono
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'distance field to the goals', parents=['s3'])
def goal_field() -> Field:
    return field(goals())

@gene('Z148a', 'goal-distance gain of a step (cached field, scaled by 10) minus threat from nearby enemies; doubled while carrying gems so I head to the altar', parents=['s4'])
def progress(t: Tile) -> Num:
    gain = at(GF, me().pos) - at(GF, t)
    threat = sum(u.strength * u.health_frac for u in enemies() if dist(u.pos, t) <= 3)
    p = gain * 10 - threat
    if gems() > 0:
        p = p * 2
    return p

@gene('Z26a', 'cache the goal distance field once per turn', parents=['s4'])
def update() -> None:
    GF = goal_field()

@gene('Z26b', 'value of casting an ability: damage/cc on targets, shield/heal when hurt, shield harder when enemies are close, dash toward goals when healthy', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.7:
            return 75
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.8:
            if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
                return 80
            return 72
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.2935:
            p = progress(o.tile)
            if p > 0:
                return 40 + 3 * p
        return 0
    return 0
