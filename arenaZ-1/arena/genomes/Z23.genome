"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: focus weak targets, recall a bit earlier but not on spawn')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.4:
            if me().pos in my_spawn():
                return 0
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 94
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: altars when carrying gems, cleared groups awaiting capture first, else living camp groups')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.8728)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, search stopped once my tile is reached (cheaper on big maps)')
def goal_field() -> Field:
    here: Tiles = near(me().pos, 0)
    return field_avoid(goals(), walls(), here)

@gene('s4', 'how much closer a step brings me to the goals; unreached tiles count as no progress')
def progress(t: Tile) -> Num:
    f: Field = goal_field()
    d0: Num = at(f, me().pos)
    d1: Num = at(f, t)
    if d0 >= 100000000:
        return 0
    if d1 >= 100000000:
        return -1
    return d0 - d1
