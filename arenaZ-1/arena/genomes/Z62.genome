"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene('s1', 'value of doing this option now; no wandering mid-recall, earlier recall, prefer bigger progress')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 136 if o.item == 6 else 0
    if o.kind == RECALL:
        if channeling():
            return 0
        return 90 if me().health_frac < 0.38 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 74
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if is_recalling(me()):
            return 0
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: altar with gems (fallback: any altar); else cleared groups awaiting capture, then nearest living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    live = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            live = live | group_tiles(g)
    n = nearest(live, me().pos)
    if valid(n):
        return near(n, 0)
    return live

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_F

@gene('s4', 'how much closer a step brings me to the goals (field read once)')
def progress(t: Tile) -> Num:
    f = goal_field()
    return at(f, me().pos) - at(f, t)

@gene('Z73a', 'per-turn cache of the goal distance field', parents=['s3'])
def update() -> None:
    GOAL_F = field(goals())
