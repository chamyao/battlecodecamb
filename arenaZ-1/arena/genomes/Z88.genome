"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z149a', 'value of doing this option now; ladder draft, merged casts, cached-field moves with gem urgency', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 75
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        if gems() > 0:
            return min(58, 45 + p)
        return min(55, p)
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9866)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('Z149b', 'goal-distance gain of a step (cached field), minus threat; threat weighs more when carrying gems or hurt', parents=['s4'])
def progress(t: Tile) -> Num:
    gain = at(GF, me().pos) - at(GF, t)
    pen = 1
    if me().health_frac < 0.5:
        pen = 2
    if gems() > 0:
        pen = pen + 1
    threat = sum(u.strength * u.health_frac for u in enemies() if dist(u.pos, t) <= 3)
    return gain * 10 - threat * pen

@gene('Z124a', 'cache the goal distance field once per turn', parents=['s3'])
def update() -> None:
    GF = goal_field()

@gene('Z102a', 'draft preference following the top ladder drafts', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z149c', 'value of casting: damage on enemy champions/camps, shield/heal on self when hurt or allies under threat', parents=['Z102b', 's1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        if exists(o.unit):
            if o.unit.is_enemy:
                return 0
            if o.unit.health_frac < 0.7 and count(dist(u.pos, o.unit.pos) <= 4 for u in enemies()) > 0:
                return 85
            return 0
        if me().health_frac < 0.6:
            return 85
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78
            if o.unit.is_camp and gems() == 0:
                return 62
        return 0
    return 0
