"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'altar when carrying 5+ gems (or no capture target); else cleared groups awaiting capture, then living camp groups')
def goals() -> Tiles:
    reward = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            reward = reward | group_tiles(g)
    if gems() > 0 and (gems() >= 5 or size(reward) == 0):
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 1)
        return acc
    if size(reward) > 0:
        return reward
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn)')
def goal_field() -> Field:
    return GOAL_F

@gene('s4', 'goal progress minus a penalty for enemies within 3 tiles of the step')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d - 2 * sum(1 for u in enemies() if dist(u.pos, t) <= 3)

@gene('Z25a', 'goal distance field avoiding walls and camp tiles, computed once per turn', parents=['s3'])
def update() -> None:
    GOAL_F = field_avoid(goals(), walls() | camp_tiles(), walls() - walls())
