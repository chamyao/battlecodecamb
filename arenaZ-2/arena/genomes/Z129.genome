"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
DZ: Tiles

@gene('s1', 'value of doing this option now', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 100
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat to spawn when hurt (earlier when carrying gems), heal before leaving spawn', parents=['s3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    limit = 0.3
    if gems() > 0:
        limit = 0.4
    if hf < limit:
        return field(home)
    if hf < 0.6 and m.pos in home:
        return field(home)
    if gems() >= 10 and hf < 0.65:
        return field(home)
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, clamped to [-3, 6]; 0 if unreachable; minus a penalty for danger near enemy champions', parents=['s4'])
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    there = at(GF, t)
    if here >= 500000000 or there >= 500000000:
        return 0
    p = here - there
    if p > 6:
        p = 6
    if p < -3:
        p = -3
    if t in DZ:
        p -= 2
    return p

@gene('Z12a', 'compute the goal distance field and a per-turn danger set (tiles near enemy champions) once per turn (skip when dead)', parents=['s4', 'Z12a'])
def update() -> None:
    if alive():
        GF = goal_field()
        DZ = near(me().pos, 0)
        for u in enemies():
            if u.is_champion:
                DZ = DZ | near(u.pos, 2)

@gene('Z12b', 'draft preference: Heart of Ruin first (sturdy, shield in fights), then Vesper Vale', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == HEART_OF_RUIN:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z12c', 'value of casting an ability option; shield in fights, heal allies, finish weak champions; dash scales with progress', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        if hf < 0.9 and count_units(enemies()) > 0:
            return 85
        if hf < 0.6:
            return 84
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy and not o.unit.is_camp:
            return 85 if o.unit.health_frac < 0.6 else 0
        return 85 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if gems() > 0:
                return 30 + 5 * p if p >= 2 else 0
            return 40 + 5 * p if p >= 2 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78 + 5 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
