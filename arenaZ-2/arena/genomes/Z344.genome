"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('Z508a', 'value of doing this option now; smart recall; focus weak champions; fight back against awake camps', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113 + 5 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60
        return 55 if is_awake(o.unit) else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group holding gems or gold; else any living group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) + group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; heal at spawn with hysteresis when badly hurt, retreat earlier (70%) when carrying 10+ gems, and home at 50% when carrying 5+ gems', parents=['s3', 's3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    if HEALING or hf < 0.3:
        return field(home)
    if gems() >= 10 and hf < 0.7:
        return field(home)
    if gems() >= 5 and hf < 0.5:
        return field(home)
    if hf < 0.5 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached per-turn field), clamped to [-2, 8]; 0 if either tile is unreachable', parents=['s4'])
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    there = at(GF, t)
    if here >= 500000000 or there >= 500000000:
        return 0
    p = here - there
    if p > 8:
        return 8
    if p < -2:
        return -2
    return p

@gene('Z12a', 'once per turn: update heal hysteresis, then compute the goal distance field (skip when dead)', parents=['s4', 's3'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.35:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        GF = goal_field()

@gene('Z12b', 'draft preference: Vesper Vale, Heart of Ruin, then Vendetta above Marcella, then Ryth', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == VENDETTA:
        return 4.5
    if c == MARCELLA:
        return 4
    if c == RYTH:
        return 2
    return 0.8699

@gene('Z508b', 'cast value: shield in fights or vs awake camps; heal allies and self, earlier in fights; dash scales with progress; stun enemy champions (bonus for gem carriers and weak targets); damage finishes weak champions', parents=['Z12c', 'Z12c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        foes = count_units(enemies())
        if hf < 0.9 and foes > 0:
            return 85
        if hf < 0.6:
            return 84
        if hf < 0.7 and any(is_awake(c) and dist(c.pos, me().pos) <= 3 for c in camps()):
            return 80
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy and not o.unit.is_camp:
            return 85 if o.unit.health_frac < 0.6 else 0
        if hf < 0.6:
            return 85
        if hf < 0.8 and count_units(enemies()) > 0:
            return 65
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if gems() > 0:
                return 30 + 5 * p if p >= 2 else 0
            return 40 + 5 * p if p >= 2 else 0
        return 0
    if k == AB_CC:
        if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
            carry = 20 if unit_gems(o.unit) > 0 else 0
            return 95 + carry + (15 if o.unit.health_frac < 0.35 else 0)
        if exists(o.unit) and o.unit.is_camp:
            return 58 if gems() == 0 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                carry = 15 if unit_gems(o.unit) > 0 else 0
                return 78 + carry + (20 if o.unit.health_frac < 0.35 else 0)
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0

@gene('Z215a', 'recall when hurt (earlier, ~60%, when carrying 5+ gems), far from spawn, and no enemy champion near enough to cancel it; value grows with gems carried', parents=['s1'])
def recall_value() -> Num:
    hf = me().health_frac
    carrying = gems()
    limit = 0.4
    if carrying >= 5:
        limit = 0.6044
    if hf >= limit:
        return 0
    here = me().pos
    sp = nearest(my_spawn(), here)
    if valid(sp) and dist(sp, here) <= 6:
        return 0
    if hf >= 0.25 and any(u.is_champion and dist(u.pos, here) <= 4 for u in enemies()):
        return 0
    return 90 + carrying
