"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('s1', 'value of doing this option now', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z305a', 'distance field to goals; retreat home to heal when badly hurt, when carrying 10+ gems below 60% or carrying any gems below 40%; with 6+ gems head to an altar; stay home while moderately hurt', parents=['Z305a', 's3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    if HEALING or hf < 0.3:
        return field(home)
    if gems() > 0 and hf < 0.4:
        return field(home)
    if gems() >= 10 and hf < 0.6:
        return field(home)
    if hf < 0.5 and m.pos in home:
        return field(home)
    if gems() >= 6 and size(altars()) > 0:
        return field(altars())
    return field(goals())

@gene('s4', 'progress toward goals (cached field); tripled while healing so retreat dominates; otherwise scaled by carried gems, capped at 2.5x', parents=['s4'])
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    if p > 100000000 or p < -100000000:
        return 0
    if HEALING:
        p = p * 3
    else:
        p = p * min(1 + gems() / 10, 2.5)
    return max(-9, min(9, p))

@gene('Z305b', 'once per turn: update heal hysteresis (start below 40%, stop above 90%), then compute the goal field (skip when dead)', parents=['Z305b', 'Z12a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        GF = goal_field()

@gene('Z12b', 'draft preference: Heart of Ruin first (sturdy, shield in fights), then Vesper Vale', parents=['Z12b'])
def pick_value(c: Num) -> Num:
    if c == HEART_OF_RUIN:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z305c', 'value of casting an ability: shield when threatened, heal when hurt, dash scaled by progress with gem and low-health bonuses; damage and CC favour wounded enemy champions, camps only when carrying no gems', parents=['Z305c', 'Z12c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        return 85 if hf < 0.7 and count_units(enemies()) > 0 else 0
    if k == AB_HEAL:
        return 85 if hf < 0.65 else 0
    if k == AB_DASH:
        if valid(o.tile) and hf >= 0.35:
            p = progress(o.tile)
            if p >= 2:
                bonus = 0
                if gems() > 0:
                    bonus += 20
                if hf < 0.5:
                    bonus += 15
                return min(90, 25 * p) + bonus
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 70 + 20 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    if k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 80 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
