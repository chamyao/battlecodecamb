"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
ENEMY_NEAR: Tiles
HEALING: Bool = False

@gene('s1', 'value of doing this option now', parents=['s1', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.3:
            return 90
        if me().health_frac < 0.4 and count_units(enemies()) > 0:
            return 88
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 49 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1.0462)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat earlier when enemies are within 4 tiles or when carrying 10+ gems; heal latch (HEALING) keeps me home until healthy; heal to 80% on spawn before leaving', parents=['s3', 's3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    limit = 0.3
    if gems() > 0:
        limit = 0.4
    if gems() >= 10:
        limit = 0.5
    if sum(1 for u in enemies() if dist(u.pos, m.pos) <= 4) > 0:
        limit = limit + 0.15
    if HEALING or hf < limit:
        return field(home)
    if hf < 0.8 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'progress toward goals; threat penalty for steps into enemy range grows smoothly as health drops (0.5 at full health, 3.5 at zero)', parents=['s4', 's4'])
def progress(t: Tile) -> Num:
    base = at(GF, me().pos) - at(GF, t)
    if t in ENEMY_NEAR:
        pen = 0.5 + 3.0 * (1.0 - me().health_frac)
        return base - pen
    return base

@gene('Z12a', 'once per turn: update heal hysteresis, compute the goal field and enemy-threat tiles (skip when dead)', parents=['s4', 's3', 's4'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.35:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        GF = goal_field()
        ENEMY_NEAR = near(me().pos, 0) - near(me().pos, 0)
        for u in enemies():
            ENEMY_NEAR = ENEMY_NEAR | near(u.pos, 2)

@gene('Z12b', 'draft preference: Vesper Vale first (strong with Power Strength), then Heart of Ruin, Marcella, Vendetta, Ryth', parents=['s1', 'Z12b'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 0.8699

@gene('Z12c', 'value of casting an ability: shield/heal when hurt in fights or near awake camps; dash toward goals (bonus when carrying gems); damage enemy champions (more when low); camps when empty-handed; reset when the other ability is down', parents=['s1', 'Z12c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        if hf < 0.7:
            if count_units(enemies()) > 0:
                return 85
            if any(is_awake(c) and dist(c.pos, me().pos) <= 3 for c in camps()):
                return 80
        return 0
    if k == AB_HEAL:
        return 85 if hf < 0.657 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return min(90, 20 * p) + (20 if gems() > 0 else 0)
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 and hf > 0.4:
                    return 58
                return 25
        return 0
    if k == AB_RESET:
        other = 1 - o.slot
        return 40 if not slot_ready(other) and count_units(enemies()) > 0 else 0
    return 0
