"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
ENEMY_NEAR: Tiles
HEALING: Bool = False
HOME_F: Field = None
HOME_SET: Bool = False

@gene('s1', 'value of doing this option now', parents=['s1', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z362a', 'distance field to the goals; reuse the cached home field to heal with hysteresis when badly hurt, retreat earlier when carrying gems or when enemies are close and I am hurt or outnumbered', parents=['Z362a'])
def goal_field(es: Units, hf: Num) -> Field:
    m = me()
    if HEALING or hf < 0.3:
        return HOME_F
    if gems() >= 10 and hf < 0.8:
        return HOME_F
    if hf < 0.5 and m.pos in my_spawn():
        return HOME_F
    if hf < 0.75:
        close = count(dist(u.pos, m.pos) <= 4 for u in es)
        if close > 0:
            if hf < 0.6:
                return HOME_F
            pals = count(dist(a.pos, m.pos) <= 4 for a in allies())
            if close >= pals + 1:
                return HOME_F
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached field), clamped to [-3, 6], minus a threat penalty for steps near enemies; doubled while healing; scaled up by carried gems; 0 if either tile is unreachable', parents=['s4'])
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    there = at(GF, t)
    if here >= 500000000 or there >= 500000000:
        return 0
    p = here - there
    if t in ENEMY_NEAR:
        p -= 0.5 + 3.0 * (1.0 - me().health_frac)
    if p > 6:
        p = 6
    if p < -3:
        p = -3
    if HEALING:
        p = p * 2
    else:
        p = p * (1 + gems() / 10)
    return p

@gene('Z244a', 'once per turn: heal hysteresis (enter at 40%, leave at 90%), cache the home field once, compute the goal field and enemy-proximity tiles from one enemies() read (skip when dead)', parents=['Z244a'])
def update() -> None:
    if alive():
        m = me()
        hf = m.health_frac
        if hf < 0.4:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        if not HOME_SET:
            HOME_F = field(my_spawn())
            HOME_SET = True
        es = enemies()
        GF = goal_field(es, hf)
        ENEMY_NEAR = near(m.pos, 0) - near(m.pos, 0)
        for u in es:
            ENEMY_NEAR = ENEMY_NEAR | near(u.pos, 2)

@gene('Z362b', 'draft preference: Heart of Ruin first (sturdy, shield in fights), then Vesper Vale, then Marcella', parents=['Z362b'])
def pick_value(c: Num) -> Num:
    if c == HEART_OF_RUIN:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 0.8699

@gene('Z492a', 'casting: shield when hurt in fights or near awake camps; heal self and allies; dash scaled by progress; stun or damage enemy champions (bonus when they carry gems and when they are low); clear camps, keep hitting awake camps while carrying', parents=['Z237a', 'Z12c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    foes = count_units(enemies())
    if k == AB_SHIELD:
        if foes > 0:
            if hf < 0.9:
                return 85
            if any(dist(u.pos, me().pos) <= 2 for u in enemies()):
                return 80
            return 0
        if hf < 0.6:
            return 84
        if hf < 0.7 and any(is_awake(c) and dist(c.pos, me().pos) <= 3 for c in camps()):
            return 80
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy and not o.unit.is_camp:
            return 85 if o.unit.health_frac < 0.6 else 0
        if hf < 0.6:
            return 85
        if hf < 0.8 and foes > 0:
            return 65
        return 60 if hf < 1.1243 and foes == 0 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if gems() == 0:
                return 45 + 5 * p if p >= 2 else 0
            return 30 + 5 * p if p >= 2 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                carry = 15 if unit_gems(o.unit) > 0 else 0
                base = 95 if k == AB_CC else 78
                v = base + carry + 5 * (1 - o.unit.health_frac)
                return v + 15 if o.unit.health_frac < 0.35 else v
            if o.unit.is_camp:
                if gems() == 0:
                    return 58
                return 40 if is_awake(o.unit) else 0
        return 0
    return 0
