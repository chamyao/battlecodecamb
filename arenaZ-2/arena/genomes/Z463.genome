"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
ENEMY_NEAR: Tiles
HEALING: Bool = False
NE: Num = 0
HF: Num = 1
COVER: Tiles = None

@gene('s1', 'value of doing this option now; fight back against awake camps even when carrying gems; cached health/enemy count', parents=['s1', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if HF < 0.3:
            return 90
        if HF < 0.4 and NE > 0:
            return 88
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        if gems() == 0:
            return 60
        if HF > 0.4 and is_awake(o.unit):
            return 55
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = 5 if gems() >= 5 else 0
            return 49 + 10 * min(p, 2) + bonus
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1.0462)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat earlier when enemies are near (scaled by count), relax the threshold with nearby allies; heal latch (HEALING) keeps me home until healthy; heal to 85% on spawn before leaving', parents=['s3', 's3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    limit = 0.3
    if gems() > 0:
        limit = 0.4381
    if gems() >= 10:
        limit = 0.5
    near_foes = sum(1 for u in enemies() if dist(u.pos, m.pos) <= 4)
    limit = limit + 0.1 * min(near_foes, 3)
    near_allies = sum(1 for u in allies() if dist(u.pos, m.pos) <= 3)
    support = max(0, near_allies - 1)
    limit = limit - 0.05 * min(support, 2)
    if limit < 0.2:
        limit = 0.2
    if HEALING or hf < limit:
        return field(home)
    if hf < 0.85 and m.pos in home:
        return field(home)
    return field(goals())

@gene('Z485a', 'progress toward goals, scaled by carried gems unless healing (doubled); threat penalty for steps into enemy range grows as health drops, +1 when carrying 5+ gems, reduced when 2+ allies cover the step (precomputed cover tiles)', parents=['s4', 's4'])
def progress(t: Tile) -> Num:
    base = at(GF, me().pos) - at(GF, t)
    g = gems()
    if HEALING:
        base = base * 2
    else:
        base = base * (1 + g / 20)
    if t in ENEMY_NEAR:
        pen = 0.5 + 3.0 * (1.0 - HF)
        if g >= 5:
            pen += 1.0
        if t in COVER:
            pen = pen * 0.6
        return base - pen
    return base

@gene('Z12a', 'once per turn: heal hysteresis, goal field, enemy-threat tiles, cached health/enemy count, tiles covered by 2+ allies (skip when dead)', parents=['s4', 's3', 's4'])
def update() -> None:
    if alive():
        hf = me().health_frac
        HF = hf
        if hf < 0.35:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        GF = goal_field()
        p = me().pos
        ENEMY_NEAR = near(p, 0) - near(p, 0)
        n = 0
        for u in enemies():
            ENEMY_NEAR = ENEMY_NEAR | near(u.pos, 2)
            n += 1
        NE = n
        seen = near(p, 0) - near(p, 0)
        cov = near(p, 0) - near(p, 0)
        for a in allies():
            r = near(a.pos, 3)
            cov = cov | (seen & r)
            seen = seen | r
        COVER = cov

@gene('Z12b', 'draft preference: Vesper Vale first (strong with Power Strength builds), then Heart of Ruin, Marcella, Vendetta, Ryth', parents=['s1', 'Z12b'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 0.8699

@gene('Z485b', 'cast value: shield vs close enemy champions or when hurt near enemies/awake camps; heal when hurt; dash toward goals with gem and low-health bonuses; CC/damage favour enemy champions, finish low ones; damage camps when empty-handed and healthy; reset when other ability down; uses cached health/enemy count', parents=['Z12c', 'Z12c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = HF
    if k == AB_SHIELD:
        if NE > 0:
            if hf < 0.8 and any(u.is_champion and dist(u.pos, me().pos) <= 4 for u in enemies()):
                return 88
            if hf < 0.7:
                return 85
        if hf < 0.7 and any(is_awake(c) and dist(c.pos, me().pos) <= 3 for c in camps()):
            return 80
        return 0
    if k == AB_HEAL:
        if hf < 0.657:
            return 85
        if hf < 0.8 and NE > 0:
            return 65
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = min(progress(o.tile), 4)
            if p >= 1:
                bonus = 0
                if gems() > 0:
                    bonus += 20
                if hf < 0.5:
                    bonus += 15
                return min(90, 20 * p) + bonus
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                low = 15 if o.unit.health_frac < 0.35 else 0
                if k == AB_CC:
                    return 82 + 10 * (1 - o.unit.health_frac) + low
                return 78 + 10 * (1 - o.unit.health_frac) + low
            if o.unit.is_camp:
                if gems() == 0 and hf > 0.4:
                    return 86
                return 25
        return 0
    if k == AB_RESET:
        other = 1 - o.slot
        return 64 if not slot_ready(other) and NE > 0 else 0
    return 0
