"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 66 if me().health_frac < 0.2534 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 49 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1.0462)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat earlier when enemies are within 4 tiles or when carrying 10+ gems, and heal to 80% on spawn before leaving')
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    limit = 0.3
    if gems() > 0:
        limit = 0.4
    if gems() >= 10:
        limit = 0.5
    if sum(1 for u in enemies() if dist(u.pos, m.pos) <= 4) > 0:
        limit = limit + 0.15
    if hf < limit:
        return field(home)
    if hf < 0.8 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'progress toward goals; guards unreachable fields; penalises nearby enemies by strength*health, harder when hurt')
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    there = at(GF, t)
    if here >= 1000000 or there >= 1000000:
        return -5
    p = here - there
    danger = sum(u.strength * u.health_frac for u in enemies() if dist(u.pos, t) <= 2)
    k = 2 if me().health_frac < 0.5 else 0.5
    return p - k * danger

@gene('Z12a', 'compute the goal distance field once per turn (skip when dead)', parents=['s4'])
def update() -> None:
    if alive():
        GF = goal_field()

@gene('Z12b', 'draft preference: Heart of Ruin first (sturdy, shield in fights), then Vesper Vale', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == HEART_OF_RUIN:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 0.9886

@gene('Z12c', 'value of casting an ability option; dash scales with distance gained', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        return 85 if hf < 0.7 and count_units(enemies()) > 0 else 0
    if k == AB_HEAL:
        return 85 if hf < 0.657 else 0
    if k == AB_DASH:
        if valid(o.tile) and gems() == 0:
            pr = progress(o.tile)
            return min(45, 15 * pr) if pr >= 2 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
