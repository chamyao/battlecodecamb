"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('Z599a', 'value of doing this option now; recalls below 30% always and below 45% when no fight is close; champions attacked first (B priorities above casts-on-camps), gold buys treasure shard', parents=['s1', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        hf = me().health_frac
        if hf < 0.28:
            return 90
        if hf < 0.45 and not in_fight():
            return 75
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 102 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 71
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z599b', 'distance field to the goals; retreat to spawn below 30% (45% when carrying gems), or carrying 10+ gems below 70%; stay home and top up to 85% before leaving', parents=['s3', 's3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    limit = 0.3
    if gems() > 0:
        limit = 0.45
    if hf < limit:
        return field(home)
    if gems() >= 10 and hf < 0.7:
        return field(home)
    if hf < 0.85 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'progress toward goals; tripled while healing so retreat dominates; gem bonus scales with carried gems but is capped at 2.5x; zero when our own tile is unreachable in the field so stranded champions do not read huge progress', parents=['s4'])
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    if here > 100000000:
        return 0
    p = here - at(GF, t)
    if HEALING:
        p = p * 2
    else:
        p = p * min(1 + gems() / 10, 2.5)
    return p

@gene('Z12a', 'once per turn: heal hysteresis (start below 40%, stop above 90%); while healing the field points home so the hysteresis actually holds the retreat, otherwise the goal distance field (skip when dead)', parents=['s4', 's3'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        if HEALING:
            GF = field(my_spawn())
        else:
            GF = goal_field()

@gene('Z12b', 'draft preference: Vesper Vale first, then Heart of Ruin (sturdy, shield in fights), then Marcella', parents=['s1', 'Z12b'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z12c', 'value of casting an ability option; shield in fights or near awake camps when hurt; heal at 66% or earlier in fights; stun or damage enemy champions with bonuses for carried gems and finishing low-health targets; dash scales with progress toward goals', parents=['s1', 'Z12c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    foes = count_units(enemies())
    if k == AB_SHIELD:
        if hf >= 0.85:
            return 0
        if in_fight():
            return 85 + 10 * (1 - hf)
        if any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
            return 80
        return 0
    if k == AB_HEAL:
        if hf < 0.4735:
            return 92
        if hf < 0.657:
            return 85
        if hf < 0.7692 and foes > 0:
            return 65 + (20 if gems() > 0 else 0)
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                bonus = 0
                if gems() >= 10:
                    bonus += 30
                elif gems() > 0:
                    bonus += 15
                if hf < 0.5:
                    bonus += 15
                return min(90, 20 * p) + bonus
        return 0
    if k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                carry = 20 if unit_gems(o.unit) > 0 else 0
                return 95 + carry + (15 if o.unit.health_frac < 0.35 else 0)
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                carry = 15 if unit_gems(o.unit) > 0 else 0
                return 78 + carry + 20 * (1 - o.unit.health_frac) + (6 if o.unit.health_frac < 0.35 else 0)
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
            return 0
        if valid(o.tile):
            r = max(1, slot_radius(o.slot))
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            if n > 0:
                return 85 + 5 * n
        return 0
    return 0

@gene('Z520a', 'true when an enemy champion is within 5 tiles or an awake camp is within 3 tiles', parents=['Z12c'])
def in_fight() -> Bool:
    mp = me().pos
    if any(dist(u.pos, mp) <= 5 for u in enemies()):
        return True
    return any(is_awake(c) and dist(c.pos, mp) <= 3 for c in camps())
