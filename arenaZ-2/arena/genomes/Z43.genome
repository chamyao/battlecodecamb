"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now, merged from both parents', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living gem-bearing camp group; else any living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat to spawn to heal when badly hurt and not carrying a tribute run', parents=['s3', 's2'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    if hf < 0.3:
        return field(home)
    if hf < 0.5 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'progress toward goals, minus a penalty for steps within 2 tiles of an enemy champion', parents=['s4'])
def progress(t: Tile) -> Num:
    base = at(GF, me().pos) - at(GF, t)
    threats = count(u.is_champion and dist(u.pos, t) <= 2 for u in enemies())
    return base - 3 * threats

@gene('Z12a', 'compute the goal distance field once per turn (skip when dead)', parents=['s4', 'Z12a'])
def update() -> None:
    if alive():
        GF = goal_field()

@gene('Z12b', 'draft preference by ladder strength', parents=['Z12b'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z12c', 'value of casting an ability option: shield and heal when hurt, dash toward goals, damage on enemies and camps', parents=['Z12c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        if count_units(enemies()) > 0:
            return 90 if hf < 0.5 else (85 if hf < 0.7 else 0)
        return 0
    if k == AB_HEAL:
        return 85 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if gems() == 0:
                return 45 if progress(o.tile) >= 2 else 0
            return 60 if progress(o.tile) >= 3 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 92 if o.unit.health_frac < 0.4 else 78
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
