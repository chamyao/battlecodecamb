"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('s1', 'value of doing this option now', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 71 if me().health_frac < 0.3029 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat to spawn to heal when badly hurt, keep delivering when carrying gems and not critical, idle at spawn when no goals', parents=['s3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    g = goals()
    if gems() >= 10 and hf >= 0.2 and size(g) > 0:
        return field(g)
    if HEALING or hf < 0.3:
        return field(home)
    if hf < 0.6 and m.pos in home:
        return field(home)
    if size(g) == 0:
        return field(home)
    return field(g)

@gene('s4', 'progress toward goals; zero when either tile is unreachable, doubled when carrying gems', parents=['s4'])
def progress(t: Tile) -> Num:
    a = at(GF, me().pos)
    b = at(GF, t)
    if a >= 1000000 or b >= 1000000:
        return 0
    base = a - b
    return base * 2 if gems() > 0 else base

@gene('Z12a', 'once per turn: update heal hysteresis (enter below 0.43, leave above 0.95), then compute the goal distance field (skip when dead or channeling, since the field is unused then)', parents=['s4', 's3'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.43:
            HEALING = True
        if hf > 0.95:
            HEALING = False
        if not channeling():
            GF = goal_field()

@gene('Z12b', 'draft preference: Vesper Vale first, then Heart of Ruin', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5.5
    if c == MARCELLA:
        return 3
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 0.8699

@gene('Z12c', 'value of casting an ability option; dash scales with progress toward goals, bonus when carrying gems', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        return 85 if hf < 0.7 and count_units(enemies()) > 0 else 0
    if k == AB_HEAL:
        return 85 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return min(90, 20 * p) + (20 if gems() > 0 else 0)
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
