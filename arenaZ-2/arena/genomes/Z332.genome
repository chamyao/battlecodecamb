"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
ENEMY_NEAR: Tiles
HEALING: Bool = False
HOME_F: Field = None
HOME_SET: Bool = False

@gene('s1', 'value of doing this option now; moves scale with goal progress so bigger gains (and gem-boosted steps) win', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.33 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 10 + 6 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z362a', 'distance field to the goals; reuse the cached home field to heal with hysteresis when badly hurt, retreat earlier when carrying gems (10+ below 80% health) or when enemies are within 4 and I am hurt or outnumbered', parents=['s3', 's3'])
def goal_field(es: Units, hf: Num) -> Field:
    m = me()
    if HEALING or hf < 0.3:
        return HOME_F
    if gems() >= 10 and hf < 0.8:
        return HOME_F
    if hf < 0.5 and m.pos in my_spawn():
        return HOME_F
    if hf < 0.75:
        close = count(dist(u.pos, m.pos) <= 4 for u in es)
        if close > 0:
            if hf < 0.6:
                return HOME_F
            pals = count(dist(a.pos, m.pos) <= 4 for a in allies())
            if close >= pals + 1:
                return HOME_F
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached field), clamped to [-3, 6], minus a threat penalty for steps into enemy range that grows as health drops; doubled while healing; scaled up by carried gems; 0 if either tile is unreachable', parents=['s4', 's4'])
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    there = at(GF, t)
    if here >= 500000000 or there >= 500000000:
        return 0
    p = here - there
    if t in ENEMY_NEAR:
        p -= 0.5 + 3.0 * (1.0 - me().health_frac)
    if p > 6:
        p = 6
    if p < -3:
        p = -3
    if HEALING:
        p = p * 2
    else:
        p = p * (1 + gems() / 10)
    return p

@gene('Z244a', 'once per turn: update heal hysteresis (enter at 40% like top teams), cache the static home field once, compute the goal field and enemy-proximity tiles from a single enemies() read (skip when dead)', parents=['Z12a', 's4'])
def update() -> None:
    if alive():
        m = me()
        hf = m.health_frac
        if hf < 0.4:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        if not HOME_SET:
            HOME_F = field(my_spawn())
            HOME_SET = True
        es = enemies()
        GF = goal_field(es, hf)
        ENEMY_NEAR = near(m.pos, 0) - near(m.pos, 0)
        for u in es:
            ENEMY_NEAR = ENEMY_NEAR | near(u.pos, 2)

@gene('Z362b', 'draft preference: Heart of Ruin first (sturdy, shield in fights), then Vesper Vale, then Marcella', parents=['Z12b', 'Z12b'])
def pick_value(c: Num) -> Num:
    if c == HEART_OF_RUIN:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 0.8699

@gene('Z237a', 'casting: shield when hurt in fights, when enemies are close, or vs awake camps when hurt; heal self and allies; dash scaled by progress; nuke champions (more when low), clear camps, keep hitting awake camps while carrying', parents=['Z12c', 'Z12c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        if count_units(enemies()) > 0:
            if hf < 0.9:
                return 85
            if any(dist(u.pos, me().pos) <= 2 for u in enemies()):
                return 80
            return 0
        if hf < 0.6:
            return 84
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy and not o.unit.is_camp:
            return 85 if o.unit.health_frac < 0.6 else 0
        if hf < 0.6:
            return 85
        return 60 if hf < 1.1243 and count_units(enemies()) == 0 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p < 2:
                return 0
            if gems() > 0:
                return 30 + 5 * p
            return 40 + 5 * p
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                v = 78 + 5 * (1 - o.unit.health_frac)
                return v + 2 if o.unit.health_frac < 0.4 else v
            if o.unit.is_camp:
                if gems() == 0:
                    return 58
                return 40 if is_awake(o.unit) else 0
        return 0
    return 0
