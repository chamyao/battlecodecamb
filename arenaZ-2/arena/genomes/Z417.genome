"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
ENEMY_NEAR: Tiles
HEALING: Bool = False

@gene('Z608a', 'value of doing this option now; moves scale with progress toward goals; tribute slightly above walking; camp attacks when empty-handed', parents=['s1', 'Z554a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.3:
            return 90
        if me().health_frac < 0.4 and count_units(enemies()) > 0:
            return 88
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 102 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 71
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 49 + 10 * min(p, 2)
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1.0462)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z608b', 'distance field to the goals; retreat earlier when enemies are near (scaled by count), relax with nearby allies; heal latch keeps me home until healthy; heal to 85% on spawn before leaving', parents=['s3', 'Z554b'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    limit = 0.3
    if gems() > 0:
        limit = 0.4381
    if gems() >= 10:
        limit = 0.5
    near_foes = sum(1 for u in enemies() if dist(u.pos, m.pos) <= 4)
    limit = limit + 0.1 * min(near_foes, 3)
    near_allies = sum(1 for u in allies() if dist(u.pos, m.pos) <= 3)
    support = max(0, near_allies - 1)
    limit = limit - 0.05 * min(support, 2)
    if limit < 0.2:
        limit = 0.2
    if HEALING or hf < limit:
        return field(home)
    if hf < 0.85 and m.pos in home:
        return field(home)
    return field(goals())

@gene('Z608c', 'progress toward goals, scaled by carried gems unless healing (doubled); 0 if unreachable; threat penalty for steps into enemy range grows as health drops, +1 when carrying 5+ gems', parents=['Z485a', 's4'])
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    there = at(GF, t)
    if here >= 1000000 or there >= 1000000:
        return 0
    base = here - there
    if HEALING:
        base = base * 2
    else:
        base = base * (0.7443 + gems() / 20)
    if t in ENEMY_NEAR:
        pen = 0.5 + 3.0 * (1.0 - me().health_frac)
        if gems() >= 5:
            pen += 1.0
        return base - pen
    return base

@gene('Z608d', 'once per turn: update heal hysteresis, compute the goal field and enemy-threat tiles (skip when dead)', parents=['Z12a', 's4'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.35:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        GF = goal_field()
        ENEMY_NEAR = near(me().pos, 0) - near(me().pos, 0)
        for u in enemies():
            ENEMY_NEAR = ENEMY_NEAR | near(u.pos, 2)

@gene('Z608e', 'draft preference: Heart of Ruin first, then Vesper Vale, Marcella, Vendetta, Ryth', parents=['Z12b'])
def pick_value(c: Num) -> Num:
    if c == HEART_OF_RUIN:
        return 9
    if c == VESPER_VALE:
        return 8
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z608f', 'value of casting: shield vs champions or awake camps when hurt; heal in fights; stun/damage enemy champions (bonus if they carry gems or are low); dash toward goals by steps gained; damage camps when empty-handed', parents=['Z485b', 'Z554c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    foes = count_units(enemies())
    if k == AB_SHIELD:
        if foes > 0:
            if hf < 0.8 and sum(1 for u in enemies() if u.is_champion and dist(u.pos, me().pos) <= 4) > 0:
                return 88
            if hf < 0.7:
                return 85
        if hf < 0.7 and any(is_awake(c) and dist(c.pos, me().pos) <= 3 for c in camps()):
            return 80
        return 0
    if k == AB_HEAL:
        if hf < 0.7:
            return 85
        if hf < 0.7692 and foes > 0:
            return 65
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            steps = min(progress(o.tile), 4)
            if gems() == 0:
                return 30 + 15 * steps if steps >= 2 else 0
            return 20 + 15 * steps if steps >= 2 else 0
        return 0
    if k == AB_CC:
        if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
            carry = 20 if unit_gems(o.unit) > 0 else 0
            return 95 + carry + (15 if o.unit.health_frac < 0.35 else 0)
        if exists(o.unit) and o.unit.is_camp:
            return 58 if gems() == 0 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                carry = 15 if unit_gems(o.unit) > 0 else 0
                low = 20 if o.unit.health_frac < 0.35 else 0
                return 78 + carry + low + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 and hf > 0.4:
                    return 86
                return 25 if gems() == 0 else 0
        return 0
    if k == AB_RESET:
        other = 1 - o.slot
        return 64 if not slot_ready(other) and foes > 0 else 0
    return 0
