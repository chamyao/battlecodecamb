"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now; focus weak champions, recall ~40% health unless already on spawn, avoid camp fights when low')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.4:
            if me().pos in my_spawn():
                return 0
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if gems() == 0 and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat to spawn to heal when badly hurt and not carrying a tribute run')
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    if hf < 0.3:
        return field(home)
    if hf < 0.5 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached per-turn field); invalid or unreachable tiles give 0')
def progress(t: Tile) -> Num:
    if not valid(t):
        return 0
    d = at(GF, t)
    if d >= 100000000:
        return 0
    here = at(GF, me().pos)
    if here >= 100000000:
        return 1
    return here - d

@gene('Z116a', 'skip listing option kinds we never use (wards, locks) to save fuel', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK:
        return False
    return True

@gene('Z12a', 'compute the goal distance field once per turn (skip when dead)', parents=['s4'])
def update() -> None:
    if alive():
        GF = goal_field()

@gene('Z12b', 'draft preference: Vesper, Heart (raised), Marcella, Vendetta, Ryth', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 9
    if c == HEART_OF_RUIN:
        return 8.5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 6
    if c == RYTH:
        return 5
    return 1

@gene('Z12c', 'value of casting an ability option; dash scales with progress toward goals, larger bonus when carrying gems', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        return 85 if hf < 0.7 and count_units(enemies()) > 0 else 0
    if k == AB_HEAL:
        return 85 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return min(90, 20 * p) + (30 if gems() > 0 else 0)
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
