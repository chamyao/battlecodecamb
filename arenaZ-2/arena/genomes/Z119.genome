"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False

@gene('s1', 'value of doing this option now; carrying gems raises the value of steps toward goals', parents=['s1', 'Z12c'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if progress(o.tile) <= 0:
            return 0
        return 85 if gems() > 0 else 50
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living gem-bearing camp group; else any living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, or to my spawn when retreating to heal', parents=['s3'])
def goal_field(retreat: Bool) -> Field:
    if retreat:
        return field(my_spawn())
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached per-turn field)', parents=['s4'])
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z12a', 'compute the goal distance field once per turn; skip when dead; retreat home to heal at low health (with hysteresis)', parents=['s4', 'Z12a'])
def update() -> None:
    if not alive():
        RETREAT = False
        return
    hf = me().health_frac
    if hf < 0.3:
        RETREAT = True
    elif hf >= 0.9:
        RETREAT = False
    GF = goal_field(RETREAT)

@gene('Z12b', 'draft preference: Vesper Vale first (Power Strength bruiser), then Heart of Ruin, Marcella, Vendetta, Ryth', parents=['Z12b'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z12c', 'value of casting an ability option: threat-aware shield/heal, dash scales with progress toward goals (not while retreating), enemy champion CC/damage scales with missing health and gem carrying', parents=['Z12c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    foes = count_units(enemies())
    if k == AB_SHIELD:
        if foes > 0:
            return 95 if hf < 0.5 else (88 if hf < 0.8 else 30)
        return 0
    if k == AB_HEAL:
        if foes == 0:
            return 86 if hf < 0.8 else 0
        return 84 if hf < 0.45 else 0
    if k == AB_DASH:
        if RETREAT:
            return 0
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return min(90, 20 * p) + (20 if gems() > 0 else 0)
        return 0
    if k == AB_CC:
        if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
            v = 88 + 5 * (1 - o.unit.health_frac)
            if unit_gems(o.unit) > 0:
                v += 5
            return min(95, v)
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                v = 70 + 20 * (1 - o.unit.health_frac)
                if unit_gems(o.unit) > 0:
                    v += 10
                return min(95, v)
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
