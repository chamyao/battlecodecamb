"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
FOES: Num = 0

@gene('s1', 'value of doing this option now', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z305a', 'distance field to goals; retreat to heal with heal hysteresis, earlier when carrying gems; with 10+ gems head to an altar; stay home while moderately hurt on spawn', parents=['Z305a', 's3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    if HEALING or hf < 0.3:
        return field(home)
    if gems() >= 10 and hf < 0.7:
        return field(home)
    if hf < 0.85 and m.pos in home:
        return field(home)
    if gems() >= 10 and size(altars()) > 0:
        return field(altars())
    return field(goals())

@gene('Z453a', 'progress toward goals, clamped to +-6 so dashes register their gain; doubled while healing so retreat dominates; scaled by carried gems otherwise; unreachable reads as no progress', parents=['s4', 's4'])
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    there = at(GF, t)
    if here >= 100000000 or there >= 100000000:
        return 0
    p = max(-6, min(6, here - there))
    if HEALING:
        p = p * 2
    else:
        p = p * (1 + gems() / 10)
    return p

@gene('Z305b', 'once per turn: update heal hysteresis (start below 40%, stop above 90%), cache enemy count, then compute the goal field (skip when dead)', parents=['Z305b', 'Z12a'])
def update() -> None:
    FOES = 0
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        FOES = count_units(enemies())
        GF = goal_field()

@gene('Z12b', 'draft preference: Vesper Vale first, then Heart of Ruin (sturdy, shield in fights)', parents=['Z12b', 'Z12b'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z12c', 'value of casting an ability: shield when threatened or near awake camps, heal at 60% or earlier in fights, stun enemy champions (cancels tribute) with a finishing bonus, damage on wounded champions, dash scaled by progress with gem and low-health bonuses; uses the enemy count cached in update()', parents=['Z12c', 'Z305c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    foes = FOES
    if k == AB_SHIELD:
        if hf >= 0.7:
            return 0
        if foes > 0:
            return 85
        return 80 if any(is_awake(c) and dist(c.pos, me().pos) <= 3 for c in camps()) else 0
    if k == AB_HEAL:
        if hf < 0.6:
            return 85
        if HEALING and hf < 0.8:
            return 60
        if hf < 0.8 and foes > 0:
            return 65
        return 0
    if k == AB_DASH:
        if valid(o.tile) and hf >= 0.35:
            p = progress(o.tile)
            if p >= 2:
                bonus = 0
                if gems() > 0:
                    bonus += 20
                if hf < 0.5:
                    bonus += 15
                return min(90, 22 * p) + bonus
        return 0
    if k == AB_CC:
        if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
            return 95 + (15 if o.unit.health_frac < 0.35 else 0)
        if exists(o.unit) and o.unit.is_camp:
            return 58 if gems() == 0 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 70 + 20 * (1 - o.unit.health_frac) + (10 if o.unit.health_frac < 0.35 else 0)
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
