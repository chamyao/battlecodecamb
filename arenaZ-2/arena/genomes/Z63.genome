"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now; focus low-health targets, recall near ladder threshold, tribute and gem-carrying priorities', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if channeling():
            return 0
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 75
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an unlocked altar when carrying gems; else a cleared group awaiting capture; else a living camp group, preferring ones with gems', parents=['s2'])
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat to spawn to heal when badly hurt and not carrying a tribute run', parents=['s3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    if hf < 0.3:
        return field(home)
    if hf < 0.5 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached per-turn field)', parents=['s4'])
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z12a', 'compute the goal distance field once per turn (skip when dead)', parents=['s4'])
def update() -> None:
    if alive():
        GF = goal_field()

@gene('Z12b', 'draft preference by ladder strength, avoid duplicating our own picks', parents=['s1'])
def pick_value(c: Num) -> Num:
    v = 1
    if c == VESPER_VALE:
        v = 6
    elif c == HEART_OF_RUIN:
        v = 5
    elif c == MARCELLA:
        v = 4
    elif c == VENDETTA:
        v = 3
    elif c == RYTH:
        v = 2
    if picked_by_us(c):
        v = v * 0.1
    return v

@gene('Z12c', 'value of casting an ability option; dash scales with progress toward goals, bonus when carrying gems', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        return 85 if hf < 0.7 and count_units(enemies()) > 0 else 0
    if k == AB_HEAL:
        return 85 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return min(90, 20 * p) + (20 if gems() > 0 else 0)
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
