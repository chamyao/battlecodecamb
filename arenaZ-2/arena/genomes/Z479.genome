"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
ENEMY_NEAR: Tiles
HEALING: Bool = False

@gene('Z648a', 'value of doing this option now; recall near enemies plus early recall out of fight; champion attacks first, camp attacks 102 when no gems; cast and move values', parents=['Z648a', 'Z599a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        hf = me().health_frac
        if hf < 0.28:
            return 90
        if hf < 0.4 and count_units(enemies()) > 0:
            return 88
        if hf < 0.45 and not in_fight():
            return 75
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 102 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 71
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 20 + min(29, p * 10)
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z599b', 'distance field to the goals; retreat below 30% (45% carrying gems), more retreat as nearby enemies grow, or carrying 10+ gems below 70%; stay home and top up to 85% before leaving; heal latch holds retreat', parents=['Z599b', 'Z648c'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    if HEALING:
        return field(home)
    limit = 0.3
    if gems() > 0:
        limit = 0.45
    near_foes = count(dist(u.pos, m.pos) <= 4 for u in enemies())
    limit = limit + 0.05 * min(near_foes, 3)
    if limit > 0.6:
        limit = 0.6
    if hf < limit:
        return field(home)
    if gems() >= 10 and hf < 0.7:
        return field(home)
    if hf < 0.85 and m.pos in home:
        return field(home)
    return field(goals())

@gene('Z648b', 'progress toward goals, 0 if unreachable; doubled while healing, else gem scaling capped at 2.5x; steps into enemy-threat tiles are penalised, more when hurt and for gem carriers', parents=['Z648b', 'Z599c'])
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    if here >= 1000000:
        return 0
    there = at(GF, t)
    if there >= 1000000:
        return 0
    p = here - there
    if HEALING:
        p = p * 2
    else:
        p = p * min(1 + gems() / 10, 2.5)
    if t in ENEMY_NEAR:
        pen = 1.0 + 4.0 * (1.0 - me().health_frac)
        if gems() >= 5:
            pen += 3.0
        p = p - pen
    return p

@gene('Z12a', 'once per turn: heal hysteresis (start below 35-40%, stop above 90%); goal field; enemy-threat tiles sized by attack range, monsters at least radius 2 (skip when dead)', parents=['Z12a', 'Z12d'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.37:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        GF = goal_field()
        ENEMY_NEAR = near(me().pos, 0) - near(me().pos, 0)
        for u in enemies():
            if u.is_champion:
                ENEMY_NEAR = ENEMY_NEAR | near(u.pos, u.attack_range + 1)
            else:
                ENEMY_NEAR = ENEMY_NEAR | near(u.pos, max(2, u.attack_range + 1))

@gene('Z12b', 'draft preference: Vesper Vale first, then Heart of Ruin, Marcella, Vendetta, Ryth', parents=['Z12b', 'Z12e'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 0.8699

@gene('Z12c', 'value of casting an ability: shield in fights or near awake camps when hurt; heal by threshold (B), earlier in fights; CC and damage on enemy champions with carry and low-health bonuses; AOE on enemy clusters; camp damage only when no gems; dash scales with progress', parents=['Z12c', 'Z648c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    foes = count_units(enemies())
    if k == AB_SHIELD:
        if hf >= 0.85:
            return 0
        if in_fight():
            return 85 + 10 * (1 - hf)
        if any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
            return 80
        return 0
    if k == AB_HEAL:
        if hf < 0.4735:
            return 92
        if hf < 0.657:
            return 85
        if hf < 0.7692 and foes > 0:
            return 65 + (20 if gems() > 0 else 0)
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                bonus = 0
                if gems() >= 10:
                    bonus += 40
                elif gems() > 0:
                    bonus += 15
                if hf < 0.5:
                    bonus += 15
                return min(90, 20 * p) + bonus
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                low = 15 if o.unit.health_frac < 0.35 else 0
                carry = 15 if unit_gems(o.unit) > 0 else 0
                if k == AB_CC:
                    return 92 + carry + 10 * (1 - o.unit.health_frac) + low
                return 87 + carry + 15 * (1 - o.unit.health_frac) + low
            if o.unit.is_camp and k != AB_CC:
                if gems() == 0 and (hf > 0.4 or in_fight()):
                    return 86
                return 25 if gems() == 0 else 0
            return 0
        if valid(o.tile) and k != AB_CC:
            r = max(1, slot_radius(o.slot))
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            if n > 0:
                return 85 + 5 * n
        return 0
    if k == AB_RESET:
        other = 1 - o.slot
        return 64 if not slot_ready(other) and count_units(enemies()) > 0 else 0
    return 0

@gene('Z520a', 'true when an enemy champion is within 5 tiles or an awake camp is within 3 tiles', parents=['Z520a', 'Z12c'])
def in_fight() -> Bool:
    mp = me().pos
    if any(dist(u.pos, mp) <= 5 for u in enemies()):
        return True
    return any(is_awake(c) and dist(c.pos, mp) <= 3 for c in camps())
