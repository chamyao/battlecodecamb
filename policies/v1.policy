# v1: starter + strength shards + abilities on camps and enemies + recall at 20% health.
# Hand-written from single-change experiments (each measured over 400 games vs starter).

# ---- draft ----
if is_draft():
    let pool = unpicked_champions()
    if available(pool, champ_vesper_vale()):
        pick(champ_vesper_vale())
    else:
        pick( random_champion(pool) )
    end_turn()

# ---- every turn ----
keep camp_spawns = camp_spawn_tiles()

if not alive() or channeling() or (not can_move() and not can_attack()):
    end_turn()

let at_spawn = contains( spawn_region(ally), position() )
if at_spawn:
    buy( shard(stat_strength()), floor( gold() / 30 ) )

if not at_spawn and health() < 0.2 * max_health():
    recall()
    end_turn()

let enemy = first( filter( enemies_visible(), in_attack_range ) )
if exists(enemy):
    if ability_ready(0):
        cast_at_unit(0, enemy)
    if ability_ready(1):
        cast_at_unit(1, enemy)
    attack(enemy)
    end_turn()

if gems() > 0:
    let open_altars = minus( altars(), locked_altars() )
    let altar = first( filter( open_altars, within(1, position()) ) )
    if exists(altar):
        tribute(altar)
        end_turn()
    move_towards( closest( ring(open_altars, 1) ) )
    end_turn()

let camp = first( filter( camps_visible(), in_attack_range ) )
if exists(camp):
    if ability_ready(0):
        cast_at_unit(0, camp)
    if ability_ready(1):
        cast_at_unit(1, camp)
    attack(camp)
    end_turn()
let goals = minus( camp_spawns, respawning_visible_spawns() )
move_towards( closest(goals) )
let camp2 = first( filter( camps_visible(), in_attack_range ) )
if exists(camp2):
    attack(camp2)
set_priority( 1 + random_int(100) )
end_turn()
