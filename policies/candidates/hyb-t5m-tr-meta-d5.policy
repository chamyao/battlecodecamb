# hyb-t5m-tr-meta-d5 [hybrid line]: hyb-t5m + TOP_TEAMS_RULES combat (engage <= 8 at HP >= 0.8, enemies_within(5) <= allies_within(5)+1, closest target, ability opener, basic>reset>basic, disengage < 0.5 HP) + meta draft (VV, HoR, Vendetta, Marcella, Ryth).
# tune-5 [line: tune]: parent tune-3. Camp-goal dash from distance > 2 (was 4) and Jungle shards = half the rest after
# Treasure (was a third). Each was ~+4 in the tune-3 constant grid (54 variants screened, top 8 confirmed).
# Together, on 2 x 400 fresh games (seeds 9019/9020, sim @ interp/v0 c92239d): 53.25% / 53.25% vs tune-3
# (promoted under Cham's > 52% bar); cambc-exact 80 vs tune-3 47/80. Gauntlet tune-5 (tune-3): v4 86.6 (85.1),
# locker 95.3 (93.9), fs-2 86.7 (84.6), starter 98.0 (98.2), v5d-fs2 77.4 (77.8), v7 76.7 (74.8), v7-zerogem 76.5 (73.1),
# v7zg-cast 67.4 (65.1), Icecream 77.5 (75.6), Odyssey 85.4 (83.5), metab stand-in 85.6 (86.6).
# (tune-4 is the coordinator's unshipped monolith-fallback variant on interp/v0, hence 5.)
# tune-3 [line: tune]: parent tune-2. Policy-level fuel guard: the optional dash toward a far camp goal only when
# fuel_remaining() > 55000 (the near-cap turns are far camp trips: dash + long move search). Sim @ interp/v0 7a19520
# (80/80 cambc match). 01big-world as A vs tune-2, 600 per-game-seeded games: suspensions 0.56/game (tune-2 1.06),
# win rate 50.7% (tune-2 mirror 50.3%). cambc-exact 80-game check vs tune-2: 41/80; 400 all-map games 52.0%.
# Sweep: F 45k-70k, goal dash vs all dashes; F <= 45k never fires, F >= 70k loses (27% on big-world).
# tune-2 [line: tune]: parent tune-1. Tribute bag 25 gems (was 10) and tribute-when-hurt below 0.3 health (was 0.5):
# each alone was ~+3.5 (constant grid, 50 variants screened, top 8 confirmed), together they interact.
# 2 x 400 fresh games (seeds 9005/9006, sim @ interp/v0 340ce89, 80/80 cambc match): 60.75%/61.0% vs tune-1;
# cambc-exact 80-game check vs tune-1 57.5%. Gauntlet tune-2 (tune-1): v4 84.5 (85.9), locker 95.5 (96.4),
# fs-2 87.1 (85.9), starter 98.6 (98.2), v5d-fs2 78.1 (78.6), v7 74.4 (73.0), v7-zerogem 73.1 (71.6),
# v7zg-cast 64.8 (58.0), Icecream draft 76.4 (67.0), Odyssey draft 82.6 (80.9).
# tune-1 [line: tune]: parent v7zg-cast. Draft order vendetta, vesper_vale, tavi, ryth, ren (frontliner first,
# ryth/ren replace marcella/stellar). Racing draft search: 233 orders screened at 200 games, top 8 confirmed on
# 2 x 400 fresh seeds (sim @ interp/v0 f848dcd): 60.8%/57.0% vs v7zg-cast; cambc-exact 80-game check 62.5%;
# vs v4 86.0 (+1.4), locker 95.4 (+1.3), fs-2 83.1 (+2.3), starter 98.6 (+0.1), v5d-fs2 75.8 (+1.6), v7 71.8 (+5.1),
# v7-zerogem 72.8 (+8.5), Icecream draft 68.1 (+10.1), Odyssey draft 80.1 (+2.8) (in brackets: change vs v7zg-cast).
# v7zg-cast [hybrid line]: v7-zerogem + ability-type-aware casting grafted from hybrid #14 (Opus, runs/hyb2-g1 #14): shield/heal on self, dash kept for escape and far camp goals, damage/aoe/stun/reset at the target.
# v7-zerogem: v7 + fixes for the three maps where a v7 mirror tributes nothing (docs/ZERO_GEM_MAPS.md):
# no fighting enemies on their own spawn, fight a camp that is the only way to an altar, and go
# for monoliths when nothing is tributed by round 300. Proposal from the sim-calibration session.
# v7: v5d-fs2 + idle fix (docs/FARM_DIAGNOSIS.md on deploy/v0): when standing on a dead camp of an
# uncleared group, walk to the nearest living camp instead of idling.
# v5d-fs2 [hybrid line]: v5d plus fs-2's league finds (Treasure/Jungle shards; tribute at >= 10 gems, when hurt, or after round 1500).
# v5d: v5 with a fixed draft order (the composition that won 75% of a v4 mirror).
# v5: v4 attacking the weakest enemy in range (focus fire) instead of the first.
# v4: v3 + altar fixes from docs/LADDER_LOSSES_V3.md: never freeze when every altar is locked
# (tributing a locked altar attacks the lock), and prefer altars out of monolith reach.
# v3: fs-1 + three fixes from the ladder-loss analysis (docs/LADDER_LOSSES.md on analysis/sprint1):
# retreat toward spawn below 30% health while in_danger() and recall only once clear; hold on a
# camp tile only when its group is capturable; skip monoliths and golems.
# Based on fs-1: FunSearch pilot #146 (5 Haiku edits from v1): split strength/health shards, heal on spawn,
# retreat at 50% health when carrying gems, hold on a cleared camp spawn to capture, one camps_visible() per turn.

# zg14: ability-type-aware casting from hybrid #14 (Opus): shield/heal on self, dash kept for escape/travel
def cast_on(slot, u):
    if ability_ready(slot):
        if slot_is_shield(slot) or slot_is_heal(slot):
            cast_self(slot)
        elif not slot_is_dash(slot):
            cast_at_unit(slot, u)

def dash_to(slot, t):
    if ability_ready(slot):
        if slot_is_dash(slot):
            dash_towards(slot, t)

# TOP_TEAMS_RULES fight step (docs/TOP_TEAMS_RULES.md on analysis/sprint1): ability opener on the first-hit
# turn (damage/stun/aoe from range, dash from 3), then basic > attack reset > basic; names the team target
def fight(u):
    set_team_target(u)
    if ability_ready(0) and not slot_is_dash(0) and not slot_is_shield(0) and not slot_is_heal(0) and not slot_is_reset(0):
        cast_at_unit(0, u)
    if ability_ready(1) and not slot_is_dash(1) and not slot_is_shield(1) and not slot_is_heal(1) and not slot_is_reset(1):
        cast_at_unit(1, u)
    if distance(position(), unit_position(u)) <= 3 and distance(position(), unit_position(u)) > 1:
        if ability_ready(0) and slot_is_dash(0):
            dash_towards(0, unit_position(u))
        if ability_ready(1) and slot_is_dash(1):
            dash_towards(1, unit_position(u))
    if not exists( first( filter( enemies_visible(), in_attack_range() ) ) ):
        move_towards( unit_position(u) )
    attack(u)
    if ability_ready(0) and slot_is_reset(0):
        cast_at_unit(0, u)
        attack(u)
    if ability_ready(1) and slot_is_reset(1):
        cast_at_unit(1, u)
        attack(u)
    end_turn()

# ---- draft ----
if is_draft():
    let pool = unpicked_champions()
    if available(pool, champ_vesper_vale()):
        pick(champ_vesper_vale())
    elif available(pool, champ_heart_of_ruin()):
        pick(champ_heart_of_ruin())
    elif available(pool, champ_vendetta()):
        pick(champ_vendetta())
    elif available(pool, champ_marcella()):
        pick(champ_marcella())
    elif available(pool, champ_ryth()):
        pick(champ_ryth())
    else:
        pick( random_champion(pool) )
    end_turn()

# ---- every turn ----
keep camp_spawns = camp_spawn_tiles()
keep altar_ring = ring( altars(), 1 )
keep safe_altar_ring = ring( minus( altars(), ring(monolith_tiles(), 5) ), 1 )
# gems outside monolith groups (0 on 00contest-like maps, where monoliths are the only gems)
keep non_mono_gem_spawns = count( minus( rich_spawns(1), group_tiles( monolith_tiles() ) ) )

if not alive() or channeling() or (not can_move() and not can_attack()):
    end_turn()

let at_spawn = contains( spawn_region(ally()), position() )
if at_spawn:
    let shards_bought = floor( gold() / 30 )
    let treasure_n = floor( shards_bought / 2 )
    let rest_after_treasure = shards_bought - treasure_n
    let jungle_n = floor( rest_after_treasure / 2 )
    let rest_after_jungle = rest_after_treasure - jungle_n
    let strength_shards = floor( rest_after_jungle / 2 )
    buy( shard_of(family_treasure(), stat_strength()), treasure_n )
    buy( shard_of(family_jungle(), stat_health()), jungle_n )
    buy( shard(stat_strength()), strength_shards )
    buy( shard(stat_health()), rest_after_jungle - strength_shards )
    # heal on spawn before heading back out, unless an enemy is already in reach
    if health() < max_health() and not exists(first(filter(enemies_visible(), in_attack_range()))):
        end_turn()

# retreat at 20% health normally, but at 50% when carrying gems
if not at_spawn and health() < 0.3 * max_health():
    if in_danger():
        let home = closest( spawn_region(ally()) )
        dash_to(0, home)
        dash_to(1, home)
        move_towards(home)
        end_turn()
    recall()
    end_turn()
if not at_spawn and gems() > 0 and health() < 0.5 * max_health() and not in_danger():
    recall()
    end_turn()

# ---- combat (TOP_TEAMS_RULES) ----
let foe = nearest( enemies_visible() )
let foe_ok = exists(foe) and not contains( spawn_region(enemy()), unit_position(foe) )
# disengage early (they leave at 0.77-0.94 HP and die 1.6 times a game) unless the target is nearly dead
if foe_ok and not at_spawn and health() < 0.5 * max_health() and distance(position(), unit_position(foe)) <= 5 and unit_health_frac(foe) > 0.3:
    move_away_from( unit_position(foe) )
    end_turn()
# in reach: keep fighting, team target first, else the weakest in range
let tt = team_target()
let in_reach = weakest( filter( enemies_visible(), in_attack_range() ) )
if exists(in_reach) and not contains( spawn_region(enemy()), unit_position(in_reach) ):
    if exists(tt) and distance(unit_position(tt), unit_position(in_reach)) <= 1:
        fight(tt)
    fight(in_reach)
# engage at vision range while healthy and not outnumbered (usually 2v1), closest enemy
if foe_ok and health() >= 0.8 * max_health() and distance(position(), unit_position(foe)) <= 8 and enemies_within(5) <= allies_within(5) + 1:
    fight(foe)

# tribute only with a worthwhile bag (or when hurt / late game)
let bag_ready = gems() >= 25 or round_number() > 1500 or health() < 0.3 * max_health()
if gems() > 0 and bag_ready:
    # an altar next to us works even when locked: tributing there attacks the lock (5 hits clear it)
    let altar = first( filter( altars(), within(1, position()) ) )
    if exists(altar):
        tribute(altar)
        end_turn()
    # walk to an open altar out of monolith reach (5); else any altar out of reach; else any altar
    let target = closest( minus( safe_altar_ring, ring(locked_altars(), 1) ) )
    if exists(target):
        move_towards(target)
        end_turn()
    let target2 = closest(safe_altar_ring)
    if exists(target2):
        move_towards(target2)
        end_turn()
    let altar_goal = closest(altar_ring)
    # every altar-adjacent tile is taken by a camp (01boss-battle: holes and a monolith): fight it
    if contains(camp_spawns, altar_goal):
        let blocker = first( filter( camps_visible(), in_attack_range() ) )
        if exists(blocker):
            attack(blocker)
            end_turn()
    move_towards( altar_goal )
    end_turn()

# one camps_visible() query per turn, reused for both attack checks
let camps = camps_visible()

let camp = first( filter( camps, in_attack_range() ) )
if exists(camp):
    cast_on(0, camp)
    cast_on(1, camp)
    attack(camp)
    end_turn()

# nothing tributed by round 300 (00contest: only monoliths carry gems): go for monoliths too
if team_score(ally()) == 0 and round_number() > 300 and non_mono_gem_spawns == 0:
    move_towards( closest( minus( minus( camp_spawns, respawning_visible_spawns() ), golem_tiles() ) ) )
    end_turn()
let goals = minus( minus( minus( camp_spawns, respawning_visible_spawns() ), monolith_tiles() ), golem_tiles() )

# already standing on a cleared camp spawn: hold here so the capture timer keeps running
if contains(capturable_spawns(), position()):
    end_turn()

let goal = closest(goals)
# on a dead camp of a group that is not cleared yet, the closest goal is our own tile: walk to the
# nearest living camp instead (not a monolith or golem), so the group can be finished
if distance(goal, position()) == 0:
    let live = nearest(camps)
    if exists(live) and not contains( union( monolith_tiles(), golem_tiles() ), unit_position(live) ):
        move_towards( unit_position(live) )
        end_turn()
# tunable: dash toward a camp goal only when it is farther than this
# fuel guard (tune line): skip the optional dash on a near-cap turn
if exists(goal) and distance(position(), goal) > 2 and fuel_remaining() > 55000:
    dash_to(0, goal)
    dash_to(1, goal)
move_towards( goal )
let camp2 = first( filter( camps, in_attack_range() ) )
if exists(camp2):
    attack(camp2)
set_priority( 1 + random_int(100) )
end_turn()
