if is_draft():
    let pool = unpicked_champions()
    if available(pool, champ_vendetta()):
        pick(champ_vendetta())
    elif available(pool, champ_vesper_vale()):
        pick(champ_vesper_vale())
    elif available(pool, champ_tavi()):
        pick(champ_tavi())
    elif available(pool, champ_ryth()):
        pick(champ_ryth())
    elif available(pool, champ_ren()):
        pick(champ_ren())
    else:
        pick( random_champion(pool) )
    end_turn()
let mono = closest(ring(monolith_tiles(), 1))
if exists(mono):
    if camp_threat(position()) > 0:
        move_away_from(mono)
        end_turn()
    if in_monolith_zone(position()):
        let c = first(filter(camps_visible(), in_attack_range()))
        if exists(c):
            attack(c)
            end_turn()
    move_towards(mono)
    end_turn()
let safe = closest(altar_safe_tiles())
if exists(safe):
    move_towards(safe)
end_turn()
