if is_draft():
    let pool = unpicked_champions()
    if available(pool, champ_vendetta()):
        pick(champ_vendetta())
    elif available(pool, champ_vesper_vale()):
        pick(champ_vesper_vale())
    elif available(pool, champ_tavi()):
        pick(champ_tavi())
    elif available(pool, champ_ryth()):
        pick(champ_ryth())
    elif available(pool, champ_ren()):
        pick(champ_ren())
    else:
        pick( random_champion(pool) )
    end_turn()
let goal = closest( camp_spawn_tiles() )
if exists(goal):
    if group_rate(goal) > 0.3:
        move_towards(goal)
        end_turn()
    move_away_from(goal)
    end_turn()
