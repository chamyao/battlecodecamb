"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
MONO: Tiles = None
MONO_DONE: Bool = False

@gene('s1', 'value of doing this option now; recall to shop when rich, focus the weakest enemy champion, never poke a monolith')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return buy_value(o.item, o.count)
    if o.kind == RECALL:
        return 90 if want_recall() else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + (1 - o.unit.health_frac) * 9
        if o.unit.type == MONOLITH:
            return 0
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals without monolith groups (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z36a', 'once per turn: remember every tile of monolith groups (first turn), cache the distance field to the goals minus monolith groups', parents=['s3'])
def update() -> None:
    if not MONO_DONE:
        mono = type_spawns(MONOLITH)
        acc = near(tile(-5, -5), 0)
        for g in range(num_groups()):
            gt = group_tiles(g)
            if size(gt & mono) > 0:
                acc = acc | gt
        MONO = acc
        MONO_DONE = True
    GF = field(goals() - MONO)

@gene('Z7a', 'value of casting an ability option: damage and stuns on champions or camps, resets after an attack, shields and heals when hurt, dashes toward the goal (counts once per pass)', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC:
        if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
            return 85
        if exists(o.unit) and o.unit.is_camp and gems() == 0 and o.unit.type != MONOLITH:
            return 65
        return 0
    if k == AB_AOE:
        if not (o.tile in hot_tiles()):
            return 0
        n = count(dist(u.pos, o.tile) <= 1 for u in enemies()) * 2 + count(dist(u.pos, o.tile) <= 1 and is_awake(u) for u in camps())
        return 60 + 5 * n if n > 0 else 0
    if k == AB_RESET:
        return 62 if not can_attack() and foes_in_reach() > 0 else 0
    if k == AB_SHIELD:
        return 88 if me().health_frac < 0.8 and threats() > 0 else 0
    if k == AB_HEAL:
        return 87 if exists(o.unit) and o.unit.health_frac < 0.6 else 0
    if k == AB_DASH:
        return 55 if progress(o.tile) >= 2 else 0
    return 0

@gene('Z48a', 'shop value: a Treasure strength emblem first (more gold), then Power strength', parents=['s1'])
def buy_value(item: Num, n: Num) -> Num:
    if item == 18 and items_owned(19) == 0:
        return 100 + n
    if item == 6:
        return 95 + n
    return 0

@gene('Z48b', 'worth recalling: low health, or 150+ gold with an empty bag and nothing threatening nearby', parents=['s1'])
def want_recall() -> Bool:
    if me().health_frac < 0.3:
        return True
    return gold() >= 150 and gems() == 0 and threats() == 0 and not (me().pos in my_spawn())

@gene('Z48c', 'tiles next to an enemy champion or an awake camp (once per pass)', parents=['Z7a'])
def hot_tiles() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for u in enemies():
        acc = acc | near(u.pos, 1)
    for u in camps():
        if is_awake(u):
            acc = acc | near(u.pos, 1)
    return acc

@gene('Z48d', 'enemy champions and awake camps within my basic attack range (once per pass)', parents=['Z7a'])
def foes_in_reach() -> Num:
    return count(dist(u.pos, me().pos) <= me().attack_range for u in enemies()) + count(is_awake(u) and dist(u.pos, me().pos) <= me().attack_range for u in camps())

@gene('Z48e', 'enemy champions within 4 plus awake camps (once per pass)', parents=['Z7a'])
def threats() -> Num:
    return count(dist(u.pos, me().pos) <= 4 for u in enemies()) + count(is_awake(u) for u in camps())
