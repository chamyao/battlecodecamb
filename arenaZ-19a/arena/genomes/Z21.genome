"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

MONO: Tiles = None
MONO_DONE: Bool = False
GF: Field = None
GF_OK: Bool = False
GF_BAG: Bool = False

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living camp group that is not too strong yet')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if not too_strong(gt):
                acc = acc | gt
    return acc

@gene('s3', 'distance field to the goals: the cached one while the bag state is unchanged, else a fresh one')
def goal_field() -> Field:
    if GF_OK and GF_BAG == (gems() > 0):
        return GF
    return field(goals())

@gene('Z23a', 'end of turn: cache the distance field to the goals for the next turn', parents=['s3'])
def after() -> None:
    GF = field(goals())
    GF_OK = True
    GF_BAG = gems() > 0

@gene('Z23b', 'true if a group is too strong to take on now: monoliths always, golems before round 600', parents=['s2'])
def too_strong(gt: Tiles) -> Bool:
    if size(gt & MONO) > 0:
        return True
    return round() < 600 and size(gt & type_spawns(GOLEM)) > 0

@gene('Z9a', 'once: remember the monolith spawn tiles (static map data)', parents=['s2'])
def update() -> None:
    if not MONO_DONE:
        MONO = type_spawns(MONOLITH)
        MONO_DONE = True

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)
