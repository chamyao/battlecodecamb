"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HOT: Tiles = None
THREATS: Num = 0
FOES_IN_REACH: Num = 0
MONO: Tiles = None
MONO_DONE: Bool = False

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return draft_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if retreating():
        if o.kind == MOVE:
            dn = danger_at(o.tile)
            return 95 - dn if dn < danger_at(me().pos) else 0
        if o.kind == RECALL:
            return 0
        if o.kind == ATTACK:
            return 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + (1 - o.unit.health_frac) * 9
        if o.unit.type == MONOLITH:
            return 0
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group that is not a monolith")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc - MONO

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z69a', 'once per turn: cache the distance field to the goals', parents=['s3'])
def update() -> None:
    if not MONO_DONE:
        mono = type_spawns(MONOLITH)
        acc = near(tile(-5, -5), 0)
        for g in range(num_groups()):
            gt = group_tiles(g)
            if size(gt & mono) > 0:
                acc = acc | gt
        MONO = acc
        MONO_DONE = True
    GF = field(goals())
    hot = near(tile(-5, -5), 0)
    reach = 0
    threats = 0
    for u in enemies():
        hot = hot | near(u.pos, 1)
        threats += 1 if dist(u.pos, me().pos) <= 4 else 0
        reach += 1 if dist(u.pos, me().pos) <= me().attack_range else 0
    for u in camps():
        if is_awake(u):
            hot = hot | near(u.pos, 1)
            threats += 1
            reach += 1 if dist(u.pos, me().pos) <= me().attack_range else 0
    HOT = hot
    THREATS = threats
    FOES_IN_REACH = reach

@gene('s4', 'how much closer a step brings me to the goals; prefer bushes; with a big bag keep two tiles away from enemy champions')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    if gems() >= 20 and any(dist(u.pos, t) <= 2 for u in enemies()):
        return d - 1.5
    if d > 0 and t in bushes():
        return d + 0.5
    return d

@gene('Z7a', 'value of casting an ability option: damage and stuns on champions or camps, resets after an attack, shields and heals when hurt, dashes toward the goal (counts once per pass)', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC:
        if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
            return 85 + (1 - o.unit.health_frac) * 9 + min(unit_gems(o.unit), 30) / 3
        if exists(o.unit) and o.unit.is_camp and gems() == 0 and o.unit.type != MONOLITH:
            return 65
        return 0
    if k == AB_AOE:
        if not (o.tile in hot_tiles()):
            return 0
        n = count(dist(u.pos, o.tile) <= 1 for u in enemies()) * 2 + count(dist(u.pos, o.tile) <= 1 and is_awake(u) for u in camps())
        return 60 + 5 * n if n > 0 else 0
    if k == AB_RESET:
        return 62 if not can_attack() and foes_in_reach() > 0 else 0
    if k == AB_SHIELD:
        return 88 if me().health_frac < 0.8 and threat_count() > 0 else 0
    if k == AB_HEAL:
        return 87 if exists(o.unit) and o.unit.health_frac < 0.6 else 0
    if k == AB_DASH:
        if slot_radius(o.slot) > 0 and o.tile in hot_tiles():
            return 70
        return 55 if progress(o.tile) >= 2 else 0
    return 0

@gene('Z96a', 'tiles next to an enemy champion or an awake camp (once per pass)', parents=['Z7a'])
def hot_tiles() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for u in enemies():
        acc = acc | near(u.pos, 1)
    for u in camps():
        if is_awake(u):
            acc = acc | near(u.pos, 1)
    return acc

@gene('Z96b', 'enemy champions and awake camps within my basic attack range (once per pass)', parents=['Z7a'])
def foes_in_reach() -> Num:
    return count(dist(u.pos, me().pos) <= me().attack_range for u in enemies()) + count(is_awake(u) and dist(u.pos, me().pos) <= me().attack_range for u in camps())

@gene('Z96c', 'enemy champions within 4 plus awake camps (once per pass)', parents=['Z7a'])
def threat_count() -> Num:
    return count(dist(u.pos, me().pos) <= 4 for u in enemies()) + count(is_awake(u) for u in camps())

@gene('Z69b', 'draft order: a ranged gold earner, a stunner, a ranged stunner, a splash melee, a stun-immune melee', parents=['s1'])
def draft_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 10
    if c == RYTH:
        return 9
    if c == TAVI:
        return 8
    if c == VARG:
        return 7
    if c == MARCELLA:
        return 6
    return 1

@gene('Z69c', 'hurt and threatened: walk out of reach before recalling (damage cancels a recall)', parents=['s1'])
def retreating() -> Bool:
    return me().health_frac < 0.35 and danger_at(me().pos) > 0

@gene('Z69d', 'how many awake camps and enemy champions can hit this tile', parents=['s1'])
def danger_at(t: Tile) -> Num:
    return count(is_awake(u) and dist(u.pos, t) <= u.attack_range for u in camps()) + count(dist(u.pos, t) <= u.attack_range + 1 for u in enemies())
