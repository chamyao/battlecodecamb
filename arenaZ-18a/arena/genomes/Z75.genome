"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: draft, casts, focus the weakest foe, heal on spawn, cash out a big bag, recall only out of danger; shop durability and jungle emblems')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return shop_value(o)
    if o.kind == RECALL:
        if under_threat():
            return 0
        if me().health_frac < (0.45 if gems() > 0 else 0.3):
            return 90
        if gems() >= 10 and me().health_frac < 0.5:
            return 90
        return 45 if gems() == 0 and gold() >= 210 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 0 if o.unit.pos in enemy_spawn() else 80 + 10 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60
        return 54 if path_blocked() else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if me().pos in my_spawn() and me().health_frac < 0.9 and count_units(enemies()) == 0:
            return 0
        return 50 if step_gain(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, minus a penalty for stepping next to enemy champions when hurt')
def progress(t: Tile) -> Num:
    gain = at(goal_field(), me().pos) - at(goal_field(), t)
    if me().health_frac < 0.5 and any(dist(u.pos, t) <= u.attack_range + 1 for u in enemies()):
        return gain - 2
    if gems() > 0 and any(dist(u.pos, t) <= u.attack_range + 1 and u.health > me().health for u in enemies()):
        return gain - 2
    return gain

@gene('Z80a', 'walking field home, for retreats', parents=['s1'])
def home_field() -> Field:
    return field(my_spawn())

@gene('Z80b', 'how much closer a step brings me: toward home when badly hurt under threat, else toward the goals', parents=['s1'])
def step_gain(t: Tile) -> Num:
    if me().health_frac < 0.35 and under_threat():
        return at(home_field(), me().pos) - at(home_field(), t)
    return progress(t)

@gene('Z51a', 'draft preference: Vendetta, Vesper Vale, Tavi, Ryth, Ren, then anything', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == VENDETTA:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == TAVI:
        return 4
    if c == RYTH:
        return 3
    if c == REN:
        return 2
    return 1

@gene('Z51b', 'value of a cast: damage or stun on foes and camps, shield or heal when hurt, attack resets once the attack is spent, dash two steps toward the goal', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        return 85 if o.unit == me() and me().health_frac < 0.7 else 0
    if k == AB_RESET:
        if can_attack():
            return 0
        r = me().attack_range
        if any(dist(u.pos, me().pos) <= r for u in enemies()):
            return 88
        return 66 if gems() == 0 and any(dist(c.pos, me().pos) <= r for c in camps()) else 0
    if k == AB_DASH:
        return 52 if progress(o.tile) >= 2 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit) and o.unit.is_enemy and o.unit.is_champion:
            return 86
        if exists(o.unit) and o.unit.is_camp and gems() == 0:
            return 65
        if any(u.pos == o.tile for u in enemies()):
            return 84
    return 0

@gene('Z51c', 'an enemy champion within its range + 3 or an awake camp within its range + 1', parents=['s1'])
def under_threat() -> Bool:
    p = me().pos
    return any(dist(p, u.pos) <= u.attack_range + 3 for u in enemies()) or any(is_awake(c) and dist(p, c.pos) <= c.attack_range + 1 for c in camps())

@gene('Z97a', 'no free step brings me closer to the goals (a camp or unit is in the way)', parents=['s1'])
def path_blocked() -> Bool:
    return not any(progress(t) > 0 for t in near(me().pos, 1) - camp_tiles() - ally_tiles() - enemy_tiles())

@gene('Z64a', 'shop: a durability health emblem, then a jungle health emblem, then power strength; bigger buys first', parents=['s1'])
def shop_value(o: Option) -> Num:
    if items_owned(17) == 0:
        return 100 + o.count / 100 if o.item == 16 and o.count <= 5 - items_owned(16) else 0
    if items_owned(29) == 0:
        return 100 + o.count / 100 if o.item == 28 and o.count <= 5 - items_owned(28) else 0
    return 100 + o.count / 100 if o.item == 6 else 0
