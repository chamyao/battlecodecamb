"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

DEAD: Tiles = None    # camp spawns seen empty (their camp is dead) in groups not yet cleared
WF: Field = None      # this turn's walking field
RETREAT: Bool = False # this turn: badly hurt under threat, walk home
HIT: Bool = False     # this turn: I lost health since last turn
LASTHP: Num = 0       # my health at the start of last turn
ALT: Tiles = None     # tiles next to altars we can tribute at (cached)
LIVEG: Tiles = None   # spawn tiles of live groups not yet cleared (cached)
REWG: Tiles = None    # spawn tiles of cleared groups waiting for capture (cached)
GOAL: Tile = None     # this turn's walking goal
GTURN: Num = 0        # round to re-pick the walking goal
GSKEY: Num = -1000    # group state the cached sets were built for

@gene('s1', 'value of doing this option now: draft, casts, focus the weakest foe, fight back against awake camps, heal on spawn, cash out a big bag; shop durability and jungle emblems; recall only out of danger')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return shop_value(o)
    if o.kind == RECALL:
        if under_threat():
            return 0
        if me().health_frac < 0.45:
            return 76
        return 76 if gems() >= 10 and me().health_frac < 0.5 and count_units(enemies()) == 0 else 0
    if (o.kind == MOVE or o.kind == CAST or o.kind == ATTACK) and RETREAT:
        return retreat_value(o)
    if o.kind == CAST:
        return cast_v2(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (0.6312 - o.unit.health_frac)
        if gems() == 0:
            if big_camp(o.unit) and not is_awake(o.unit):
                return 0
            return 60 + 5 * (1 - o.unit.health_frac)
        if is_awake(o.unit):
            return 55
        return 54 if path_blocked() else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if me().pos in my_spawn() and me().health_frac < 0.9 and count_units(enemies()) == 0:
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s3', 'walking field this turn (set in update)')
def goal_field() -> Field:
    return WF

@gene('Z121a', 'start of turn: dead camp spawns, cached goal sets (rebuilt when bag or group state changes), retreat flag, then a walking goal by walk distance (re-picked every 8 rounds) and a field to it around units')
def update() -> None:
    live = camp_tiles()
    DEAD = (DEAD | ((camp_spawns() & vision()) - live)) - live
    if size(DEAD) > 0:
        for g in range(num_groups()):
            if group_respawning(g):
                DEAD = DEAD - group_tiles(g)
    k = -1 - size(locked_altars())
    if gems() == 0:
        k = 0
        p = 1
        for g in range(num_groups()):
            if not group_respawning(g):
                k += p * (2 if group_reward(g) else 1)
            p *= 3
    force = k != GSKEY
    if force:
        GSKEY = k
        if gems() > 0:
            ALT = near(tile(-5, -5), 0)
            for a in altars() - locked_altars():
                ALT = ALT | near(a, 1)
        else:
            LIVEG = near(tile(-5, -5), 0)
            REWG = LIVEG
            for g in range(num_groups()):
                if not group_respawning(g):
                    if group_reward(g):
                        REWG = REWG | group_tiles(g)
                    else:
                        LIVEG = LIVEG | group_tiles(g)
    HIT = me().health < LASTHP - 0.5
    LASTHP = me().health
    RETREAT = me().health_frac < 0.3 and (HIT or under_threat())
    here = me().pos
    unseen = camp_spawns() - vision() - DEAD
    blk = (walls() | holes() | altars() | enemy_spawn() | ally_tiles() | enemy_tiles() | live | unseen) - near(here, 0)
    tgt = my_spawn()
    if not RETREAT:
        tgt = ALT if gems() > 0 else REWG | (LIVEG - DEAD)
    if here in tgt:
        GOAL = here
    elif force or not valid(GOAL) or not (GOAL in tgt) or GOAL == here or round() >= GTURN:
        cand = tgt - (blk - live - unseen)
        GOAL = walk_nearest(cand, here, blk - cand)
        GTURN = round() + 8
    gt = near(GOAL, 0)
    WF = field_avoid(gt, blk - gt, near(here, 0))

@gene('s4', 'how much closer a step brings me to the goals, minus a penalty for stepping next to enemy champions when hurt')
def progress(t: Tile) -> Num:
    gain = at(goal_field(), me().pos) - at(goal_field(), t)
    if me().health_frac < 0.5 and any(dist(u.pos, t) <= u.attack_range + 1 for u in enemies()):
        return gain - 2
    return gain

@gene('Z170a', 'a monolith or golem camp', parents=['s1'])
def big_camp(u: Unit) -> Bool:
    k = spawn_type(camp_spawn(u))
    return k == MONOLITH or k == GOLEM

@gene('Z170b', 'option kinds worth listing this pass: skip kinds never used, casts with no slot ready, shopping off spawn, tributes without gems', parents=['s1'])
def consider(k: Num) -> Bool:
    if k == PICK or k == MOVE or k == ATTACK:
        return True
    if k == CAST:
        return slot_ready(0) or slot_ready(1)
    if k == BUY:
        return can_shop()
    if k == TRIBUTE:
        return gems() > 0
    if k == RECALL:
        return not (me().pos in my_spawn())
    return False

@gene('Z121c', 'shop: a durability health emblem, then a jungle health emblem, then power strength; bigger buys first', parents=['s1'])
def shop_value(o: Option) -> Num:
    if items_owned(17) == 0:
        return 100 + o.count / 100 if o.item == 16 and o.count <= 5 - items_owned(16) else 0
    if items_owned(29) == 0:
        return 100 + o.count / 100 if o.item == 28 and o.count <= 5 - items_owned(28) else 0
    return 100 + o.count / 100 if o.item == 6 else 0

@gene('Z121d', 'value of a cast: damage or stun on foes and camps, shield or heal when hurt, attack resets once the attack is spent, dash two steps toward the goal')
def cast_v2(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        return 85 if o.unit == me() and me().health_frac < 0.7 else 0
    if k == AB_RESET:
        if can_attack():
            return 0
        r = me().attack_range
        if any(dist(u.pos, me().pos) <= r for u in enemies()):
            return 88
        return 66 if gems() == 0 and any(dist(c.pos, me().pos) <= r for c in camps()) else 0
    if k == AB_DASH:
        return 52 if progress(o.tile) >= 2 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit) and o.unit.is_enemy and o.unit.is_champion:
            return 86
        if exists(o.unit) and o.unit.is_camp and gems() == 0:
            return 65
        if any(u.pos == o.tile for u in enemies()):
            return 84
    return 0

@gene('Z61a', 'an enemy champion within 5 or an awake camp within its range + 1', parents=['s3'])
def under_threat() -> Bool:
    p = me().pos
    return any(dist(p, u.pos) <= 5 for u in enemies()) or any(is_awake(c) and dist(p, c.pos) <= c.attack_range + 1 for c in camps())

@gene('Z138a', 'while retreating: step or dash home first, shield or heal, otherwise hit only what is in reach', parents=['s1'])
def retreat_value(o: Option) -> Num:
    if o.kind == MOVE:
        return 95 if raw_gain(o.tile) > 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DASH:
            return 96 if raw_gain(o.tile) >= 2 else 0
        if k == AB_SHIELD or k == AB_HEAL:
            return 97 if o.unit == me() else 0
        return cast_v2(o) / 2
    return 40

@gene('Z138b', 'how much closer a step onto t brings me on the walking field (no danger penalty)', parents=['s1'])
def raw_gain(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z15a', 'draft preference: Vendetta, Vesper Vale, Tavi, Ryth, Ren, then anything', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == VENDETTA:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == TAVI:
        return 4
    if c == RYTH:
        return 3
    if c == REN:
        return 2
    return 1

@gene('Z121e', 'no free step brings me closer to the goals (a camp or unit is in the way)')
def path_blocked() -> Bool:
    return not any(progress(t) > 0 for t in near(me().pos, 1) - camp_tiles() - ally_tiles() - enemy_tiles())
