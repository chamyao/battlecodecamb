"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('s1', 'value of doing this option now: draft priorities, casts, spawn healing, safer recall', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return draft_value(o)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        return recall_value(o, hf)
    if o.kind == ATTACK:
        return attack_value(o, hf)
    if o.kind == CAST:
        return cast_merged(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return move_value(o, hf)
    return 0

@gene('X80a', 'draft priority: fixed champion order, skipping champions already picked by either team', parents=['s1'])
def draft_value(o: Option) -> Num:
    if picked_by_us(o.champ) or picked_by_them(o.champ):
        return 0
    if o.champ == VESPER_VALE:
        return 10
    if o.champ == HEART_OF_RUIN:
        return 9
    if o.champ == MARCELLA:
        return 8
    if o.champ == VENDETTA:
        return 7
    if o.champ == RYTH:
        return 6
    return 1

@gene('X80b', 'value of recalling home: only when hurt and not already on spawn', parents=['s1'])
def recall_value(o: Option, hf: Num) -> Num:
    if me().pos in my_spawn():
        return 0
    return 90 if hf < 0.38 else 0

@gene('X80c', 'value of attacking: prefer finishing wounded champions, mild preference for damaged camps when no gems carried', parents=['s1'])
def attack_value(o: Option, hf: Num) -> Num:
    if o.unit.is_champion:
        if hf < 0.3 and o.unit.health_frac > 0.5:
            return 0
        return 80 + 40 * (1 - o.unit.health_frac)
    if gems() > 0:
        return 0
    return 50 + 20 * (1 - o.unit.health_frac)

@gene('X80d', 'value of a move: hold on spawn while hurt, else progress toward goals', parents=['s1'])
def move_value(o: Option, hf: Num) -> Num:
    if hf < 0.9 and me().pos in my_spawn():
        return 0
    p = progress(o.tile)
    return 50 + p if p > 0 else 0

@gene('s2', 'where to walk: an altar when carrying gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    rew = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
    if size(rew) > 0:
        return rew
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn)', parents=['s3'])
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'progress toward goals; a step that enters enemy reach while hurt counts as no progress', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    p = at(f, me().pos) - at(f, t)
    if p > 0 and me().health_frac < 0.8:
        if sum(1 for u in enemies() if dist(u.pos, t) <= 2) > 0:
            return 0
    if p > 0 and me().health_frac < 0.5:
        if sum(1 for u in enemies() if dist(u.pos, t) <= 3) > 0:
            return 0
    return p

@gene('Z179a', 'value of an ability: damage scaled by enemy champion wounds (finisher bonus), camp damage when no gems, shield/heal scaled by own missing health, dash when progressing and healthy', parents=['Z64a', 'Z76a'])
def cast_merged(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                v = 60 + 40 * (1 - o.unit.health_frac)
                if o.unit.health_frac < 0.35:
                    v += 30
                return v
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_SHIELD:
        if hf < 0.8 and any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            return 70 + 20 * (1 - hf)
        return 88 if hf < 0.6 else 0
    if k == AB_HEAL:
        if hf < 0.6:
            return 50 + 50 * (1 - hf)
        return 0
    if k == AB_DASH:
        if valid(o.tile) and hf > 0.4:
            p = progress(o.tile)
            if p >= 2:
                return 30 + 10 * min(p, 4)
        return 0
    return 0

@gene('Z5a', 'per-turn cache of the distance field to the goals', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())
