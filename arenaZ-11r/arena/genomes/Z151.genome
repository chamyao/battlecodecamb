"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('s1', 'value of doing this option now: draft priorities, casts, spawn healing, safer recall')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return draft_value(o)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        return recall_value(hf)
    if o.kind == ATTACK:
        return attack_value(o, hf)
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return move_value(o, hf)
    return 0

@gene('X40a', 'draft priority of a champion pick', parents=['s1'])
def draft_value(o: Option) -> Num:
    if o.champ == VESPER_VALE:
        return 10
    if o.champ == HEART_OF_RUIN:
        return 9
    if o.champ == MARCELLA:
        return 8
    if o.champ == VENDETTA:
        return 7
    if o.champ == RYTH:
        return 6
    return 1

@gene('X40b', 'value of recalling home: low health, or carrying 10+ gems at moderate health (protect the gems), not when already at spawn', parents=['s1'])
def recall_value(hf: Num) -> Num:
    if me().pos in my_spawn():
        return 0
    if hf < 0.38:
        return 90
    if gems() >= 10 and hf < 0.55:
        return 85
    return 0

@gene('X40c', 'value of a basic attack: focus the weakest champion, finish weakened camps, skip camps when low or carrying gems', parents=['s1'])
def attack_value(o: Option, hf: Num) -> Num:
    u = o.unit
    if u.is_champion:
        if hf < 0.3 and u.health_frac > 0.5:
            return 0
        return 80 + (1 - u.health_frac) * 15
    if gems() > 0:
        return 0
    if hf < 0.25 and u.health_frac > 0.5:
        return 0
    return 60 + (1 - u.health_frac) * 8

@gene('X40d', 'value of a move: hold at spawn until healed, else progress toward the goal field', parents=['s1'])
def move_value(o: Option, hf: Num) -> Num:
    if hf < 0.9 and me().pos in my_spawn():
        return 0
    p = progress(o.tile)
    return 50 + p if p > 0 else 0

@gene('s2', 'where to walk: an altar when carrying gems; else a cleared group awaiting capture; else a living camp group with loot (falls back to any living group)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    rew = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
    if size(rew) > 0:
        return rew
    loot = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) + group_gold(g) > 0:
            loot = loot | group_tiles(g)
    if size(loot) > 0:
        return loot
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'progress toward goals; doubled when carrying gems; camp tiles give no progress (checked first, cheap)')
def progress(t: Tile) -> Num:
    if t in camp_tiles():
        return 0
    f = goal_field()
    p = at(f, me().pos) - at(f, t)
    if gems() > 0:
        return p * 2
    return p

@gene('Z76a', 'value of casting an ability: heal when hurt, shield when enemies close or low, finish weakened champions', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_HEAL:
        return 88 if hf < 0.6 else 0
    if k == AB_SHIELD:
        if hf < 0.5:
            return 92
        if any(dist(u.pos, me().pos) <= 3 for u in enemies()):
            return 70
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 75 if o.unit.health_frac < 0.35 else 58
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_DASH:
        if valid(o.tile) and hf > 0.4:
            return 57 if progress(o.tile) >= 2 else 0
        return 0
    return 0

@gene('Z5a', 'per-turn cache of the distance field to the goals', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())
