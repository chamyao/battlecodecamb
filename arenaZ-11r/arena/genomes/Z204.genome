"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('s1', 'value of doing this option now; also uses abilities on fights, camps, shields and dashes')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 63 if me().health_frac < 0.2287 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.5913)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'how much closer a step brings me to the goals (0 if unreachable or if a moderately wounded bot would step within 2 of an enemy champion)')
def progress(t: Tile) -> Num:
    f = goal_field()
    a = at(f, me().pos)
    b = at(f, t)
    if b >= 1000000:
        return 0
    if me().health_frac < 0.7 and any(u.is_champion and dist(u.pos, t) <= 2 for u in enemies()):
        return 0
    return a - b

@gene('Z64a', 'value of casting an ability: crowd control and damage scaled by enemy champion wounds (stuns cancel enemy tributes), camp damage when no gems, shield scaled by own missing health when enemies near, heal when hurt, dash scaled by progress toward goals', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_CC:
        if exists(o.unit) and o.unit.is_enemy and o.unit.is_champion:
            return 66 + 34 * (1 - o.unit.health_frac)
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                return 60 + 40 * (0.6877 - o.unit.health_frac)
            if o.unit.is_camp:
                return 62 if gems() == 0 else 0
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.8 and any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            return 70 + 20 * (1 - me().health_frac)
        return 0
    if k == AB_HEAL:
        return 72 if me().health_frac < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return 30 + 10 * min(p, 4)
        return 0
    return 0

@gene('Z5a', 'per-turn cache of the distance field to the goals, routing around enemy champions', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field_avoid(goals(), walls() | enemy_tiles(), goals())
