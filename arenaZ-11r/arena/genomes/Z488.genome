"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None
HEALING: Bool = False

@gene('s1', 'value of doing this option now; also uses abilities on fights, camps, shields and dashes')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.2287 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 37
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a cleared group awaiting capture, else a gem-bearing living camp group, else any living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.655)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'progress toward goals minus a threat penalty per enemy within 2 tiles of the step (offset by allies within 3 tiles), doubled when below half health (0 if unreachable)', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    a = at(f, me().pos)
    b = at(f, t)
    if b >= 1000000:
        return 0
    w = 2 if me().health_frac < 0.5 else 1
    threat = count(dist(u.pos, t) <= 2 for u in enemies())
    support = count(dist(u.pos, t) <= 3 for u in allies())
    pen = max(threat - support, 0)
    return a - b - w * pen

@gene('Z64a', 'value of casting an ability: damage scaled by target wounds on champions, camp damage when no gems, shield scaled by own missing health when enemies near, heal scaled by missing health below 60%, dash scaled by progress toward goals (bonus when carrying gems, only when health above 30%)', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                return 60 + 19 * (1.0236 - o.unit.health_frac)
            if o.unit.is_camp:
                return 62 if gems() == 0 else 0
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.8 and any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            return 70 + 20 * (1 - me().health_frac)
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.6:
            return 65 + 40 * (0.6 - me().health_frac) / 0.6
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.3:
            p = progress(o.tile)
            if p >= 1:
                bonus = 20 if gems() > 0 else 0
                return 30 + 10 * min(p, 3) + bonus
        return 0
    return 0

@gene('Z5a', 'per-turn cache of the goal field; walks home to heal when low (below 30%, or below 50% while carrying gems; hysteresis to 90%), skips work when dead', parents=['s3'])
def update() -> None:
    if not alive():
        HEALING = False
        return
    hf = me().health_frac
    if hf < 0.3 or (hf < 0.5053 and gems() > 0):
        HEALING = True
    elif hf > 0.9:
        HEALING = False
    if HEALING:
        GOAL_FIELD = field(my_spawn())
    else:
        GOAL_FIELD = field(goals())
