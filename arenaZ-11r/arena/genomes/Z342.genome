"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None
HEALING: Bool = False

@gene('s1', 'value of doing this option now; also uses abilities on fights, camps, shields and dashes', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.2287 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 37
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a cleared group awaiting capture with gems/gold, else a gem-bearing living camp group, else any living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.655)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g) and group_gems(g) + group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals avoiding visible enemies when any are seen (else cached)', parents=['s3'])
def goal_field() -> Field:
    if count(True for u in enemies()) == 0:
        return GOAL_FIELD
    f = field_avoid(goals(), enemy_tiles(), goals())
    if at(f, me().pos) >= 1000000:
        return GOAL_FIELD
    return f

@gene('s4', 'progress toward goals minus a threat penalty per enemy within 2 tiles of the step, doubled when below half health (0 if unreachable)', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    a = at(f, me().pos)
    b = at(f, t)
    if b >= 1000000:
        return 0
    w = 2 if me().health_frac < 0.5 else 1
    threat = count(dist(u.pos, t) <= 1 for u in enemies())
    return a - b - w * threat

@gene('Z64a', 'value of casting an ability: damage scaled by target wounds on champions (finisher and interrupt bonuses), camp damage when no gems, shield delegated to a helper, heal scaled by missing health below 60%, dash scaled by progress up to 5 steps (bonus with gems, not when low)', parents=['s1', 'Z64a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                if is_tributing(o.unit) or is_recalling(o.unit):
                    return 95
                if o.unit.health_frac < 0.3:
                    return 90
                return 60 + 19 * (1.0236 - o.unit.health_frac)
            if o.unit.is_camp:
                return 62 if gems() == 0 else 0
        return 0
    if k == AB_SHIELD:
        return shield_value()
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.6:
            return 65 + 40 * (0.6 - hf) / 0.6
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.3:
            p = progress(o.tile)
            if p >= 1:
                bonus = 15 if gems() > 0 else 0
                return 30 + 10 * min(p, 5) + bonus
        return 0
    return 0

@gene('X300a', 'value of a shield: scaled by missing health when enemies are within 4, or awake camps within 2 while below 75% health; otherwise 0', parents=['Z64a'])
def shield_value() -> Num:
    hf = me().health_frac
    if hf < 0.9:
        mp = me().pos
        if any(dist(u.pos, mp) <= 4 for u in enemies()):
            return 70 + 20 * (1 - hf)
        if hf < 0.75 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
            return 65 + 20 * (1 - hf)
    return 0

@gene('Z5a', 'per-turn cache of the goal field; walks home to heal when low (hysteresis 35%->92%), skips work when dead', parents=['Z5a'])
def update() -> None:
    if not alive():
        HEALING = False
        return
    hf = me().health_frac
    if hf < 0.35:
        HEALING = True
    elif hf > 0.92:
        HEALING = False
    if HEALING:
        GOAL_FIELD = field(my_spawn())
    else:
        GOAL_FIELD = field(goals())
