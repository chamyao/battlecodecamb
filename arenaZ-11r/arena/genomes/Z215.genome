"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('s1', 'value of doing this option now; recall a bit earlier (not on spawn), abilities via cast_value', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.3 and not (me().pos in my_spawn()):
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 121
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems (radius 0.6), else a living camp group", parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'how much closer a step brings me to the goals (0 if unreachable); doubled when carrying gems', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    a = at(f, me().pos)
    b = at(f, t)
    if b >= 1000000:
        return 0
    p = a - b
    if gems() > 0:
        p = p * 2
    return p

@gene('Z64a', 'value of casting: CC prioritising tributing/recalling enemies, damage scaled by wounds (threshold 0.6877), camp damage when no gems, shield when hurt with enemy close, heal when hurt, dash by progress only when healthy', parents=['s1', 'Z64a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_CC:
        if exists(o.unit) and o.unit.is_enemy and o.unit.is_champion:
            bonus = 25 if (is_tributing(o.unit) or is_recalling(o.unit)) else 0
            return 66 + 34 * (1 - o.unit.health_frac) + bonus
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                bonus = 15 if is_tributing(o.unit) or o.unit.health_frac < 0.3 else 0
                return 60 + 40 * (0.6877 - o.unit.health_frac) + bonus
            if o.unit.is_camp:
                return 62 if gems() == 0 else 0
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.8 and enemy_close():
            return 70 + 20 * (1 - me().health_frac)
        return 0
    if k == AB_HEAL:
        return 72 if me().health_frac < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac >= 0.5:
            p = progress(o.tile)
            if p >= 2:
                return 25 + 8 * min(p, 5)
        return 0
    return 0

@gene('Z183a', 'an enemy champion is within 4 tiles of me (computed once per pass)', parents=['Z64a'])
def enemy_close() -> Bool:
    return any(dist(u.pos, me().pos) <= 4 for u in enemies() if u.is_champion)

@gene('Z5a', 'per-turn cache of the goal field: heal/shop at spawn when hurt or rich, else goals minus solo-unsafe monolith tiles (monoliths allowed late with 2+ allies)', parents=['s3', 'Z5a'])
def update() -> None:
    hp = me().health_frac
    g = goals()
    if gems() == 0 and (hp < 0.35 or (gold() >= 150 and round() < 1800)):
        GOAL_FIELD = field(my_spawn())
    elif round() >= 1000 and count_units(allies()) >= 2 and size(g) > 0:
        GOAL_FIELD = field(g)
    else:
        safe = g - type_spawns(MONOLITH)
        if size(safe) > 0:
            GOAL_FIELD = field(safe)
        else:
            GOAL_FIELD = field(g)
