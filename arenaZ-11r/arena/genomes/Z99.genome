"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('s1', 'value of doing this option now; also uses abilities on fights, camps, shields and dashes')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.2287 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.655)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'how much closer a step brings me to the goals (0 if unreachable or my own tile unreachable)')
def progress(t: Tile) -> Num:
    f = goal_field()
    a = at(f, me().pos)
    b = at(f, t)
    if b >= 1000000 or a >= 1000000:
        return 0
    return a - b

@gene('Z64a', 'value of casting an ability: damage/cc on champions or camps (unit or ground target), shield when hurt near enemies or awake camps, heal when hurt, dash toward goals scaled by progress when no enemy champion is near', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                return 85 + 5 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                return 62 if gems() == 0 else 0
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies() if u.is_champion)
            if n > 0:
                return 80 + 3 * n
            if gems() == 0:
                c = count(dist(u.pos, o.tile) <= r for u in camps() if is_awake(u))
                if c > 0:
                    return 58 + min(c, 3)
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.8:
            if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
                return 75
            if hf < 0.6 and any(dist(u.pos, me().pos) <= 2 for u in camps() if is_awake(u)):
                return 74
        return 0
    if k == AB_HEAL:
        return 72 if me().health_frac < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if any(dist(u.pos, me().pos) <= 4 for u in enemies() if u.is_champion):
                return 0
            p = progress(o.tile)
            if p >= 2:
                return 30 + 10 * min(p, 4)
        return 0
    return 0

@gene('Z5a', 'per-turn cache of the distance field to the goals (bounded search avoiding walls and enemies)', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field_avoid(goals(), walls() | enemy_tiles(), near(me().pos, 1))
