"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('s1', 'value of doing this option now: draft, recall, attacks, casts, moves, tribute', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return draft_value(o)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    if o.kind == RECALL:
        return recall_value(hf)
    if o.kind == ATTACK:
        return attack_value(o, hf)
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return move_value(o, hf)
    return 0

@gene('X40a', 'draft priority of a champion pick', parents=['s1'])
def draft_value(o: Option) -> Num:
    if o.champ == VESPER_VALE:
        return 10
    if o.champ == HEART_OF_RUIN:
        return 9
    if o.champ == MARCELLA:
        return 8
    if o.champ == VENDETTA:
        return 7
    if o.champ == RYTH:
        return 6
    return 1

@gene('X40b', 'recall home away from spawn when health is low', parents=['s1'])
def recall_value(hf: Num) -> Num:
    if me().pos in my_spawn():
        return 0
    return 90 if hf < 0.3 else 0

@gene('X40c', 'basic attack: champions unless we are low and they are healthy; camps only when no gems carried', parents=['s1'])
def attack_value(o: Option, hf: Num) -> Num:
    if o.unit.is_champion:
        if hf < 0.3 and o.unit.health_frac > 0.5:
            return 0
        return 80
    return 60 if gems() == 0 else 0

@gene('X40d', 'move: hold at spawn until healed, else progress toward goals', parents=['s1'])
def move_value(o: Option, hf: Num) -> Num:
    if hf < 0.9 and me().pos in my_spawn():
        return 0
    p = progress(o.tile)
    return 50 + p if p > 0 else 0

@gene('Z132a', 'where to walk: altar when carrying gems; else reward-ready groups; else gem-bearing living groups; else any living group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.655)
        if size(acc) > 0:
            return acc
    rew = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
    if size(rew) > 0:
        return rew
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('Z132b', 'progress toward goals minus a penalty per enemy within 2 tiles of the step; camp tiles and unreachable tiles give none; doubled when carrying gems', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    a = at(f, me().pos)
    b = at(f, t)
    if b >= 1000000:
        return 0
    if t in camp_tiles():
        return 0
    threat = count(dist(u.pos, t) <= 2 for u in enemies())
    p = a - b - threat
    if gems() > 0:
        return p * 2
    return p

@gene('Z76a', 'value of casting: heal and shield when hurt (shield scaled by missing health near enemies), damage scaled by target wounds, camp damage when no gems, dash scaled by progress', parents=['Z76a', 'Z64a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_HEAL:
        return 88 if hf < 0.6 else 0
    if k == AB_SHIELD:
        if hf < 0.8 and any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            return 70 + 20 * (1 - hf)
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                return 60 + 40 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                return 62 if gems() == 0 else 0
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return 30 + 10 * min(p, 4)
        return 0
    return 0

@gene('Z5a', 'per-turn cache of the distance field to the goals', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())
