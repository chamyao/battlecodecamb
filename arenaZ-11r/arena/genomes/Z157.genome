"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('s1', 'value of doing this option now; recall a bit earlier (not on spawn), farm camps until tribute is worth it, skip monoliths')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.33 and not (me().pos in my_spawn()):
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        if o.unit.type == MONOLITH:
            return 0
        return 60 if not want_tribute() else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar when tributing is worth it, else living non-monolith camp groups (rewarded ones first), else altars')
def goals() -> Tiles:
    alt = near(tile(-5, -5), 0)
    for a in altars() - locked_altars():
        alt = alt | near(a, 0.655)
    if want_tribute():
        return alt
    mono = type_spawns(MONOLITH)
    acc = near(tile(-5, -5), 0)
    rich = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            ts = group_tiles(g)
            if size(ts & mono) == 0:
                acc = acc | ts
                if group_reward(g):
                    rich = rich | ts
    if size(rich) > 0:
        return rich
    if size(acc) > 0:
        return acc
    if gems() > 0:
        return alt
    return acc

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'how much closer a step brings me to the goals (0 if unreachable)')
def progress(t: Tile) -> Num:
    f = goal_field()
    a = at(f, me().pos)
    b = at(f, t)
    if b >= 1000000:
        return 0
    return a - b

@gene('Z64a', 'value of casting: CC prioritising tributing/recalling enemies, damage scaled by wounds, camp damage when no gems, shield when hurt with enemy close (cached check), heal when hurt, dash by progress only when healthy', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_CC:
        if exists(o.unit) and o.unit.is_enemy and o.unit.is_champion:
            bonus = 25 if (is_tributing(o.unit) or is_recalling(o.unit)) else 0
            return 66 + 34 * (1 - o.unit.health_frac) + bonus
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                bonus = 15 if is_tributing(o.unit) or o.unit.health_frac < 0.3 else 0
                return 60 + 40 * (1 - o.unit.health_frac) + bonus
            if o.unit.is_camp:
                return 62 if gems() == 0 else 0
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.8 and enemy_close():
            return 70 + 20 * (1 - me().health_frac)
        return 0
    if k == AB_HEAL:
        return 72 if me().health_frac < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac >= 0.5:
            p = progress(o.tile)
            if p >= 2:
                return 25 + 8 * min(p, 5)
        return 0
    return 0

@gene('Z183a', 'an enemy champion is within 4 tiles of me (computed once per pass)', parents=['Z64a'])
def enemy_close() -> Bool:
    return any(dist(u.pos, me().pos) <= 4 for u in enemies() if u.is_champion)

@gene('Z5a', 'per-turn cache of the distance field to the goals', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())

@gene('Z236a', 'should I head to an altar now: enough gems carried, late game, or hurt while carrying', parents=['Z5a', 's1', 's2', 's4'])
def want_tribute() -> Bool:
    g = gems()
    if g <= 0:
        return False
    if g >= 25:
        return True
    if round() > 1880:
        return True
    return me().health_frac < 0.5
