"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('Z206a', 'value of doing this option now; recall at ~30% health (between parents); uses abilities on fights, camps, shields and dashes', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.655)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'how much closer a step brings me to the goals (0 if unreachable)')
def progress(t: Tile) -> Num:
    f = goal_field()
    a = at(f, me().pos)
    b = at(f, t)
    if b >= 1000000:
        return 0
    return a - b

@gene('Z206b', 'value of casting: CC scaled by enemy wounds (stuns cancel tributes), damage pressing weak champions or camps when few gems, shield in fights or awake camps scaled by missing health, heal self or hurt ally, dash toward goals avoiding enemy landings or flee when low', parents=['Z64a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_CC:
        if exists(o.unit) and o.unit.is_enemy and o.unit.is_champion:
            bonus = 10 if is_tributing(o.unit) else 0
            return 70 + 32 * (1 - o.unit.health_frac) + bonus
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                return 68 + 35 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                return 62 if gems() < 10 else 0
        return 0
    if k == AB_SHIELD:
        mp = me().pos
        hf = me().health_frac
        if hf < 0.9:
            if any(dist(u.pos, mp) <= 5 for u in enemies()):
                return 70 + 20 * (1 - hf)
            if any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 66 + 15 * (1 - hf)
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            uf = o.unit.health_frac
            return 72 + 10 * (1 - uf) if uf < 0.6 else 0
        return 72 if me().health_frac < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            mp = me().pos
            if me().health_frac < 0.4 and any(dist(u.pos, mp) <= 4 for u in enemies()):
                near_now = min((dist(u.pos, mp) for u in enemies()), default=99)
                near_then = min((dist(u.pos, o.tile) for u in enemies()), default=99)
                if near_then >= near_now + 2:
                    return 66
                return 0
            p = progress(o.tile)
            threat = sum(1 for u in enemies() if dist(u.pos, o.tile) <= 3)
            if threat > 0 and me().health_frac < 0.6:
                return 0
            if p >= 2:
                return 30 + 10 * min(p, 4) - 15 * threat
        return 0
    return 0

@gene('Z5a', 'per-turn cache of the distance field to the goals', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())
