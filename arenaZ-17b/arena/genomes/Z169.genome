"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
HOME: Field = None
HOMED: Bool = False

@gene('s1', 'value of doing this option now: treasure then strength shards, ability casts and dashes toward goals, no camp fights while retreating')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 6:
            return 100 if items_owned(6) < 5 else 0
        if items_owned(6) >= 5 and item_strength(o.item) > 0:
            return 50 + item_strength(o.item)
        return 0
    if o.kind == RECALL:
        if me().health_frac < 0.35 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if RETREAT:
            return 0
        return 80 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not RETREAT:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and progress(o.tile) > 1:
                return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living camp group holding gems, else any living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    rich = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            acc = acc | gt
            if group_gems(g) > 0:
                rich = rich | gt
    safe_rich = rich - type_spawns(MONOLITH)
    if size(safe_rich) > 0:
        return safe_rich
    return acc

@gene('s3', 'cached spawn field while retreating, else a cleared group to capture (while carrying few gems), else goals without monoliths (and golems early), spawn if none')
def goal_field(hurt: Bool) -> Field:
    if hurt:
        return HOME
    if gems() < 20:
        rew = near(tile(-5, -5), 0)
        for g in range(num_groups()):
            if group_reward(g):
                rew = rew | group_tiles(g)
        if size(rew) > 0:
            return field(rew)
    gl = goals()
    safe = gl - type_spawns(MONOLITH)
    if round() < 400:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return field(easy)
    if size(safe) > 0:
        return field(safe)
    if size(gl) > 0:
        return field(gl)
    return HOME

@gene('s4', 'how much closer a step brings me to the goals (cached field)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z34a', 'compute the goal distance field once per turn, with retreat hysteresis, cached spawn field, skipped while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    if not alive():
        RETREAT = False
        return
    if not HOMED:
        HOME = field(my_spawn())
        HOMED = True
    hf = me().health_frac
    if hf < 0.4:
        RETREAT = True
    elif hf > 0.9:
        RETREAT = False
    if RETREAT:
        GF = HOME
    else:
        GF = goal_field(False)

@gene('Z34b', 'skip option kinds we never use or cannot use now (no move/attack when unable, no buy without gold, no tribute without gems, no recall when healthy or on spawn, no cast with both slots down)', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    if kind == RECALL:
        return me().health_frac < 0.35 and not (me().pos in my_spawn())
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == MOVE:
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    return True
