"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False

@gene('s1', 'value of doing this option now, with ability casts and dashes toward goals; recall when retreating and safe; no camp fights while retreating; hurt bots avoid stepping next to enemy champions')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if count(dist(u.pos, me().pos) <= 3 for u in enemies()) > 0:
            return 0
        if me().health_frac < 0.35:
            return 90
        if RETREAT and me().health_frac < 0.6:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if RETREAT:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not RETREAT:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and progress(o.tile) > 1:
                return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if progress(o.tile) <= 0:
            return 0
        if RETREAT or me().health_frac < 0.5:
            if any(u.is_champion and dist(u.pos, o.tile) <= 1 for u in enemies()):
                return 0
        return 50
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living camp group holding gems, else any living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    rich = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            acc = acc | gt
            if group_gems(g) > 0:
                rich = rich | gt
    safe_rich = rich - type_spawns(MONOLITH)
    if size(safe_rich) > 0:
        return safe_rich
    return acc

@gene('s3', 'distance field to spawn while retreating, else a cleared group to capture while lightly loaded, else the goals without monoliths, spawn if none')
def goal_field(hurt: Bool) -> Field:
    if hurt:
        return field(my_spawn())
    if gems() < 30:
        rew = near(tile(-5, -5), 0)
        for g in range(num_groups()):
            if group_reward(g):
                rew = rew | group_tiles(g)
        if size(rew) > 0:
            return field(rew)
    gl = goals()
    safe = gl - type_spawns(MONOLITH)
    if size(safe) > 0:
        return field(safe)
    if size(gl) > 0:
        return field(gl)
    return field(my_spawn())

@gene('s4', 'how much closer a step brings me to the goals (cached field, unreachable-safe on both ends)')
def progress(t: Tile) -> Num:
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    d0 = at(GF, me().pos)
    if d0 >= 1000000:
        return 0
    return d0 - d1

@gene('Z34a', 'compute the goal distance field once per turn, with retreat hysteresis and skipped while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    if not alive():
        RETREAT = False
        return
    hf = me().health_frac
    if hf < 0.4:
        RETREAT = True
    elif hf > 0.9:
        RETREAT = False
    GF = goal_field(RETREAT)

@gene('Z34b', 'skip option kinds we never use to save fuel', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    return not (kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL)
