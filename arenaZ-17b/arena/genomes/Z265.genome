"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
LASTR: Num = 0
LASTG: Num = 0
FRESH: Bool = False
ONSP: Bool = False
D0: Num = 0
D0POS: Tile = None

@gene('s1', 'value of doing this option now, with ability casts and dashes toward goals; recall whenever retreating with no enemy close; retreating bots skip camp fights')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if gems() == 0 and not RETREAT:
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not RETREAT:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and progress(o.tile) > 1:
                return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an unlocked altar with gems (any altar if all locked), else a living non-monolith camp group with loot (golems skipped early), else any living camp group')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if gems() > 0:
        acc = empty
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 1)
        return acc
    acc = empty
    rich = empty
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            acc = acc | gt
            if group_gems(g) > 0 or group_gold(g) > 0:
                rich = rich | gt
    mono = type_spawns(MONOLITH)
    safe_rich = rich - mono
    if round() < 400:
        easy = safe_rich - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe_rich) > 0:
        return safe_rich
    return acc

@gene('s3', 'distance field to spawn while retreating, else a nearby cleared group to capture (few gems, not endgame), else the goals without monoliths, spawn if none')
def goal_field(hurt: Bool) -> Field:
    if hurt:
        return field(my_spawn())
    endgame = round() > 1850 and gems() > 0
    if gems() < 30 and not endgame:
        rew = near(tile(-5, -5), 0)
        mp = me().pos
        for g in range(num_groups()):
            if group_reward(g):
                gt = group_tiles(g)
                nt = nearest(gt, mp)
                if valid(nt) and dist(nt, mp) <= 28:
                    rew = rew | gt
        if size(rew) > 0:
            return field(rew)
    gl = goals()
    safe = gl - type_spawns(MONOLITH)
    if size(safe) > 0:
        return field(safe)
    if size(gl) > 0:
        return field(gl)
    return field(my_spawn())

@gene('s4', 'how much closer a step brings me to the goals (cached field, own distance taken from the update cache while unmoved, unreachable-safe on both ends)')
def progress(t: Tile) -> Num:
    p = me().pos
    d0 = D0
    if not valid(D0POS) or dist(p, D0POS) > 0:
        d0 = at(GF, p)
    if d0 >= 1000000:
        return 0
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    return d0 - d1

@gene('Z34a', 'goal distance field with retreat hysteresis (below 40%, 55% with 30+ gems, stay until 90%); refreshed only on retreat change, gem change or every 2 rounds; caches spawn flag and own field distance; skipped while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    if not alive():
        RETREAT = False
        FRESH = False
        ONSP = False
        return
    hf = me().health_frac
    was = RETREAT
    thr = 0.55 if gems() >= 30 else 0.4
    if hf < thr:
        RETREAT = True
    elif hf > 0.9:
        RETREAT = False
    p = me().pos
    ONSP = p in my_spawn()
    changed = (RETREAT and not was) or (was and not RETREAT)
    if changed or not FRESH or gems() != LASTG or round() - LASTR >= 2:
        GF = goal_field(RETREAT)
        LASTR = round()
        LASTG = gems()
        FRESH = True
    D0POS = p
    D0 = at(GF, p)

@gene('Z34b', 'skip option kinds we never use or cannot use now (no buy off shop, no move/attack when unable, no tribute without gems, recall only when retreating and off spawn via cached flag, no moves while tributing) to save fuel', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return gold() >= 30 and can_shop()
    if kind == RECALL:
        return RETREAT and not ONSP
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == MOVE:
        if channeling() and gems() > 0:
            return False
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    return True
