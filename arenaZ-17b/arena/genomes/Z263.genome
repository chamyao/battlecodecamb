"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
HOME: Field = None
HOMED: Bool = False
LASTR: Num = 0
LASTG: Num = 0
WASR: Bool = True

@gene('s1', 'value of doing this option now; chase weak unguarded enemy champions when healthy; recall ~40%; no camp fights when hurt')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hurt = me().health_frac < 0.35
    if o.kind == RECALL:
        if me().health_frac < 0.4 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if hurt:
            return 0
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not hurt:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and progress(o.tile) > 1:
                return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if me().health_frac > 0.711:
            p = prey()
            if exists(p) and p.is_champion and p.health_frac < 0.3 and dist(p.pos, me().pos) <= 6:
                if dist(o.tile, p.pos) < dist(me().pos, p.pos):
                    return 56
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, a cleared group to capture, else a living non-monolith camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    safe = acc - type_spawns(MONOLITH)
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'distance field to spawn when hurt (~40%), else to the goals, spawn if none')
def goal_field() -> Field:
    if me().health_frac < 0.4:
        return field(my_spawn())
    g = goals()
    if size(g) == 0:
        return field(my_spawn())
    return field(g)

@gene('s4', 'how much closer a step brings me to the goals (cached field, own distance computed once per pass, unreachable-safe on both ends)')
def progress(t: Tile) -> Num:
    d0 = my_d0()
    if d0 >= 1000000:
        return 0
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    return d0 - d1

@gene('Z34a', 'goal field with retreat hysteresis (home below 40%, stay until 90%); spawn field cached once; goal field refreshed only after retreat, on gem change or every 2 rounds; skip while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    if alive():
        h = me().health_frac
        RETREAT = h < 0.4 or (RETREAT and h < 0.9)
        if RETREAT:
            if not HOMED:
                HOME = field(my_spawn())
                HOMED = True
            GF = HOME
            WASR = True
        elif WASR or gems() != LASTG or round() - LASTR >= 2:
            GF = goal_field()
            LASTR = round()
            LASTG = gems()
            WASR = False
    else:
        RETREAT = False
        WASR = True

@gene('Z281a', 'my own distance on the cached goal field, computed once per pass', parents=['s4'])
def my_d0() -> Num:
    return at(GF, me().pos)

@gene('Z34b', 'skip option kinds we never use or cannot use now (no move/attack when unable, no tribute without gems, recall only when hurt and off spawn) to save fuel', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    if kind == RECALL:
        return me().health_frac < 0.4 and not (me().pos in my_spawn())
    if kind == TRIBUTE:
        return gems() > 0
    if kind == MOVE:
        return can_move() and not channeling()
    if kind == ATTACK:
        return can_attack()
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    return True

@gene('Z76a', 'a weak visible enemy champion within 6 tiles worth chasing, not guarded by two healthy enemies; prefers gem carriers (invalid if none)', parents=['s1'])
def prey() -> Unit:
    return best(enemies(), lambda u: (1 - u.health_frac) + 0.01 * unit_gems(u) - (100 if (not u.is_champion) or u.health_frac >= 0.3 or dist(u.pos, me().pos) > 6 or count(v.is_champion and v.health_frac > 0.5 and dist(v.pos, u.pos) <= 3 for v in enemies()) >= 2 else 0))
