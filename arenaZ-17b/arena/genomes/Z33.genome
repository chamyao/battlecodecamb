"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('Z57a', 'value of doing this option now: safe recall, focus weak champions, ability casts, graded moves', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.35 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 45 + 3 * p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z57b', 'distance field to spawn until healed, a cleared group to capture, else the goals, spawn if none', parents=['s3'])
def goal_field() -> Field:
    if HEALING:
        return field(my_spawn())
    if gems() == 0:
        rew = near(tile(-5, -5), 0)
        for g in range(num_groups()):
            if group_reward(g):
                rew = rew | group_tiles(g)
        if size(rew) > 0:
            return field(rew)
    g = goals()
    if size(g) == 0:
        return field(my_spawn())
    return field(g)

@gene('s4', 'how much closer a step brings me to the goals (cached field)')
def progress(t: Tile) -> Num:
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    return at(GF, me().pos) - d1

@gene('Z57c', 'track healing retreat with hysteresis, then compute the goal field once per turn while alive', parents=['Z34a', 'Z38a'])
def update() -> None:
    if alive():
        if me().health_frac < 0.35:
            HEALING = True
        if me().health_frac > 0.9:
            HEALING = False
        GF = goal_field()

@gene('Z34b', 'skip option kinds we never use to save fuel', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    return not (kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL)
