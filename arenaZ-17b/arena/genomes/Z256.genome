"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
HOME: Field = None
HOMED: Bool = False
WASR: Bool = True
LASTG: Num = -1
LASTR: Num = -100
PREYT: Tile
PREYV: Bool

@gene('s1', 'value of doing this option now; treasure then strength shards; gem-carrier focus; chase/dash at a per-turn cached prey when healthy; recall when retreating (gem-aware) only if spawn is a real walk away; no camp fights when hurt')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 6:
            return 100 if items_owned(6) < 5 else 0
        if items_owned(6) >= 5 and item_strength(o.item) > 0:
            return 50 + item_strength(o.item)
        return 0
    hurt = me().health_frac < 0.35
    if o.kind == RECALL:
        if RETREAT and me().health_frac < 0.6 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            d = at(HOME, me().pos) if HOMED else 99
            if d > 6 or me().health_frac < 0.25:
                return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac) + min(5, unit_gems(o.unit) / 10)
        if hurt or RETREAT:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not hurt and not RETREAT:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile):
                if PREYV and me().health_frac > 0.6 and not RETREAT:
                    if dist(o.tile, PREYT) <= 1:
                        return 57
                if progress(o.tile) > 1:
                    return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if PREYV and me().health_frac > 0.6 and not RETREAT:
            if dist(o.tile, PREYT) < dist(me().pos, PREYT):
                return 56
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, a cleared group to capture, else a gem-holding living non-monolith camp group, else any living non-monolith group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 1)
        return acc
    rew = near(tile(-5, -5), 0)
    rich = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
            if group_gems(g) > 0:
                rich = rich | group_tiles(g)
    if size(rew) > 0:
        return rew
    mono = type_spawns(MONOLITH)
    srich = rich - mono
    if size(srich) > 0:
        return srich
    safe = acc - mono
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'distance field to spawn while retreating, else to the goals, spawn if none')
def goal_field(hurt: Bool) -> Field:
    if hurt:
        return field(my_spawn())
    g = goals()
    if size(g) == 0:
        return field(my_spawn())
    return field(g)

@gene('s4', 'how much closer a step brings me to the goals (cached field, unreachable-safe on both ends)')
def progress(t: Tile) -> Num:
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    d0 = at(GF, me().pos)
    if d0 >= 1000000:
        return 0
    return d0 - d1

@gene('Z34a', 'goal field with retreat hysteresis (home below 40%, 55% with 30+ gems, stay until 90%); spawn field cached once; goal field refreshed on gem change, retreat end or every 2 rounds; chase target computed once per turn; skip while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    PREYV = False
    if alive():
        h = me().health_frac
        low = 0.55 if gems() >= 30 else 0.4
        RETREAT = h < low or (RETREAT and h < 0.9)
        if RETREAT:
            if not HOMED:
                HOME = goal_field(True)
                HOMED = True
            GF = HOME
        elif WASR or gems() != LASTG or round() - LASTR >= 2:
            GF = goal_field(False)
            LASTR = round()
            LASTG = gems()
        WASR = RETREAT
        if h > 0.6 and not RETREAT:
            p = prey()
            if exists(p):
                if prey_ok(p):
                    PREYV = True
                    PREYT = p.pos
    else:
        RETREAT = False
        WASR = True

@gene('Z34b', 'skip option kinds we never use or cannot use now (no move/attack when unable, no tribute without gems) to save fuel', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    if kind == RECALL:
        return me().health_frac < 0.4
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == MOVE:
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    return True

@gene('Z76a', 'a weak visible enemy champion worth chasing, not guarded by more healthy enemies than allies near me (within 6) can match; prefers gem carriers and closer targets (invalid if none)', parents=['s1'])
def prey() -> Unit:
    mp = me().pos
    sup = 1 + count(dist(a.pos, mp) <= 6 and a.health_frac > 0.4 for a in allies())
    return best(enemies(), lambda u: (1 - u.health_frac) + 0.01 * unit_gems(u) - 0.03 * dist(u.pos, mp) - (100 if (not prey_ok(u)) or count(v.is_champion and v.health_frac > 0.5 and dist(v.pos, u.pos) <= 3 for v in enemies()) >= max(2, sup) else 0))

@gene('Z212a', 'is this enemy a chase target: a champion within 6 tiles, below 45% health, far less health than me, or a rich gem carrier below 60%', parents=['Z76a'])
def prey_ok(u: Unit) -> Bool:
    return u.is_champion and dist(u.pos, me().pos) <= 6 and (u.health_frac < 0.45 or u.health < 0.5 * me().health or (unit_gems(u) >= 20 and u.health_frac < 0.6))
