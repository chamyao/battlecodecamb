"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
LASTR: Num = 0
LASTG: Num = 0
FRESH: Bool = False
HOME: Field = None
HOMED: Bool = False

@gene('s1', 'value of doing this option now; treasure then strength shards; gem-carrier focus; recall when retreating off spawn; no camp fights when hurt or retreating; ability casts and dashes toward goals')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 6:
            return 100 if items_owned(6) < 5 else 0
        if items_owned(6) >= 5 and item_strength(o.item) > 0:
            return 50 + item_strength(o.item)
        return 0
    hurt = me().health_frac < 0.35
    if o.kind == RECALL:
        if RETREAT and me().health_frac < 0.6 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            d = at(HOME, me().pos) if HOMED else 99
            if d > 6 or me().health_frac < 0.25:
                return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac) + min(5, unit_gems(o.unit) / 10)
        if hurt or RETREAT:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not hurt and not RETREAT:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and progress(o.tile) > 1:
                return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an unlocked altar with gems (any altar if all locked), else a living non-monolith camp group with loot (golems skipped early), else any living camp group')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if gems() > 0:
        acc = empty
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 1)
        return acc
    acc = empty
    rich = empty
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            acc = acc | gt
            if group_gems(g) > 0 or group_gold(g) > 0:
                rich = rich | gt
    mono = type_spawns(MONOLITH)
    safe_rich = rich - mono
    if round() < 400:
        easy = safe_rich - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe_rich) > 0:
        return safe_rich
    return acc

@gene('s3', 'cached spawn field while retreating, else a cleared group to capture (while carrying few gems), else the goals without monoliths, spawn if none')
def goal_field(hurt: Bool) -> Field:
    if hurt:
        return HOME
    if gems() < 30:
        rew = near(tile(-5, -5), 0)
        for g in range(num_groups()):
            if group_reward(g):
                rew = rew | group_tiles(g)
        if size(rew) > 0:
            return field(rew)
    gl = goals()
    safe = gl - type_spawns(MONOLITH)
    if size(safe) > 0:
        return field(safe)
    if size(gl) > 0:
        return field(gl)
    return HOME

@gene('s4', 'how much closer a step brings me to the goals (cached field, own distance read once, unreachable-safe on both ends)')
def progress(t: Tile) -> Num:
    d0 = at(GF, me().pos)
    if d0 >= 1000000:
        return 0
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    return d0 - d1

@gene('Z34a', 'goal distance field with retreat hysteresis (below 40%, 55% with 30+ gems, stay until 90%); spawn field cached once; refreshed only on retreat change, gem change or every 2 rounds to save fuel; skipped while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    if not alive():
        RETREAT = False
        FRESH = False
        return
    if not HOMED:
        HOME = field(my_spawn())
        HOMED = True
    hf = me().health_frac
    was = RETREAT
    thr = 0.55 if gems() >= 30 else 0.4
    if hf < thr:
        RETREAT = True
    elif hf > 0.9:
        RETREAT = False
    changed = (RETREAT and not was) or (was and not RETREAT)
    if RETREAT:
        GF = HOME
        FRESH = True
    elif changed or not FRESH or gems() != LASTG or round() - LASTR >= 2:
        GF = goal_field(False)
        LASTR = round()
        LASTG = gems()
        FRESH = True

@gene('Z34b', 'skip option kinds we never use or cannot use now (no buy off shop, no move/attack when unable, no tribute without gems, recall only when retreating and off spawn, no moves while tributing) to save fuel', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    if kind == RECALL:
        if me().pos in my_spawn():
            return False
        return RETREAT
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == MOVE:
        if channeling() and gems() > 0:
            return False
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    return True
