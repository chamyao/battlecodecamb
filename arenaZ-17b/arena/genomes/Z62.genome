"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HOMING: Bool = False
LG: Tiles = None

@gene('Z73a', 'value of doing this option now, with ability casts and dashes; recall ~40%; finish low camps first; no camp fights when hurt', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hurt = me().health_frac < 0.35
    if o.kind == RECALL:
        if me().health_frac < 0.4 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if hurt:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not hurt:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and progress(o.tile) > 1:
                return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, a cleared group to capture, else a living non-monolith camp group (gem groups preferred)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    gem = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
            if group_gems(g) > 0:
                gem = gem | group_tiles(g)
    if size(rew) > 0:
        return rew
    mono = type_spawns(MONOLITH)
    safegem = gem - mono
    if size(safegem) > 0:
        return safegem
    safe = acc - mono
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'goal tile set: spawn while homing, else the goals, spawn if none')
def goal_field(homing: Bool) -> Tiles:
    if homing:
        return my_spawn()
    g = goals()
    if size(g) == 0:
        return my_spawn()
    return g

@gene('s4', 'how much closer a step brings me to the goals (cached field, unreachable-safe)')
def progress(t: Tile) -> Num:
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    return at(GF, me().pos) - d1

@gene('Z34a', 'goal distance field per turn, rebuilt only when the goal set changes; retreat hysteresis (home below 40% until 85%)', parents=['s1', 's3', 's4'])
def update() -> None:
    if alive():
        h = me().health_frac
        if h < 0.4:
            HOMING = True
        elif h > 0.85:
            HOMING = False
        g = goal_field(HOMING)
        if size(g) != size(LG) or size(g & LG) != size(g):
            GF = field(g)
            LG = g

@gene('Z34b', 'skip option kinds we never use (or cannot use now) to save fuel', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    if kind == RECALL:
        return me().health_frac < 0.4
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    return True
