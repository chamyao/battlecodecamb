"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
HOME: Field = None
HOMED: Bool = False
LASTR: Num = -100
LASTG: Num = -1
WASR: Bool = True
LASTGS: Tiles = None
D0: Num
D0POS: Tile

@gene('Z215a', 'value of doing this option now; treasure then strength shards; focus weak gem carriers; chase/dash at weak prey when healthy; recall ~40% (55% with 30+ gems); hurt bots avoid stepping next to enemy champions; strong camp attacks when healthy and gemless', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 6:
            return 66 if items_owned(6) < 5 else 0
        if items_owned(6) >= 5 and item_strength(o.item) > 0:
            return 50 + item_strength(o.item)
        return 0
    hf = me().health_frac
    hurt = hf < 0.35
    if o.kind == RECALL:
        low = 0.55 if gems() >= 30 else 0.4
        if hf < low and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac) + min(5, unit_gems(o.unit) / 10)
        if hurt or RETREAT:
            return 0
        return 75 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 123
                if o.unit.is_camp and gems() == 0 and not hurt and not RETREAT:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if hf < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile):
                if hf > 0.6 and not RETREAT:
                    p = prey()
                    if exists(p) and p.health_frac < 0.4 and dist(o.tile, p.pos) <= 1:
                        return 57
                if progress(o.tile) > 1:
                    return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if hf > 0.6 and not RETREAT:
            p = prey()
            if exists(p) and p.is_champion and p.health_frac < 0.4 and dist(p.pos, me().pos) <= 6:
                if dist(o.tile, p.pos) < dist(me().pos, p.pos):
                    return 56
        if progress(o.tile) <= 0:
            return 0
        if RETREAT or hf < 0.5:
            if any(u.is_champion and dist(u.pos, o.tile) <= 1 for u in enemies()):
                return 0
        return 50
    return 0

@gene('Z215b', 'where to walk: a free altar with gems, a cleared group to capture while carrying few gems, else gem-rich non-monolith camps, else living non-monolith camps (no golems early)', parents=['s2'])
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    if gems() > 0:
        acc = empty
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9171)
        if size(acc) > 0 and gems() >= 20:
            return acc
    rew = empty
    acc2 = empty
    rich = empty
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            gt = group_tiles(g)
            acc2 = acc2 | gt
            if group_gems(g) > 0:
                rich = rich | gt
    if size(rew) > 0:
        return rew
    if gems() > 0:
        alt = empty
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if size(alt) > 0:
            return alt
    safe = acc2 - type_spawns(MONOLITH)
    saferich = rich - type_spawns(MONOLITH)
    if round() < 400:
        easyrich = saferich - type_spawns(GOLEM)
        if size(easyrich) > 0:
            return easyrich
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(saferich) > 0:
        return saferich
    if size(safe) > 0:
        return safe
    return acc2

@gene('s3', 'distance field to a given goal set, cached spawn field if empty')
def goal_field(g: Tiles) -> Field:
    if size(g) == 0:
        return HOME
    return field(g)

@gene('s4', 'how much closer a step brings me to the goals (cached field and cached own distance while unmoved, unreachable-safe on both ends)')
def progress(t: Tile) -> Num:
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    d0 = D0
    if dist(me().pos, D0POS) != 0:
        d0 = at(GF, me().pos)
    if d0 >= 1000000:
        return 0
    return d0 - d1

@gene('Z34a', 'goal field with retreat hysteresis (home below 40%, 55% with 30+ gems, stay until 90%); spawn field cached; goals re-read on gem change, after retreat or every 2 rounds, distance field recomputed only when the goal set changed; own field distance cached; skip while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    if alive():
        if not HOMED:
            HOME = field(my_spawn())
            HOMED = True
        h = me().health_frac
        low = 0.55 if gems() >= 30 else 0.4
        RETREAT = h < low or (RETREAT and h < 0.9)
        if RETREAT:
            GF = HOME
            WASR = True
        elif WASR or gems() != LASTG or round() - LASTR >= 2:
            g = goals()
            if size(g) == 0:
                GF = HOME
                LASTGS = g
            elif WASR or size((g - LASTGS) | (LASTGS - g)) > 0:
                GF = goal_field(g)
                LASTGS = g
            LASTR = round()
            LASTG = gems()
            WASR = False
        D0POS = me().pos
        D0 = at(GF, D0POS)
    else:
        RETREAT = False
        WASR = True

@gene('Z34b', 'skip option kinds we never use or cannot use now (no move/attack when unable, no tribute without gems) to save fuel', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    if kind == RECALL:
        return me().health_frac < 0.4
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == MOVE:
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    return True

@gene('Z76a', 'a weak visible enemy champion within 6 tiles worth chasing, not guarded by more healthy enemies than allies near me can match; prefers gem carriers (invalid if none)', parents=['s1'])
def prey() -> Unit:
    sup = 1 + count(dist(a.pos, me().pos) <= 5 and a.health_frac > 0.4 for a in allies())
    return best(enemies(), lambda u: (1 - u.health_frac) + 0.01 * unit_gems(u) - (100 if (not u.is_champion) or u.health_frac >= 0.4 or dist(u.pos, me().pos) > 6 or count(v.is_champion and v.health_frac > 0.5 and dist(v.pos, u.pos) <= 3 for v in enemies()) >= max(2, sup) else 0))
