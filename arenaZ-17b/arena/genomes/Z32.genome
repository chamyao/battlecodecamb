"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

HEALING: Bool = False

@gene('s1', 'value of doing this option now; safe recall and no camp fights while healing')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if HEALING and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEALING and o.unit.health_frac > 0.3:
                return 0
            return 80 + 10 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 and not HEALING else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: spawn until healed, an altar with gems, a cleared group to capture, else a living camp group')
def goals() -> Tiles:
    if HEALING or me().health_frac < 0.3:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    return acc

@gene('s3', 'distance field to the goals, search bounded at my neighbourhood (cheap)')
def goal_field() -> Field:
    return field_avoid(goals(), walls(), near(me().pos, 1))

@gene('Z26a', 'track whether I am retreating to heal: start below 30% health, stop above 90%', parents=['s2'])
def update() -> None:
    if me().health_frac < 0.3:
        HEALING = True
    elif me().health_frac > 0.9:
        HEALING = False

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)
