"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: spawn when hurt, an altar with gems, a cleared group to capture, else a living camp group')
def goals() -> Tiles:
    if me().health_frac < 0.3:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    return acc

@gene('s3', 'distance field to the goals, routed around enemy champions')
def goal_field() -> Field:
    return field_avoid(goals(), enemy_tiles(), near(tile(-5, -5), 0))

@gene('s4', 'how much closer a step brings me to the goals, avoiding enemy-adjacent tiles when hurt or carrying')
def progress(t: Tile) -> Num:
    d = at(GF, me().pos) - at(GF, t)
    if gems() > 0 or me().health_frac < 0.5:
        if count(dist(u.pos, t) <= 2 for u in enemies()) > 0:
            d -= 1
    return d

@gene('Z30a', 'compute the goal distance field once per turn', parents=['s3', 's4'])
def update() -> None:
    GF = goal_field()
