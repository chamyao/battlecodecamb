"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
LASTR: Num = 0
LASTG: Num = 0
WASR: Bool = False

@gene('s1', 'value of doing this option now; treasure then strength shards; chase killable enemies when healthy; recall ~40%; hurt bots disengage and step away from nearby champions; no camp fights when hurt')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 6:
            return 100 if items_owned(6) < 5 else 0
        if items_owned(6) >= 5 and item_strength(o.item) > 0:
            return 50 + item_strength(o.item)
        return 0
    hurt = me().health_frac < 0.35
    if o.kind == RECALL:
        if me().health_frac < 0.4 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hurt and o.unit.health_frac > me().health_frac + 0.2:
                return 40
            return 80 + 10 * (1 - o.unit.health_frac)
        if hurt or RETREAT:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not hurt and not RETREAT:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and progress(o.tile) > 1:
                return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        pr = progress(o.tile)
        if hurt or RETREAT:
            e = best(enemies(), lambda u: (0 - dist(u.pos, me().pos)) - (100 if not u.is_champion else 0))
            if exists(e) and e.is_champion and dist(e.pos, me().pos) <= 4:
                if dist(o.tile, e.pos) > dist(me().pos, e.pos):
                    return 52 + (2 if pr > 0 else 0)
            return 50 if pr > 0 else 0
        if me().health_frac > 0.55:
            p = prey()
            if exists(p):
                d = dist(me().pos, p.pos)
                if d > me().attack_range and dist(o.tile, p.pos) < d:
                    return 56
        return 50 if pr > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, a cleared group to capture, else a living non-monolith camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    safe = acc - type_spawns(MONOLITH)
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'distance field to spawn while retreating, else to the goals, spawn if none')
def goal_field(hurt: Bool) -> Field:
    if hurt:
        return field(my_spawn())
    g = goals()
    if size(g) == 0:
        return field(my_spawn())
    return field(g)

@gene('s4', 'how much closer a step brings me to the goals (cached field, unreachable-safe on both ends)')
def progress(t: Tile) -> Num:
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    d0 = at(GF, me().pos)
    if d0 >= 1000000:
        return 0
    return d0 - d1

@gene('Z34a', 'goal field with retreat hysteresis (below 40%, 55% with 30+ gems, stay until 90%); field refreshed only on retreat change, gem change or every 2 rounds to save fuel; skip while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    if alive():
        h = me().health_frac
        thr = 0.55 if gems() >= 30 else 0.4
        newr = h < thr or (RETREAT and h < 0.9)
        changed = (newr and not RETREAT) or (RETREAT and not newr)
        RETREAT = newr
        if changed or not WASR or gems() != LASTG or round() - LASTR >= 2:
            GF = goal_field(RETREAT)
            LASTR = round()
            LASTG = gems()
            WASR = True
    else:
        RETREAT = False
        WASR = False

@gene('Z34b', 'skip option kinds we never use or cannot use now (no move/attack when unable, no tribute without gems, no recall on spawn)', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    if kind == RECALL:
        return me().health_frac < 0.4 and not (me().pos in my_spawn())
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == MOVE:
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    return True

@gene('Z76a', 'a killable visible enemy champion within 6 tiles (below 40% or within ~3 of my hits), not guarded by more healthy enemies than allies near me can match; prefers gem carriers (invalid if none)', parents=['s1'])
def prey() -> Unit:
    mp = me().pos
    ms = me().strength
    sup = 1 + count(dist(a.pos, mp) <= 5 and a.health_frac > 0.4 for a in allies())
    return best(enemies(), lambda u: (1 - u.health_frac) + 0.01 * unit_gems(u) - (100 if (not u.is_champion) or (u.health_frac >= 0.4 and u.health > 3 * ms) or dist(u.pos, mp) > 6 or count(v.is_champion and v.health_frac > 0.5 and dist(v.pos, u.pos) <= 3 for v in enemies()) >= max(2, sup) else 0))
