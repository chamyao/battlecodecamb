"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
HOME: Field = None
HOMED: Bool = False
LASTR: Num = -10
LASTG: Num = -1
WASR: Bool = False
D0: Num = 0
D0POS: Tile = None

@gene('s1', 'value of doing this option now; treasure then strength shards; chase weak or gem-rich enemies when healthy; recall ~40%; hurt bots disengage from healthy champions; no camp fights when hurt')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 6:
            return 100 if items_owned(6) < 5 else 0
        if items_owned(6) >= 5 and item_strength(o.item) > 0:
            return 50 + item_strength(o.item)
        return 0
    hurt = me().health_frac < 0.35
    if o.kind == RECALL:
        if me().health_frac < 0.4 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if hurt and o.unit.health_frac > me().health_frac + 0.2:
                return 40
            return 80 + 10 * (1 - o.unit.health_frac) + min(5, 0.05 * unit_gems(o.unit))
        if hurt or RETREAT:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not hurt and not RETREAT:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and progress(o.tile) > 1:
                return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if me().health_frac > 0.6 and not RETREAT:
            p = prey()
            if exists(p) and prey_ok(p):
                if dist(o.tile, p.pos) < dist(me().pos, p.pos):
                    return 56
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: a free altar once carrying 30+ gems (any gems late or with no camps left), a cleared group to capture, else a living non-monolith camp group (no golems early)')
def goals() -> Tiles:
    if gems() >= 30 or (gems() > 0 and round() > 1700):
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    safe = acc - type_spawns(MONOLITH)
    if round() < 400:
        easy = safe - type_spawns(GOLEM)
        if size(easy) > 0:
            return easy
    if size(safe) > 0:
        return safe
    if gems() > 0:
        alt = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if size(alt) > 0:
            return alt
    return acc

@gene('s3', 'distance field to spawn while retreating, else to the goals, spawn if none; while carrying gems route around tiles next to visible enemy champions (falls back to the plain field if that blocks me)')
def goal_field(hurt: Bool) -> Field:
    if hurt:
        return field(my_spawn())
    g = goals()
    if size(g) == 0:
        return field(my_spawn())
    if gems() > 0:
        avoid = g - g
        n = 0
        for u in enemies():
            if u.is_champion:
                avoid = avoid | near(u.pos, 1)
                n += 1
        if n > 0:
            avoid = avoid - g
            avoid = avoid - near(me().pos, 0)
            f = field_avoid(g, walls() | avoid, g - g)
            if at(f, me().pos) < 1000000:
                return f
    return field(g)

@gene('s4', 'how much closer a step brings me to the goals (cached field and cached own distance while unmoved, unreachable-safe on both ends)')
def progress(t: Tile) -> Num:
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    p = me().pos
    d0 = D0
    if not (valid(D0POS) and dist(p, D0POS) == 0):
        d0 = at(GF, p)
    if d0 >= 1000000:
        return 0
    return d0 - d1

@gene('Z34a', 'goal field with retreat hysteresis (home below 40%, stay until 90%); spawn field cached once; goal field refreshed on gem change, retreat change or every 2 rounds; my own distance cached; skip while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    if alive():
        h = me().health_frac
        r = h < 0.4 or (RETREAT and h < 0.9)
        if r:
            if not HOMED:
                HOME = field(my_spawn())
                HOMED = True
            GF = HOME
        elif WASR or gems() != LASTG or round() - LASTR >= 2:
            GF = goal_field(False)
            LASTR = round()
            LASTG = gems()
        WASR = r
        RETREAT = r
        D0POS = me().pos
        D0 = at(GF, D0POS)
    else:
        RETREAT = False
        WASR = True

@gene('Z34b', 'skip option kinds we never use or cannot use now (no move/attack when unable, no tribute without gems, no recall on spawn, no moves/recall that break a running tribute)', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if channeling() and (kind == MOVE or kind == RECALL or kind == TRIBUTE):
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    if kind == RECALL:
        return me().health_frac < 0.4 and not (me().pos in my_spawn())
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == MOVE:
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    return True

@gene('Z76a', 'a weak visible enemy champion worth chasing (see prey_ok); prefers gem carriers and low health (invalid-ish if none: check prey_ok)', parents=['s1'])
def prey() -> Unit:
    return best(enemies(), lambda u: (1 - u.health_frac) + 0.01 * unit_gems(u) - (100 if not prey_ok(u) else 0))

@gene('Z155a', 'whether an enemy unit is worth chasing: a champion within 6, weak (under 40% or much lower health than me), not guarded by more healthy enemies than allies near me can match; not while carrying 30+ gems', parents=['Z76a'])
def prey_ok(u: Unit) -> Bool:
    if not u.is_champion or dist(u.pos, me().pos) > 6:
        return False
    if gems() >= 30:
        return False
    if u.health_frac >= 0.4 and u.health >= 0.5 * me().health:
        return False
    sup = 1 + count(dist(a.pos, me().pos) <= 5 and a.health_frac > 0.4 for a in allies())
    return count(v.is_champion and v.health_frac > 0.5 and dist(v.pos, u.pos) <= 3 for v in enemies()) < max(2, sup)
