"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 75 + 15 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60 + 10 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if is_recalling(me()):
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: spawn when hurt, a free altar with gems, a cleared group to capture, else a living camp group (no solo monoliths early)')
def goals() -> Tiles:
    if me().health_frac < 0.3:
        return my_spawn()
    if gems() > 0:
        alt = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if size(alt) > 0:
            return alt
    mono = type_spawns(MONOLITH)
    late = round() > 1000
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        gt = group_tiles(g)
        if group_reward(g):
            rew = rew | gt
        elif not group_respawning(g):
            if late or size(gt & mono) == 0:
                acc = acc | gt
    if size(rew) > 0:
        return rew
    if size(acc) > 0:
        return acc
    return my_spawn()

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached field)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z8a', 'compute the goal distance field once per turn', parents=['s1', 's4'])
def update() -> None:
    GF = goal_field()
