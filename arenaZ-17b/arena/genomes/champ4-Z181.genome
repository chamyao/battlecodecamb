"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
HOME: Field = None
HOMED: Bool = False
LASTR: Num = -100
LASTG: Num = -1
WASR: Bool = True

@gene('Z159a', 'value of doing this option now; treasure then strength shards; focus weak gem carriers; prefer finishing weak camps; chase/dash at weak prey when healthy; recall ~40%; no camp fights when hurt or retreating', parents=['s1', 'Z104a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 6:
            return 100 if items_owned(6) < 5 else 0
        if items_owned(6) >= 5 and item_strength(o.item) > 0:
            return 50 + item_strength(o.item)
        return 0
    hf = me().health_frac
    hurt = hf < 0.35 or RETREAT
    if o.kind == RECALL:
        if hf < 0.4 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac) + min(5, unit_gems(o.unit) / 10)
        if hurt:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 78
                if o.unit.is_camp and gems() == 0 and not hurt:
                    return 62
            return 0
        if k == AB_SHIELD:
            return 65 if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0 else 0
        if k == AB_HEAL:
            return 65 if hf < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile):
                if hf > 1.072 and not RETREAT:
                    p = prey()
                    if exists(p) and p.health_frac < 0.4 and dist(o.tile, p.pos) <= 1:
                        return 57
                if progress(o.tile) > 1:
                    return 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if hf > 0.6 and not RETREAT:
            p = prey()
            if exists(p) and p.is_champion and p.health_frac < 0.4 and dist(p.pos, me().pos) <= 6:
                if dist(o.tile, p.pos) < dist(me().pos, p.pos):
                    return 56
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z204a', 'where to walk: a cleared group to capture (unless carrying many gems), a free altar with gems (any altar if all locked), else a living non-monolith camp group, preferring gem-holding groups, skipping golems early', parents=['s2'])
def goals() -> Tiles:
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    rich = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            gt = group_tiles(g)
            acc = acc | gt
            if group_gems(g) > 0:
                rich = rich | gt
    if size(rew) > 0 and gems() < 50:
        return rew
    if gems() > 0:
        alt = near(tile(-5, -5), 0)
        free = altars() - locked_altars()
        if size(free) == 0:
            free = altars()
        for a in free:
            alt = alt | near(a, 1)
        if size(alt) > 0:
            return alt
    mono = type_spawns(MONOLITH)
    safe = acc - mono
    safe_rich = rich - mono
    if round() < 400:
        golem = type_spawns(GOLEM)
        easy_rich = safe_rich - golem
        if size(easy_rich) > 0:
            return easy_rich
        easy = safe - golem
        if size(easy) > 0:
            return easy
    if size(safe_rich) > 0:
        return safe_rich
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'cached spawn field while retreating, else distance field to the goals, spawn if none')
def goal_field(hurt: Bool) -> Field:
    if hurt:
        return HOME
    g = goals()
    if size(g) == 0:
        return HOME
    return field(g)

@gene('s4', 'how much closer a step brings me to the goals (cached field, unreachable-safe on both ends)')
def progress(t: Tile) -> Num:
    d1 = at(GF, t)
    if d1 >= 1000000:
        return 0
    d0 = at(GF, me().pos)
    if d0 >= 1000000:
        return 0
    return d0 - d1

@gene('Z34a', 'goal field with retreat hysteresis (home below 40%, stay until 90%); spawn field cached; goal field refreshed on gem change, after retreat or every 2 rounds; skip while dead', parents=['s1', 's3', 's4'])
def update() -> None:
    if alive():
        if not HOMED:
            HOME = field(my_spawn())
            HOMED = True
        h = me().health_frac
        RETREAT = h < 0.4 or (RETREAT and h < 0.9)
        if RETREAT:
            GF = HOME
            WASR = True
        elif WASR or gems() != LASTG or round() - LASTR >= 2:
            GF = goal_field(False)
            LASTR = round()
            LASTG = gems()
            WASR = False
    else:
        RETREAT = False
        WASR = True

@gene('Z34b', 'skip option kinds we never use or cannot use now (no move/attack when unable, no tribute without gems) to save fuel', parents=['s1', 's3', 's4'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    if kind == RECALL:
        return me().health_frac < 0.4
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == MOVE:
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    return True

@gene('Z76a', 'a weak visible enemy champion within 6 tiles worth chasing, not guarded by more healthy enemies than allies near me can match; prefers gem carriers (invalid if none)', parents=['s1'])
def prey() -> Unit:
    sup = 1 + count(dist(a.pos, me().pos) <= 5 and a.health_frac > 0.4 for a in allies())
    return best(enemies(), lambda u: (1 - u.health_frac) + 0.01 * unit_gems(u) - (100 if (not u.is_champion) or u.health_frac >= 0.4 or dist(u.pos, me().pos) > 6 or count(v.is_champion and v.health_frac > 0.5 and dist(v.pos, u.pos) <= 3 for v in enemies()) >= max(2, sup) else 0))
