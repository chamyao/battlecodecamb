"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None

@gene('Z73a', 'value of doing this option now; draft priorities, focus low enemies, dash toward goals, shield/heal when hurt or outmatched, recall when low or when healing far from home with no enemy champion in sight', parents=['Z56a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 5
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 4
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.35:
            return 90
        if HEALING and safe_far_from_home():
            return 88
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + (1 - o.unit.health_frac) * 4
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 65
            return 0
        if k == AB_SHIELD or k == AB_HEAL:
            return 96 if me().health_frac < 0.65 else 0
        if k == AB_DASH:
            if valid(o.tile):
                return 55 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group waiting for capture; else a living camp group (monoliths only after round 1000)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    rew = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    if round() < 1000:
        acc = acc - type_spawns(MONOLITH)
    return acc

@gene('Z56b', 'distance field to the goals; walk home and heal (with hysteresis) when hurt without gems', parents=['s3'])
def goal_field() -> Field:
    if HEALING and gems() == 0:
        return field(my_spawn())
    g = goals()
    if size(g) == 0:
        g = camp_spawns()
    return field(g)

@gene('Z75a', 'how much closer a step brings me to the goals (cached field); unreachable reads as no progress; penalise danger tiles, reward leaving danger', parents=['Z72a', 's4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = at(GF, me().pos)
    if here >= 1000000:
        return 1
    d = here - there
    inside = me().pos in DANGER
    if t in DANGER:
        if inside:
            return d - 1
        return d - 2
    if inside:
        return d + 1
    return d

@gene('Z140a', 'healing, at least 10 steps from spawn and no enemy champion visible: a recall is safe and saves walking', parents=['Z75a'])
def safe_far_from_home() -> Bool:
    if gems() >= 15:
        return False
    if me().pos in my_spawn():
        return False
    if dist(me().pos, nearest(my_spawn(), me().pos)) < 10:
        return False
    return not any(u.is_champion for u in enemies())

@gene('Z85a', 'once per turn: healing hysteresis (start <40% or <60% when outmatched, stop >=93%), danger tiles near enemy champions when hurt, goal field; skip while dead', parents=['Z73b', 'Z75b'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        elif hf < 0.6 and threat_ratio() > 1.3:
            HEALING = True
        if hf >= 0.93:
            HEALING = False
        DANGER = DANGER - DANGER
        if hf < 0.6:
            for u in enemies():
                if u.is_champion:
                    DANGER = DANGER | near(u.pos, 2)
        GF = goal_field()

@gene('Z38a', 'nearby enemy champion threat relative to my own strength plus nearby allied champions', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mine = (m.strength + m.focus) * m.health_frac + 1
    mine += 0.7 * sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, m.pos) <= 4 and dist(a.pos, m.pos) > 0)
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, m.pos) <= 4)
    return theirs / mine
