"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
HERE: Num = 0
HERE_T: Tile = None
FIGHT: Bool = False

@gene('Z275a', 'value of doing this option now; ladder draft, aoe/damage/cc casts, dash toward goals, shield when hurt or on cooldown in fights, recall at 29% or when healing far from home with no enemy champion near; while healing, retreat steps beat fights unless the target is nearly dead', parents=['Z255a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == HEART_OF_RUIN:
            return 8
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.29:
            return 90
        if HEALING and safe_recall():
            return 88
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEALING and o.unit.health_frac > 0.25:
                return 40
            return 80 + 10 * (1 - o.unit.health_frac)
        if HEALING:
            return 0
        if gems() == 0 and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0 and not HEALING:
                    return 65
            return 0
        if k == AB_SHIELD:
            return 96 if (me().health_frac < 0.7 or FIGHT) else 0
        if k == AB_HEAL:
            return 96 if me().health_frac < 0.7 else 0
        if k == AB_DASH:
            if valid(o.tile):
                p = progress(o.tile)
                if p >= 2:
                    return 94 if HEALING else 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 93 if HEALING else 50
        return 0
    return 0

@gene('s2', 'where to walk: a cleared group waiting for capture (unless carrying 40+ gems), else an altar once carrying 12+ gems (6+ after round 1500, any near the end), else a living non-monolith camp group (monolith only late with 2+ allies close by); altar if nothing else and carrying gems')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    g0 = gems()
    if g0 < 40:
        for g in range(num_groups()):
            if group_reward(g):
                acc = acc | group_tiles(g)
        if size(acc) > 0:
            return acc
    need = 12
    if round() >= 1500:
        need = 6
    if g0 >= need or (g0 > 0 and round() >= 1850):
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    mono = type_spawns(MONOLITH)
    late = False
    if round() >= 1100:
        p = me().pos
        late = count(dist(u.pos, p) > 0 and dist(u.pos, p) <= 6 for u in allies()) >= 2
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                acc = acc | gt
    if size(acc) == 0 and g0 > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
    return acc

@gene('Z430a', 'distance field to the goals (camp spawns if none) or my spawn while healing; while healing with 20+ gems, no enemy champion seen and health >= 25%, bank at a nearer free altar instead of walking home; route around visible enemy champions when healing or carrying 20+ gems', parents=['s3'])
def goal_field() -> Field:
    mp = me().pos
    gm = gems()
    if HEALING:
        g = my_spawn()
        if gm >= 20 and me().health_frac >= 0.25:
            seen = any(u.is_champion for u in enemies())
            if not seen:
                acc = near(tile(-5, -5), 0)
                for a in altars() - locked_altars():
                    acc = acc | near(a, 1)
                if size(acc) > 0:
                    na = nearest(acc, mp)
                    ns = nearest(g, mp)
                    if valid(na) and valid(ns) and dist(na, mp) < dist(ns, mp):
                        g = acc
    else:
        g = goals()
    if size(g) == 0:
        g = camp_spawns()
    if HEALING or gm >= 20:
        av = g - g
        n = 0
        for u in enemies():
            if u.is_champion:
                n += 1
                av = av | near(u.pos, 2 if u.attack_range <= 1 else 3)
        if n > 0:
            occ = enemy_tiles()
            mine = near(mp, 0)
            av = (av | occ) - mine
            f = field_avoid(g, av, g - g)
            if at(f, mp) < 100000000:
                return f
            f2 = field_avoid(g, occ - mine, g - g)
            if at(f2, mp) < 100000000:
                return f2
    return field(g)

@gene('Z72a', 'how much closer a step brings me to the goals (cached field and cached own value, refreshed if I moved); unreachable reads as no progress', parents=['s4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = HERE
    p = me().pos
    if not valid(HERE_T) or dist(p, HERE_T) != 0:
        here = at(GF, p)
    if here >= 1000000:
        return 1
    return here - there

@gene('Z349a', 'while healing: far from spawn by cached walk distance and no enemy champion within 6: recall saves the walk', parents=['Z72a'])
def safe_recall() -> Bool:
    p = me().pos
    d = HERE
    if not valid(HERE_T) or dist(p, HERE_T) != 0:
        d = at(GF, p)
    if d <= 8:
        return False
    return not any(u.is_champion and dist(u.pos, p) <= 6 for u in enemies())

@gene('Z296a', 'compute the goal distance field once per turn and cache my own value; note whether an enemy champion is within 4 tiles (fight); heal when badly hurt, moderately hurt and outmatched, badly outmatched while scratched, or hurt while carrying many gems (stop at 93%); reset healing while dead', parents=['Z6a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        g = gems()
        mp = me().pos
        FIGHT = any(u.is_champion and u.is_enemy and dist(u.pos, mp) <= 4 for u in enemies())
        if hf < 0.4:
            HEALING = True
        elif hf < 0.8 and FIGHT:
            tr = threat_ratio()
            if hf < 0.65 and tr > 1.2:
                HEALING = True
            elif tr > 2.2:
                HEALING = True
        if g >= 30 and hf < 0.55:
            HEALING = True
        if hf >= 0.93:
            HEALING = False
        GF = goal_field()
        HERE_T = mp
        HERE = at(GF, HERE_T)
    else:
        HEALING = False
        FIGHT = False

@gene('Z38a', 'nearby enemy champion threat relative to my own plus nearby allied effective strength', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mine = (m.strength + m.focus) * m.health_frac + 1
    help = sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, m.pos) <= 4 and dist(a.pos, m.pos) > 0)
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, m.pos) <= 5)
    return theirs / (mine + 0.6 * help)
