"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
HERE: Num = 0
HERE_T: Tile = None
GT: Tiles = None
GOK: Bool = False
NEAR6: Bool = False
BANK: Bool = False

@gene('Z275a', 'value of doing this option now; ladder draft, aoe/damage/cc casts, dash toward goals, shield when hurt, recall at 29% or when healing far from home; keep farming camps while carrying under 15 gems; prefer gem-carrying champion targets', parents=['Z255a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == HEART_OF_RUIN:
            return 8
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.29:
            return 90
        if HEALING and safe_recall():
            return 88
        return 0
    farm = gems() < 15 and (round() < 1850 or gems() == 0)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEALING and o.unit.health_frac > 0.25:
                return 40
            return 80 + 8 * (1 - o.unit.health_frac) + min(unit_gems(o.unit) / 20, 2)
        if HEALING:
            return 0
        if farm and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and farm and not HEALING:
                    return 39
            return 0
        if k == AB_SHIELD or k == AB_HEAL:
            return 96 if me().health_frac < 0.7 else 0
        if k == AB_DASH:
            if valid(o.tile):
                p = progress(o.tile)
                if p >= 2:
                    return 94 if HEALING else 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 93 if HEALING else 50
        return 0
    return 0

@gene('Z300a', 'skip listing option kinds that score() never values (wards, locks, cancels), purchases off spawn or unaffordable, tributes without gems and recalls that score() would reject', parents=['Z275a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return gold() >= 35 and can_shop()
    if kind == TRIBUTE:
        return gems() > 0
    if kind == RECALL:
        return HEALING or me().health_frac < 0.29
    return True

@gene('s2', 'where to walk: a cleared group waiting for capture (unless carrying 40+ gems), else an altar once carrying 12+ gems (6+ after round 1500, any near the end), else a living non-monolith camp group (monolith only late and only with 2+ allies close by)')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    g0 = gems()
    if g0 < 40:
        for g in range(num_groups()):
            if group_reward(g):
                acc = acc | group_tiles(g)
        if size(acc) > 0:
            return acc
    need = 11
    if round() >= 1500:
        need = 6
    if g0 >= need or (g0 > 0 and round() >= 1850):
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    mono = type_spawns(MONOLITH)
    late = False
    if round() >= 1100:
        p = me().pos
        late = count(dist(u.pos, p) > 0 and dist(u.pos, p) <= 6 for u in allies()) >= 2
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                acc = acc | gt
    if size(acc) == 0 and g0 > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
    return acc

@gene('s3', 'distance field to the given goal tiles; when avoiding (healing or carrying 20+ gems) route around visible enemy champions (wider buffer for ranged), then their tiles only, then the plain field')
def goal_field(g: Tiles, avoid: Bool) -> Field:
    if avoid:
        occ = enemy_tiles()
        if size(occ) > 0:
            av = occ
            for u in enemies():
                if u.is_champion:
                    av = av | near(u.pos, 2 if u.attack_range <= 1 else 3)
            mine = near(me().pos, 0)
            av = av - mine
            f = field_avoid(g, av, g - g)
            if at(f, me().pos) < 100000000:
                return f
            f2 = field_avoid(g, occ - mine, g - g)
            if at(f2, me().pos) < 100000000:
                return f2
    return field(g)

@gene('Z72a', 'how much closer a step brings me to the goals (cached field and cached own value, refreshed if I moved); unreachable reads as no progress', parents=['s4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = HERE
    p = me().pos
    if not valid(HERE_T) or dist(p, HERE_T) != 0:
        here = at(GF, p)
    if here >= 1000000:
        return 1
    return here - there

@gene('Z349a', 'while healing toward spawn (not banking at an altar): far from spawn by cached walk distance, no enemy champion within 6 (cached) and no awake camp within 3: recall is unlikely to be cancelled and saves the walk', parents=['Z72a'])
def safe_recall() -> Bool:
    if NEAR6 or BANK:
        return False
    p = me().pos
    d = HERE
    if not valid(HERE_T) or dist(p, HERE_T) != 0:
        d = at(GF, p)
    if d <= 8:
        return False
    return not any(is_awake(u) and dist(u.pos, p) <= 3 for u in camps())

@gene('Z318a', 'heal below ~45%, moderately hurt and outmatched, lightly hurt and heavily outmatched, or hurt while carrying many gems (stop at 93%); note an enemy champion within 6 once per turn and whether a healing trip goes to an altar instead of spawn; compute the goal field only when needed, cache my own value; reset while dead', parents=['Z300b', 'Z296a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        g = gems()
        mp = me().pos
        NEAR6 = any(u.is_champion and dist(u.pos, mp) <= 6 for u in enemies())
        if hf < 0.45:
            HEALING = True
        elif g >= 30 and hf < 0.55:
            HEALING = True
        elif hf < 0.8 and not HEALING and NEAR6:
            tr = threat_ratio()
            if hf < 0.65 and tr > 1.2:
                HEALING = True
            elif tr > 2.8:
                HEALING = True
        if hf >= 0.93:
            HEALING = False
        tg = goal_tiles()
        BANK = HEALING and size(tg & my_spawn()) == 0
        avoid = HEALING or g >= 20
        if avoid or not GOK or size(tg - GT) > 0 or size(GT - tg) > 0:
            GF = goal_field(tg, avoid)
            GT = tg
            GOK = not avoid
        HERE_T = mp
        HERE = at(GF, HERE_T)
    else:
        HEALING = False
        GOK = False
        NEAR6 = False
        BANK = False

@gene('Z411a', 'goal tiles: my spawn while healing, but bank 10+ carried gems at a clearly nearer free altar first when health is above 30% and no enemy champion is within 6; else goals(); camp spawns if empty', parents=['s3'])
def goal_tiles() -> Tiles:
    if HEALING:
        g = my_spawn()
        if gems() >= 10 and not NEAR6 and me().health_frac > 0.3:
            a = altars() - locked_altars()
            if size(a) > 0:
                mp = me().pos
                na = nearest(a, mp)
                ns = nearest(g, mp)
                if valid(na) and valid(ns) and dist(na, mp) + 3 < dist(ns, mp):
                    g = near(na, 1)
    else:
        g = goals()
    if size(g) == 0:
        g = camp_spawns()
    return g

@gene('Z38a', 'Lanchester-style threat: nearby enemy champions damage times health (plus awake camps within 2 at half weight) over my side damage times health (me plus allies within 5 at 0.9 weight); skips the allies query when no enemy champion is near; ranged enemies counted from slightly farther', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mp = m.pos
    tdmg = 0
    thp = 0
    for u in enemies():
        if u.is_champion and dist(u.pos, mp) <= 5 + (1 if u.attack_range > 1 else 0):
            tdmg += u.strength + u.focus
            thp += u.health
    if tdmg <= 0:
        return 0
    for c in camps():
        if dist(c.pos, mp) <= 2 and is_awake(c):
            tdmg += 0.5 * c.strength
            thp += 0.5 * c.health
    odmg = m.strength + m.focus + 1
    ohp = m.health + 1
    for a in allies():
        if a.is_champion:
            da = dist(a.pos, mp)
            if da <= 5 and da > 0:
                odmg += 0.9 * (a.strength + a.focus)
                ohp += 0.9 * a.health
    return (tdmg * thp) / (odmg * ohp)
