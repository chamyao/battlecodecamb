"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
HERE: Num = 0
HERE_T: Tile = None
FIGHT: Bool = False
NEAR6: Bool = False
BUSH: Tiles = None
TR: Num = 0
GT: Tiles = None
GOK: Bool = False

@gene('Z523a', 'value of doing this option now; ladder draft, aoe/damage/cc casts, dash toward goals, shield when hurt, in fights or outmatched, recall when low or when healing far from home with no enemy champion near; keep farming camps while carrying under 15 gems; prefer gem-carrying champion targets; avoid trading into healthy champions when clearly outmatched; while healing, retreat steps beat fights unless the target is nearly dead', parents=['Z453a', 'Z275a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == HEART_OF_RUIN:
            return 8
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 3
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.29:
            return 90
        if HEALING and not NEAR6 and HERE > 12 and HERE < 1000000:
            return 88
        return 0
    farm = gems() < 15 and (round() < 1850 or gems() == 0)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEALING and o.unit.health_frac > 0.25:
                return 40
            if TR > 1.6 and o.unit.health_frac > 0.5:
                return 30
            return 80 + 8 * (1 - o.unit.health_frac) + min(unit_gems(o.unit) / 20, 2)
        if HEALING:
            return 0
        if farm and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and farm and not HEALING:
                    return 65
            return 0
        if k == AB_SHIELD:
            if me().health_frac < 0.7 or FIGHT:
                return 96
            if TR > 1.2 and me().health_frac < 0.85:
                return 96
            return 0
        if k == AB_HEAL:
            if me().health_frac < 0.7:
                return 96
            if TR > 1.2 and me().health_frac < 0.85:
                return 96
            return 0
        if k == AB_DASH:
            if valid(o.tile):
                p = progress(o.tile)
                if p >= 2:
                    return 94 if HEALING else 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 93 if HEALING else 50
        return 0
    return 0

@gene('Z523b', 'skip listing option kinds that score() never values (wards, locks, cancels), purchases we cannot afford or cannot make away from the shop, tributes without gems and recalls that score() would reject', parents=['Z478a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return gold() >= 30 and can_shop()
    if kind == TRIBUTE:
        return gems() > 0
    if kind == RECALL:
        return HEALING or me().health_frac < 0.29
    return True

@gene('s2', 'where to walk: a cleared group waiting for capture (unless carrying 40+ gems), else an altar once carrying 12+ gems (any gems near the end), else a living non-monolith camp group (monolith only late)')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    g0 = gems()
    if g0 < 40:
        for g in range(num_groups()):
            if group_reward(g):
                acc = acc | group_tiles(g)
        if size(acc) > 0:
            return acc
    if g0 >= 12 or (g0 > 0 and round() >= 1850):
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    mono = type_spawns(MONOLITH)
    late = round() >= 1100
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                acc = acc | gt
    if size(acc) == 0 and g0 > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
    return acc

@gene('Z411a', 'goal tiles: my spawn while healing, but bank 10+ carried gems at a clearly nearer free altar first when health is above 30% and no enemy champion is within 6 (cached); else goals(); camp spawns if empty', parents=['s3'])
def goal_tiles() -> Tiles:
    if HEALING:
        g = my_spawn()
        if gems() >= 10 and me().health_frac > 0.3 and not NEAR6:
            p = me().pos
            a = nearest(altars() - locked_altars(), p)
            s = nearest(g, p)
            if valid(a) and valid(s) and dist(a, p) + 4 < dist(s, p):
                g = near(a, 1)
    else:
        g = goals()
    if size(g) == 0:
        g = camp_spawns()
    return g

@gene('Z551a', 'distance field to given goal tiles; when avoiding, route around visible enemy champions (wider buffer for ranged), then their tiles only, then the plain field', parents=['Z523c', 's3'])
def goal_field(g: Tiles, avoid: Bool) -> Field:
    if avoid:
        av = g - g
        n = 0
        for u in enemies():
            if u.is_champion:
                n += 1
                av = av | near(u.pos, 2 if u.attack_range <= 1 else 3)
        if n > 0:
            occ = enemy_tiles()
            mp = me().pos
            mine = near(mp, 0)
            av = (av | occ) - mine
            f = field_avoid(g, av, g - g)
            if at(f, mp) < 100000000:
                return f
            f2 = field_avoid(g, occ - mine, g - g)
            if at(f2, mp) < 100000000:
                return f2
    return field(g)

@gene('Z72a', 'how much closer a step brings me to the goals (cached field and cached own value, refreshed if I moved); while retreating from nearby enemies a forward step into a bush scores a little more; unreachable reads as no progress', parents=['s4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = HERE
    p = me().pos
    if not valid(HERE_T) or dist(p, HERE_T) != 0:
        here = at(GF, p)
    if here >= 1000000:
        return 1
    dlt = here - there
    if dlt > 0 and HEALING and t in BUSH:
        return dlt + 0.3
    return dlt

@gene('Z551b', 'note enemy champions within 4 and 6 tiles; cache threat ratio only when an enemy champion is within 7; cache bushes while healing; heal when badly hurt, moderately hurt and outmatched, heavily outmatched, or hurt while carrying many gems (stop at 94%); recompute the goal field only when the goal set changes or enemy avoidance is needed; reset while dead', parents=['Z523d', 'Z318a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        mp = me().pos
        g = gems()
        d = min((dist(u.pos, mp) for u in enemies() if u.is_champion and u.is_enemy), default=100)
        FIGHT = d <= 4
        NEAR6 = d <= 6
        if d <= 7:
            TR = threat_ratio()
        else:
            TR = 0
        if hf < 0.4:
            HEALING = True
        elif hf < 0.8:
            if hf < 0.63 and TR > 1.3:
                HEALING = True
            elif TR > 2.8:
                HEALING = True
            if g >= 30 and hf < 0.55:
                HEALING = True
        if hf >= 0.94:
            HEALING = False
        if HEALING and NEAR6:
            BUSH = bushes()
        else:
            BUSH = mp_empty(mp)
        tg = goal_tiles()
        avoid = (HEALING or g >= 10 or hf < 0.6 or TR > 1.5) and d < 100
        if avoid or not GOK or size(tg - GT) > 0 or size(GT - tg) > 0:
            GF = goal_field(tg, avoid)
            GT = tg
            GOK = not avoid
        HERE_T = mp
        HERE = at(GF, HERE_T)
    else:
        HEALING = False
        FIGHT = False
        NEAR6 = False
        TR = 0

@gene('Z396a', 'an empty tile set (cheap)', parents=['Z273a'])
def mp_empty(t: Tile) -> Tiles:
    s = near(t, 0)
    return s - s

@gene('Z38a', 'Lanchester-style threat: nearby enemy champions damage times health over my side damage times health (me plus nearby allies); skips the allies query when no enemy is near; ranged enemies counted farther', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    p = m.pos
    theirs = sum((u.strength + u.focus) * u.health for u in enemies() if u.is_champion and dist(u.pos, p) <= (5 if u.attack_range <= 1 else 7))
    if theirs <= 0:
        return 0
    mine = (m.strength + m.focus + 1) * m.health
    help = sum((a.strength + a.focus) * a.health for a in allies() if a.is_champion and dist(a.pos, p) <= 5 and dist(a.pos, p) > 0)
    return theirs / (mine + 0.7 * help)
