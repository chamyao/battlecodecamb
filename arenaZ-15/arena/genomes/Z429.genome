"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
HERE: Num = 0
HERE_T: Tile = None
FIGHT: Bool = False
GT: Tiles = None
GOK: Bool = False

@gene('Z329a', 'value of doing this option now; ladder draft, focus weak champions, aoe/damage casts, dash toward goals (urgent while healing), shield when hurt or on cooldown in fights, recall at 29% (or when healing/below 42% and safe far from home); while healing avoid fights unless the target is nearly dead', parents=['Z323a', 'Z275a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == HEART_OF_RUIN:
            return 8
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 3
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        hf = me().health_frac
        if hf < 0.29:
            return 90
        if (HEALING or hf < 0.42) and safe_recall():
            return 97
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEALING and o.unit.health_frac > 0.25:
                return 40
            return 80 + 10 * (1 - o.unit.health_frac)
        if HEALING:
            return 0
        if gems() == 0 and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0 and not HEALING:
                    return 65
            return 0
        if k == AB_SHIELD:
            return 96 if (me().health_frac < 0.7 or FIGHT) else 0
        if k == AB_HEAL:
            return 96 if me().health_frac < 0.7 else 0
        if k == AB_DASH:
            if valid(o.tile):
                if progress(o.tile) >= 2:
                    return 94 if HEALING else 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        pr = progress(o.tile)
        if pr > 0:
            return (93 if HEALING else 50) + min(pr, 3) * 0.1
        return 0
    return 0

@gene('Z300a', 'skip listing option kinds that score() never values (wards, locks, cancels) to save fuel', parents=['Z275a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    return True

@gene('s2', 'where to walk: a cleared group waiting for capture (unless carrying 40+ gems), else an altar with gems, else a living non-monolith camp group (monolith only late)')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() < 40:
        for g in range(num_groups()):
            if group_reward(g):
                acc = acc | group_tiles(g)
        if size(acc) > 0:
            return acc
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    mono = type_spawns(MONOLITH)
    late = round() >= 1100
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                acc = acc | gt
    return acc

@gene('s3', 'distance field to the given goal tiles; when avoiding route around visible enemy champions (wider buffer for ranged), then their tiles only, then the plain field')
def goal_field(g: Tiles, avoid: Bool) -> Field:
    if avoid:
        occ = enemy_tiles()
        if size(occ) > 0:
            av = occ
            for u in enemies():
                if u.is_champion:
                    av = av | near(u.pos, 2 if u.attack_range <= 1 else 3)
            mp = me().pos
            mine = near(mp, 0)
            av = av - mine
            f = field_avoid(g, av, g - g)
            if at(f, mp) < 100000000:
                return f
            f2 = field_avoid(g, occ - mine, g - g)
            if at(f2, mp) < 100000000:
                return f2
    return field(g)

@gene('Z72a', 'how much closer a step brings me to the goals (cached field; own value computed once per pass); unreachable reads as no progress', parents=['s4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = my_goal_dist()
    if here >= 1000000:
        return 1
    return here - there

@gene('Z456a', 'my own goal-field value, from the cached value unless I moved this turn; zero-argument so computed once per pass', parents=['Z72a'])
def my_goal_dist() -> Num:
    p = me().pos
    if not valid(HERE_T) or dist(p, HERE_T) != 0:
        return at(GF, p)
    return HERE

@gene('Z329b', 'note an enemy champion within 4 tiles; heal when badly hurt, outmatched, or hurt while carrying many gems (stop at 94%); recompute the goal field only when the goal set changes or avoidance is needed with a champion in sight; cache own value; reset while dead', parents=['Z273a', 'Z318a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        mp = me().pos
        seen = False
        FIGHT = False
        for u in enemies():
            if u.is_champion:
                seen = True
                if dist(u.pos, mp) <= 4:
                    FIGHT = True
        if hf < 0.4:
            HEALING = True
        elif hf < 0.8:
            tr = threat_ratio()
            if hf < 0.63 and tr > 1.2:
                HEALING = True
            elif tr > 2.5:
                HEALING = True
            elif gems() >= 30 and hf < 0.55:
                HEALING = True
        if hf >= 0.94:
            HEALING = False
        if HEALING:
            tg = my_spawn()
        else:
            tg = goals()
        if size(tg) == 0:
            tg = camp_spawns()
        avoid = seen and (HEALING or gems() >= 10 or hf < 0.6)
        if avoid or not GOK or size(tg - GT) > 0 or size(GT - tg) > 0:
            GF = goal_field(tg, avoid)
            GT = tg
            GOK = not avoid
        HERE_T = mp
        HERE = at(GF, HERE_T)
    else:
        HEALING = False
        FIGHT = False
        GOK = False

@gene('Z38a', 'Lanchester-style threat: nearby enemy champions (ranged counted farther) damage times health over my own plus nearby allied; returns 0 without querying allies when no enemy champion is near (cheaper)', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mp = m.pos
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and u.is_enemy and dist(u.pos, mp) <= (5 if u.attack_range <= 1 else 7))
    if theirs <= 0:
        return 0
    mine = (m.strength + m.focus) * m.health_frac + 0.9044
    help = sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, mp) <= 4 and dist(a.pos, mp) > 0)
    return theirs / (mine + 0.6 * help)

@gene('Z294a', 'far from home (cached walk distance to spawn while healing, else straight line), no visible enemy champion within 6 tiles and no awake camp within 3: recall is unlikely to be cancelled', parents=['s1'])
def safe_recall() -> Bool:
    m = me()
    p = m.pos
    if HEALING:
        d = HERE
        if not valid(HERE_T) or dist(p, HERE_T) != 0:
            d = at(GF, p)
        if d < 10:
            return False
    elif dist(p, nearest(my_spawn(), p)) < 12:
        return False
    if any(u.is_champion and dist(u.pos, p) <= 6 for u in enemies()):
        return False
    return not any(dist(u.pos, p) <= 4 and is_awake(u) for u in camps())
