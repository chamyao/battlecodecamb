"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None

@gene('Z80a', 'value of doing this option now; ladder draft (HoR first), focus low enemies, shield/heal thresholds, dash toward goals, recall at 40%', parents=['Z56a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == HEART_OF_RUIN:
            return 8
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + (1 - o.unit.health_frac) * 4
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 65
            return 0
        if k == AB_SHIELD:
            return 75 if me().health_frac < 0.65 else 0
        if k == AB_HEAL:
            return 75 if me().health_frac < 0.7 else 0
        if k == AB_DASH:
            if valid(o.tile):
                return 55 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar once carrying enough gems (or hurt/late), else a living camp group, skipping monoliths before round 1000')
def goals() -> Tiles:
    g0 = gems()
    if g0 > 0:
        bank = g0 >= 15 or me().health_frac < 0.6 or round() > 1800
        if bank:
            acc = near(tile(-5, -5), 0)
            for a in altars() - locked_altars():
                acc = acc | near(a, 1)
            if size(acc) > 0:
                return acc
    acc = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    late = round() >= 1000
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                acc = acc | gt
    return acc

@gene('Z56b', 'distance field to the goals; walk home and heal (with hysteresis) when hurt without gems', parents=['s3'])
def goal_field() -> Field:
    if HEALING and gems() == 0:
        return field(my_spawn())
    g = goals()
    if size(g) == 0:
        g = camp_spawns()
    return field(g)

@gene('Z56c', 'how much closer a step brings me to the goals (cached field); unreachable is no progress; penalise tiles near enemies when hurt', parents=['s4'])
def progress(t: Tile) -> Num:
    here = at(GF, me().pos)
    there = at(GF, t)
    if here >= 1000000 or there >= 1000000:
        return 0
    d = here - there
    if t in DANGER:
        return d - 2
    return d

@gene('Z80b', 'once per turn: healing hysteresis (start <40%, stop >=95%), danger tiles near enemy champions when hurt, goal field; skip while dead', parents=['Z56d', 'Z6a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        if hf >= 0.95:
            HEALING = False
        DANGER = DANGER - DANGER
        if hf < 0.6:
            for u in enemies():
                if u.is_champion:
                    DANGER = DANGER | near(u.pos, 2)
        GF = goal_field()
