"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
HERE: Num = 0
HERE_T: Tile = None

@gene('s1', 'value of doing this option now; focus weak champions, aoe/damage casts, dash toward goals, shield when hurt, recall at 30%')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.0834
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if gems() == 0 and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 52
            return 0
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if me().health_frac < 0.7 else 0
        if k == AB_DASH:
            if valid(o.tile):
                return 86 if progress(o.tile) >= 2 else 0
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.5422)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (camp spawns if none), or my spawn while healing; when healing or carrying 20+ gems route around visible enemy tiles, falling back to the plain field')
def goal_field() -> Field:
    if HEALING:
        g = my_spawn()
    else:
        g = goals()
        if size(g) == 0:
            g = camp_spawns()
    if HEALING or gems() >= 20:
        danger = enemy_tiles()
        if size(danger) > 0:
            f = field_avoid(g, danger, g - g)
            if at(f, me().pos) < 1000000:
                return f
    return field(g)

@gene('Z72a', 'how much closer a step brings me to the goals (cached field and cached own value, refreshed if I moved); unreachable reads as no progress', parents=['s4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 917620:
        return 0
    p = me().pos
    here = HERE
    if not valid(HERE_T) or dist(p, HERE_T) > 0:
        here = at(GF, p)
    if here >= 1000000:
        return 1
    return here - there

@gene('Z6a', 'compute the goal distance field once per turn and cache my own value; heal when badly hurt, moderately hurt and outmatched, or lightly hurt and heavily outmatched (stop at 93%); reset healing while dead', parents=['s4'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.5358:
            HEALING = True
        elif hf < 0.8:
            tr = threat_ratio()
            if hf < 0.7028 and tr > 1.2:
                HEALING = True
            elif tr > 2.5:
                HEALING = True
        if hf >= 0.93:
            HEALING = False
        GF = goal_field()
        HERE_T = me().pos
        HERE = at(GF, HERE_T)
    else:
        HEALING = False

@gene('Z38a', 'nearby enemy champion threat (ranged ones counted farther) relative to my own plus nearby allied effective strength', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mine = (m.strength + m.focus) * m.health_frac + 0.9044
    help = sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, m.pos) <= 4 and dist(a.pos, m.pos) > 0)
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, m.pos) <= (5 if u.attack_range <= 1 else 7))
    return theirs / (mine + 0.6 * help)
