"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None

@gene('s1', 'value of doing this option now; focus weak champions, aoe/damage casts, dash toward goals, shield when hurt, recall at 30%')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if gems() == 0 and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 65
            return 0
        if k == AB_SHIELD or k == AB_HEAL:
            return 75 if me().health_frac < 0.7 else 0
        if k == AB_DASH:
            if valid(o.tile):
                return 55 if progress(o.tile) >= 2 else 0
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: a cleared group waiting for capture (unless carrying 40+ gems), else an altar when carrying 25+ gems (any gems late or with nothing to farm), else a living camp group with loot (monoliths only after round 1200)')
def goals() -> Tiles:
    carry = gems()
    empty = near(tile(-5, -5), 0)
    rew = empty
    live = empty
    rich = empty
    late = round() >= 1200
    for g in range(num_groups()):
        ts = group_tiles(g)
        if group_reward(g):
            rew = rew | ts
        elif not group_respawning(g):
            if late or not any(spawn_type(t) == MONOLITH for t in ts):
                live = live | ts
                if group_gems(g) + group_gold(g) > 0:
                    rich = rich | ts
    if size(rew) > 0 and carry < 40:
        return rew
    if size(rich) > 0:
        live = rich
    if carry > 0:
        if carry >= 25 or size(live) == 0 or round() >= 1800:
            acc = empty
            for a in altars() - locked_altars():
                acc = acc | near(a, 1)
            if size(acc) > 0:
                return acc
    return live

@gene('s3', 'distance field to the goals (camp spawns if none) or my spawn while healing; when healing or carrying 20+ gems route around visible enemy champions (wider for ranged), then their tiles only, then the plain field')
def goal_field() -> Field:
    g = goals()
    if HEALING:
        g = my_spawn()
    if size(g) == 0:
        g = camp_spawns()
    if HEALING or gems() >= 20:
        occ = enemy_tiles()
        if size(occ) > 0:
            av = occ
            for u in enemies():
                if u.is_champion:
                    av = av | near(u.pos, 2 if u.attack_range <= 1 else 3)
            mine = near(me().pos, 0)
            f = field_avoid(g, av - mine, g - g)
            if at(f, me().pos) < 100000000:
                return f
            f2 = field_avoid(g, occ - mine, g - g)
            if at(f2, me().pos) < 100000000:
                return f2
    return field(g)

@gene('Z72a', 'how much closer a step brings me to the goals (cached field); unreachable reads as no progress; while hurt, steps into enemy champion reach are discounted', parents=['s4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = at(GF, me().pos)
    if here >= 1000000:
        return 1
    d = here - there
    if size(DANGER) > 0 and t in DANGER:
        d -= 0.8
    return d

@gene('Z6a', 'compute the goal distance field once per turn; heal when badly hurt or moderately hurt and outmatched (stop at 93%); mark tiles in reach of visible enemy champions while hurt; reset healing while dead', parents=['s4'])
def update() -> None:
    DANGER = DANGER - DANGER
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        elif hf < 0.65 and threat_ratio() > 1.2:
            HEALING = True
        if hf >= 0.93:
            HEALING = False
        if HEALING or hf < 0.65:
            for u in enemies():
                if u.is_champion:
                    DANGER = DANGER | near(u.pos, u.attack_range + 1)
        GF = goal_field()
    else:
        HEALING = False

@gene('Z38a', 'nearby enemy champion threat relative to my own plus nearby allied effective strength', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mine = (m.strength + m.focus) * m.health_frac + 1
    help = sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, m.pos) <= 4 and dist(a.pos, m.pos) > 0)
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, m.pos) <= 5)
    return theirs / (mine + 0.6 * help)
