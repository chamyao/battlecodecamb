"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None

@gene('Z178a', 'value of doing this option now; ladder draft, focus low enemies, dash toward goals, shield/heal when hurt, recall when low (B-tuned threshold)', parents=['Z138a', 'Z165a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == HEART_OF_RUIN:
            return 8
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.2878 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + (1 - o.unit.health_frac) * 4
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 65
            return 0
        if k == AB_SHIELD or k == AB_HEAL:
            return 96 if me().health_frac < 0.7 else 0
        if k == AB_DASH:
            if valid(o.tile):
                return 55 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z178b', 'skip option kinds the score never values (wards, locks, cancel) to save fuel')
def consider(kind: Num) -> Bool:
    return not (kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL)

@gene('s2', 'where to walk: an altar with gems, else a living camp group worth gems/gold (monoliths only after round 1000)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    rest = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    late = round() >= 1000
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                if group_gems(g) + group_gold(g) > 0 or group_reward(g):
                    acc = acc | gt
                else:
                    rest = rest | gt
    if size(acc) > 0:
        return acc
    return rest

@gene('Z138b', 'distance field to the goals or my spawn while healing (healing only when gemless); when healing or carrying 20+ gems, route around visible enemy champions, falling back to plain field', parents=['s3', 'Z56b'])
def goal_field() -> Field:
    heal = HEALING and gems() == 0
    g = goals()
    if heal:
        g = my_spawn()
    if size(g) == 0:
        g = camp_spawns()
    if heal or gems() >= 20:
        occ = enemy_tiles()
        if size(occ) > 0:
            av = occ
            for u in enemies():
                if u.is_champion:
                    av = av | near(u.pos, 2)
            av = av - near(me().pos, 0)
            f = field_avoid(g, av, g - g)
            if at(f, me().pos) < 100000000:
                return f
            f2 = field_avoid(g, occ, g - g)
            if at(f2, me().pos) < 100000000:
                return f2
    return field(g)

@gene('Z75a', 'how much closer a step brings me to the goals (cached field); unreachable reads as no progress; penalise danger tiles, reward leaving danger', parents=['Z72a', 's4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = at(GF, me().pos)
    if here >= 1000000:
        return 1
    d = here - there
    inside = me().pos in DANGER
    if t in DANGER:
        if inside:
            return d - 1
        return d - 2
    if inside:
        return d + 1
    return d

@gene('Z178c', 'once per turn: healing hysteresis (B thresholds), danger tiles near enemy champions when hurt, goal field; reset healing while dead', parents=['Z138c', 'Z165b'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        elif hf < 0.62 and threat_ratio() > 1.25:
            HEALING = True
        if hf >= 0.94:
            HEALING = False
        DANGER = DANGER - DANGER
        if hf < 0.6:
            for u in enemies():
                if u.is_champion:
                    DANGER = DANGER | near(u.pos, 2 if u.attack_range <= 1 else 3)
        GF = goal_field()
    else:
        HEALING = False

@gene('Z38a', 'nearby enemy champion threat relative to my own plus nearby allied effective strength', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mine = (m.strength + m.focus) * m.health_frac + 1
    help = sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, m.pos) <= 4 and dist(a.pos, m.pos) > 0)
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, m.pos) <= 5)
    return theirs / (mine + 0.6 * help)
