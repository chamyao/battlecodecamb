"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
HERE: Num = 0
HERE_T: Tile = None

@gene('Z275a', 'value of doing this option now; ladder draft, aoe/damage/cc casts, dash toward goals, shield when hurt, recall at 29% or when healing far from home; focus low-health and gem-carrying enemy champions; while healing, retreat steps beat fights unless the target is nearly dead', parents=['Z255a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == HEART_OF_RUIN:
            return 8
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.29:
            return 90
        if HEALING and safe_far_from_home():
            return 88
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEALING and o.unit.health_frac > 0.25:
                return 40
            return 80 + 8 * (1 - o.unit.health_frac) + min(unit_gems(o.unit) / 20, 2)
        if HEALING:
            return 0
        if gems() == 0 and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0 and not HEALING and me().health_frac > 0.3:
                    return 65
            return 0
        if k == AB_SHIELD or k == AB_HEAL:
            return 96 if me().health_frac < 0.7 else 0
        if k == AB_DASH:
            if valid(o.tile):
                p = progress(o.tile)
                if p >= 2:
                    return 94 if HEALING else 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 93 if HEALING else 50
        return 0
    return 0

@gene('Z300a', 'skip listing option kinds that score() never values (wards, locks, cancels), purchases we cannot afford, tributes without gems and recalls that score() would reject', parents=['Z275a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return gold() >= 30
    if kind == TRIBUTE:
        return gems() > 0
    if kind == RECALL:
        return HEALING or me().health_frac < 0.29
    return True

@gene('s2', 'where to walk: a cleared group waiting for capture (unless carrying 40+ gems), else an altar with gems, else a living non-monolith camp group (monolith only late)')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() < 40:
        for g in range(num_groups()):
            if group_reward(g):
                acc = acc | group_tiles(g)
        if size(acc) > 0:
            return acc
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    mono = type_spawns(MONOLITH)
    late = round() >= 1100
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                acc = acc | gt
    return acc

@gene('s3', 'distance field to the goals (camp spawns if none) or my spawn while healing (goals skipped then); when healing or carrying 20+ gems route around visible enemy champions (wider buffer for ranged), then their tiles only, then the plain field')
def goal_field() -> Field:
    if HEALING:
        g = my_spawn()
    else:
        g = goals()
    if size(g) == 0:
        g = camp_spawns()
    if HEALING or gems() >= 20:
        occ = enemy_tiles()
        if size(occ) > 0:
            av = occ
            for u in enemies():
                if u.is_champion:
                    av = av | near(u.pos, 2 if u.attack_range <= 1 else 3)
            mine = near(me().pos, 0)
            av = av - mine
            f = field_avoid(g, av, g - g)
            if at(f, me().pos) < 100000000:
                return f
            f2 = field_avoid(g, occ - mine, g - g)
            if at(f2, me().pos) < 100000000:
                return f2
    return field(g)

@gene('Z72a', 'how much closer a step brings me to the goals (cached field and cached own value, refreshed if I moved); unreachable reads as no progress', parents=['s4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = HERE
    p = me().pos
    if not valid(HERE_T) or dist(p, HERE_T) != 0:
        here = at(GF, p)
    if here >= 1000000:
        return 1
    return here - there

@gene('Z251a', 'far from my spawn and no visible enemy champion within 6 tiles: a recall is unlikely to be cancelled and saves the walk', parents=['s1'])
def safe_far_from_home() -> Bool:
    p = me().pos
    s = nearest(my_spawn(), p)
    if not valid(s) or dist(p, s) <= 8:
        return False
    return not any(u.is_champion and dist(u.pos, p) <= 6 for u in enemies())

@gene('Z318a', 'compute the goal distance field once per turn and cache my own value; heal below ~45%, moderately hurt and outmatched, or hurt while carrying many gems (stop at 93%); reset healing while dead', parents=['Z300b', 'Z296a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        g = gems()
        if hf < 0.45:
            HEALING = True
        elif hf < 0.65 and threat_ratio() > 1.2:
            HEALING = True
        elif g >= 30 and hf < 0.55:
            HEALING = True
        if hf >= 0.93:
            HEALING = False
        GF = goal_field()
        HERE_T = me().pos
        HERE = at(GF, HERE_T)
    else:
        HEALING = False

@gene('Z38a', 'nearby enemy champion threat (ranged ones counted from farther) relative to my own plus nearby allied effective strength; skips the allies query when no enemy champion is near', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mp = m.pos
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, mp) <= (5 if u.attack_range <= 1 else 7))
    if theirs <= 0:
        return 0
    mine = (m.strength + m.focus) * m.health_frac + 1
    help = sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, mp) <= 4 and dist(a.pos, mp) > 0)
    return theirs / (mine + 0.6 * help)
