"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None

@gene('Z193a', 'value of doing this option now; draft priorities, focus low enemies, aoe/damage casts, dash toward goals, shield/heal when hurt, recall when low', parents=['Z73a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 5
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 4
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.33 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 88 + (1 - o.unit.health_frac) * 8
        if gems() == 0 and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 65
            return 0
        if k == AB_SHIELD or k == AB_HEAL:
            return 96 if me().health_frac < 0.65 else 0
        if k == AB_DASH:
            if valid(o.tile):
                return 55 if progress(o.tile) >= 2 else 0
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living camp group worth gems/gold (monoliths only after round 1000 and with 2+ allied champions nearby)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    rest = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    late = False
    if round() >= 1000:
        p = me().pos
        late = count(a.is_champion and dist(a.pos, p) <= 6 and dist(a.pos, p) > 0 for a in allies()) >= 2
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                if group_gems(g) + group_gold(g) > 0 or group_reward(g):
                    acc = acc | gt
                else:
                    rest = rest | gt
    if size(acc) > 0:
        return acc
    return rest

@gene('Z56b', 'distance field to the goals (camp spawns if none) or my spawn when healing without gems; when healing or carrying 20+ gems route around the given enemy buffer, then enemy tiles only, then the plain field', parents=['s3'])
def goal_field(av: Tiles) -> Field:
    g = goals()
    if HEALING and gems() == 0:
        g = my_spawn()
    if size(g) == 0:
        g = camp_spawns()
    if (HEALING or gems() >= 20) and size(av) > 0:
        mine = near(me().pos, 0)
        f = field_avoid(g, av - mine, g - g)
        if at(f, me().pos) < 100000000:
            return f
        occ = enemy_tiles() - mine
        if size(occ) > 0:
            f2 = field_avoid(g, occ, g - g)
            if at(f2, me().pos) < 100000000:
                return f2
    return field(g)

@gene('Z75a', 'how much closer a step brings me to the goals (cached field); unreachable reads as no progress; penalise danger tiles, reward leaving danger', parents=['Z72a', 's4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = at(GF, me().pos)
    if here >= 1000000:
        return 1
    d = here - there
    inside = me().pos in DANGER
    if t in DANGER:
        if inside:
            return d - 1
        return d - 2
    if inside:
        return d + 1
    return d

@gene('Z193b', 'once per turn: healing hysteresis (start <40% or <60% when outmatched, stop >=93%), one pass over enemy champions builds the avoid set (danger tiles when hurt), goal field; reset healing while dead', parents=['Z85a', 'Z6a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        elif hf < 0.6 and threat_ratio() > 1.25:
            HEALING = True
        if hf >= 0.93:
            HEALING = False
        av = DANGER - DANGER
        for u in enemies():
            if u.is_champion:
                av = av | near(u.pos, 2 if u.attack_range <= 1 else 3)
        if hf < 0.6:
            DANGER = av
        else:
            DANGER = av - av
        GF = goal_field(av)
    else:
        HEALING = False

@gene('Z38a', 'nearby enemy champion threat relative to my own plus nearby allied effective strength', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mine = (m.strength + m.focus) * m.health_frac + 1
    help = sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, m.pos) <= 4 and dist(a.pos, m.pos) > 0)
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, m.pos) <= 5)
    return theirs / (mine + 0.6 * help)
