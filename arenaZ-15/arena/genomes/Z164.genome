"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
DANGER: Tiles = None

@gene('Z168a', 'value of doing this option now; ladder draft, treasure then strength shards, focus low enemies, damage/cc/aoe casts, dash toward goals, shield when hurt or in close fights, recall when low or retreating hurt', parents=['Z97a', 'Z73a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == HEART_OF_RUIN:
            return 8
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        if o.item == 6:
            return 100
        if round() > 400 and item_strength(o.item) > 0:
            return 40
        return 0
    if o.kind == RECALL:
        hf = me().health_frac
        if hf < 0.2878:
            return 90
        if HEALING and hf < 0.45:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + (1 - o.unit.health_frac) * 4
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 65
            elif k == AB_AOE and valid(o.tile):
                if any(u.is_champion and dist(u.pos, o.tile) <= slot_radius(o.slot) for u in enemies()):
                    return 84
            return 0
        if k == AB_SHIELD or k == AB_HEAL:
            hf = me().health_frac
            if hf < 0.7:
                return 96
            if k == AB_SHIELD and hf < 0.95:
                if any(u.is_champion and dist(u.pos, me().pos) <= 3 for u in enemies()):
                    return 88
            return 0
        if k == AB_DASH:
            if valid(o.tile):
                return 55 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals or to my spawn while healing; when healing or carrying 20+ gems, route around a 2-tile buffer of visible enemy champions, falling back to avoiding only their tiles, then to the plain field')
def goal_field() -> Field:
    g = goals()
    if HEALING:
        g = my_spawn()
    if HEALING or gems() >= 20:
        occ = enemy_tiles()
        if size(occ) > 0:
            av = occ
            for u in enemies():
                if u.is_champion:
                    av = av | near(u.pos, 2)
            av = av - near(me().pos, 0)
            f = field_avoid(g, av, g - g)
            if at(f, me().pos) < 100000000:
                return f
            f2 = field_avoid(g, occ, g - g)
            if at(f2, me().pos) < 100000000:
                return f2
    return field(g)

@gene('Z75a', 'how much closer a step brings me to the goals (cached field); unreachable reads as no progress; penalise danger tiles, reward leaving danger', parents=['Z72a', 's4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = at(GF, me().pos)
    if here >= 1000000:
        return 1
    d = here - there
    inside = me().pos in DANGER
    if t in DANGER:
        if inside:
            return d - 1
        return d - 2
    if inside:
        return d + 1
    return d

@gene('Z168b', 'once per turn: healing hysteresis (start <40% or <60% when outmatched, stop >=95%), danger tiles near enemy champions when hurt, goal field; reset healing while dead', parents=['Z6a', 'Z85a'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        elif hf < 0.6 and threat_ratio() > 1.3:
            HEALING = True
        if hf >= 0.95:
            HEALING = False
        DANGER = DANGER - DANGER
        if hf < 0.6:
            for u in enemies():
                if u.is_champion:
                    DANGER = DANGER | near(u.pos, 2)
        GF = goal_field()
    else:
        HEALING = False

@gene('Z38a', 'nearby enemy champion threat relative to my own plus nearby allied effective strength', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mine = (m.strength + m.focus) * m.health_frac + 1
    help = sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, m.pos) <= 4 and dist(a.pos, m.pos) > 0)
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, m.pos) <= 5)
    return theirs / (mine + 0.6 * help)
