"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
HERE: Num = 0
HERE_T: Tile = None
TR: Num = 0
NEAR_E: Bool = False

@gene('Z275a', 'value of doing this option now; ladder draft, aoe/damage/cc casts, dash toward goals, shield when hurt or on cooldown in fights, recall at 29% or when healing far from home; avoid trading into healthy champions when clearly outmatched (cached threat ratio)', parents=['Z255a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == HEART_OF_RUIN:
            return 8
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.29:
            return 90
        if HEALING and safe_far_from_home():
            return 88
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEALING and o.unit.health_frac > 0.25:
                return 40
            if TR > 1.6 and o.unit.health_frac > 0.5:
                return 30
            return 80 + 10 * (1 - o.unit.health_frac)
        if HEALING:
            return 0
        if gems() == 0 and me().health_frac > 0.3:
            return 60
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 85
                if o.unit.is_camp and gems() == 0 and not HEALING:
                    return 65
            return 0
        if k == AB_SHIELD or k == AB_HEAL:
            hf = me().health_frac
            if hf < 0.7:
                return 96
            if TR > 1.2 and hf < 0.85:
                return 96
            if k == AB_SHIELD and NEAR_E and hf < 0.97:
                return 96
            return 0
        if k == AB_DASH:
            if valid(o.tile):
                p = progress(o.tile)
                if p >= 2:
                    return 94 if HEALING else 55
            return 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 93 if HEALING else 50
        return 0
    return 0

@gene('Z300a', 'skip listing option kinds that score() never values (wards, locks, cancels) to save fuel', parents=['Z275a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    return True

@gene('s2', 'where to walk: a cleared group waiting for capture (unless carrying 40+ gems), else an altar with gems, else a living non-monolith camp group (monolith only late)')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() < 40:
        for g in range(num_groups()):
            if group_reward(g):
                acc = acc | group_tiles(g)
        if size(acc) > 0:
            return acc
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    mono = type_spawns(MONOLITH)
    late = round() >= 1100
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                acc = acc | gt
    return acc

@gene('s3', 'distance field to the goals (camp spawns if none) or my spawn while healing; when healing or carrying 20+ gems route around visible enemy champions (wider buffer for ranged), then their tiles only, then the plain field')
def goal_field() -> Field:
    g = goals()
    if HEALING:
        g = my_spawn()
    if size(g) == 0:
        g = camp_spawns()
    if HEALING or gems() >= 20:
        occ = enemy_tiles()
        if size(occ) > 0:
            av = occ
            for u in enemies():
                if u.is_champion:
                    av = av | near(u.pos, 2 if u.attack_range <= 1 else 3)
            mine = near(me().pos, 0)
            av = av - mine
            f = field_avoid(g, av, g - g)
            if at(f, me().pos) < 100000000:
                return f
            f2 = field_avoid(g, occ - mine, g - g)
            if at(f2, me().pos) < 100000000:
                return f2
    return field(g)

@gene('Z72a', 'how much closer a step brings me to the goals (cached field and cached own value, refreshed if I moved); unreachable reads as no progress', parents=['s4'])
def progress(t: Tile) -> Num:
    there = at(GF, t)
    if there >= 1000000:
        return 0
    here = HERE
    p = me().pos
    if not valid(HERE_T) or dist(p, HERE_T) != 0:
        here = at(GF, p)
    if here >= 1000000:
        return 1
    return here - there

@gene('Z251a', 'far from my spawn by walk (cached healing field) and no visible enemy champion within 6 or awake camp within 4 tiles: a recall is unlikely to be cancelled and saves the walk', parents=['s1'])
def safe_far_from_home() -> Bool:
    p = me().pos
    d = HERE
    if not HEALING or not valid(HERE_T) or dist(p, HERE_T) != 0:
        s = nearest(my_spawn(), p)
        if not valid(s):
            return False
        d = dist(p, s)
    if d <= 8:
        return False
    if any(u.is_champion and dist(u.pos, p) <= 6 for u in enemies()):
        return False
    return not any(is_awake(c) and dist(c.pos, p) <= 4 for c in camps())

@gene('Z300b', 'compute the goal distance field once per turn and cache my own value, the threat ratio and whether an enemy champion is within 4 tiles; heal below ~45% or moderately hurt and outmatched (stop at 93%); reset healing while dead', parents=['Z6a'])
def update() -> None:
    if alive():
        m = me()
        hf = m.health_frac
        TR = threat_ratio()
        NEAR_E = any(u.is_champion and dist(u.pos, m.pos) <= 4 for u in enemies())
        if hf < 0.45:
            HEALING = True
        elif hf < 0.65 and TR > 1.2:
            HEALING = True
        if hf >= 0.93:
            HEALING = False
        GF = goal_field()
        HERE_T = m.pos
        HERE = at(GF, HERE_T)
    else:
        HEALING = False
        NEAR_E = False
        TR = 0

@gene('Z38a', 'nearby enemy champion threat (ranged ones counted farther, awake camps close by counted partly) relative to my own plus nearby allied effective strength', parents=['Z6a'])
def threat_ratio() -> Num:
    m = me()
    mine = (m.strength + m.focus) * m.health_frac + 1
    help = sum((a.strength + a.focus) * a.health_frac for a in allies() if a.is_champion and dist(a.pos, m.pos) <= 5 and dist(a.pos, m.pos) > 0)
    theirs = sum((u.strength + u.focus) * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, m.pos) <= 4 + u.attack_range)
    if theirs > 0:
        theirs += 0.5 * sum(c.strength * c.health_frac for c in camps() if is_awake(c) and dist(c.pos, m.pos) <= 3)
    return theirs / (mine + 0.6 * help)
