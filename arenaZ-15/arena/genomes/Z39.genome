"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
ET: Tiles = None

@gene('s1', 'value of doing this option now; draft preference and ability use')
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 5
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.42 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_champion and o.unit.is_enemy:
                    return 107
                if o.unit.is_camp and gems() == 0:
                    return 88
            return 0
        if k == AB_SHIELD:
            return 75 if me().health_frac < 0.8 else 0
        if k == AB_HEAL:
            return 73 if me().health_frac < 0.6 else 0
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a cleared group to capture, else a living non-monolith camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
        for a in altars():
            acc = acc | near(a, 1)
        return acc
    reward = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            reward = reward | group_tiles(g)
        elif not group_respawning(g):
            gt = group_tiles(g)
            if not any(spawn_type(t) == MONOLITH for t in gt):
                acc = acc | gt
    if size(reward) > 0:
        return reward
    return acc

@gene('s3', 'distance field to the goals, or to my spawn while healing')
def goal_field() -> Field:
    if HEALING:
        return field(my_spawn())
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached field); while healing avoid stepping next to enemies')
def progress(t: Tile) -> Num:
    base = at(GF, me().pos) - at(GF, t)
    if HEALING and size(ET) > 0:
        e = nearest(ET, t)
        if valid(e):
            if dist(e, t) <= 2:
                base -= 0.6
    return base

@gene('Z8a', 'compute the goal distance field and visible enemy tiles once per turn; when badly hurt walk home to heal until nearly full; skip while dead', parents=['s4'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.4:
            HEALING = True
        if hf >= 0.95:
            HEALING = False
        GF = goal_field()
        if HEALING:
            ET = enemy_tiles()
        else:
            ET = my_spawn() - my_spawn()
