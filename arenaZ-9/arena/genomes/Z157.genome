"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene('s1', 'value of doing this option now: draft top picks, cast abilities, heal on spawn, rank moves by progress', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 5
        if o.champ == HEART_OF_RUIN:
            return 4
        if o.champ == MARCELLA:
            return 3
        if o.champ == VENDETTA:
            return 2
        if o.champ == RYTH:
            return 1.5
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        if me().health_frac < 0.9 and me().pos in my_spawn():
            return 0
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: home to heal when hurt, an altar with gems, else a cleared group awaiting capture, else a living camp group with gems or gold, else any living group', parents=['s2'])
def goals() -> Tiles:
    if me().health_frac < 0.35:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    rich = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) + group_gold(g) > 0:
            rich = rich | group_tiles(g)
    if size(rich) > 0:
        return rich
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn)', parents=['s3'])
def goal_field() -> Field:
    return GOAL_F

@gene('s4', 'progress toward goals, minus a penalty for steps near enemy champions', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    d0 = at(f, me().pos)
    d1 = at(f, t)
    bonus = 3 if d1 < 1 else 0
    threat = sum(u.strength for u in enemies() if u.is_champion and dist(u.pos, t) <= 3)
    return d0 - d1 + bonus - 0.2 * threat

@gene('Z130a', 'value of casting an ability: heal/shield scale with low health, damage/cc on enemy champions favour wounded targets with a finishing bonus, dash value scales with progress toward goals', parents=['s1', 'Z141a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        h = me().health_frac
        if h < 0.5:
            return 80
        return 65 if h < 0.7 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                fin = 20 if o.unit.health_frac < 0.25 else 0
                return 85 + (1 - o.unit.health_frac) * 30 + fin
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p > 2:
                return 40 + 2 * min(p, 6)
        return 0
    return 0

@gene('Z34a', 'compute the goal distance field once per turn, routing around walls and holes', parents=['s3'])
def update() -> None:
    GOAL_F = field_avoid(goals(), walls() | holes(), walls() & holes())
