"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene("Z358a", "value of doing this option now: draft top picks, buy, recall when low, attack champions, tribute, cast abilities, rank moves by threat-aware progress (doubled while healing); moves ending near enemy champions lose value when below 60% health", parents=["Z318a", "s1", "Z397a", "Z351a"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 5
        if o.champ == HEART_OF_RUIN:
            return 4
        if o.champ == MARCELLA:
            return 3
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 1.5
        return 0.4428
    if o.kind == BUY:
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 120
        return 58 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 103
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        if me().health_frac < 0.9 and me().pos in my_spawn():
            return 0
        p = progress(o.tile)
        if p <= 0:
            return 0
        pen = 0
        if me().health_frac < 0.6:
            pen = 20 * min(1, count(dist(u.pos, o.tile) <= 3 for u in enemies() if u.is_champion))
        if HEALING:
            return 50 + 2 * p - pen
        return 50 + p - pen
    return 0

@gene("Z344b", "where to walk: home to heal when hurt (hysteresis) or outnumbered below 60% health, an altar with gems, else a cleared group awaiting capture, else a living non-monolith camp group, else home", parents=["s2", "Z397b", "Z344b"])
def goals() -> Tiles:
    hf = me().health_frac
    if HEALING or hf < 0.35:
        return my_spawn()
    if hf < 0.6:
        threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 6)
        if threat >= 2:
            return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            if not (valid(t0) and spawn_type(t0) == MONOLITH):
                acc = acc | gt
    if size(acc) > 0:
        return acc
    return my_spawn()

@gene("s3", "distance field to the goals, routed around walls, holes, non-goal camps and enemy champions (cached once per turn in update)", parents=["s3", "Z34a"])
def goal_field() -> Field:
    return GF

@gene("Z371b", "how much closer a step brings me to the goals (clamped to +-5, bonus for stepping onto a goal; 0 when cut off); when healing no danger adjustment; when below 50% health minus a penalty per enemy within 3 of the step; otherwise halved when the step lands in reach of a healthy enemy champion", parents=["Z358b", "Z371b", "Z344c"])
def progress(t: Tile) -> Num:
    d0 = at(goal_field(), me().pos)
    if d0 > 100000000:
        return 0
    d1 = at(goal_field(), t)
    bonus = 2 if d1 < 1 else 0
    p = max(-5, min(5, d0 - d1 + bonus))
    if HEALING:
        return p
    if me().health_frac < 0.5:
        return p - sum(3 for u in enemies() if dist(u.pos, t) <= 3)
    if p > 0 and any(e.is_champion and e.health_frac > 0.5 and dist(e.pos, t) <= e.attack_range + 1 for e in enemies()):
        return p * 0.5
    return p

@gene("Z318c", "once per turn: track heal hysteresis (retreat below 0.45, resume above 0.9) and compute the routed goal distance field that routes around walls, holes, non-goal camps and enemy-occupied tiles", parents=["Z75a", "Z34a", "Z356a"])
def update() -> None:
    hf = me().health_frac
    if hf < 0.45:
        HEALING = True
    elif hf > 0.9:
        HEALING = False
    GF = field_avoid(goals(), walls() | holes() | (camp_tiles() - goals()) | (enemy_tiles() - goals()), walls() & holes())

@gene("Z371c", "value of casting an ability: heal/shield scale with low health, damage/cc on enemy champions favour wounded targets (finisher bonus), dash value grows with progress toward goals while health above 40% (floor 45 for real progress, bonus while healing)", parents=["Z197a", "Z371c", "Z141a", "Z397c"])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        h = me().health_frac
        if h < 0.3:
            return 95
        if h < 0.5:
            return 78
        return 68 if h < 0.7 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if o.unit.health_frac < 0.3:
                    return 110
                return 85 + (1 - o.unit.health_frac) * 25
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            if p >= 2:
                v = max(25 + 6 * min(p, 10), 45)
                if HEALING:
                    v += 15
                return v
        return 0
    return 0
