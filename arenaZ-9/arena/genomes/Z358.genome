"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
GT: Tiles

@gene('Z489a', 'value of doing this option now: draft top picks, buy, recall when low, attack champions (prefer wounded ones), tribute, cast abilities, rank moves by progress (doubled while healing)', parents=['Z318a', 'Z371a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 9
        if o.champ == HEART_OF_RUIN:
            return 4
        if o.champ == MARCELLA:
            return 3
        if o.champ == VENDETTA:
            return 2.5
        if o.champ == RYTH:
            return 1.5
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 139 + 40 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 103
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        if me().health_frac < 0.9 and me().pos in my_spawn():
            return 0
        p = progress(o.tile)
        if p <= 0:
            return 0
        if HEALING:
            return 50 + 2 * p
        return 50 + p
    return 0

@gene('s3', 'distance field to the goals, routed around walls and holes (cached once per turn in update)', parents=['s3'])
def goal_field() -> Field:
    return GF

@gene('Z489b', 'how much closer a step brings me to the goals (clamped to +-5, bonus for stepping onto a goal; 0 when cut off), minus a penalty per enemy champion within 2 of the step and per enemy monster adjacent to the step (heavier while healing); halved near a healthy enemy champion when not hurt', parents=['Z318b', 'Z371b'])
def progress(t: Tile) -> Num:
    d0 = at(goal_field(), me().pos)
    if d0 > 100000000:
        return 0
    d1 = at(goal_field(), t)
    bonus = 2 if d1 < 1 else 0
    base = max(-5, min(5, d0 - d1 + bonus))
    k = 1.5 if me().health_frac > 0.5 else 3
    es = enemies()
    danger = sum(1 for u in es if u.is_champion and dist(u.pos, t) <= 2)
    mobs = sum(1 for u in es if not u.is_champion and dist(u.pos, t) <= 1)
    pen = mobs * (3 if HEALING else 0.5)
    p = base - k * danger - pen
    if p > 0 and me().health_frac >= 0.5:
        if any(e.is_champion and e.health_frac > 0.3 and dist(e.pos, t) <= e.attack_range + 1 for e in es):
            return p * 0.5
    return p

@gene('Z489c', 'once per turn: heal hysteresis (retreat below 0.47, resume above 0.93), cache the goal set, and compute the routed goal distance field', parents=['Z318c', 'Z371c'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.47:
        HEALING = True
    elif hf > 0.93:
        HEALING = False
    GT = goals_calc()
    GF = field_avoid(GT, walls() | holes(), walls() & holes())

@gene('Z489d', 'compute the goal set once per turn: home to heal when hurt (hysteresis) or outnumbered, an altar with gems, else a cleared group awaiting capture, else a living non-monolith camp group, else home', parents=['Z439a', 'Z344b'])
def goals_calc() -> Tiles:
    hf = me().health_frac
    if HEALING or hf < 0.35:
        return my_spawn()
    threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 6)
    if hf < 0.5 and threat >= 2:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            if not (valid(t0) and spawn_type(t0) == MONOLITH):
                acc = acc | gt
    if size(acc) > 0:
        return acc
    return my_spawn()

@gene('Z489e', 'value of casting an ability: heal/shield scale with low health and fire in fights near enemy champions, damage/cc on enemy champions favour wounded targets (finisher bonus), camp damage when unladen or camp awake, dash toward goals (needs 2+ tiles, halved below 40% health)', parents=['Z371c', 'Z197a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        h = me().health_frac
        if h < 0.3:
            return 95
        if h < 0.5713:
            return 78
        if h < 0.7:
            return 68
        if k == AB_SHIELD and h < 0.95:
            mp = me().pos
            if any(u.is_champion and u.is_enemy and dist(u.pos, mp) <= 4 for u in enemies()):
                return 66
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if o.unit.health_frac < 0.3:
                    return 110
                return 85 + (1 - o.unit.health_frac) * 25
            if o.unit.is_camp:
                if gems() == 0:
                    return 58
                if is_awake(o.unit) and me().health_frac > 0.5:
                    return 55
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = dash_gain(o.tile)
            if p >= 2:
                v = 25 + 6 * min(p, 10)
                if me().health_frac < 0.4:
                    v = v * 0.5
                return v
        return 0
    return 0

@gene('Z489f', 'unclamped walking distance a dash saves toward the goals (bonus for landing on a goal; 0 when cut off or unreachable)', parents=['Z382a'])
def dash_gain(t: Tile) -> Num:
    f = goal_field()
    d0 = at(f, me().pos)
    if d0 > 100000000:
        return 0
    d1 = at(f, t)
    if d1 > 100000000:
        return 0
    bonus = 2 if d1 < 1 else 0
    return min(12, d0 - d1 + bonus)
