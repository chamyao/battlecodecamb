"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: spawn when badly hurt; an altar with gems; else cleared groups awaiting capture; else a living camp group')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if me().health_frac < 0.3 and gems() < 20:
        return my_spawn()
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    rewarded = False
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
            rewarded = True
    if rewarded:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z86a', 'once per turn: cache the distance field to the goals', parents=['s3'])
def update() -> None:
    GF = field(goals())

@gene('s4', 'how much closer a step brings me to the goals, minus a penalty for enemies near the step (weighted by enemy health, range 3)')
def progress(t: Tile) -> Num:
    f = goal_field()
    threat = sum(1 + u.health_frac for u in enemies() if dist(u.pos, t) <= 3)
    return at(f, me().pos) - at(f, t) - 3 * threat
