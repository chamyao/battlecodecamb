"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home to heal when hurt, an altar with gems, else a cleared group awaiting capture, else the live camp group with the best value over distance')
def goals() -> Tiles:
    if me().health_frac < 0.35:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    best_g = -1
    best_v = -1
    for g in range(num_groups()):
        if not group_respawning(g):
            v = group_gems(g) + group_gold(g)
            if v > 0:
                d = dist(me().pos, nearest(group_tiles(g), me().pos))
                sc = v / (5 + d)
                if sc > best_v:
                    best_v = sc
                    best_g = g
    if best_g >= 0:
        return group_tiles(best_g)
    return near(tile(-5, -5), 0)

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'progress toward goals, discounted by enemy pressure near the step')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    danger = sum(u.health_frac for u in enemies() if dist(u.pos, t) <= 2)
    return d - 3 * danger
