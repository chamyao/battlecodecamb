"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
THREAT: Tiles = None

@gene('Z163a', "value of doing this option now: A's scoring with casting, B's progress and threat-aware move", parents=['s1', 'Z108a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: home to heal when hurt or outnumbered, an altar with gems, else a cleared group awaiting capture, else a living camp group')
def goals() -> Tiles:
    hf = me().health_frac
    if hf < 0.35:
        return my_spawn()
    threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 6)
    if hf < 0.5 and threat >= 2:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z108b', 'once per turn: cache the goal field and the tiles near visible enemies', parents=['Z86a', 'Z34a'])
def update() -> None:
    GF = field(goals())
    acc = near(tile(-5, -5), 0)
    for u in enemies():
        acc = acc | near(u.pos, 2)
    THREAT = acc

@gene('Z108c', 'how much closer a step brings me to the goals, minus a penalty for stepping near enemies', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    pen = 2 if t in THREAT else 0
    return at(f, me().pos) - at(f, t) - pen

@gene('Z130a', 'value of casting an ability option: heal/shield scale with low health, damage/cc on enemy champions favour wounded targets, dash only for real progress', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        if me().health_frac < 0.5:
            return 75
        return 70 if me().health_frac < 0.7 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85 + (1 - o.unit.health_frac) * 20
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            return 45 if progress(o.tile) > 2 else 0
        return 0
    return 0
