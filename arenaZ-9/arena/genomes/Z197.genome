"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene('s1', 'value of doing this option now: draft by top picks, buy/recall/attack/tribute priorities, cast abilities, move by progress toward goals (home-guard when healthy at spawn)', parents=['s1_A', 's1_B'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 9
        if o.champ == HEART_OF_RUIN:
            return 4
        if o.champ == MARCELLA:
            return 3
        if o.champ == VENDETTA:
            return 2
        if o.champ == RYTH:
            return 1.5
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 103
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        if me().health_frac < 0.9 and me().pos in my_spawn():
            return 0
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: home to heal when hurt or outnumbered, an altar with gems, else a cleared group awaiting capture, else a living camp group', parents=['s2_A', 's2_B'])
def goals() -> Tiles:
    hf = me().health_frac
    if hf < 0.35:
        return my_spawn()
    if hf < 0.5:
        threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 6)
        if threat >= 2:
            return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn)', parents=['s3_B'])
def goal_field() -> Field:
    return GOAL_F

@gene('s4', 'progress toward goals: 0 into unreachable tiles, small positive when cut off, bonus for stepping onto a goal tile', parents=['s4_B'])
def progress(t: Tile) -> Num:
    f = goal_field()
    d0 = at(f, me().pos)
    d1 = at(f, t)
    if d1 > 100000000:
        return 0
    if d0 > 100000000:
        return 1
    bonus = 3 if d1 < 1 else 0
    return d0 - d1 + bonus

@gene('Z197a', 'value of casting an ability option: heal/shield scale with low health (stronger below 30%), damage/cc on enemy champions favour wounded targets (finishers get a bonus), dash value grows with progress toward goals (needs 2+ tiles of progress)', parents=['Z197a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        h = me().health_frac
        if h < 0.3:
            return 95
        if h < 0.5:
            return 78
        return 68 if h < 0.7 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if o.unit.health_frac < 0.3:
                    return 110
                return 85 + (1 - o.unit.health_frac) * 25
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return 25 + 6 * min(p, 10)
        return 0
    return 0

@gene('Z34a', 'compute the goal distance field once per turn, routing around walls and holes', parents=['Z34a'])
def update() -> None:
    GOAL_F = field_avoid(goals(), walls() | holes(), walls() & holes())
