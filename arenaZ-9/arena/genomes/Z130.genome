"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene("s1", "value of doing this option now; also uses abilities (damage/cc on champions and camps, shield/heal when hurt, dash toward goals)", parents=["s1"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: home to heal when hurt (hysteresis) or outnumbered, an altar with gems, else a cleared group awaiting capture, else a living non-monolith camp group', parents=["s2", "Z172a"])
def goals() -> Tiles:
    hf = me().health_frac
    if HEALING or hf < 0.4:
        return my_spawn()
    threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 6)
    if hf < 0.5 and threat >= 2:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            if not (valid(t0) and spawn_type(t0) == MONOLITH):
                acc = acc | gt
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)', parents=["s3"])
def goal_field() -> Field:
    return GF

@gene('Z75a', 'once per turn: track heal hysteresis (retreat below 0.5, resume above 0.95) and compute the goal distance field', parents=['Z75a'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.5:
        HEALING = True
    elif hf > 0.95:
        HEALING = False
    GF = field(goals())

@gene('s4', 'progress toward goals, minus a penalty for stepping near enemies', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    base = at(f, me().pos) - at(f, t)
    threat = sum(u.strength for u in enemies() if dist(u.pos, t) <= 2)
    return base - 0.3 * threat

@gene('Z199a', 'value of casting an ability option: heal/shield scale with low health (A thresholds), damage/cc on enemy champions favour wounded targets, dash scales with real progress toward goals', parents=['Z167a', 'Z172b'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        h = me().health_frac
        if h < 0.5:
            return 80
        return 65 if h < 0.7 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85 + (1 - o.unit.health_frac) * 22
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p > 2:
                return 33 + 4 * min(p, 6)
        return 0
    return 0
