"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('Z358a', 'value of doing this option now: draft top picks, buy, recall when low, attack champions (focus wounded / gem carriers), attack weakest camp unit, tribute, cast abilities, rank moves by threat-aware progress (doubled while healing)', parents=['Z318a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 5
        if o.champ == HEART_OF_RUIN:
            return 4
        if o.champ == MARCELLA:
            return 3
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 1.5
        return 0.4428
    if o.kind == BUY:
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 120 + 10 * (1 - o.unit.health_frac) + min(unit_gems(o.unit), 50) / 10
        if gems() == 0:
            return 58 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 103
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        if me().health_frac < 0.9 and me().pos in my_spawn():
            return 0
        p = progress(o.tile)
        if p <= 0:
            return 0
        if HEALING:
            return 50 + 2 * p
        return 50 + p
    return 0

@gene('Z478a', 'where to walk: home to heal when hurt (hysteresis) or outnumbered by 3 (2 when below half health), an altar with gems, else a cleared group awaiting capture, else a living camp group within 15 tiles if any (else any; monoliths only after round 1000 with 3+ healthy allies)', parents=['s2', 's2'])
def goals() -> Tiles:
    hf = me().health_frac
    if HEALING or hf < 0.35:
        return my_spawn()
    threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 5)
    if threat >= 3 or (hf < 0.5 and threat >= 2):
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    late = round() > 1000 and hf >= 0.8 and count_units(allies()) >= 3
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            mono = valid(t0) and spawn_type(t0) == MONOLITH
            if (not mono) or late:
                acc = acc | gt
    close = acc & near(me().pos, 15)
    if size(close) > 0:
        return close
    return acc

@gene('s3', 'distance field to the goals, routed around walls and holes (cached once per turn in update)', parents=['s3'])
def goal_field() -> Field:
    return GF

@gene('Z358b', 'how much closer a step brings me to the goals (clamped to +-5, bonus 3 for stepping onto a goal; 0 when cut off); reduced when the step lands in reach of a healthy enemy champion (less so while retreating)', parents=['Z318b', 's4'])
def progress(t: Tile) -> Num:
    g = goal_field()
    d0 = at(g, me().pos)
    if d0 > 100000000:
        return 0
    d1 = at(g, t)
    bonus = 3 if d1 < 1 else 0
    p = max(-5, min(5, d0 - d1 + bonus))
    if p > 0 and any(e.is_champion and e.health_frac > 0.5 and dist(e.pos, t) <= e.attack_range + 1 for e in enemies()):
        return p * (0.75 if HEALING else 0.5)
    return p

@gene('Z318c', 'once per turn: track heal hysteresis (retreat below 0.45, resume above 0.9; retreat early when carrying many gems) and compute the routed goal distance field (skipped while dead or channeling to save fuel)', parents=['Z75a'])
def update() -> None:
    if alive() and not channeling():
        hf = me().health_frac
        if hf < 0.45 or (hf < 0.6 and gems() >= 20):
            HEALING = True
        elif hf > 0.9:
            HEALING = False
        GF = field_avoid(goals(), walls() | holes(), walls() & holes())

@gene('Z548a', 'skip listing and scoring option kinds the policy never uses (wards, locks, cancels) to save fuel', parents=['Z358a'])
def consider(kind: Num) -> Bool:
    return not (kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL)

@gene('Z197a', 'value of casting an ability: heal/shield scale with low health, damage/cc on enemy champions favour wounded targets (finishing blows valued most), dash value grows with progress toward goals', parents=['Z197a', 'Z141a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        h = me().health_frac
        if h < 0.3:
            return 95
        if h < 0.5:
            return 78
        return 68 if h < 0.7 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if o.unit.health_frac < 0.3:
                    return 110
                return 85 + (1 - o.unit.health_frac) * 25
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return 25 + 6 * min(p, 10)
        return 0
    return 0
