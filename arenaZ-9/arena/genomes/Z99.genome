"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 73 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living or cleared-awaiting-capture camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g) or not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to goals; detours around enemy champions and walls when an enemy is within 6 tiles, else the cached per-turn field')
def goal_field() -> Field:
    threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 6)
    if threat > 0:
        return field_avoid(goals(), walls() | enemy_tiles(), goals())
    return GOAL_F

@gene('s4', 'how much closer a step brings me to the goals, with a bonus for stepping onto a goal tile')
def progress(t: Tile) -> Num:
    d0 = at(goal_field(), me().pos)
    d1 = at(goal_field(), t)
    bonus = 2 if d1 < 1 else 0
    return d0 - d1 + bonus

@gene('Z34a', 'compute the goal distance field once at the start of each turn', parents=['s3'])
def update() -> None:
    GOAL_F = field(goals())
