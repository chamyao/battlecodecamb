"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene('Z140a', 'value of doing this option now; steps toward goals weigh more while carrying gems', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 50 + 15 * gems() if gems() > 0 else 50
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living or cleared-awaiting-capture camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g) or not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn)', parents=['s3'])
def goal_field() -> Field:
    return GOAL_F

@gene('Z140b', 'how much closer a step brings me to the goals; 0 when goals are unreachable; bonus for stepping onto a goal', parents=['s4'])
def progress(t: Tile) -> Num:
    here = at(goal_field(), me().pos)
    if here >= 100000:
        return 0
    d1 = at(goal_field(), t)
    bonus = 2 if d1 < 1 else 0
    return here - d1 + bonus

@gene('Z34a', 'compute the goal distance field once at the start of each turn', parents=['Z34a'])
def update() -> None:
    GOAL_F = field(goals())
