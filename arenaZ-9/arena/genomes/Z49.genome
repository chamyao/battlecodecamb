"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene("s1", "value of doing this option now", parents=["s1"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 85 if me().health_frac < 0.38 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z71a', 'where to walk: home to heal when hurt, an altar when carrying gems, else a cleared group awaiting capture, else a living camp group that holds gold or gems', parents=['Z71a', 's2'])
def goals() -> Tiles:
    if me().health_frac < 0.38:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        worth = group_gems(g) + group_gold(g) > 0
        if worth and not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn)', parents=['s3'])
def goal_field() -> Field:
    return GOAL_F

@gene('s4', 'distance gained by a step, discounted by nearby enemy champion threat', parents=['s4'])
def progress(t: Tile) -> Num:
    base = at(goal_field(), me().pos) - at(goal_field(), t)
    threat = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= 3)
    return base - 0.2 * threat

@gene('Z34a', 'compute the goal distance field once at the start of each turn', parents=['Z34a'])
def update() -> None:
    GOAL_F = field(goals())
