"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('s1', 'value of doing this option now; also uses abilities (damage/cc on champions and camps, shield/heal when hurt, dash toward goals); when healing, retreat steps are weighted higher and steps into enemy champion range are refused; when not healing, steps near enemy champions are discounted and refused while hurt', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 103
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        threat = count(dist(u.pos, o.tile) <= 3 for u in enemies() if u.is_champion)
        if HEALING:
            if threat > 0:
                return 0
            return 50 + 2 * p
        if threat > 0 and me().health_frac < 0.5:
            return 0
        return 50 + p - 5 * threat
    return 0

@gene('s2', 'where to walk: home to heal when hurt (hysteresis) or outnumbered, an altar with gems, else a cleared group awaiting capture, else a living non-monolith camp group', parents=['s2'])
def goals() -> Tiles:
    hf = me().health_frac
    if HEALING or hf < 0.35:
        return my_spawn()
    threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 6)
    if hf < 0.5 and threat >= 2:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            if not (valid(t0) and spawn_type(t0) == MONOLITH):
                acc = acc | gt
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)', parents=['s3'])
def goal_field() -> Field:
    return GF

@gene('s4', 'how much closer a step brings me to the goals (clamped to +-4, minus 2 if the step lands within 2 tiles of an enemy champion; 0 when I am cut off from the goals)', parents=['s4'])
def progress(t: Tile) -> Num:
    d0 = at(goal_field(), me().pos)
    if d0 > 100000000:
        return 0
    d1 = at(goal_field(), t)
    p = max(-4, min(4, d0 - d1))
    if count(dist(u.pos, t) <= 2 for u in enemies() if u.is_champion) > 0:
        p -= 2
    return p

@gene('Z75a', 'once per turn: track heal hysteresis (retreat below 0.5, resume above 0.95) and compute the goal distance field', parents=['s3'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.5:
        HEALING = True
    elif hf > 0.95:
        HEALING = False
    GF = field(goals())

@gene('Z197a', 'value of casting an ability option: heal/shield scale with low health (stronger below 30%), damage/cc on enemy champions favour wounded targets (finishers get a bonus), dash value grows with progress toward goals (needs 2+ tiles of progress)', parents=['Z130a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        h = me().health_frac
        if h < 0.3:
            return 95
        if h < 0.5:
            return 78
        return 68 if h < 0.7 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if o.unit.health_frac < 0.3:
                    return 110
                return 85 + (1 - o.unit.health_frac) * 25
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if p >= 2:
                return 25 + 6 * min(p, 10)
        return 0
    return 0
