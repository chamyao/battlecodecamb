"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('Z318a', 'value of doing this option now: draft top picks, buy, recall when low, attack champions (prefer wounded ones), tribute, cast abilities, rank moves by progress (doubled while healing)', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 5
        if o.champ == HEART_OF_RUIN:
            return 4
        if o.champ == MARCELLA:
            return 3
        if o.champ == VENDETTA:
            return 2
        if o.champ == RYTH:
            return 1.5
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 139 + 40 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 100
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        if me().health_frac < 0.9 and me().pos in my_spawn():
            return 0
        p = progress(o.tile)
        if p <= 0:
            return 0
        if HEALING:
            return 50 + 2 * p
        return 50 + p
    return 0

@gene('s2', 'where to walk: home to heal when hurt (hysteresis) or outnumbered, an altar with gems, else a cleared group awaiting capture, else a living non-monolith camp group', parents=['s2'])
def goals() -> Tiles:
    hf = me().health_frac
    if HEALING or hf < 0.35:
        return my_spawn()
    threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 6)
    if hf < 0.5 and threat >= 2:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            if not (valid(t0) and spawn_type(t0) == MONOLITH):
                acc = acc | gt
    return acc

@gene('s3', 'distance field to the goals, routed around walls and holes (cached once per turn in update)', parents=['s3'])
def goal_field() -> Field:
    return GF

@gene('Z318b', 'how much closer a step brings me to the goals (clamped to +-5, bonus for stepping onto a goal; 0 when cut off)', parents=['s4'])
def progress(t: Tile) -> Num:
    d0 = at(goal_field(), me().pos)
    if d0 > 100000000:
        return 0
    d1 = at(goal_field(), t)
    bonus = 2 if d1 < 1 else 0
    return max(-5, min(5, d0 - d1 + bonus))

@gene('Z318c', 'once per turn: track heal hysteresis (retreat below 0.5, resume above 0.9) and compute the routed goal distance field', parents=['Z75a'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.5:
        HEALING = True
    elif hf > 0.9:
        HEALING = False
    GF = field_avoid(goals(), walls() | holes(), walls() & holes())

@gene('Z197a', 'value of casting an ability: heal scales with low health, shield also fires in fights with enemy champions close, damage/cc on enemy champions favour wounded targets, camp damage when unladen or camp already awake, dash value from unclamped walk gain toward goals', parents=['Z197a', 'Z141a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        h = me().health_frac
        if h < 0.3:
            return 95
        if h < 0.5:
            return 78
        if h < 0.7:
            return 68
        if k == AB_SHIELD and h < 0.95:
            mp = me().pos
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 66
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if o.unit.health_frac < 0.3:
                    return 110
                return 85 + (1 - o.unit.health_frac) * 25
            if o.unit.is_camp:
                if gems() == 0:
                    return 58
                if is_awake(o.unit) and me().health_frac > 0.5:
                    return 55
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = dash_gain(o.tile)
            if p >= 2:
                return 25 + 6 * min(p, 10)
        return 0
    return 0

@gene('Z382a', 'unclamped walking distance a dash saves toward the goals (bonus for landing on a goal; 0 when cut off or unreachable)', parents=['Z318b'])
def dash_gain(t: Tile) -> Num:
    f = goal_field()
    d0 = at(f, me().pos)
    if d0 > 100000000:
        return 0
    d1 = at(f, t)
    if d1 > 100000000:
        return 0
    bonus = 2 if d1 < 1 else 0
    return min(12, d0 - d1 + bonus)
