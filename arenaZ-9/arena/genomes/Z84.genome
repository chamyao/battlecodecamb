"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

HEALING: Bool = False
GOAL_F: Field = None

@gene("s1", "value of doing this option now; steps toward goals weigh more while carrying gems", parents=["s1"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 50 + 15 * gems() if gems() > 0 else 50
        return 0
    return 0

@gene("s2", "where to walk: home to heal when hurt (with hysteresis), an altar with gems, else a cleared group awaiting capture, else a living or cleared non-monolith camp group", parents=["s2", "s1"])
def goals() -> Tiles:
    if HEALING or me().health_frac < 0.4:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g) or not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            if not (valid(t0) and spawn_type(t0) == MONOLITH):
                acc = acc | gt
    return acc

@gene("s3", "distance field to the goals, cached once per turn in update", parents=["s3"])
def goal_field() -> Field:
    return GOAL_F

@gene('Z132a', 'once per turn: heal hysteresis and goal distance field', parents=['Z75a', 'Z21a', 'Z34a'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.4:
        HEALING = True
    elif hf > 0.9:
        HEALING = False
    GOAL_F = field(goals())

@gene("s4", "how much closer a step brings me to the goals, plus a bonus for stepping onto a goal tile; doubled while healing", parents=["s4"])
def progress(t: Tile) -> Num:
    d0 = at(goal_field(), me().pos)
    d1 = at(goal_field(), t)
    bonus = 2 if d1 < 1 else 0
    d = d0 - d1 + bonus
    if HEALING:
        return d * 2
    return d
