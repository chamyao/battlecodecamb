"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene('s1', 'value of doing this option now; steps toward goals weigh more while carrying gems', parents=["s1"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 50 + 15 * gems() if gems() > 0 else 50
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture; else a living camp group', parents=["s2"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        return acc
    acc = near(tile(-5, -5), 0)
    if any(group_reward(g) for g in range(num_groups())):
        for g in range(num_groups()):
            if group_reward(g):
                acc = acc | group_tiles(g)
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; routes around camp tiles when fuel allows, else the cached per-turn field')
def goal_field() -> Field:
    if fuel() < 30000:
        return GOAL_F
    return field_avoid(goals(), camp_tiles(), goals())

@gene("s4", "how much closer a step brings me to the goals", parents=["s4"])
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z21a', 'compute the goal distance field once per turn', parents=['s3'])
def update() -> None:
    GOAL_F = field(goals())
