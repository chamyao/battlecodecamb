"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('Z371a', 'value of doing this option now: draft top picks, buy, recall when low, attack champions, tribute, cast abilities, rank moves by threat-aware progress (doubled while healing)', parents=['Z358a', 'Z344a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 9
        if o.champ == HEART_OF_RUIN:
            return 4
        if o.champ == MARCELLA:
            return 3
        if o.champ == VENDETTA:
            return 2.5
        if o.champ == RYTH:
            return 1.5
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 63 if me().health_frac < 0.3081 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 120
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 103
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        if me().health_frac < 0.9 and me().pos in my_spawn():
            return 0
        p = progress(o.tile)
        if p <= 0:
            return 0
        if HEALING:
            return 52 + 2 * p
        return 50 + p
    return 0

@gene('Z344b', 'where to walk: home to heal when hurt (hysteresis) or outnumbered below 60% health, an altar with gems, else a cleared group awaiting capture, else the richest living non-monolith camp group (union fallback), else home', parents=['s2'])
def goals() -> Tiles:
    hf = me().health_frac
    if HEALING or hf < 0.35:
        return my_spawn()
    if hf < 0.6:
        threat = sum(1 for u in enemies() if dist(u.pos, me().pos) <= 6)
        if threat >= 2:
            return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    richest = near(tile(-5, -5), 0)
    bestv = 0
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            if not (valid(t0) and spawn_type(t0) == MONOLITH):
                acc = acc | gt
                v = group_gems(g) + 0.5 * group_gold(g)
                if v > bestv:
                    bestv = v
                    richest = gt
    if bestv > 0:
        return richest
    if size(acc) > 0:
        return acc
    return my_spawn()

@gene('Z371b', 'how much closer a step brings me to the goals (clamped to +-6, bonus onto a goal; 0 when cut off); minus a danger penalty near enemy champions when healing or hurt; halved in reach of a healthy enemy champion otherwise', parents=['Z358b', 'Z344c'])
def progress(t: Tile) -> Num:
    d0 = at(GF, me().pos)
    if d0 > 100000000:
        return 0
    d1 = at(GF, t)
    bonus = 3 if d1 < 1 else 0
    p = max(-6, min(6, d0 - d1 + bonus))
    es = enemies()
    if HEALING:
        return p - sum(3 for u in es if u.is_champion and dist(u.pos, t) <= 3)
    if me().health_frac < 0.5:
        return p - sum(3 for u in es if dist(u.pos, t) <= 3)
    if p > 0 and any(e.is_champion and e.health_frac > 0.5 and dist(e.pos, t) <= e.attack_range + 1 for e in es):
        return p * 0.5
    return p

@gene('Z318c', 'once per turn: track heal hysteresis (retreat below 0.47, resume above 0.93) and compute the goal distance field routed around walls, holes, camp monsters and enemy champions', parents=['Z75a'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.47:
        HEALING = True
    elif hf > 0.93:
        HEALING = False
    GF = field_avoid(goals(), walls() | holes() | camp_tiles() | enemy_tiles(), walls() & holes())

@gene('Z371c', 'value of casting an ability: heal/shield scale with low health, damage/cc on enemy champions favour wounded targets (finisher bonus), dash toward goals while healthy, and dash home to escape when retreating hurt (higher value if enemies near)', parents=['Z344d', 'Z197a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        h = me().health_frac
        if h < 0.3996:
            return 95
        if h < 0.5713:
            return 78
        return 68 if h < 0.7 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 122 + (1 - o.unit.health_frac) * 25
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            if HEALING:
                p = progress(o.tile)
                if p >= 2:
                    threat = count(e.is_champion and dist(e.pos, me().pos) <= 5 for e in enemies())
                    return 30 + 7 * min(p, 8) + 20 * min(threat, 2)
                return 0
            if me().health_frac > 0.4:
                p = progress(o.tile)
                if p >= 2:
                    return 25 + 7 * min(p, 6)
        return 0
    return 0
