"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
ENEMY_T: Tiles = None

@gene('Z127a', 'value of doing this option now; steps toward goals weigh more while carrying gems; casts scored by cast_value', parents=['s1', 's1', 'Z130a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.4428
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.37 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 98
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        if progress(o.tile) > 0:
            return 50 + 15 * gems() if gems() > 0 else 50
        return 0
    return 0

@gene('Z173a', 'skip listing option kinds score() never values, saving fuel', parents=['Z127a'])
def consider(kind: Num) -> Bool:
    return kind == PICK or kind == BUY or kind == RECALL or kind == ATTACK or kind == TRIBUTE or kind == MOVE or kind == CAST

@gene('s2', 'where to walk: home to heal while HEALING, an altar with gems, else a cleared group awaiting capture, else a living camp group (monoliths only after round 1000)', parents=['s2'])
def goals() -> Tiles:
    if HEALING:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.6334)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            is_mono = valid(t0) and spawn_type(t0) == MONOLITH
            if (not is_mono) or round() > 1000:
                acc = acc | gt
    return acc

@gene('Z173b', 'once per turn: track heal hysteresis, compute the goal distance field and cache enemy tiles', parents=['Z75a'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.4:
        HEALING = True
    elif hf > 0.9:
        HEALING = False
    GF = field(goals())
    ENEMY_T = enemy_tiles()

@gene('Z173c', 'how much closer a step brings me to the goals; enemy-proximity penalty per nearby enemy tile, doubled while healing (from cached enemy tiles)', parents=['s4', 's4'])
def progress(t: Tile) -> Num:
    d = at(GF, me().pos) - at(GF, t)
    n = size(near(t, 2) & ENEMY_T)
    if HEALING:
        d -= 2 * n
    elif n > 0:
        d -= 1
    return d

@gene('Z130a', 'value of casting an ability option: heal/shield scale with low health, damage/cc on enemy champions favour wounded targets, dash only for real progress', parents=['s1', 'Z151a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        if me().health_frac < 0.5:
            return 75
        return 70 if me().health_frac < 0.7 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85 + (1 - o.unit.health_frac) * 20
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            return 45 if progress(o.tile) > 2 else 0
        return 0
    return 0
