"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False

@gene('s1', 'value of doing this option now', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.2534 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 113
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 49 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1.0462)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat to spawn when hysteresis-healing or below a limit (lower limit when empty-handed is not needed: 45% when carrying gems); top up to 85% on spawn before leaving', parents=['s3', 's3'])
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    limit = 0.3
    if gems() > 0:
        limit = 0.45
    if HEALING or hf < limit:
        return field(home)
    if hf < 0.85 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'progress toward goals; doubled while healing so retreat dominates; gem bonus scales with carried gems (1 + gems/8), capped at 2.5x', parents=['s4'])
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    if HEALING:
        p = p * 2
    else:
        p = p * min(1 + gems() / 8, 2.5)
    return p

@gene('Z12a', 'once per turn: update heal hysteresis (start below 35%, stop above 90%), then compute the goal field (skip when dead)', parents=['s4', 's3'])
def update() -> None:
    if alive():
        hf = me().health_frac
        if hf < 0.35:
            HEALING = True
        if hf > 0.9:
            HEALING = False
        GF = goal_field()

@gene('Z12b', 'draft preference: Heart of Ruin first (sturdy, shield in fights), then Vesper Vale, then Marcella', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == HEART_OF_RUIN:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z12c', 'value of casting an ability option; shield also vs awake camps near me, heal earlier in fights (earlier still when carrying gems), stun enemy champions (cancels tribute), finishing bonus on low-health enemies, dash toward goals', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    foes = count_units(enemies())
    if k == AB_SHIELD:
        if hf >= 0.7:
            return 0
        if foes > 0:
            return 85
        return 80 if any(is_awake(c) and dist(c.pos, me().pos) <= 3 for c in camps()) else 0
    if k == AB_HEAL:
        if hf < 0.657:
            return 85
        if hf < 0.8 and foes > 0:
            return 65 + (20 if gems() > 0 else 0)
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if gems() == 0:
                return 45 if p >= 2 else 0
            return 50 if p >= 2 else 0
        return 0
    if k == AB_CC:
        if exists(o.unit) and o.unit.is_champion and o.unit.is_enemy:
            return 95 + (15 if o.unit.health_frac < 0.35 else 0)
        if exists(o.unit) and o.unit.is_camp:
            return 58 if gems() == 0 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78 + 20 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
