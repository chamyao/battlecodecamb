"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else a cleared group awaiting capture; else a living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat to spawn to heal when hurt (matches 40% recall), stay until mostly healed')
def goal_field() -> Field:
    m = me()
    hf = m.health_frac
    home = my_spawn()
    if hf < 0.4:
        return field(home)
    if hf < 0.6 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached per-turn field)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z12a', 'compute the goal distance field once per turn (skip when dead)', parents=['s4'])
def update() -> None:
    if alive():
        GF = goal_field()

@gene('Z12b', 'draft preference: Vesper Vale first (top-ladder draft, strong with Power Strength), then Heart of Ruin, Marcella', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z12c', 'value of casting an ability option; heal earlier, dash when carrying gems toward goals', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_SHIELD:
        return 85 if hf < 0.7 and count_units(enemies()) > 0 else 0
    if k == AB_HEAL:
        if hf < 0.5:
            return 90
        return 60 if hf < 0.8 and count_units(enemies()) == 0 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if gems() == 0:
                return 45 if progress(o.tile) >= 2 else 0
            return 55 if progress(o.tile) >= 2 else 0
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78
            if o.unit.is_camp:
                return 58 if gems() == 0 else 0
        return 0
    return 0
