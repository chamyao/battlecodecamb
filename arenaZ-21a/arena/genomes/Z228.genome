"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now: draft Ryth, Vesper Vale, Vendetta, Tavi, Varg; casts, fight back, focus the weakest target and gem carriers; when low or outnumbered while hurt, recall only where it is safe, else walk away first and only finish off nearly dead champions')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    low = me().health_frac < 0.35 or (me().health_frac < 0.7 and outnumbered())
    if o.kind == RECALL:
        if low:
            return 90 if safe() else 0
        return 55 if shop_trip() else 0
    if o.kind == MOVE:
        if low and not safe():
            return 75 if at(retreat_field(), me().pos) - at(retreat_field(), o.tile) > 0 else 0
        return 50 if progress(o.tile) > 0 else 0
    if o.kind == CAST:
        if low and exists(o.unit) and o.unit.is_champion and o.unit.health_frac > 0.25:
            return 0
        if exists(o.unit) and o.unit.is_champion:
            return cast_value(o) + min(unit_gems(o.unit), 50) / 10
        return cast_value(o)
    if o.kind == ATTACK:
        w = 0.7787 - o.unit.health_frac
        if o.unit.is_champion:
            if low and o.unit.health_frac > 0.25:
                return 0
            return 80 + 5 * w + min(unit_gems(o.unit), 50) / 10
        if gems() == 0:
            return 60 + 1.5 * w
        return 58 + 1.5 * w if is_awake(o.unit) else 0
    if o.kind == TRIBUTE:
        return 70
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group; a cleared group waiting for capture only if I am the closest visible ally, so the others move on and the reward is not split")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            ts = group_tiles(g)
            if group_reward(g):
                d = dist(nearest(ts, me().pos), me().pos)
                if not any(dist(nearest(ts, a.pos), a.pos) < d for a in allies()):
                    acc = acc | ts
            else:
                acc = acc | ts
    return acc

@gene('s3', 'distance field to a fight an ally just announced nearby, else to the goals computed once per turn in update')
def goal_field() -> Field:
    r = rally_tiles()
    if size(r) > 0:
        return field(r)
    return GF

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z18a', 'once per turn: the distance field to the goals plus enemy champions worth hunting, or home when hurt or rich with spawn close, empty-handed and not in a fight', parents=['s3'])
def update() -> None:
    home = False
    if gems() == 0 and not any(is_awake(c) and dist(c.pos, me().pos) <= 4 for c in camps()):
        if me().health_frac < 0.5:
            home = True
        elif gold() >= 150 and dist(nearest(my_spawn(), me().pos), me().pos) <= 12:
            home = True
    if home:
        GF = field(my_spawn())
    else:
        GF = field(goals() | hunt_tiles())

@gene('Z120a', 'tiles holding enemy champions or camps we fight (awake, or any when carrying nothing), built once per pass', parents=['Z4b'])
def hot_tiles() -> Tiles:
    if gems() == 0:
        return enemy_tiles() | camp_tiles()
    acc = enemy_tiles()
    for c in camps():
        if is_awake(c):
            acc = acc | near(c.pos, 0)
    return acc

@gene('Z4b', 'number of enemy champions and camps we fight within radius one of a tile, from the per-pass hot tile set (cheap per option)', parents=['s1'])
def hits_at(t: Tile) -> Num:
    return size(near(t, 1) & hot_tiles())

@gene('Z51a', 'value of casting an ability now: dash next to a badly hurt enemy champion; focus targeting with the Heart of Ruin dash onto targets', parents=['Z7a', 'Z4c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion:
                return 85 + 3 * (1 - o.unit.health_frac)
            if o.unit.is_camp and (is_awake(o.unit) or gems() == 0):
                return 64 + (1 - o.unit.health_frac)
            return 0
        if valid(o.tile):
            h = hits_at(o.tile)
            return 64 + h if h > 0 else 0
        return 0
    if k == AB_SHIELD:
        return 66 if any(is_awake(c) and dist(c.pos, me().pos) <= 4 for c in camps()) or any(dist(u.pos, me().pos) <= 3 for u in enemies()) else 0
    if k == AB_RESET:
        if can_attack():
            return 0
        r = me().attack_range
        return 62 if any(dist(u.pos, me().pos) <= r for u in enemies()) or any(dist(c.pos, me().pos) <= r and (is_awake(c) or gems() == 0) for c in camps()) else 0
    if k == AB_HEAL:
        return 70 if exists(o.unit) and o.unit.health_frac < 0.6 else 0
    if k == AB_DASH:
        if not valid(o.tile):
            return 0
        if any(dist(u.pos, o.tile) <= 1 and u.health_frac < 0.4 for u in enemies()) and me().health_frac > 0.4:
            return 70
        if me().type == HEART_OF_RUIN and hits_at(o.tile) > 0:
            return 67
        return 51 if progress(o.tile) >= 2 else 0
    return 0

@gene('Z48a', 'worth recalling to spend gold: rich, carrying nothing, nobody near', parents=['s1'])
def shop_trip() -> Bool:
    if gold() < 150 or gems() > 0:
        return False
    if any(dist(u.pos, me().pos) <= 8 for u in enemies()):
        return False
    return not any(is_awake(c) and dist(c.pos, me().pos) <= 5 for c in camps())

@gene('Z71a', 'no awake camp can reach me next turn and no enemy champion within 5: a recall here will not be cancelled', parents=['s1'])
def safe() -> Bool:
    if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
        return False
    return not any(is_awake(c) and dist(c.pos, me().pos) <= c.attack_range + 1 for c in camps())

@gene('Z71b', 'distance field to our spawn, for retreating', parents=['s1'])
def retreat_field() -> Field:
    return field(my_spawn())

@gene('Z59a', 'draft preference: Ryth, Vesper Vale, Vendetta, then Tavi and Varg', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == RYTH:
        return 10
    if c == VESPER_VALE:
        return 9
    if c == VENDETTA:
        return 8
    if c == TAVI:
        return 7
    if c == VARG:
        return 6
    return 1

@gene('Z199a', 'the enemy champions within 5 outnumber me and my allies within 5 by two or more', parents=['s1'])
def outnumbered() -> Bool:
    foes = count(dist(u.pos, me().pos) <= 5 for u in enemies())
    if foes < 2:
        return False
    return foes >= 3 + count(dist(a.pos, me().pos) <= 5 for a in allies())

@gene('Z120b', 'skip option kinds that cannot score: wards, locks, cancels always; casts unless a target is within 6 or a dash is ready', parents=['Z18a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == CAST:
        if (slot_kind(0) == AB_DASH and slot_ready(0)) or (slot_kind(1) == AB_DASH and slot_ready(1)):
            return True
        if any(dist(u.pos, me().pos) <= 6 for u in enemies()):
            return True
        return any(dist(c.pos, me().pos) <= 6 and (is_awake(c) or gems() == 0) for c in camps())
    return True

@gene('Z170a', 'visible enemy champions worth hunting: badly hurt ones within 6 while I am healthy, or all within 8 when my visible allies (me included) outnumber them', parents=['Z18a'])
def hunt_tiles() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if me().health_frac < 0.5:
        return acc
    foes = count(dist(u.pos, me().pos) <= 8 for u in enemies())
    if foes == 0:
        return acc
    friends = 1 + count(dist(a.pos, me().pos) <= 8 for a in allies())
    for u in enemies():
        if dist(u.pos, me().pos) <= 8:
            if friends >= foes and me().health_frac >= 0.7:
                acc = acc | near(u.pos, 1)
            elif u.health_frac < 0.35 and dist(u.pos, me().pos) <= 6:
                acc = acc | near(u.pos, 1)
    return acc

@gene('Z210a', 'after my actions: announce the tile I just attacked and the round, so allies can join the fight', parents=['s3'])
def after() -> None:
    if acted(ATTACK):
        t = acted_tile(ATTACK)
        if valid(t):
            write_shared(0, t.x)
            write_shared(1, t.y)
            write_shared(2, round() - 256 * floor(round() / 256))

@gene('Z210b', 'an ally fight announced in the last 3 rounds within 12 tiles, worth joining when I am healthy and empty-handed', parents=['s3'])
def rally_tiles() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0 or me().health_frac < 0.6:
        return acc
    age = round() - 256 * floor(round() / 256) - read_shared(2)
    if age < 0:
        age += 256
    if age > 3:
        return acc
    t = tile(read_shared(0), read_shared(1))
    if valid(t) and dist(t, me().pos) <= 12 and dist(t, me().pos) > 1:
        acc = near(t, 1)
    return acc
