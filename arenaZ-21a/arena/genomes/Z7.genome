"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: strong draft, buy strength and health items')
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 10
        if o.champ == HEART_OF_RUIN:
            return 9
        if o.champ == MARCELLA:
            return 8
        if o.champ == VENDETTA:
            return 7
        if o.champ == RYTH:
            return 6
        return 1
    if o.kind == BUY:
        return buy_value(o)
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z9a', 'value of buying an item: combat stats per purchase, treasure early', parents=['s1'])
def buy_value(o: Option) -> Num:
    v = item_strength(o.item) * 2 + item_health(o.item) / 25
    if item_passive(o.item) == P_TREASURE and round() < 700:
        v += 6
    if item_passive(o.item) == P_JUNGLE:
        v += 3
    if v <= 0:
        return 0
    return 100 + v + o.count
