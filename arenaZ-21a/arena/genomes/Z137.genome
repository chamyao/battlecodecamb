"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now: casts, fight back against awake camps, focus the weakest target; below 35 percent health, recall only where it is safe, else walk away first and only finish off nearly dead champions; recall to shop when rich and idle')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    low = me().health_frac < 0.35
    if o.kind == RECALL:
        if low:
            return 90 if safe() else 0
        return 55 if gems() == 0 and gold() >= 150 and safe() else 0
    if o.kind == MOVE:
        if low and not safe():
            return 75 if at(retreat_field(), me().pos) - at(retreat_field(), o.tile) > 0 else 0
        return 50 if progress(o.tile) > 0 else 0
    if o.kind == CAST:
        if low and exists(o.unit) and o.unit.is_champion and o.unit.health_frac > 0.25:
            return 0
        return cast_value(o)
    if o.kind == ATTACK:
        w = 1 - o.unit.health_frac
        if o.unit.is_champion:
            if low and o.unit.health_frac > 0.25:
                return 0
            return 80 + 5 * w
        if gems() == 0:
            return 60 + 1.5 * w
        return 58 + 1.5 * w if is_awake(o.unit) else 0
    if o.kind == TRIBUTE:
        return 70
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living camp group not next to the enemy spawn (unless nothing else is left); a cleared group waiting for capture only if I am the closest visible ally')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    risky = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            ts = group_tiles(g)
            if group_reward(g):
                d = dist(nearest(ts, me().pos), me().pos)
                if not any(dist(nearest(ts, a.pos), a.pos) < d for a in allies()):
                    acc = acc | ts
            else:
                t0 = nearest(ts, me().pos)
                if dist(t0, nearest(enemy_spawn(), t0)) <= 7:
                    risky = risky | ts
                else:
                    acc = acc | ts
    if size(acc) == 0:
        return risky
    return acc

@gene('s3', 'distance field to the goals, computed once per turn in update')
def goal_field() -> Field:
    return GF

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z18a', 'once per turn: the distance field to the goals, or home when hurt or rich with spawn close, empty-handed and not in a fight', parents=['s3'])
def update() -> None:
    home = False
    if gems() == 0 and not any(is_awake(c) and dist(c.pos, me().pos) <= 4 for c in camps()):
        if me().health_frac < 0.5:
            home = True
        elif gold() >= 150 and dist(nearest(my_spawn(), me().pos), me().pos) <= 12:
            home = True
    if home:
        GF = field(my_spawn())
    else:
        GF = field(goals())

@gene('Z4b', 'number of enemy champions and camps we fight within radius one of a tile, from the per-pass hot tile set (cheap per option)', parents=['s1'])
def hits_at(t: Tile) -> Num:
    return size(near(t, 1) & hot_tiles())

@gene('Z69a', 'value of casting an ability now: Z7a focus targeting with the Z4c Heart of Ruin dash onto targets', parents=['Z7a', 'Z4c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion:
                return 85 + 3 * (1 - o.unit.health_frac)
            if o.unit.is_camp and (is_awake(o.unit) or gems() == 0):
                return 64 + (1 - o.unit.health_frac)
            return 0
        if valid(o.tile):
            h = hits_at(o.tile)
            return 64 + h if h > 0 else 0
        return 0
    if k == AB_SHIELD:
        return 66 if hits_at(me().pos) > 0 or count(dist(u.pos, me().pos) <= 3 for u in enemies()) > 0 else 0
    if k == AB_RESET:
        if can_attack():
            return 0
        r = me().attack_range
        return 62 if any(dist(u.pos, me().pos) <= r for u in enemies()) or any(dist(c.pos, me().pos) <= r and (is_awake(c) or gems() == 0) for c in camps()) else 0
    if k == AB_HEAL:
        return 70 if exists(o.unit) and o.unit.health_frac < 0.6 else 0
    if k == AB_DASH:
        if not valid(o.tile):
            return 0
        if me().type == HEART_OF_RUIN and hits_at(o.tile) > 0:
            return 67
        return 51 if progress(o.tile) >= 2 else 0
    return 0

@gene('Z69b', 'no awake camp can reach me next turn and no enemy champion within 5: a recall here will not be cancelled', parents=['s1'])
def safe() -> Bool:
    if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
        return False
    return not any(is_awake(c) and dist(c.pos, me().pos) <= c.attack_range + 1 for c in camps())

@gene('Z69c', 'distance field to our spawn, for retreating', parents=['s1'])
def retreat_field() -> Field:
    return field(my_spawn())

@gene('Z127a', 'tiles holding enemy champions or camps we fight (awake, or any when carrying nothing), built once per pass', parents=['Z4b'])
def hot_tiles() -> Tiles:
    if gems() == 0:
        return enemy_tiles() | camp_tiles()
    acc = enemy_tiles()
    for c in camps():
        if is_awake(c):
            acc = acc | near(c.pos, 0)
    return acc

@gene('Z127b', 'skip option kinds that cannot score: wards, locks, cancels always; casts unless a target is within 6 or a dash is ready', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == CAST:
        if (slot_kind(0) == AB_DASH and slot_ready(0)) or (slot_kind(1) == AB_DASH and slot_ready(1)):
            return True
        if any(dist(u.pos, me().pos) <= 6 for u in enemies()):
            return True
        return any(dist(c.pos, me().pos) <= 6 and (is_awake(c) or gems() == 0) for c in camps())
    return True
