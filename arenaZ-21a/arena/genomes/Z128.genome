"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: default draft, casts in fights, focus the weakest target, recall to shop when rich and idle, recall when low only where it will not be cancelled, else walk away')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.35:
            return 90 if safe() else 0
        return 55 if shop_trip() else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        w = 1 - o.unit.health_frac
        if o.unit.is_champion:
            return 80 + 5 * w
        if is_awake(o.unit):
            return 61 + w
        return 60 + w if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if fleeing():
            return 75 if at(flee_field(), me().pos) - at(flee_field(), o.tile) > 0 else 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s3', 'distance field to the goals, or home when hurt or rich with spawn close, empty-handed and not in a fight')
def goal_field() -> Field:
    if gems() == 0 and not any(is_awake(c) and dist(c.pos, me().pos) <= 4 for c in camps()):
        if me().health_frac < 0.5:
            return field(my_spawn())
        if gold() >= 150 and dist(nearest(my_spawn(), me().pos), me().pos) <= 12:
            return field(my_spawn())
    return field(open_goals())

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z43a', 'where to walk: an altar with gems, else any living camp group', parents=['s3'])
def open_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z4b', 'number of awake camps and enemy champions within radius one of a tile', parents=['s1'])
def hits_at(t: Tile) -> Num:
    return count(dist(u.pos, t) <= 1 for u in enemies()) + count(dist(c.pos, t) <= 1 and is_awake(c) for c in camps())

@gene('Z4c', 'value of casting an ability now: burst the weakest champion or camp we fight, dash away when fleeing, Heart of Ruin dash onto clusters, shield in a fight', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion:
                return 85 + 3 * (1 - o.unit.health_frac)
            if o.unit.is_camp and (is_awake(o.unit) or gems() == 0):
                return 64 + (1 - o.unit.health_frac)
            return 0
        if valid(o.tile):
            h = hits_at(o.tile)
            return 64 + h if h > 0 else 0
        return 0
    if k == AB_SHIELD:
        return 66 if hits_at(me().pos) > 0 or count(dist(u.pos, me().pos) <= 3 for u in enemies()) > 0 else 0
    if k == AB_RESET:
        if can_attack():
            return 0
        r = me().attack_range
        if any(dist(u.pos, me().pos) <= r for u in enemies()):
            return 62
        return 62 if any(dist(c.pos, me().pos) <= r and (is_awake(c) or gems() == 0) for c in camps()) else 0
    if k == AB_HEAL:
        return 70 if exists(o.unit) and o.unit.health_frac < 0.6 else 0
    if k == AB_DASH:
        if not valid(o.tile):
            return 0
        if fleeing():
            return 80 if at(flee_field(), me().pos) - at(flee_field(), o.tile) >= 2 else 0
        if me().type == HEART_OF_RUIN and hits_at(o.tile) > 0:
            return 67
        return 52 if progress(o.tile) >= 2 else 0
    return 0

@gene('Z106a', 'low on health with an awake camp or enemy champion close: walk or dash home instead of fighting', parents=['s1'])
def fleeing() -> Bool:
    if me().health_frac >= 0.3:
        return False
    if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
        return True
    return any(is_awake(c) and dist(c.pos, me().pos) <= c.attack_range + 1 for c in camps())

@gene('Z106b', 'distance field to our spawn, for fleeing', parents=['s1'])
def flee_field() -> Field:
    return field(my_spawn())

@gene('Z87a', 'worth recalling to spend gold: at least 150 gold, carrying nothing, no enemy or awake camp near', parents=['s1'])
def shop_trip() -> Bool:
    if gold() < 150 or gems() > 0:
        return False
    if any(dist(u.pos, me().pos) <= 8 for u in enemies()):
        return False
    return not any(is_awake(c) and dist(c.pos, me().pos) <= 5 for c in camps())

@gene('Z87b', 'no awake camp can reach me next turn and no enemy champion within 5: a recall here will not be cancelled', parents=['s1'])
def safe() -> Bool:
    if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
        return False
    return not any(is_awake(c) and dist(c.pos, me().pos) <= c.attack_range + 1 for c in camps())
