"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now: draft Ryth, Vesper Vale, Vendetta, Varg, Tavi; casts, fight back, focus the weakest target and gem carriers, recall to shop when rich and idle; when low or outnumbered while hurt, recall only where it is safe, else walk away first')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    low = me().health_frac < 0.35 or (me().health_frac < 0.7 and outnumbered())
    if o.kind == RECALL:
        if low:
            return 90 if safe() else 0
        return 55 if shop_trip() else 0
    if o.kind == MOVE:
        if low and not safe():
            return 75 if at(retreat_field(), me().pos) - at(retreat_field(), o.tile) > 0 else 0
        return 50 if progress(o.tile) > 0 else 0
    if o.kind == CAST:
        if exists(o.unit) and o.unit.is_champion:
            return cast_value(o) + min(unit_gems(o.unit), 50) / 10
        return cast_value(o)
    if o.kind == ATTACK:
        w = 1 - o.unit.health_frac
        if o.unit.is_champion:
            return 80 + 5 * w + min(unit_gems(o.unit), 50) / 10
        if gems() == 0:
            return 60 + 1.5 * w
        return 58 + 1.5 * w if is_awake(o.unit) else 0
    if o.kind == TRIBUTE:
        return 70
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living camp group; a cleared group waiting for capture only if I am the closest visible ally, so the others move on and the reward is not split')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            ts = group_tiles(g)
            if group_reward(g):
                d = dist(nearest(ts, me().pos), me().pos)
                if not any(dist(nearest(ts, a.pos), a.pos) < d for a in allies()):
                    acc = acc | ts
            else:
                acc = acc | ts
    return acc

@gene('s3', 'distance field to the goals (computed once per turn in update), or home when hurt or rich (and spawn is close), empty-handed and not in a fight')
def goal_field() -> Field:
    if gems() == 0 and not any(is_awake(c) and dist(c.pos, me().pos) <= 4 for c in camps()):
        if me().health_frac < 0.5:
            return field(my_spawn())
        if gold() >= 150 and dist(nearest(my_spawn(), me().pos), me().pos) <= 12:
            return field(my_spawn())
    return GF

@gene('s4', 'how much closer a step brings me to the goals, or to spawn when fleeing')
def progress(t: Tile) -> Num:
    if fleeing():
        return at(spawn_field(), me().pos) - at(spawn_field(), t)
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z18a', 'once per turn: the distance field to the goals plus enemy champions worth hunting', parents=['s3'])
def update() -> None:
    GF = field(goals() | hunt_tiles())

@gene('Z180a', 'low on health with an awake camp or enemy champion close: walk or dash home instead of fighting', parents=['s4'])
def fleeing() -> Bool:
    if me().health_frac >= 0.3:
        return False
    if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
        return True
    return any(is_awake(c) and dist(c.pos, me().pos) <= c.attack_range + 1 for c in camps())

@gene('Z180b', 'distance field to our spawn', parents=['s4'])
def spawn_field() -> Field:
    return field(my_spawn())

@gene('Z150a', 'visible enemy champions worth hunting: badly hurt ones within 6 while I am healthy, or all within 8 when my visible allies (me included) outnumber them', parents=['s2'])
def hunt_tiles() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if me().health_frac < 0.5:
        return acc
    foes = count(dist(u.pos, me().pos) <= 8 for u in enemies())
    if foes == 0:
        return acc
    friends = 1 + count(dist(a.pos, me().pos) <= 8 for a in allies())
    for u in enemies():
        if dist(u.pos, me().pos) <= 8:
            if friends > foes and me().health_frac >= 0.6:
                acc = acc | near(u.pos, 1)
            elif u.health_frac < 0.35 and dist(u.pos, me().pos) <= 6:
                acc = acc | near(u.pos, 1)
    return acc

@gene('Z62a', 'draft preference: the default first three, then Varg and Tavi instead of the linked pair', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == RYTH:
        return 10
    if c == VESPER_VALE:
        return 9
    if c == VENDETTA:
        return 8
    if c == VARG:
        return 7
    if c == TAVI:
        return 6
    return 1

@gene('Z48a', 'worth recalling to spend gold: rich, carrying nothing, nobody near', parents=['s1'])
def shop_trip() -> Bool:
    if gold() < 150 or gems() > 0:
        return False
    if any(dist(u.pos, me().pos) <= 8 for u in enemies()):
        return False
    return not any(is_awake(c) and dist(c.pos, me().pos) <= 5 for c in camps())

@gene('Z7a', 'value of casting an ability now: damage on the weakest champion or camp we fight, shields in fights, resets with a target, dash home when fleeing or next to a badly hurt enemy champion, Heart of Ruin dash onto targets, dashes toward goals', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion:
                return 85 + 3 * (1 - o.unit.health_frac)
            if o.unit.is_camp and (is_awake(o.unit) or gems() == 0):
                return 64 + (1 - o.unit.health_frac)
            return 0
        if valid(o.tile):
            h = count(dist(u.pos, o.tile) <= 1 for u in enemies()) + count(dist(c.pos, o.tile) <= 1 and (is_awake(c) or gems() == 0) for c in camps())
            return 64 + h if h > 0 else 0
        return 0
    if k == AB_SHIELD:
        return 66 if any(is_awake(c) and dist(c.pos, me().pos) <= 4 for c in camps()) or any(dist(u.pos, me().pos) <= 3 for u in enemies()) else 0
    if k == AB_RESET:
        if can_attack():
            return 0
        r = me().attack_range
        return 62 if any(dist(u.pos, me().pos) <= r for u in enemies()) or any(dist(c.pos, me().pos) <= r and (is_awake(c) or gems() == 0) for c in camps()) else 0
    if k == AB_HEAL:
        return 70 if exists(o.unit) and o.unit.health_frac < 0.6 else 0
    if k == AB_DASH:
        if not valid(o.tile):
            return 0
        if fleeing():
            return 80 if progress(o.tile) >= 2 else 0
        if any(dist(u.pos, o.tile) <= 1 and u.health_frac < 0.4 for u in enemies()) and me().health_frac > 0.4:
            return 70
        if me().type == HEART_OF_RUIN:
            h = count(dist(u.pos, o.tile) <= 1 for u in enemies()) + count(dist(c.pos, o.tile) <= 1 and (is_awake(c) or gems() == 0) for c in camps())
            if h > 0:
                return 66 + h
        return 51 if progress(o.tile) >= 2 else 0
    return 0

@gene("Z73a", "no awake camp can reach me next turn and no enemy champion within 5: a recall here will not be cancelled", parents=["s1"])
def safe() -> Bool:
    if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
        return False
    return not any(is_awake(c) and dist(c.pos, me().pos) <= c.attack_range + 1 for c in camps())

@gene("Z73b", "distance field to our spawn, for retreating", parents=["s1"])
def retreat_field() -> Field:
    return field(my_spawn())

@gene('Z214a', 'the enemy champions within 5 outnumber me and my allies within 5 by two or more', parents=['s1'])
def outnumbered() -> Bool:
    foes = count(dist(u.pos, me().pos) <= 5 for u in enemies())
    if foes < 2:
        return False
    return foes >= 3 + count(dist(a.pos, me().pos) <= 5 for a in allies())
