"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

LOW: Num = 0.45
GF: Field = None
HURT: Bool = False
FIGHT: Bool = False
BAD: Tiles = None
STILL: Num = 0

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == RYTH:
            return 20
        if o.champ == VESPER_VALE:
            return 19
        if o.champ == VENDETTA:
            return 14
        if o.champ == CASSI:
            return 14
        if o.champ == TAVI:
            return 20
        return 1
    if o.kind == BUY:
        return 100 if o.item == 36 else 0
    if o.kind == RECALL:
        return 90 if HURT and not FIGHT else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        if (o.unit.type == MONOLITH or o.unit.type == GOLEM) and not is_awake(o.unit):
            return 0
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if STILL >= 2:
            return 40 + rand(10)
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z20a', 'value of casting an ability: damage on fights, heal and shield when hurt, dash toward goals')
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion:
                return 68
            if o.unit.is_camp and gems() == 0 and not ((o.unit.type == MONOLITH or o.unit.type == GOLEM) and not is_awake(o.unit)):
                return 81
        return 0
    if k == AB_HEAL:
        return 75 if me().health_frac < 0.7 else 0
    if k == AB_SHIELD:
        return 75 if me().health_frac < 0.8 and FIGHT else 0
    if k == AB_RESET:
        return 62 if not can_attack() else 0
    if k == AB_DASH:
        if valid(o.tile):
            return 86 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group without monoliths or golems")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    if not HURT:
        tgt = best(enemies(), lambda e: unit_gems(e) - dist(e.pos, me().pos) if e.is_champion and unit_gems(e) >= 20 and dist(e.pos, me().pos) <= 8 else -999)
        if exists(tgt) and unit_gems(tgt) >= 20 and dist(tgt.pos, me().pos) <= 8:
            return near(tgt.pos, 1) - near(tgt.pos, 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(gt & BAD) == 0:
                acc = acc | gt
    return acc

@gene("s4", "how much closer a step brings me to the goals (or home when hurt)")
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z20c', 'once per turn: retreat state, fight state, monolith and golem tiles, the walking field')
def update() -> None:
    hf = me().health_frac
    if hf < LOW:
        HURT = True
    if hf > 0.95 or not alive():
        HURT = False
    if size(BAD) == 0:
        BAD = type_spawns(MONOLITH) | type_spawns(GOLEM)
    FIGHT = count(e.is_champion for e in enemies()) > 0 or any(is_awake(c) and dist(c.pos, me().pos) <= 4 for c in camps())
    if (gold() >= 300 and gems() == 0) or HURT:
        GF = field(my_spawn())
    else:
        GF = field(goals())

@gene('Z156a', 'after the turn: count turns in a row with no action while away from the goal', parents=['Z20c', 's1'])
def after() -> None:
    if alive() and not channeling() and at(GF, me().pos) > 0 and not (acted(MOVE) or acted(ATTACK) or acted(CAST) or acted(TRIBUTE) or acted(RECALL) or acted(BUY)):
        STILL += 1
    else:
        STILL = 0

@gene('Z79a', 'skip option kinds never used, shopping away from spawn, recall unless hurt, tribute without gems')
def consider(kind: Num) -> Bool:
    if kind == BUY:
        return can_shop()
    if kind == RECALL:
        return HURT
    if kind == TRIBUTE:
        return gems() > 0
    return kind != WARD and kind != LOCK and kind != BUY_LOCK and kind != CANCEL
