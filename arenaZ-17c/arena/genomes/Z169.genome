"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z128a', 'value of doing this option now: abilities (shield in fights, dash toward goals), heal on spawn, health-aware fights, skip monoliths, tribute first', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    on_spawn = me().pos in my_spawn()
    if o.kind == RECALL:
        return 90 if hf < 0.4 and not on_spawn else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_HEAL:
            return 85 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_enemy:
                if o.unit.is_camp and o.unit.type == MONOLITH:
                    return 0
                return 85 if o.unit.is_champion else 55
        if k == AB_SHIELD:
            return 70 if hf < 0.8 and not on_spawn else 0
        if k == AB_DASH:
            if valid(o.tile) and not (on_spawn and hf < 0.9):
                p = progress(o.tile)
                return 52 + p if p >= 2 else 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac) if hf > 0.3 else 0
        if o.unit.is_camp and o.unit.type == MONOLITH:
            return 0
        return 60 if gems() < 30 and hf > 0.35 else 0
    if o.kind == TRIBUTE:
        return 92
    if o.kind == MOVE:
        if on_spawn and hf < 0.9:
            return 0
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: altar with gems (bank at 10, any after 1750, or when banking wins the game); else cleared groups waiting for capture first, else living non-monolith camps')
def goals() -> Tiles:
    g_now = gems()
    al = near(tile(-5, -5), 0)
    if g_now > 0:
        al = altar_goals()
    if g_now >= 10 or (g_now > 0 and (round() > 1750 or team_gems() + g_now >= 1000)):
        if size(al) > 0:
            return al
    mono = type_spawns(MONOLITH)
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            ts = group_tiles(g)
            if size(ts & mono) == 0:
                acc = acc | ts
    if size(rew) > 0:
        acc = rew
    if g_now > 0:
        acc = acc | al
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z128b', 'goal field once per turn; walk home when badly hurt, earlier with a big gem stack; goal search skipped while heading home (saves fuel); keep old field if no goals, skip while channeling', parents=['Z23a', 'Z20a'])
def update() -> None:
    if alive() and not channeling():
        hf = me().health_frac
        sp = my_spawn()
        if (hf < 0.3 or (gems() >= 20 and hf < 0.45)) and not (me().pos in sp):
            GF = field(sp)
        else:
            g = goals()
            if size(g) > 0:
                GF = field(g)

@gene('Z20b', 'free, walkable altar-adjacent tiles; if every altar is locked, beside locked ones (tribute there breaks the lock)', parents=['s2'])
def altar_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for a in altars() - locked_altars():
        acc = acc | near(a, 1)
    if size(acc) == 0:
        for a in altars():
            acc = acc | near(a, 1)
    return acc - walls() - holes()

@gene('s4', 'how much closer a step brings me to the goals (field read once); big gem carriers and badly hurt champions shy from enemy champions (cached per pass), harder the more gems carried and the more hurt')
def progress(t: Tile) -> Num:
    f = goal_field()
    here = me().pos
    d = at(f, here) - at(f, t)
    if d > 0:
        g = gems()
        hf = me().health_frac
        if g >= 15 or hf < 0.4:
            th = threat_tiles()
            if size(th) > 0:
                n = count(dist(e, t) <= 2 for e in th)
                d = d - (0.5 + g / 80 + (0.4 - hf if hf < 0.4 else 0)) * n
    return d

@gene('Z175a', 'enemy champion positions seen this pass (one vision query per pass instead of one per step option)', parents=['s4'])
def threat_tiles() -> Tiles:
    t0 = me().pos
    s = near(t0, 0) - near(t0, 0)
    for u in enemies():
        if u.is_champion:
            s = s | near(u.pos, 0)
    return s

@gene('Z57a', 'skip listing option kinds the policy never uses (saves fuel)', parents=['s1'])
def consider(kind: Num) -> Bool:
    return not (kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL)
