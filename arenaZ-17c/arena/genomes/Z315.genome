"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z128a', 'value of doing this option now: abilities (shield in fights, dash toward goals), heal on spawn, health-aware fights, skip monoliths, tribute first', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    on_spawn = me().pos in my_spawn()
    if o.kind == RECALL:
        return 90 if hf < 0.4 and not on_spawn else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_HEAL:
            return 85 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_enemy:
                if o.unit.is_camp and o.unit.type == MONOLITH:
                    return 0
                return 85 if o.unit.is_champion else 55
        if k == AB_SHIELD:
            return 70 if hf < 0.8 and not on_spawn else 0
        if k == AB_DASH:
            if valid(o.tile) and not (on_spawn and hf < 0.9):
                p = progress(o.tile)
                return 52 + p if p >= 1 else 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac) if hf > 0.3 else 0
        if o.unit.is_camp and o.unit.type == MONOLITH:
            return 0
        return 60 if gems() < 27 and hf > 0.35 else 0
    if o.kind == TRIBUTE:
        return 92
    if o.kind == MOVE:
        if on_spawn and hf < 0.9:
            return 0
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: altar with gems (bank at 10, any after 1750, when banking wins the game, or when hurt carrying 5+); else cleared groups waiting for capture first, else living non-monolith camps (golem groups only after round 600 or if nothing else); altars only computed when carrying')
def goals() -> Tiles:
    g_now = gems()
    al = near(tile(-5, -5), 0)
    if g_now > 0:
        al = altar_goals()
    bank = g_now >= 10
    if g_now > 0 and (round() > 1750 or team_gems() + g_now >= 1000):
        bank = True
    if g_now >= 5 and me().health_frac < 0.5:
        bank = True
    if bank:
        if size(al) > 0:
            return al
    mono = type_spawns(MONOLITH)
    golem = type_spawns(GOLEM)
    early = round() < 600
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    hard = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            ts = group_tiles(g)
            if size(ts & mono) == 0:
                if early and size(ts & golem) > 0:
                    hard = hard | ts
                else:
                    acc = acc | ts
    if size(acc) == 0:
        acc = hard
    if size(rew) > 0:
        acc = rew
    if g_now > 0:
        acc = acc | al
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z128b', 'goal field once per turn; walk home when badly hurt, earlier with a big gem stack; goal search skipped while heading home (saves fuel); keep old field if no goals, skip while channeling', parents=['Z23a', 'Z20a'])
def update() -> None:
    if alive() and not channeling():
        hf = me().health_frac
        if hf < 0.3 or (gems() >= 20 and hf < 0.45):
            sp = my_spawn()
            if not (me().pos in sp):
                GF = field(sp)
        else:
            g = goals()
            if size(g) > 0:
                GF = field(g)

@gene('Z20b', 'free, walkable altar-adjacent tiles, preferring altars with no visible enemy champion within 3; if every altar is locked, beside locked ones (tribute there breaks the lock)', parents=['s2'])
def altar_goals() -> Tiles:
    ec = enemy_champ_tiles()
    acc = near(tile(-5, -5), 0)
    risky = near(tile(-5, -5), 0)
    for a in altars() - locked_altars():
        if size(near(a, 3) & ec) == 0:
            acc = acc | near(a, 1)
        else:
            risky = risky | near(a, 1)
    if size(acc) == 0:
        acc = risky
    if size(acc) == 0:
        for a in altars():
            acc = acc | near(a, 1)
    return acc - walls() - holes()

@gene('s4', 'how much closer a step brings me to the goals (field read once); gem carriers (10+) and hurt champions shy from enemy champions (cheap tile-mask test, adjacent ones count extra), harder the more gems carried and the lower my health, softened when allies are near the step')
def progress(t: Tile) -> Num:
    f = goal_field()
    d = at(f, me().pos) - at(f, t)
    if d > 0:
        g = gems()
        hf = me().health_frac
        if g >= 10 or hf < 0.5749:
            ec = enemy_champ_tiles()
            n = size(near(t, 2) & ec)
            if n > 0:
                n1 = size(near(t, 1) & ec)
                w = 0.5 + g / 80
                if hf < 0.4:
                    w = w + 0.5
                na = max(size(near(t, 2) & ally_tiles()) - 1, 0)
                d = d - w * (n + 0.5 * n1) / (1 + 0.5 * na)
    return d

@gene('Z185a', 'tiles holding visible enemy champions (one engine mask per pass instead of iterating enemies per option)', parents=['s4'])
def enemy_champ_tiles() -> Tiles:
    return enemy_tiles() - camp_tiles()

@gene('Z57a', 'skip listing option kinds the policy never uses (saves fuel)', parents=['s1'])
def consider(kind: Num) -> Bool:
    return not (kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL)
