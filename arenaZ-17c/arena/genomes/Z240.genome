"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEAL: Bool = False

@gene('Z290a', 'value of doing this option now: abilities (shield in fights, dash toward goals), heal on spawn, health-aware fights preferring hurt camps and finishing low or gem-rich champions, skip monoliths, tribute first', parents=['Z128a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    on_spawn = me().pos in my_spawn()
    if o.kind == RECALL:
        return 90 if hf < 0.4 and not on_spawn else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_HEAL:
            return 85 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_enemy:
                if o.unit.is_camp and o.unit.type == MONOLITH:
                    return 0
                return 85 if o.unit.is_champion else 55
        if k == AB_SHIELD:
            return 70 if hf < 0.8 and not on_spawn else 0
        if k == AB_DASH:
            if valid(o.tile) and not (on_spawn and hf < 0.9):
                p = progress(o.tile)
                return 52 + p if p >= 1 else 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            uh = o.unit.health_frac
            if hf > 0.3 or uh < 0.25:
                return 80 + 10 * (1 - uh) + min(unit_gems(o.unit) / 10, 5)
            return 0
        if o.unit.is_camp and o.unit.type == MONOLITH:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() < 27 and hf > 0.35 else 0
    if o.kind == TRIBUTE:
        return 92
    if o.kind == MOVE:
        if on_spawn and hf < 0.9:
            return 0
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: altar with gems (bank at 10, any after 1750, or when banking wins the game); else cleared groups first, else living non-monolith camps')
def goals() -> Tiles:
    g_now = gems()
    al = near(tile(-5, -5), 0)
    if g_now > 0:
        al = altar_goals()
    if g_now >= 10 or (g_now > 0 and (round() > 1750 or team_gems() + g_now >= 1000)):
        if size(al) > 0:
            return al
    mono = type_spawns(MONOLITH)
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            ts = group_tiles(g)
            if size(ts & mono) == 0:
                acc = acc | ts
    if size(rew) > 0:
        acc = rew
    if g_now > 0:
        acc = acc | al
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z128b', 'goal field once per turn; walk home when badly hurt or hurt with a big stack and stay healing until 85% (hysteresis); goals skipped while heading home (saves fuel)', parents=['Z23a', 'Z20a'])
def update() -> None:
    if alive() and not channeling():
        hf = me().health_frac
        if hf < 0.3 or (gems() >= 20 and hf < 0.45):
            HEAL = True
        if hf >= 0.85:
            HEAL = False
        if HEAL:
            GF = field(my_spawn())
        else:
            g = goals()
            if size(g) > 0:
                GF = field(g)

@gene('Z20b', 'free, walkable altar-adjacent tiles; if every altar is locked, beside locked ones (tribute there breaks the lock)', parents=['s2'])
def altar_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for a in altars() - locked_altars():
        acc = acc | near(a, 1)
    if size(acc) == 0:
        for a in altars():
            acc = acc | near(a, 1)
    return acc - walls() - holes()

@gene('Z290b', 'how much closer a step brings me to the goals (field read once); gem carriers (10+) and hurt champions shy from enemy champions only, skipping the per-tile test when none are visible, harder the more gems carried and the lower my health', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    d = at(f, me().pos) - at(f, t)
    if d > 0:
        g = gems()
        hf = me().health_frac
        if g >= 10 or hf < 0.5749:
            foes = foe_champ_mask()
            if size(foes) > 0:
                n = size(near(t, 2) & foes)
                if n > 0:
                    w = 0.5 + g / 80
                    if hf < 0.4:
                        w = w + 0.5
                    d = d - w * n
    return d

@gene('Z281a', 'tiles holding visible enemy champions (camps excluded, they are our goals), one mask per pass', parents=['s4'])
def foe_champ_mask() -> Tiles:
    return enemy_tiles() - camp_tiles()

@gene('Z57a', 'skip listing option kinds the policy never uses, and shopping when we cannot shop (saves fuel)', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop()
    return True
