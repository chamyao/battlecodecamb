"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z52a', 'value of doing this option now: abilities (shield in fights, dash toward goals), heal on spawn, health-aware fights, tribute first', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    hf = me().health_frac
    on_spawn = me().pos in my_spawn()
    if o.kind == RECALL:
        return 90 if hf < 0.4 and not on_spawn else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_HEAL:
            return 85 if hf < 0.6 else 0
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit) and o.unit.is_enemy:
                return 85 if o.unit.is_champion else 55
        if k == AB_SHIELD:
            return 70 if hf < 0.8 and not on_spawn else 0
        if k == AB_DASH:
            if valid(o.tile) and not (on_spawn and hf < 0.9):
                p = progress(o.tile)
                return 52 + p if p >= 2 else 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac) if hf > 0.3 else 0
        return 60 if gems() < 30 and hf > 0.35 else 0
    if o.kind == TRIBUTE:
        return 88
    if o.kind == MOVE:
        if on_spawn and hf < 0.9:
            return 0
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: altar with 10+ gems, or any gems late or when an altar is close; else capturable or living non-monolith camps (altar joins when carrying)')
def goals() -> Tiles:
    g_now = gems()
    al = near(tile(-5, -5), 0)
    close = False
    if g_now > 0:
        al = altar_goals()
        if size(al) > 0:
            na = nearest(al, me().pos)
            if valid(na) and dist(na, me().pos) <= 4:
                close = True
    if g_now >= 10 or (g_now > 0 and (round() > 1800 or close)):
        if size(al) > 0:
            return al
    mono = type_spawns(MONOLITH)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
        elif not group_respawning(g):
            ts = group_tiles(g)
            if size(ts & mono) == 0:
                acc = acc | ts
    if g_now > 0:
        acc = acc | al
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z20a', 'compute the goal distance field once per turn (keep the old field if no goals)', parents=['s3'])
def update() -> None:
    if alive():
        gl = goals()
        if size(gl) > 0:
            GF = field(gl)

@gene('Z20b', 'free, walkable altar-adjacent tiles', parents=['s2'])
def altar_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for a in altars() - locked_altars():
        acc = acc | near(a, 1)
    return acc - walls()

@gene('s4', 'how much closer a step brings me to the goals; gem carriers shy away from enemy champions')
def progress(t: Tile) -> Num:
    f = goal_field()
    d = at(f, me().pos) - at(f, t)
    if d > 0 and gems() >= 15:
        d = d - 0.4 * count(u.is_champion and dist(u.pos, t) <= 2 for u in enemies())
    return d
