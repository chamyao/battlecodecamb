"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False

@gene('Z61a', 'value of doing this option now: finish low enemies, keep hitting awake camps that fight us; recall uses retreat state', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if LOW:
            return 0
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.is_camp and is_awake(o.unit) and me().health_frac > 0.35:
            return 50
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar once carrying enough gems (or late/no camps), else cleared groups to capture and living non-monolith camp groups')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    altar_set = empty
    if gems() > 0:
        for a in altars() - locked_altars():
            altar_set = altar_set | near(a, 1)
    if gems() >= 20 or (gems() > 0 and round() > 1850):
        if size(altar_set) > 0:
            return altar_set
    acc = empty
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if round() < 1200:
        acc = acc - type_spawns(MONOLITH)
    if size(acc) == 0:
        return altar_set
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields)')
def progress(t: Tile) -> Num:
    if LOW:
        return at(HF, me().pos) - at(HF, t)
    return at(GF, me().pos) - at(GF, t)

@gene('Z4a', 'compute the goal field once per turn; retreat home earlier (40%, or 50% when carrying many gems) with hysteresis; home field cached once', parents=['s4'])
def update() -> None:
    hf = me().health_frac
    if LOW:
        if hf > 0.9:
            LOW = False
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    if LOW:
        if not HSET:
            HF = field(my_spawn())
            HSET = True
    else:
        GF = goal_field()

@gene('Z61b', 'cast value: focus low enemies, fight awake camps, shield vs nearby threats, dash toward goals/home, escape dash when low', parents=['Z4b'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 75 + 20 * (1 - o.unit.health_frac)
            if o.unit.is_camp and not LOW:
                if gems() == 0:
                    return 55 + 10 * (1 - o.unit.health_frac)
                if is_awake(o.unit) and hf > 0.35:
                    return 50
        return 0
    if k == AB_SHIELD:
        if hf < 0.95:
            if any(dist(u.pos, m.pos) <= 4 for u in enemies()):
                return 72
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, m.pos) <= 2 for c in camps()):
                return 70
        return 0
    if k == AB_HEAL:
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if hf < 0.35 and not LOW:
                if any(dist(u.pos, m.pos) <= 5 for u in enemies()):
                    home = nearest(my_spawn(), m.pos)
                    if valid(home):
                        gain = dist(m.pos, home) - dist(o.tile, home)
                        if gain >= 2:
                            return 74 + gain
                return 0
            p = progress(o.tile)
            if LOW:
                return 74 + p if p >= 2 else 0
            if p >= 2 and (hf > 0.5 or gems() > 0):
                return 45 + p
        return 0
    return 0
