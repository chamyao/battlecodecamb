"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False
ET: Tiles = None
HEALING: Bool = False
RECALLING: Bool = False
GSIG: Num = -1
GAGE: Num = 0

@gene('Z109a', 'value of doing this option now; do not break recalls, heal up on spawn, safe recall from the LOW state; focus low and gem-rich enemies, finish awake camps even with gems', parents=['Z72a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if RECALLING or HEALING:
            return 0
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if me().health_frac < 0.25 and o.unit.health_frac > 0.3:
                return 0
            return 80 + 8 * (1 - o.unit.health_frac) + unit_gems(o.unit) / 10
        if RECALLING or LOW:
            return 0
        if gems() == 0:
            return 60 + 4 * (1 - o.unit.health_frac)
        if is_awake(o.unit):
            return 55 + 4 * (1 - o.unit.health_frac)
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if RECALLING or HEALING:
            return 0
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar once carrying enough gems (or late/no camps left), else cleared groups to capture and living camp groups, never monoliths solo')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    camps_acc = empty
    for g in range(num_groups()):
        if group_reward(g) or not group_respawning(g):
            camps_acc = camps_acc | group_tiles(g)
    camps_acc = camps_acc - type_spawns(MONOLITH)
    gm = gems()
    go_altar = gm >= 20 or (gm > 0 and (round() > 1850 or size(camps_acc) == 0))
    if go_altar:
        acc = empty
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    return camps_acc

@gene('s3', 'distance field to the given goals')
def goal_field(g: Tiles) -> Field:
    return field(g)

@gene('Z109b', 'how much closer a step brings me to the goals, or home when retreating (cached fields), avoiding tiles near visible enemies while retreating; 0 when unreachable', parents=['s4'])
def progress(t: Tile) -> Num:
    here = me().pos
    if LOW:
        a = at(HF, here)
        b = at(HF, t)
        if a >= 100000000 or b >= 100000000:
            return 0
        dnow = sum(1 for e in ET if dist(e, here) <= 2)
        dthere = sum(1 for e in ET if dist(e, t) <= 2)
        return a - b + 0.6 * (dnow - dthere)
    a = at(GF, here)
    b = at(GF, t)
    if a >= 100000000 or b >= 100000000:
        return 0
    return a - b

@gene('Z109c', 'per turn: note recall/healing state, retreat hysteresis (40%/50% with gems, until 90%), cached home field, enemy tiles when retreating, goal field rebuilt only when goals change or every 6 turns', parents=['Z72b', 'Z4a'])
def update() -> None:
    hf = me().health_frac
    RECALLING = is_recalling(me())
    HEALING = hf < 0.9 and (me().pos in my_spawn())
    if LOW:
        if hf > 0.9:
            LOW = False
            GSIG = -1
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    if LOW:
        if not HSET:
            HF = field(my_spawn())
            HSET = True
        if not RECALLING and not HEALING:
            ET = enemy_tiles()
    else:
        g = goals()
        sig = goal_signature(g)
        GAGE += 1
        if sig != GSIG or GAGE >= 6:
            GF = goal_field(g)
            GSIG = sig
            GAGE = 0

@gene('Z107a', 'cheap fingerprint of a tile set so the goal field is rebuilt only when goals change', parents=['s3'])
def goal_signature(g: Tiles) -> Num:
    return size(g) * 7919 + sum(t.x * 131 + t.y * 17 for t in g)

@gene('Z109d', 'value of casting: finish low enemies, CC tributers or to escape, keep fighting awake camps (not while recalling), shield in fights, heal lowest, dash toward goals or home (not while recalling/healing), dash onto weak enemies', parents=['Z4b', 'Z72c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    mp = m.pos
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if o.unit.health_frac < 0.4:
                    return 85 + 5 * (1 - o.unit.health_frac)
                if k == AB_CC and is_tributing(o.unit):
                    return 90
                if k == AB_CC and LOW:
                    return 88
                return 75 + 5 * (1 - o.unit.health_frac)
            if o.unit.is_camp and not RECALLING:
                bonus = 4 * (1 - o.unit.health_frac)
                if gems() == 0 and not LOW:
                    return 55 + bonus
                if is_awake(o.unit) and dist(o.unit.pos, mp) <= 2 and hf > 0.35:
                    return 55 + bonus
        return 0
    if k == AB_SHIELD:
        if hf < 0.9:
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 72
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 72
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 + 5 * (1 - o.unit.health_frac) if o.unit.health_frac < 0.6 else 0
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if RECALLING or HEALING:
            return 0
        if valid(o.tile):
            p = progress(o.tile)
            if LOW:
                return 50 + p if p >= 2 else 0
            if hf > 0.6:
                if any(u.is_champion and u.health_frac < 0.35 and dist(u.pos, o.tile) <= 1 for u in enemies()):
                    return 70
            if hf > 0.5:
                return 42 + p if p >= 2 else 0
        return 0
    return 0

@gene('Z50a', 'recall when retreating and no enemy champion close enough to interrupt it', parents=['s1'])
def recall_value() -> Num:
    if not LOW:
        return 0
    if at(HF, me().pos) <= 6:
        return 0
    mp = me().pos
    if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
        return 0
    return 90
