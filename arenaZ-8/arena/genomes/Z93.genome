"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False
HEALING: Bool = False
ETS: Tiles = None

@gene('Z106a', 'value of doing this option now: finish low enemies, keep hitting awake camps, safe recall, heal fully on spawn, walk to goals or home', parents=['s1', 'Z45a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if HEALING:
            return 0
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.is_camp and is_awake(o.unit) and me().health_frac > 0.35:
            return 50
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if HEALING:
            return 0
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living non-monolith camp group (monoliths only if nothing else)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    mono = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if count(spawn_type(t) == MONOLITH for t in gt) > 0:
                mono = mono | gt
            else:
                acc = acc | gt
    if size(acc) == 0:
        return mono
    return acc

@gene('s3', 'distance field to the goals, never routing through the enemy spawn (it heals them and kills us)')
def goal_field() -> Field:
    g = goals()
    es = enemy_spawn()
    if size(es) == 0:
        return field(g)
    return field_avoid(g, es - g, g)

@gene('Z106b', 'how much closer a step brings me to the goals, or home when retreating (cached fields, steering away from enemies while retreating); 0 when unreachable or healing on spawn', parents=['s4', 'Z45b'])
def progress(t: Tile) -> Num:
    if HEALING:
        return 0
    f = HF if LOW else GF
    p = me().pos
    a = at(f, p)
    b = at(f, t)
    if a >= 100000000 or b >= 100000000:
        return 0
    d = a - b
    if LOW:
        dm = count(dist(e, p) <= 2 for e in ETS)
        dt = count(dist(e, t) <= 2 for e in ETS)
        d = d - 0.6 * (dt - dm)
    return d

@gene('Z106c', 'once per turn: heal on spawn, retreat at 40% (50% with many gems) with hysteresis, cached home field and enemy tiles when retreating, else goal field', parents=['Z4a', 'Z45c'])
def update() -> None:
    m = me()
    hf = m.health_frac
    HEALING = m.pos in my_spawn() and hf < 0.95
    if LOW:
        if hf > 0.9:
            LOW = False
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    if LOW:
        if not HSET:
            HF = field(my_spawn())
            HSET = True
        if not HEALING:
            ETS = enemy_tiles()
    else:
        if not HEALING:
            GF = goal_field()

@gene('Z106d', 'value of casting: finish low enemies, CC to escape or stop tributes, focus camps, shield in fights, heal lowest, emergency dash home when threatened, dash toward goals or onto weak enemies', parents=['Z4b', 'Z45d'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    mp = m.pos
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if o.unit.health_frac < 0.4:
                    return 85 + 5 * (1 - o.unit.health_frac)
                if k == AB_CC and is_tributing(o.unit):
                    return 90
                if k == AB_CC and LOW:
                    return 88
                return 75 + 5 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                bonus = 4 * (1 - o.unit.health_frac)
                if gems() == 0:
                    return 55 + bonus
                if is_awake(o.unit) and hf > 0.35 and dist(o.unit.pos, mp) <= 2:
                    return 55 + bonus
        return 0
    if k == AB_SHIELD:
        if hf < 0.9:
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 72
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 72
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 + 5 * (1 - o.unit.health_frac) if o.unit.health_frac < 0.6 else 0
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if hf < 0.35 and any(dist(u.pos, mp) <= 5 for u in enemies()):
                home = nearest(my_spawn(), mp)
                if valid(home):
                    gain = dist(mp, home) - dist(o.tile, home)
                    if gain >= 2:
                        return 74 + gain
            p = progress(o.tile)
            if LOW:
                return 50 + p if p >= 2 else 0
            if hf > 0.6:
                if any(u.is_champion and u.health_frac < 0.35 and dist(u.pos, o.tile) <= 1 for u in enemies()):
                    return 70
            if p >= 2 and (hf > 0.5 or gems() > 0):
                return 42 + p
        return 0
    return 0

@gene('Z50a', 'recall when retreating and no enemy champion close enough to interrupt it', parents=['s1'])
def recall_value() -> Num:
    if not LOW:
        return 0
    if at(HF, me().pos) <= 6:
        return 0
    mp = me().pos
    if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
        return 0
    return 90
