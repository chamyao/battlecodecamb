"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False
GT: Tiles = None
GSET: Bool = False

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the given goal tiles')
def goal_field(g: Tiles) -> Field:
    return field(g)

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields)')
def progress(t: Tile) -> Num:
    if LOW:
        return at(HF, me().pos) - at(HF, t)
    return at(GF, me().pos) - at(GF, t)

@gene('Z4a', 'retreat home earlier (40%, or 50% with many gems) with hysteresis; home field cached once; goal field recomputed only when the goal set changes', parents=['s4'])
def update() -> None:
    hf = me().health_frac
    if LOW:
        if hf > 0.9:
            LOW = False
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    if LOW:
        if not HSET:
            HF = field(my_spawn())
            HSET = True
    else:
        g = goal_tiles()
        if (not GSET) or size((g - GT) | (GT - g)) > 0:
            GT = g
            GF = goal_field(g)
            GSET = True

@gene('Z46a', 'goal tiles; fall back to all camp spawns when no goal is known so the bot explores', parents=['s3'])
def goal_tiles() -> Tiles:
    g = goals()
    if size(g) == 0:
        return camp_spawns()
    return g

@gene('Z4b', 'value of casting an ability option; focus low targets, shield in fights, dash also when retreating', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 75 + 5 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 55 + 4 * (1 - o.unit.health_frac)
        return 0
    if k == AB_SHIELD:
        if hf < 0.85 and count_units(enemies()) > 0:
            return 72
        return 0
    if k == AB_HEAL:
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            return 65 + p if p >= 2 else 0
        return 0
    return 0
