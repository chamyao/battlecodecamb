"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False
ENEAR: Num = 0
WEAKE: Bool = False

@gene('s1', 'value of doing this option now; recall follows the LOW retreat state and avoids recalling next to enemy champions')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 74 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields); 0 when either end is unreachable')
def progress(t: Tile) -> Num:
    f = HF if LOW else GF
    a = at(f, me().pos)
    b = at(f, t)
    if a >= 100000000 or b >= 97459987:
        return 0
    return a - b

@gene('Z4a', 'compute the goal field once per turn; retreat home earlier (40%, or 50% when carrying many gems) with hysteresis; home field cached once; cache nearby enemy-champion info for casts', parents=['s4'])
def update() -> None:
    hf = me().health_frac
    mp = me().pos
    if LOW:
        if hf > 0.9:
            LOW = False
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    n = 0
    w = False
    for u in enemies():
        if u.is_champion:
            d = dist(u.pos, mp)
            if d <= 4:
                n += 1
            if d <= 6 and u.health_frac < 0.35:
                w = True
    ENEAR = n
    WEAKE = w
    if LOW:
        if not HSET:
            HF = field(my_spawn())
            HSET = True
    else:
        GF = goal_field()

@gene('Z4b', 'value of casting an ability option; finish low enemy champions first, shield in close fights (also while retreating), heal the lowest target, dash toward goals or home, dash onto weak enemies when healthy; uses cached enemy info', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    mp = m.pos
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if o.unit.health_frac < 0.4:
                    return 85
                if k == AB_CC and is_tributing(o.unit):
                    return 90
                if LOW and k == AB_CC:
                    return 80
                return 75
            if o.unit.is_camp:
                if gems() == 0:
                    return 55
                if is_awake(o.unit) and dist(o.unit.pos, mp) <= max(2, slot_range(o.slot)):
                    return 55
        return 0
    if k == AB_SHIELD:
        if ENEAR > 0 and (hf < 0.9 or ENEAR >= 2):
            return 72
        if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
            return 72
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 if o.unit.health_frac < 0.6 else 0
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if LOW:
                if ENEAR > 0 and p >= 1:
                    return 60 + p
                return 50 + p if p >= 2 else 0
            if hf > 0.6 and WEAKE:
                if any(u.is_champion and u.health_frac < 0.35 and dist(u.pos, o.tile) <= 1 for u in enemies()):
                    return 70
            if hf > 0.5:
                return 42 + p if p >= 2 else 0
        return 0
    return 0

@gene('Z50a', 'recall when retreating and no enemy champion close enough to interrupt it', parents=['s1'])
def recall_value() -> Num:
    if not LOW:
        return 0
    if at(HF, me().pos) <= 6:
        return 0
    mp = me().pos
    if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
        return 0
    return 90
