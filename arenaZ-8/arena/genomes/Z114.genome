"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False

@gene('Z103a', 'value of doing this option now: draft the ladder-top champions, safe recall when retreating, finish low enemies (only very low ones while retreating), attack camps while not banking, keep hitting awake camps that fight us', parents=['s1', 'Z75a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if LOW and o.unit.health_frac > 0.3:
                return 0
            return 80 + 10 * (1 - o.unit.health_frac)
        if LOW:
            return 0
        if not banking():
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.is_camp and is_awake(o.unit) and me().health_frac > 0.35:
            return 50
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('Z30b', 'whether I should head to an altar with my gems now: enough gems, a winning tribute, late game or hurt while carrying', parents=['s2'])
def banking() -> Bool:
    g = gems()
    if g <= 0:
        return False
    if g >= 15:
        return True
    if team_gems() + g >= 1000:
        return True
    return round() > 1800 or me().health_frac < 0.6

@gene('Z30c', 'where to walk: an altar with enough gems, else a cleared group to capture, else a living non-monolith camp group', parents=['s2'])
def goals() -> Tiles:
    if banking():
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    ready = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(gt & mono) == 0:
                acc = acc | gt
                if group_reward(g):
                    ready = ready | gt
    if size(ready) > 0:
        return ready
    if size(acc) == 0 and gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields); 0 when either end is unreachable')
def progress(t: Tile) -> Num:
    f = HF if LOW else GF
    a = at(f, me().pos)
    b = at(f, t)
    if a >= 100000000 or b >= 97459987:
        return 0
    return a - b

@gene('Z4a', 'compute the goal field once per turn; retreat home earlier (40%, or 50% when carrying many gems) with hysteresis; home field cached once', parents=['s4'])
def update() -> None:
    hf = me().health_frac
    if LOW:
        if hf > 0.9:
            LOW = False
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    if LOW:
        if not HSET:
            HF = field(my_spawn())
            HSET = True
    else:
        GF = goal_field()

@gene('Z155a', 'draft preference following the top ladder drafts', parents=['Z103a'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 10
    if c == HEART_OF_RUIN:
        return 9
    if c == MARCELLA:
        return 8
    if c == VENDETTA:
        return 7
    if c == RYTH:
        return 6
    return 1

@gene('Z155b', 'skip listing option kinds the policy never takes (wards, locks, cancels) to save fuel', parents=['Z103a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    return True

@gene('Z103b', 'cast value: finish low enemy champions and stun tributers, fight camps unless banking, shield vs nearby threats, heal lowest ally, dash toward goals/home, escape dash when low, dash onto weak enemies', parents=['Z4b', 'Z75b'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    mp = m.pos
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if k == AB_CC and is_tributing(o.unit):
                    return 95
                return 75 + 20 * (1 - o.unit.health_frac)
            if o.unit.is_camp and not LOW:
                if not banking():
                    return 55 + 10 * (1 - o.unit.health_frac)
                if is_awake(o.unit) and hf > 0.35:
                    return 50
        return 0
    if k == AB_SHIELD:
        if hf < 0.9:
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 72
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 72
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 if o.unit.health_frac < 0.6 else 0
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if hf < 0.35 and not LOW:
                if any(u.is_champion and dist(u.pos, mp) <= 5 for u in enemies()):
                    home = nearest(my_spawn(), mp)
                    if valid(home):
                        gain = dist(mp, home) - dist(o.tile, home)
                        if gain >= 2:
                            return 74 + gain
                return 0
            p = progress(o.tile)
            if LOW:
                return 74 + p if p >= 2 else 0
            if hf > 0.6:
                if any(u.is_champion and u.health_frac < 0.35 and dist(u.pos, o.tile) <= 1 for u in enemies()):
                    return 70
            if p >= 2 and (hf > 0.5 or gems() > 0):
                return 45 + p
        return 0
    return 0

@gene('Z50a', 'recall when retreating and no enemy champion close enough to interrupt it', parents=['s1'])
def recall_value() -> Num:
    if not LOW:
        return 0
    if at(HF, me().pos) <= 6:
        return 0
    mp = me().pos
    if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
        return 0
    return 90
