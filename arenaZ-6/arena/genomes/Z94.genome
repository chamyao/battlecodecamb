"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('s1', 'value of doing this option now; casts abilities, focuses weak targets')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.9423
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 94 if me().health_frac < 0.3399 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 7 * (1 - o.unit.health_frac)
        return 60 + 5 * (0.7266 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar with enough gems, cleared groups to capture, else valuable living camps')
def goals() -> Tiles:
    empty = near(tile(-5, -5), 0)
    me_u = me()
    if me_u.health_frac < 0.3 and gems() < 10:
        return my_spawn()
    if gems() >= 10 or (gems() > 0 and (round() > 1850 or me_u.health_frac < 0.45)):
        acc = empty
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    reward = empty
    rich = empty
    alive_g = empty
    for g in range(num_groups()):
        if group_reward(g):
            reward = reward | group_tiles(g)
        elif not group_respawning(g):
            alive_g = alive_g | group_tiles(g)
            if group_gems(g) + group_gold(g) > 0:
                rich = rich | group_tiles(g)
    if size(reward) > 0:
        return reward
    if size(rich) > 0:
        return rich
    if size(alive_g) > 0:
        return alive_g
    if gems() > 0:
        acc = empty
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    return alive_g

@gene('s3', 'distance field to the goals, cached per turn')
def goal_field() -> Field:
    return GOAL_FIELD

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z49a', 'value of casting an ability at a unit; favours finishing and CC on enemy champions', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if not exists(o.unit):
        return 0
    u = o.unit
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if u.is_enemy and u.is_champion:
            v = 85 + 10 * (1.3203 - u.health_frac)
            if u.health_frac < 0.3:
                v += 12
            if k == AB_CC:
                v += 4
            return v
        if u.is_camp and gems() == 0:
            return 62
        return 0
    if k == AB_HEAL or k == AB_SHIELD:
        if (not u.is_enemy) and (not u.is_camp) and u.health_frac < 0.6:
            return 88
        return 0
    return 0

@gene('Z5a', 'goal field cached once per turn', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())
