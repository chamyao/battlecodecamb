"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z71a', 'value of doing this option now; casts damage/cc at targets, heals/shields when hurt', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + (1 - o.unit.health_frac) * 5
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else cleared groups awaiting capture, else living camps (groups within 8, then 16 tiles, then all); single pass over groups')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    rew = near(tile(-5, -5), 0)
    n8 = near(tile(-5, -5), 0)
    n16 = near(tile(-5, -5), 0)
    all_live = near(tile(-5, -5), 0)
    z8 = near(me().pos, 8)
    z16 = near(me().pos, 16)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if group_reward(g):
                rew = rew | gt
            all_live = all_live | gt
            if size(z8 & gt) > 0:
                n8 = n8 | gt
            if size(z16 & gt) > 0:
                n16 = n16 | gt
    if size(rew) > 0:
        return rew
    if size(n8) > 0:
        return n8
    if size(n16) > 0:
        return n16
    return all_live

@gene('Z71b', 'compute the goal distance field once per turn into a keep', parents=['s3'])
def update() -> None:
    GF = field(goals())

@gene('Z71c', 'closer step toward goals, minus a penalty for enemy champions and awake monsters within 3 tiles, weighted by health', parents=['s4'])
def progress(t: Tile) -> Num:
    step = at(GF, me().pos) - at(GF, t)
    danger = sum((1.3 if u.is_champion else 0.4) * u.health_frac for u in enemies() if dist(u.pos, t) <= 3)
    return step * 2 - danger * 3

@gene('Z24a', 'value of casting an ability option at a unit target', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_HEAL or k == AB_SHIELD:
        return 85 if me().health_frac < 0.5 else 0
    if not exists(o.unit):
        return 0
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if o.unit.is_champion and o.unit.is_enemy:
            return 82
        if o.unit.is_camp and gems() == 0:
            return 58
    return 0
