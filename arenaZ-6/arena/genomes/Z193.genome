"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None
DANGER: Tiles

@gene('s1', 'value of doing this option now; casts abilities, focuses weak targets')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.9423
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 8 * (1 - o.unit.health_frac)
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: altar with gems (fallback any altar), else cleared reward group first, else a living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 1)
        return acc
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    return acc

@gene('s3', 'distance field to the goals, cached per turn')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'closer to goals, flat penalty if the step lies within 2 tiles of an enemy, bonus for stepping out of danger (cached set)')
def progress(t: Tile) -> Num:
    base = at(goal_field(), me().pos) - at(goal_field(), t)
    danger = 1.0 if t in DANGER else 0.0
    here = 1.0 if me().pos in DANGER else 0.0
    return base - 1.5 * danger + 0.5 * here * (1.0 - danger)

@gene('Z49a', 'value of casting an ability at a unit', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if not exists(o.unit):
        return 0
    u = o.unit
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if u.is_enemy and u.is_champion:
            return 85 + 10 * (1 - u.health_frac)
        if u.is_camp and gems() == 0:
            return 62
        return 0
    if k == AB_HEAL or k == AB_SHIELD:
        if (not u.is_enemy) and (not u.is_camp) and u.health_frac < 0.6:
            return 88
        return 0
    return 0

@gene('Z5a', 'goal field and enemy-danger tiles cached once per turn', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())
    DANGER = DANGER - DANGER
    for u in enemies():
        DANGER = DANGER | near(u.pos, 2)
