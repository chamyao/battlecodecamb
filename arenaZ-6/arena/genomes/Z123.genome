"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z71a', 'value of doing this option now; casts damage/cc at targets, heals/shields when hurt, recalls when low, tributes when carrying gems', parents=['s1', 'Z71a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.2:
            return 90
        return 58 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 88 + (1 - o.unit.health_frac) * 5
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70 if gems() > 0 else 0
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('Z83a', 'skip option kinds that never score (wards, locks, cancels) to save fuel', parents=['Z71a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == BUY_LOCK or kind == LOCK or kind == CANCEL:
        return False
    return True

@gene('s2', 'where to walk: an altar with gems, else cleared groups awaiting capture, else living camps (groups within 8 tiles first, then the nearest living group)', parents=['Z71a', 's2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    my_zone = near(me().pos, 8)
    near_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(my_zone & gt) > 0:
                near_acc = near_acc | gt
    if size(near_acc) > 0:
        return near_acc
    best_g = -1
    best_d = 1000
    for g in range(num_groups()):
        if not group_respawning(g):
            d = dist(nearest(group_tiles(g), me().pos), me().pos)
            if d < best_d:
                best_d = d
                best_g = g
    if best_g >= 0:
        return group_tiles(best_g)
    return acc

@gene('Z71b', 'compute the goal distance field once per turn into a keep', parents=['Z71b'])
def update() -> None:
    GF = field(goals())

@gene('Z145a', 'enemy occupancy mask, computed once per pass', parents=['Z145a'])
def threat_tiles() -> Tiles:
    return enemy_tiles()

@gene('Z71c', 'closer step toward goals, minus a penalty per enemy within 3 tiles of the step (heavier when hurt, then when carrying gems)', parents=['Z71b', 's4'])
def progress(t: Tile) -> Num:
    step = at(GF, me().pos) - at(GF, t)
    th = threat_tiles()
    if size(th) == 0:
        return step * 2
    danger = size(near(t, 3) & th)
    w = 2
    if me().health_frac < 0.4:
        w = 6
    elif gems() > 0:
        w = 4
    return step * 2 - danger * w

@gene('Z24a', 'value of casting an ability option: heal/shield when hurt, damage/cc enemy champions (more when they are low), camps when empty-handed', parents=['Z24a', 's1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_HEAL or k == AB_SHIELD:
        return 168 if me().health_frac < 0.5 else 0
    if not exists(o.unit):
        return 0
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if o.unit.is_champion and o.unit.is_enemy:
            return 90 + (1 - o.unit.health_frac) * 10
        if o.unit.is_camp and gems() == 0:
            return 50
    return 0
