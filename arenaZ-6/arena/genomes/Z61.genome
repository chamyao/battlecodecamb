"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene("s1", "value of doing this option now", parents=["s1"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 93 if me().health_frac < 0.1938 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 76 if progress(o.tile) > 0 else 0
    return 0

@gene('Z96a', 'where to walk: an altar with gems (any altar if all are locked), else cleared groups awaiting capture, else living camps (groups within 8 tiles first)', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    my_zone = near(me().pos, 8)
    near_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(my_zone & gt) > 0:
                near_acc = near_acc | gt
    if size(near_acc) > 0:
        return near_acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('Z96b', 'how much closer a step brings me to the goals; steps toward nearby enemy champions are penalized', parents=['s4'])
def progress(t: Tile) -> Num:
    here = at(goal_field(), me().pos)
    there = at(goal_field(), t)
    if here >= 100000 or there >= 100000:
        return 0
    p = here - there
    for u in enemies():
        if u.is_champion and dist(u.pos, t) <= 2 and dist(u.pos, t) < dist(u.pos, me().pos):
            p -= 2
    return p

@gene('Z47a', 'goal distance field cached once per turn in update()', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())
