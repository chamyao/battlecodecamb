"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now; also casts damage/cc at targets and heals/shields when hurt')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 83 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + (1 - o.unit.health_frac) * 5
        return 49 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 51 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else cleared groups awaiting capture, else living camps (groups within 8 tiles first)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    my_zone = near(me().pos, 8)
    near_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(my_zone & gt) > 0:
                near_acc = near_acc | gt
    if size(near_acc) > 0:
        return near_acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to goals avoiding walls and enemy-occupied tiles, searched near me')
def goal_field() -> Field:
    return field_avoid(goals(), walls() | enemy_tiles(), near(me().pos, 30))

@gene('s4', 'closer to goals by field distance, minus 2 per enemy champion within 3 tiles of the step')
def progress(t: Tile) -> Num:
    f = goal_field()
    d = at(f, me().pos) - at(f, t)
    danger = count(u.is_champion and dist(u.pos, t) <= 3 for u in enemies())
    return d - danger * 2

@gene('Z24a', 'value of casting an ability option at a unit target', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_HEAL or k == AB_SHIELD:
        return 100 if me().health_frac < 0.5 else 0
    if not exists(o.unit):
        return 0
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if o.unit.is_champion and o.unit.is_enemy:
            return 82
        if o.unit.is_camp and gems() == 0:
            return 58
    return 0
