"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z71a', 'value of doing this option now; casts damage/cc at targets, heals/shields when hurt', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + (1 - o.unit.health_frac) * 5
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: spawn when badly hurt, altar when carrying enough gems (or late/low on health), else cleared groups awaiting capture, else living camps (within 8, then 16, then all); single pass over groups')
def goals() -> Tiles:
    m = me()
    hp = m.health_frac
    if hp < 0.3 and size(my_spawn()) > 0:
        return my_spawn()
    g0 = gems()
    alt = near(tile(-5, -5), 0)
    if g0 > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        urgent = g0 >= 30 or round() > 1700 or hp < 0.55 or team_gems() + g0 >= 1000
        if urgent and size(alt) > 0:
            return alt
    rew = near(tile(-5, -5), 0)
    nearc = near(tile(-5, -5), 0)
    midc = near(tile(-5, -5), 0)
    allc = near(tile(-5, -5), 0)
    z8 = near(m.pos, 8)
    z16 = near(m.pos, 16)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            allc = allc | gt
            if group_reward(g):
                rew = rew | gt
            if size(z16 & gt) > 0:
                midc = midc | gt
                if size(z8 & gt) > 0:
                    nearc = nearc | gt
    if size(rew) > 0:
        return rew
    if size(nearc) > 0:
        return nearc
    if size(midc) > 0:
        return midc
    if size(allc) > 0:
        return allc
    return alt

@gene('Z71b', 'compute the goal distance field once per turn into a keep', parents=['s3'])
def update() -> None:
    GF = field(goals())

@gene('Z71c', 'closer step toward goals, minus a danger penalty for enemy champions and awake monsters within 3 tiles, scaled up when my champion is hurt', parents=['s4'])
def progress(t: Tile) -> Num:
    step = at(GF, me().pos) - at(GF, t)
    danger = sum((1.3 if u.is_champion else 0.4) * u.health_frac for u in enemies() if dist(u.pos, t) <= 3)
    fear = 1 + (1 - me().health_frac) * 2
    return step * 2 - danger * 3 * fear

@gene('Z24a', 'value of casting an ability option at a unit target', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_HEAL or k == AB_SHIELD:
        return 85 if me().health_frac < 0.5 else 0
    if not exists(o.unit):
        return 0
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if o.unit.is_champion and o.unit.is_enemy:
            return 82
        if o.unit.is_camp and gems() == 0:
            return 58
    return 0
