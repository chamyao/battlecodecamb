"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z71a', 'value of doing this option now: picks, buys, recalls, fights, casts, tributes, and steps toward goals', parents=['s1', 'Z71a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.9423
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 5 * (1 - o.unit.health_frac)
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: heal at spawn when low, altar once enough gems (or late/no camps), else cleared reward group, else a living camp group', parents=['s2'])
def goals() -> Tiles:
    hf = me().health_frac
    g0 = gems()
    if hf < 0.3 and g0 < 20:
        return my_spawn()
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    farm = size(rew) + size(acc)
    if g0 > 0 and (g0 >= 25 or round() > 1800 or farm == 0 or hf < 0.45):
        alt = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if size(alt) == 0:
            for a in altars():
                alt = alt | near(a, 1)
        if size(alt) > 0:
            return alt
    if size(rew) > 0:
        return rew
    if size(acc) > 0:
        return acc
    if g0 > 0:
        alt2 = near(tile(-5, -5), 0)
        for a in altars():
            alt2 = alt2 | near(a, 1)
        return alt2
    return enemy_spawn()

@gene('s3', 'goal distance field, computed once per turn in update()', parents=['s3'])
def goal_field() -> Field:
    return GF

@gene('Z71c', 'closer step toward goals, minus a danger penalty for enemy champions and awake monsters within 3 tiles, scaled up when hurt', parents=['s4', 'Z71c'])
def progress(t: Tile) -> Num:
    step = at(goal_field(), me().pos) - at(goal_field(), t)
    danger = sum((1.3 if u.is_champion else 0.4) * u.health_frac for u in enemies() if dist(u.pos, t) <= 3)
    fear = 1 + (1 - me().health_frac) * 2
    return step * 2 - danger * 3 * fear

@gene('Z49a', 'value of casting an ability at a unit: damage/cc on enemies and camps, heal/shield on hurt allies', parents=['Z49a', 'Z24a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_HEAL or k == AB_SHIELD:
        if not exists(o.unit):
            return 85 if me().health_frac < 0.5 else 0
        if (not o.unit.is_enemy) and (not o.unit.is_camp) and o.unit.health_frac < 0.6:
            return 88
        return 0
    if not exists(o.unit):
        return 0
    u = o.unit
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if u.is_enemy and u.is_champion:
            return 85 + 10 * (1 - u.health_frac)
        if u.is_camp and gems() == 0:
            return 62
        return 0
    return 0

@gene('Z5a', 'goal distance field cached once per turn', parents=['Z71b', 'Z5a'])
def update() -> None:
    GF = field(goals())
