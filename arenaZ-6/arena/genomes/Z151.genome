"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z71a', 'value of doing this option now; casts damage/cc at targets, heals/shields when hurt, focuses weak targets', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.9423
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 91 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 8 * (1 - o.unit.health_frac)
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else cleared groups awaiting capture, else living camps (nearby first, then gem-bearing groups, then all)', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    my_zone = near(me().pos, 8)
    near_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(my_zone & gt) > 0:
                near_acc = near_acc | gt
    if size(near_acc) > 0:
        return near_acc
    rich = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            rich = rich | group_tiles(g)
    if size(rich) > 0:
        return rich
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z71b', 'compute the goal distance field once per turn into a keep', parents=['s3', 'Z5a'])
def update() -> None:
    GF = field(goals())

@gene('Z71c', 'closer step toward goals, minus a penalty for enemy champions and awake monsters within 3 tiles, weighted by health', parents=['s4'])
def progress(t: Tile) -> Num:
    step = at(GF, me().pos) - at(GF, t)
    danger = sum((1.3 if u.is_champion else 0.4) * u.health_frac for u in enemies() if dist(u.pos, t) <= 3)
    return step * 2 - danger * 3

@gene('Z24a', 'value of casting an ability: damage/cc on enemy champions and camps, heal/shield on hurt allies or self', parents=['Z49a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_HEAL or k == AB_SHIELD:
        if not exists(o.unit):
            return 85 if me().health_frac < 0.5 else 0
        u = o.unit
        if (not u.is_enemy) and (not u.is_camp) and u.health_frac < 0.6:
            return 88
        return 96 if me().health_frac < 0.5 else 0
    if not exists(o.unit):
        return 0
    u = o.unit
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if u.is_enemy and u.is_champion:
            return 85 + 10 * (1 - u.health_frac)
        if u.is_camp and gems() == 0:
            return 62
        return 0
    return 0
