"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene('s1', 'value of doing this option now; casts damage/CC on enemy champions and heals low-health self')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 93 if me().health_frac < 0.1938 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 76 if progress(o.tile) > 0 else 0
    if o.kind == CAST:
        if not slot_ready(o.slot):
            return 0
        k = slot_kind(o.slot)
        if k == AB_HEAL:
            return 95 if (me().health_frac < 0.5 and o.unit.is_champion and not o.unit.is_enemy) else 0
        if k == AB_DAMAGE or k == AB_CC:
            return 85 if (o.unit.is_champion and o.unit.is_enemy) else 0
        return 0
    return 0

@gene('Z52a', 'list attack, move, pick, buy, recall, tribute and cast options; skip buy/tribute/recall when they cannot act', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == BUY:
        return can_shop()
    if kind == TRIBUTE:
        return gems() > 0
    if kind == RECALL:
        return me().health_frac < 0.1938
    return kind == PICK or kind == ATTACK or kind == MOVE or kind == CAST

@gene('s2', 'where to walk: an altar with gems, else cleared groups awaiting capture, else living camps (groups within 8 tiles first)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    my_zone = near(me().pos, 8)
    near_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(my_zone & gt) > 0:
                near_acc = near_acc | gt
    if size(near_acc) > 0:
        return near_acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached per turn in update())', parents=['s3'])
def goal_field() -> Field:
    return GOAL_FIELD

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z47a', 'goal distance field cached once per turn in update()', parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())
