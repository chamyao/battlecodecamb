"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
GT: Tiles

@gene('Z71a', 'value of doing this option now; casts damage/cc at targets, heals/shields when hurt, focuses weak targets; recall only when no enemy champion is close (damage cancels it); retreating moves get a higher base', parents=['s1', 'Z71a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.9423
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.3:
            close = count(u.is_champion and dist(u.pos, me().pos) <= 4 for u in enemies())
            return 90 if close == 0 else 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 8 * (1 - o.unit.health_frac)
        return 60 + 5 * (0.9647 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        base = 60 if RETREAT else 50
        return base + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: home to heal when badly hurt (or to shop when rich and close), an altar with gems, else cleared groups awaiting capture, else living camps (groups within 8 tiles first, then gem-bearing groups)', parents=['s2'])
def goals() -> Tiles:
    hf = me().health_frac
    home = my_spawn()
    if hf < 0.3 and size(home) > 0:
        return home
    if gems() == 0 and gold() >= 120 and size(home) > 0:
        if dist(nearest(home, me().pos), me().pos) <= 14:
            return home
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    my_zone = near(me().pos, 8)
    near_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(my_zone & gt) > 0:
                near_acc = near_acc | gt
    if size(near_acc) > 0:
        return near_acc
    gem_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            gem_acc = gem_acc | group_tiles(g)
    if size(gem_acc) > 0:
        return gem_acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z660a', 'retreat to spawn to heal when badly hurt, or when moderately hurt with an enemy champion close, or earlier when carrying gems with a champion close (hysteresis, release at 70-90% health); recompute the goal distance field only when the goal set changes (saves fuel)', parents=['Z71b'])
def update() -> None:
    hf = me().health_frac
    near_foes = sum(1 for u in enemies() if u.is_champion and dist(u.pos, me().pos) <= 6)
    carrying = gems() >= 10
    if hf < 0.35 or (hf < 0.6 and near_foes > 0) or (hf < 0.8 and carrying and near_foes > 0):
        RETREAT = True
    if hf >= 0.9 or (hf >= 0.7 and near_foes == 0):
        RETREAT = False
    tgt = my_spawn() if RETREAT else goals()
    if size(GT) == 0 or size(tgt - GT) > 0 or size(GT - tgt) > 0:
        GF = field(tgt)
        GT = tgt

@gene('Z660b', 'closer step toward goals (or home when retreating), weighted up while carrying gems, quadratic health-scaled penalty for strong enemy champions and awake monsters nearby, extra caution when carrying gems, bonus near allies, and a chase bonus toward weak enemy champions when healthy', parents=['Z71c'])
def progress(t: Tile) -> Num:
    mp = me().pos
    step = at(GF, mp) - at(GF, t)
    myhf = me().health_frac
    hunting = (not RETREAT) and myhf > 0.6
    danger = 0
    chase = 0
    for u in enemies():
        dt = dist(u.pos, t)
        if dt <= 3:
            if u.is_champion:
                if not (hunting and u.health_frac < 0.35):
                    danger += 4 * u.health_frac
            elif is_awake(u):
                danger += 0.4 * u.health_frac
        if hunting and u.is_champion and u.health_frac < 0.35 and dt <= 6:
            chase += (dist(u.pos, mp) - dt) * 4 * (1 + unit_gems(u) / 50)
    support = sum(0.8 for a in allies() if a.pos != mp and dist(a.pos, t) <= 3)
    hurt = 1 - myhf
    caution = (1 + hurt * hurt * 5) * (1 + min(gems(), 100) / 200)
    weight = 3 if RETREAT else 2
    if gems() > 0:
        weight += 1
    return step * weight - danger * 3 * caution + support + chase

@gene('Z24a', 'value of an ability: damage/cc on enemy champions and camps (bonus for finishing low-health targets, extra bonus for cc on champions, crowd bonus for AoE on clustered champions, penalty for casting at low health), heal/shield on hurt allies or self; ground-targeted casts scored by what is inside the radius', parents=['Z49a', 'Z106a', 'Z24a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if not exists(o.unit):
        if valid(o.tile):
            return ground_cast_value(o, k)
        if k == AB_HEAL or k == AB_SHIELD:
            return 85 if me().health_frac < 0.5 else 0
        return 0
    u = o.unit
    if k == AB_HEAL or k == AB_SHIELD:
        if (not u.is_enemy) and (not u.is_camp):
            if u.health_frac < 0.65:
                return 88
            if k == AB_SHIELD and u.health_frac < 0.85:
                if any(e.is_champion and dist(e.pos, u.pos) <= 4 for e in enemies()):
                    return 86
        return 85 if me().health_frac < 0.5 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if u.is_enemy and u.is_champion:
            finish = 12 if u.health_frac < 0.3 else 0
            cc = 6 if k == AB_CC else 0
            crowd = 5 * count(e.is_champion and dist(e.pos, u.pos) <= 2 for e in enemies()) if k == AB_AOE else 0
            caster_pen = 15 if me().health_frac < 0.3 else 0
            return 85 + 10 * (1 - u.health_frac) + finish + cc + crowd - caster_pen
        if u.is_camp and gems() == 0:
            return 60 + 8 * (1 - u.health_frac)
        return 0
    return 0

@gene('Z106a', 'value of a ground-targeted cast: enemy champions in the radius (single pass; weighted up when low health, extra for cc, bonus for awake camps caught, penalty for waking sleeping camps), camps when farming, hurt allies for heal/shield, and dashes that close distance to the goal field (higher when retreating, avoided next to healthy enemy champions)', parents=['Z49a', 'Z106a', 'B-ground'])
def ground_cast_value(o: Option, k: Num) -> Num:
    r = max(slot_radius(o.slot), 1)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        n = 0
        low = 0
        for e in enemies():
            if e.is_champion and dist(e.pos, o.tile) <= r:
                n += 1
                if e.health_frac < 0.3:
                    low += 1
        if n > 0:
            cc_bonus = 6 if k == AB_CC else 0
            aoe_bonus = 6 if (k == AB_AOE and n >= 2) else 0
            awake = 0
            sleeping = 0
            for cm in camps():
                if dist(cm.pos, o.tile) <= r:
                    if is_awake(cm):
                        awake += 1
                    else:
                        sleeping += 1
            return 84 + 4 * n + 6 * low + cc_bonus + aoe_bonus + min(awake, 3) - 3 * min(sleeping, 2)
        if gems() == 0:
            nc = count(dist(cm.pos, o.tile) <= r for cm in camps())
            if nc > 0:
                return 60 + nc
        return 0
    if k == AB_HEAL or k == AB_SHIELD:
        n = count(a.health_frac < 0.6 and dist(a.pos, o.tile) <= r for a in allies())
        if n > 0:
            return 86 + 2 * n
        if me().health_frac < 0.5 and dist(me().pos, o.tile) <= r:
            return 85
        return 0
    if k == AB_DASH:
        return dash_value(o)
    return 0

@gene('Z584a', 'value of a dash to a tile: fast progress along the goal field, higher while retreating, refused when landing next to a healthy enemy champion', parents=['Z106a'])
def dash_value(o: Option) -> Num:
    here = at(GF, me().pos)
    there = at(GF, o.tile)
    if there >= 1000000 or here >= 1000000:
        return 0
    gain = here - there
    if gain < 2:
        return 0
    if any(e.is_champion and e.health_frac > 0.4 and dist(e.pos, o.tile) <= 2 for e in enemies()):
        return 0
    if RETREAT:
        return 70 + 2 * gain
    return 25 + gain
