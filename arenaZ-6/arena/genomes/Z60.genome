"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None
HEALING: Bool = False

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: spawn if retreating to heal, altar if carrying enough gems (or no loot left / late game), else cleared groups awaiting capture, else living camp groups with loot')
def goals(healing: Bool) -> Tiles:
    if healing and size(my_spawn()) > 0:
        return my_spawn()
    g0 = gems()
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    rewards = acc
    want_altar = g0 >= 25 or (g0 > 0 and size(rewards) == 0) or (g0 > 0 and round() > 1850) or (g0 > 0 and team_gems() + g0 >= 1000)
    if want_altar:
        alt = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if size(alt) == 0:
            for a in altars():
                alt = alt | near(a, 1)
        if size(alt) > 0:
            return alt
    if size(rewards) > 0:
        return rewards
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) + group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) == 0:
        for g in range(num_groups()):
            if not group_respawning(g):
                acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, cached per turn')
def goal_field() -> Field:
    return GOAL_FIELD

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z5a', 'goal field cached once per turn; tracks low-health retreat with hysteresis', parents=['s3'])
def update() -> None:
    hf = me().health_frac
    if hf < 0.3:
        HEALING = True
    if hf > 0.9:
        HEALING = False
    GOAL_FIELD = field(goals(HEALING))
