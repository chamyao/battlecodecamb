"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False

@gene('Z71a', 'value of doing this option now; casts damage/cc at targets, heals/shields when hurt, focuses weak targets; recall only when no enemy champion is close; monster attacks worth something while carrying gems; no camp fights while retreating; retreating moves get a higher base', parents=['s1', 'Z71a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.9423
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.35 and close_champs() == 0:
            return 90
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 8 * (1 - o.unit.health_frac)
        if RETREAT:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 25
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        base = 60 if RETREAT else 50
        return base + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: home to heal when badly hurt (or to shop when rich and close), an altar with gems, else cleared groups awaiting capture, else living camps (groups within 8 tiles first, then gem-bearing groups)', parents=['s2'])
def goals() -> Tiles:
    hf = me().health_frac
    home = my_spawn()
    if hf < 0.3 and size(home) > 0:
        return home
    if gems() == 0 and gold() >= 150 and size(home) > 0:
        if dist(nearest(home, me().pos), me().pos) <= 10:
            return home
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    my_zone = near(me().pos, 8)
    near_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(my_zone & gt) > 0:
                near_acc = near_acc | gt
    if size(near_acc) > 0:
        return near_acc
    gem_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            gem_acc = gem_acc | group_tiles(g)
    if size(gem_acc) > 0:
        return gem_acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z71b', 'compute the goal distance field once per turn; retreat to spawn to heal when badly hurt, when moderately hurt with an enemy champion close, when hurt while carrying gems, or earlier when carrying gems with a champion close (hysteresis)', parents=['Z71b', 's3', 'Z5a'])
def update() -> None:
    hf = me().health_frac
    near_foes = sum(1 for u in enemies() if u.is_champion and dist(u.pos, me().pos) <= 6)
    carrying = gems() >= 10
    if hf < 0.3 or (hf < 0.6 and near_foes > 0) or (hf < 0.45 and gems() >= 10) or (hf < 0.8 and carrying and near_foes > 0):
        RETREAT = True
    if hf >= 0.9:
        RETREAT = False
    if RETREAT:
        GF = field(my_spawn())
    else:
        GF = field(goals())

@gene('Z71c', 'closer step toward goals (or home when retreating), weighted up while carrying gems, with a quadratic health-scaled penalty for enemy champions and awake monsters within 4 tiles (enemy list cached per pass), plus a bonus for standing near allies', parents=['Z71c', 's4'])
def progress(t: Tile) -> Num:
    mp = me().pos
    step = at(GF, mp) - at(GF, t)
    danger = sum((3 if u.is_champion else 0.4) * u.health_frac for u in seen_enemies() if dist(u.pos, t) <= 4)
    support = sum(0.5 for a in allies() if a.pos != mp and dist(a.pos, t) <= 3)
    hurt = 1 - me().health_frac
    caution = 1 + hurt * hurt * 6
    weight = 3 if RETREAT else 2
    if gems() > 0:
        weight += 1
    return step * weight - danger * 3 * caution + support

@gene('Z418a', 'enemy units seen this pass (one engine call per pass instead of one per move option)', parents=['Z71c'])
def seen_enemies() -> Units:
    return enemies()

@gene('Z418b', 'number of enemy champions within 5 tiles of me', parents=['Z71a'])
def close_champs() -> Num:
    return count(u.is_champion and dist(u.pos, me().pos) <= 5 for u in seen_enemies())

@gene('Z24a', 'value of an ability: damage/cc on enemy champions and camps (bonus for finishing low-health targets, extra bonus for cc on champions, crowd bonus for AoE on clustered champions, health-weighted damage), heal/shield on hurt allies or self; ground-targeted casts scored by what is inside the radius', parents=['Z24a', 'Z49a', 'Z106a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if not exists(o.unit):
        if valid(o.tile):
            return ground_cast_value(o, k)
        if k == AB_HEAL or k == AB_SHIELD:
            return 85 if me().health_frac < 0.5 else 0
        return 0
    u = o.unit
    if k == AB_HEAL or k == AB_SHIELD:
        if (not u.is_enemy) and (not u.is_camp):
            if u.health_frac < 0.6:
                return 88
            if k == AB_SHIELD and u.health_frac < 0.85:
                if any(e.is_champion and dist(e.pos, u.pos) <= 4 for e in enemies()):
                    return 86
        return 85 if me().health_frac < 0.5 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if u.is_enemy and u.is_champion:
            finish = 12 if u.health_frac < 0.3 else 0
            cc = 6 if k == AB_CC else 0
            crowd = 5 * count(e.is_champion and dist(e.pos, u.pos) <= 2 for e in seen_enemies()) if k == AB_AOE else 0
            return 85 + 10 * (0.6093 - u.health_frac) + finish + cc + crowd
        if u.is_camp and gems() == 0:
            return 60 + 8 * (1 - u.health_frac)
        return 0
    return 0

@gene('Z106a', 'value of a ground-targeted cast: enemy champions (weighted by how hurt they are, extra for low health and cc) or camps inside the radius, allies hurt inside the radius weighted by missing health; damage casts penalized per allied unit caught in the radius (friendly fire)', parents=['Z106a', 'Z49a'])
def ground_cast_value(o: Option, k: Num) -> Num:
    r = max(slot_radius(o.slot), 1)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        n = sum(1 + (1 - e.health_frac) for e in enemies() if e.is_champion and dist(e.pos, o.tile) <= r)
        if n > 0:
            low = count(e.is_champion and e.health_frac < 0.4 and dist(e.pos, o.tile) <= r for e in enemies())
            cc_bonus = 6 if k == AB_CC else 0
            friends = max(count(dist(a.pos, o.tile) <= r for a in allies()) - 1, 0)
            return 84 + 4 * n + 8 * low + cc_bonus - 12 * friends
        if gems() == 0 and me().health_frac > 0.5:
            nc = count(dist(cm.pos, o.tile) <= r for cm in camps())
            if nc > 0:
                return 60 + nc
        return 0
    if k == AB_HEAL or k == AB_SHIELD:
        n = sum(1 - a.health_frac for a in allies() if a.health_frac < 0.6 and dist(a.pos, o.tile) <= r)
        if n > 0:
            return 86 + 4 * n
        return 0
    return 0
