"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: prefers ladder-meta picks, focuses low-health targets, uses abilities on enemies, camps, heals, shields and dashes')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3587 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 9 * (1 - o.unit.health_frac)
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70 if gems() > 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 30 * p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to goals; retreats to spawn earlier (below 50% health) when carrying gems')
def goal_field() -> Field:
    thresh = 0.35
    if gems() > 0:
        thresh = 0.5
    if me().health_frac < thresh:
        return field(my_spawn())
    return field(goals())

@gene('s4', 'progress toward goals, with a bonus for stepping onto a goal tile')
def progress(t: Tile) -> Num:
    f = goal_field()
    d = at(f, me().pos) - at(f, t)
    if t in goals():
        d += 2
    return d

@gene('c44a', 'draft preference following the top ladder drafts, preferring champions not yet on our team', parents=['s1'])
def pick_value(c: Num) -> Num:
    v = 1
    if c == VESPER_VALE:
        v = 6
    elif c == HEART_OF_RUIN:
        v = 5
    elif c == MARCELLA:
        v = 4
    elif c == VENDETTA:
        v = 3
    elif c == RYTH:
        v = 2
    if picked_by_us(c):
        v = v - 4.5
    return max(v, 0.5)

@gene('c44b', 'value of casting an ability option', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_HEAL:
        return 75 if me().health_frac < 0.6 else 0
    if k == AB_SHIELD:
        if me().health_frac < 0.85:
            return 75
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            return 35 * p if p > 1 else 0
        return 0
    return 0
