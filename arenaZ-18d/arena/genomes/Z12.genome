"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now; strong draft, abilities, Treasure emblem first then Power strength')
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VENDETTA:
            return 10
        if o.champ == VESPER_VALE:
            return 9
        if o.champ == MARCELLA:
            return 8
        if o.champ == RYTH:
            return 7
        if o.champ == HEART_OF_RUIN:
            return 6
        if o.champ == VARG:
            return 5
        return 1
    if o.kind == BUY:
        if items_owned(19) == 0:
            return 100 if o.item == 18 else 0
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living camp group that is not a monolith')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(gt & mono) == 0:
                acc = acc | gt
    return acc

@gene('s3', 'distance field to the goals (cached once per turn)')
def goal_field() -> Field:
    return GF

@gene('Z12a', 'once per turn: cache the distance field to the goals', parents=['s3'])
def update() -> None:
    GF = field(goals())

@gene('Z12b', 'skip listing option kinds the policy never uses (wards, locks)', parents=['s3'])
def consider(kind: Num) -> Bool:
    return kind != WARD and kind != LOCK and kind != BUY_LOCK

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z9a', 'value of casting an ability: damage and stuns on fight targets, resets after an attack, shields when hurt, heals on hurt allies, dashes toward goals', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC or k == AB_AOE:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85
            if o.unit.is_camp:
                return 75 if gems() == 0 or is_awake(o.unit) else 0
            return 0
        if valid(o.tile):
            return 78 if o.tile in fight_tiles() else 0
        return 0
    if k == AB_RESET:
        return 55 if not can_attack() and target_in_reach() else 0
    if k == AB_SHIELD:
        return 70 if me().health_frac < 0.85 and target_in_reach() else 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 if o.unit.health_frac < 0.6 else 0
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            return 45 if progress(o.tile) >= 2 else 0
        return 0
    return 0

@gene('Z9b', 'tiles holding enemy champions or camps', parents=['s1'])
def fight_tiles() -> Tiles:
    return enemy_tiles() | camp_tiles()

@gene('Z9c', 'an enemy champion or a camp is within my basic attack range', parents=['s1'])
def target_in_reach() -> Bool:
    r = me().attack_range
    p = me().pos
    return any(dist(u.pos, p) <= r for u in enemies()) or any(dist(u.pos, p) <= r for u in camps())
