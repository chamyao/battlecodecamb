"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: cast abilities, dash toward goals, never recall, treasure then bruiser health shards; tuned')
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == REN:
            return 10
        if o.champ == TAVI:
            return 9
        if o.champ == MARCELLA:
            return 8
        return 1
    if o.kind == BUY:
        if items_owned(19) == 0:
            return 100 + o.count if o.item == 18 else 0
        return 100 + o.count if o.item == 40 else 0
    if o.kind == CAST:
        if slot_kind(o.slot) == AB_DASH:
            return 40 if progress(o.tile) > 1 else 0
        k = slot_kind(o.slot)
        if k == AB_RESET:
            if can_attack():
                return 0
            if any(dist(u.pos, me().pos) <= me().attack_range for u in enemies()):
                return 75
            return 75 if gems() < 5 and any(dist(u.pos, me().pos) <= me().attack_range for u in camps()) else 0
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() < 5 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s3', 'distance field to the goals, hunting gem carriers within 8 tiles')
def goal_field() -> Field:
    return field(goals_h68())

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z134a', 'where to walk: home below 40 percent health when empty-handed, an altar with gems, else a living camp group or an enemy champion within 8 carrying 6+ gems', parents=['s2'])
def goals_h68() -> Tiles:
    if gems() == 0 and me().health_frac < 0.4:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for e in enemies():
        if e.is_champion and unit_gems(e) >= 6 and dist(e.pos, me().pos) <= 8:
            acc = acc | near(e.pos, 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z4b', 'value of casting an ability: damage and control on enemies or camps, heal or shield when hurt', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_HEAL or k == AB_SHIELD:
        return 85 if me().health_frac < 0.6 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit) and o.unit.is_enemy:
            return 82 if o.unit.is_champion else 65
    return 0
