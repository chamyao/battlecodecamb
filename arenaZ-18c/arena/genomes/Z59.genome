"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('Z65a', 'value of doing this option now: casts on targets, dashes toward goals, never recalls, treasure then bruiser health shards; tuned: never recall, bruiser health, heal below 40 percent', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.4166
    if o.kind == BUY:
        if items_owned(19) == 0:
            return 100 + o.count if o.item == 18 else 0
        if items_owned(37) == 0:
            return 100 + o.count if o.item == 40 else 0
        return 100 + o.count if o.item == 40 else 0
    if o.kind == RECALL:
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if exists(o.unit) and o.unit.is_enemy:
            if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
                return 78 if o.unit.is_champion else 62
        if k == AB_DASH:
            return 40 if progress(o.tile) > 1 else 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('Z65b', 'how much closer a step brings me to the goals, or to my spawn below 40 percent health when carrying no gems', parents=['s4'])
def progress(t: Tile) -> Num:
    if gems() == 0 and me().health_frac < 0.4:
        return at(home_field(), me().pos) - at(home_field(), t)
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z65c', 'distance field to my spawn (healing and shopping)', parents=['s4'])
def home_field() -> Field:
    return field(my_spawn())
