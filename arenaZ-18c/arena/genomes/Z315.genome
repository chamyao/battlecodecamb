"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('Z136a', 'value of doing this option now: casts on targets, attack reset right after a basic attack, weakest camp monster first, drafts Ren Tavi Marcella, never recalls, treasure then bruiser health shards', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == REN:
            return 10
        if o.champ == TAVI:
            return 9
        if o.champ == MARCELLA:
            return 8
        return 1
    if o.kind == BUY:
        if items_owned(19) == 0:
            return 56 + o.count if o.item == 18 else 0
        return 100 + o.count if o.item == 40 else 0
    if o.kind == RECALL:
        return 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if exists(o.unit) and o.unit.is_enemy:
            if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
                return 78 if o.unit.is_champion else 62
        if k == AB_RESET:
            if can_attack():
                return 0
            if any(dist(u.pos, me().pos) <= me().attack_range for u in enemies()):
                return 59
            return 75 if gems() < 5 and any(dist(u.pos, me().pos) <= me().attack_range for u in camps()) else 0
        if k == AB_DASH:
            return 40 if progress(o.tile) > 1 else 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z136b', 'where to walk: an altar with gems, else a living camp group or a nearby enemy champion carrying 10+ gems; variant: also chase a nearly dead enemy champion when healthy', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for e in enemies():
        if e.is_champion and e.health_frac < 0.33 and dist(e.pos, me().pos) <= 5 and me().health_frac > 0.94:
            acc = acc | near(e.pos, 0)
        if e.is_champion and unit_gems(e) >= 10 and dist(e.pos, me().pos) <= 6:
            acc = acc | near(e.pos, 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('Z136c', 'how much closer a step brings me to the goals, or to my spawn below 40 percent health when carrying no gems; variant: steps next to enemy champions count less when carrying gems', parents=['s4'])
def progress(t: Tile) -> Num:
    if gems() == 0 and me().health_frac < 0.36:
        return at(home_field(), me().pos) - at(home_field(), t)
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    if gems() > 0 and d > 0:
        if any(dist(e.pos, t) <= 2 for e in enemies() if e.is_champion):
            return d * 0.5377
    return d

@gene('Z136d', 'distance field to my spawn (healing and shopping)', parents=['s4'])
def home_field() -> Field:
    return field(my_spawn())
