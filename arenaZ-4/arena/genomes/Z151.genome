"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now, with moves gated by bush-aware safe progress and discounted by enemy champion threat net of nearby ally support')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 0.861
    if o.kind == BUY:
        return 90 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.1962 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 76
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = safe_progress(o.tile)
        if p <= 0:
            return 0
        net = max(0, threat_decay(o.tile) - 0.5 * ally_support(o.tile))
        return max(1, 60 + 2 * p - 20 * net / max(1, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, with gains doubled')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 2 if d > 0 else d

@gene('Z147a', 'step progress toward goals, boosted in bushes and penalized by nearby enemy champions and strength-weighted awake camp threat', parents=['s4'])
def safe_progress(t: Tile) -> Num:
    p = progress(t)
    if p <= 0:
        return p
    bonus = 0.5 if t in bushes() else 0
    crowd = count(dist(u.pos, t) <= 2 for u in enemies() if u.is_champion)
    return p + bonus - 0.4311 * crowd - 0.3 * camp_threat(t)

@gene('Z249a', 'strength- and health-weighted pressure from awake camps within their attack range plus one of a tile', parents=['Z226a'])
def camp_threat(t: Tile) -> Num:
    return sum(u.health_frac * min(2, u.strength / max(1, me().strength)) for u in camps() if is_awake(u) and dist(u.pos, t) <= u.attack_range + 1)

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene('Z185a', 'distance-decayed health-weighted strength of other allied champions within 8 tiles of a tile', parents=['Z104a'])
def ally_support(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in allies() if u.is_champion and dist(u.pos, me().pos) > 0 and dist(u.pos, t) <= 8)
