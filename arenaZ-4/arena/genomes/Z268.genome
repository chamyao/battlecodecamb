"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z474a', 'cache the goal distance field once per turn', parents=['s3'])
def update() -> None:
    GF = field(fallback_goals())

@gene('Z474b', 'value of doing this option now: moves gated by safe progress toward goals, discounted by capped focus-fire plus capped decayed threat, camp-tile penalty; recall at low health', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.5
    if o.kind == BUY:
        return 92 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.2 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 85
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = safe_progress(o.tile)
        if p <= 0:
            return 0
        threat = min(focus_threat_at(o.tile), 6) + threat_scaled(o.tile)
        base = 55 - 22 * threat / max(1.5, me().strength * me().health_frac)
        if o.tile in camp_tiles():
            base -= 5
        return max(1, base)
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group", parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z60a', 'goals if any, else tiles of living camp groups', parents=['s2'])
def fallback_goals() -> Tiles:
    base = goals()
    if size(base) > 0:
        return base
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z474c', 'distance field to the goals, read from the per-turn cache', parents=['s3'])
def goal_field() -> Field:
    return GF

@gene('s4', 'how much closer a step brings me to the goals, with approaching gains tripled and retreats doubled', parents=['s4'])
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 3 if d > 0 else d * 2

@gene('Z329a', 'progress toward the goals, with a goal-tile bonus, reduced when the destination is much more threatened than my current tile', parents=['s4', 'Z329a'])
def safe_progress(t: Tile) -> Num:
    p = goal_bonus_progress(t)
    mine = max(1, me().strength * me().health_frac)
    extra = threat_linear(t) - threat_linear(me().pos)
    if extra > mine:
        return p - 2
    return p

@gene('Z414a', 'progress with a bonus for a step that lands on a goal tile', parents=['s4'])
def goal_bonus_progress(t: Tile) -> Num:
    p = progress(t)
    if at(goal_field(), t) == 0:
        return p + 3
    return p

@gene('Z281a', 'health-weighted strength of enemy champions that can reach a tile next turn, scaled up when several can focus it and down when allies stand nearby', parents=['Z9a'])
def focus_threat_at(t: Tile) -> Num:
    raw = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed)
    n = count(u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed for u in enemies())
    helpers = count(dist(a.pos, t) <= 4 and a.health_frac > 0.3 for a in allies())
    return raw * (1 + 0.25 * max(0, n - 1)) / (1 + 0.3 * max(0, helpers - 1))

@gene('Z104a', 'squared-distance-decayed strength of enemy champions within 7 tiles of a tile, weighted by health, with double weight for champions that can reach the tile this turn', parents=['Z104a', 'Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t) * dist(u.pos, t) / 4) * (2 if dist(u.pos, t) <= u.attack_range + u.move_speed else 1) for u in enemies() if u.is_champion and dist(u.pos, t) <= 7)

@gene('Z558a', 'linear-decayed strength of enemy champions within 5 tiles of a tile, weighted by health', parents=['Z104a'])
def threat_linear(t: Tile) -> Num:
    return sum(u.strength * u.health_frac * (6 - dist(u.pos, t)) / 6 for u in enemies() if u.is_champion and dist(u.pos, t) <= 5)

@gene('Z423a', 'threat from threat_decay soft-capped: linear up to 2, then one-third-rate growth, hard cap at 5', parents=['Z104a'])
def threat_scaled(t: Tile) -> Num:
    d = threat_decay(t)
    return min(d, 2) + min(max(d - 2, 0) / 3, 3)
