"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene("s1", "value of doing this option now: moves discounted by enemy threat at the destination, with threat-weighted strength", parents=["s1", "Z9a"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return max(1, 60 - 15 * threat_at(o.tile) / max(1, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems when we hold more than 2 gems, else a cleared group awaiting capture, else a living camp group", parents=["s2", "Z20a"])
def goals() -> Tiles:
    if gems() > 2:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    rewards = reward_goals()
    if size(rewards) > 0:
        return rewards
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('Z20a', 'tiles of camp groups cleared and waiting for capture', parents=['s2'])
def reward_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s4", "how much closer a step brings me to the goals, minus 2 per enemy threatening the step", parents=["s4"])
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t) - 2 * threat(t)

@gene('Z4a', 'number of enemy units whose attack reach covers a tile', parents=['s4'])
def threat(t: Tile) -> Num:
    return count(dist(u.pos, t) <= u.attack_range + 1 for u in enemies())

@gene('Z9a', 'health-weighted strength of enemies (champions double) that can reach a tile next turn with one step of margin', parents=['s1'])
def threat_at(t: Tile) -> Num:
    return sum(u.strength * u.health_frac * (2 if u.is_champion else 1) for u in enemies() if dist(u.pos, t) <= u.attack_range + u.move_speed + 1)
