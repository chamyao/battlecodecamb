"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: moves scored by camp-aware step gain discounted by focus-fire threat from enemy champions able to hit the destination plus distance-decayed threat; recall at moderate low health', parents=['s1', 'Z9a', 'Z104a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 90
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = step_gain(o.tile)
        if p <= 0:
            return 0
        threat = focus_threat_v2(o.tile) + threat_decay(o.tile)
        return max(1, 55 - 15 * threat / max(1, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group", parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, via the fallback goals gene', parents=['s3'])
def goal_field() -> Field:
    return field(fallback_goals())

@gene('Z60a', 'goals if any, else tiles of living camp groups', parents=['s2'])
def fallback_goals() -> Tiles:
    base = goals()
    if size(base) > 0:
        return base
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z143a', 'gain from a step toward the goals, minus one for camp tiles, zero for unreachable tiles', parents=['Z143a', 's4'])
def step_gain(t: Tile) -> Num:
    gt = at(goal_field(), t)
    if gt > 1000000:
        return 0
    d = at(goal_field(), me().pos) - gt
    if t in camp_tiles():
        return d - 1
    return d

@gene('Z330a', 'health-squared weighted strength of enemy champions that can reach a tile next turn (with one extra tile of slack), scaled up for multiple attackers and down for healthy allies within 3 tiles', parents=['Z281a'])
def focus_threat_v2(t: Tile) -> Num:
    raw = sum(u.strength * u.health_frac * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed + 1)
    n = count(u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed + 1 for u in enemies())
    helpers = count(dist(a.pos, t) <= 3 and a.health_frac > 0.4 for a in allies())
    return raw * (1 + 0.5 * max(0, n - 1)) / (1 + 0.5 * helpers)

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z104a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)
