"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z224a', 'cache the goal distance field once per turn', parents=['s3'])
def update() -> None:
    GF = field(fallback_goals())

@gene('Z224b', 'value of doing this option now: camp-aware step gain discounted by scaled reach threat, capped range-aware threat, ally-offset decayed threat and a safe-progress gate; recall at low health', parents=['s1', 'Z9a', 'Z177a', 'Z329a', 'Z423a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.3
    if o.kind == BUY:
        return 92 if o.item == 6 else 0
    if o.kind == RECALL:
        return 75 if me().health_frac < 0.18 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 85
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = step_gain(o.tile)
        if p <= 0:
            return 0
        mine = max(1.5, me().strength * me().health_frac)
        if safe_progress(o.tile) <= 0:
            return 0.45
        threat = reach_threat_scaled(o.tile) + net_threat(o.tile) + 0.5 * threat_scaled(o.tile)
        return max(1, 55 - 22 * threat / mine)
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group", parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z224c', 'distance field to the goals, read from the per-turn cache', parents=['s3'])
def goal_field() -> Field:
    return GF

@gene('Z60a', 'goals if any, else tiles of living camp groups', parents=['s2'])
def fallback_goals() -> Tiles:
    base = goals()
    if size(base) > 0:
        return base
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s4', 'how much closer a step brings me to the goals, with approaching gains tripled and retreats doubled')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 3 if d > 0 else d * 2

@gene('Z329a', 'progress toward the goals, reduced when the destination is much more threatened than my current tile', parents=['s4'])
def safe_progress(t: Tile) -> Num:
    p = progress(t)
    mine = max(1, me().strength * me().health_frac)
    extra = threat_decay(t) - threat_decay(me().pos)
    if extra > mine:
        return p - 2
    return p

@gene('Z143a', 'gain from a step toward the goals, doubled when closer, minus one for camp tiles, zero for unreachable tiles', parents=['Z143a', 's4'])
def step_gain(t: Tile) -> Num:
    gt = at(goal_field(), t)
    if gt > 1000000:
        return 0
    d = at(goal_field(), me().pos) - gt
    if d > 0:
        d = d * 2
    if t in camp_tiles():
        return d - 1
    return d

@gene('Z378a', 'health-weighted enemy champion strength that can hit a tile: full weight already in range, 0.5 weight if one move away', parents=['Z9a'])
def reach_threat(t: Tile) -> Num:
    near_now = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range)
    near_next = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) > u.attack_range and dist(u.pos, t) <= u.attack_range + u.move_speed)
    return near_now + 0.5 * near_next

@gene('Z451a', 'reach threat scaled up by 1.1, plus 0.5 times the health-weighted strength of enemy champions within three tiles', parents=['Z378a'])
def reach_threat_scaled(t: Tile) -> Num:
    close = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= 3)
    return 1.1 * reach_threat(t) + 0.5 * close

@gene('Z423a', 'threat from a range-aware decayed enemy champion strength, capped at 4 so one champion cannot dominate the move score', parents=['Z104a', 'Z488a'])
def threat_scaled(t: Tile) -> Num:
    return min(threat_reach(t), 4)

@gene('Z488a', 'strength of enemy champions within 5 tiles weighted by health, full weight inside their attack reach and decayed by distance beyond it', parents=['Z104a'])
def threat_reach(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + max(0, dist(u.pos, t) - u.attack_range - u.move_speed)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 5)

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z104a', 'Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene('Z177a', 'distance-decayed enemy champion threat at a tile minus half the distance-decayed strength of nearby allied champions, floored at zero', parents=['Z104a', 'Z177a'])
def net_threat(t: Tile) -> Num:
    support = sum(a.strength * a.health_frac / (1 + dist(a.pos, t)) for a in allies() if a.is_champion and dist(a.pos, t) <= 6 and a.pos != me().pos)
    return max(0, threat_decay(t) - 0.5 * support)
