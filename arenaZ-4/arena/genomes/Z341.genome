"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z224a', 'cache the goal distance field once per turn, including cleared camps awaiting capture', parents=['s3', 'Z402a'])
def update() -> None:
    GF = field(goals_plus())

@gene('Z224b', 'value of doing this option now: blended move score from two threat models, fixed values for picks, buys, recall, attacks and tributes', parents=['s1', 'Z9a', 'Z177a', 'Z329a', 'Z281a', 'Z477a', 'Z423a', 'Z474b'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.3
    if o.kind == BUY:
        return 110 if o.item == 6 else 0
    if o.kind == RECALL:
        return 60 if me().health_frac < 0.18 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 85
        return 60 if gems() == 0 else 20
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return blend_move(o.tile)
    return 0

@gene('Z735b', 'blend of the two move scores: Parent B model gates, and the average with Parent A model when both are positive', parents=['Z224b', 'Z474b'])
def blend_move(t: Tile) -> Num:
    b = score_move_b(t)
    if b <= 0:
        return 0
    a = score_move_a(t)
    return max(1, (b + a) / 2)

@gene('Z735c', 'Parent B move value: camp-aware step gain discounted by reach, focus, net, short-range and near threats', parents=['Z224b'])
def score_move_b(t: Tile) -> Num:
    p = step_gain(t)
    if p <= 0:
        return 0
    mine = max(1.4, me().strength * me().health_frac)
    if safe_progress(t) <= 0:
        return 0.45
    threat = reach_threat_scaled(t) + net_threat(t) + 0.5 * focus_threat_at(t)
    base = 55 - 20 * threat / mine - 5 * near_threat_adj(t) / mine - 2 * threat_scaled(t)
    if t in camp_tiles():
        base -= 4
    return max(1, base)

@gene('Z735d', 'Parent A move value: safe progress gated, discounted by capped focus-fire plus capped decayed threat, camp-tile penalty', parents=['Z474b'])
def score_move_a(t: Tile) -> Num:
    p = safe_progress_a(t)
    if p <= 0:
        return 0
    threat = min(focus_threat_at(t), 6) + threat_scaled_a(t)
    base = 55 - 22 * threat / max(1.5, me().strength * me().health_frac)
    if t in camp_tiles():
        base -= 5
    return max(1, base)

@gene("s2", "where to walk: an altar with gems, else a living camp group", parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z224c', 'distance field to the goals, read from the per-turn cache', parents=['s3'])
def goal_field() -> Field:
    return GF

@gene('Z60a', 'goals if any, else tiles of living camp groups', parents=['s2'])
def fallback_goals() -> Tiles:
    base = goals()
    if size(base) > 0:
        return base
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z402a', 'goal tiles: fallback goals plus tiles of cleared camp groups waiting for capture', parents=['Z60a', 'Z402a'])
def goals_plus() -> Tiles:
    acc = fallback_goals()
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s4', 'how much closer a step brings me to the goals, with approaching gains tripled and retreats doubled', parents=['s4'])
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 3 if d > 0 else d * 2

@gene('Z329a', 'progress toward the goals, reduced when the destination is much more threatened than my current tile', parents=['s4'])
def safe_progress(t: Tile) -> Num:
    p = progress(t)
    mine = max(1, me().strength * me().health_frac)
    extra = threat_decay(t) - threat_decay(me().pos)
    if extra > mine:
        return p - 2
    return p

@gene('Z735e', 'Parent A safe progress: goal-bonus progress, reduced when the destination is much more threatened', parents=['Z329a', 'Z414a'])
def safe_progress_a(t: Tile) -> Num:
    p = goal_bonus_progress(t)
    mine = max(1, me().strength * me().health_frac)
    extra = threat_decay_a(t) - threat_decay_a(me().pos)
    if extra > mine:
        return p - 2
    return p

@gene('Z414a', 'progress with a bonus for a step that lands on a goal tile', parents=['s4'])
def goal_bonus_progress(t: Tile) -> Num:
    p = progress(t)
    if at(goal_field(), t) == 0:
        return p + 3
    return p

@gene('Z143a', 'gain from a step toward the goals, doubled when closer, minus one for camp tiles, plus a small bonus for landing on a goal tile, zero for unreachable tiles', parents=['Z143a', 's4', 'Z414a'])
def step_gain(t: Tile) -> Num:
    gt = at(goal_field(), t)
    if gt > 1000000:
        return 0
    d = at(goal_field(), me().pos) - gt
    if d > 0:
        d = d * 2
    if gt == 0:
        d = d + 3
    if t in camp_tiles():
        return d - 1
    return d

@gene('Z281a', 'health-weighted strength of enemy champions that can reach a tile next turn, scaled up when several can focus it and down when allies stand nearby', parents=['Z9a'])
def focus_threat_at(t: Tile) -> Num:
    raw = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed)
    n = count(u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed for u in enemies())
    helpers = count(dist(a.pos, t) <= 4 and a.health_frac > 0.3 for a in allies())
    return raw * (1 + 0.25 * max(0, n - 1)) / (1 + 0.3 * max(0, helpers - 1))

@gene('Z378a', 'health-weighted enemy champion strength that can hit a tile: full weight already in range, 0.6 weight if one move away', parents=['Z9a'])
def reach_threat(t: Tile) -> Num:
    near_now = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range)
    near_next = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) > u.attack_range and dist(u.pos, t) <= u.attack_range + u.move_speed)
    return near_now + 0.6 * near_next

@gene('Z451a', 'reach threat scaled up by 1.2, plus 0.3 times the strength of enemy champions within two tiles', parents=['Z378a'])
def reach_threat_scaled(t: Tile) -> Num:
    close = sum(u.strength for u in enemies() if u.is_champion and dist(u.pos, t) <= 2)
    return 1.2 * reach_threat(t) + 0.3 * close

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z104a', 'Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene('Z735f', 'Parent A threat decay: squared-distance-decayed strength within 7 tiles, double weight for champions that can reach the tile', parents=['Z104a'])
def threat_decay_a(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t) * dist(u.pos, t) / 4) * (2 if dist(u.pos, t) <= u.attack_range + u.move_speed else 1) for u in enemies() if u.is_champion and dist(u.pos, t) <= 7)

@gene('Z561a', 'threat with squared distance decay over enemy champions within 6 tiles', parents=['Z104a'])
def threat_quad(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t) * dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 6)

@gene('Z423a', 'threat from nearby enemy champions: linear-decayed near threat plus squared-decayed threat, capped at 3', parents=['Z104a', 'Z561a'])
def threat_scaled(t: Tile) -> Num:
    return min(threat_champ_near(t) + threat_quad(t), 3)

@gene('Z735g', 'Parent A threat scaled: soft-capped threat_decay_a, linear to 2 then one-third rate, hard cap at 5', parents=['Z423a'])
def threat_scaled_a(t: Tile) -> Num:
    d = threat_decay_a(t)
    return min(d, 2) + min(max(d - 2, 0) / 3, 3)

@gene('Z633a', 'linear-decayed strength of enemy champions within 5 tiles, weighted by health fraction, with no recall discount', parents=['Z572a'])
def threat_champ_near(t: Tile) -> Num:
    return sum(u.strength * u.health_frac * (6 - dist(u.pos, t)) / 6 for u in enemies() if u.is_champion and dist(u.pos, t) <= 5)

@gene('Z177a', 'distance-decayed enemy champion threat at a tile minus half the distance-decayed strength of nearby allied champions, floored at zero', parents=['Z104a', 'Z177a'])
def net_threat(t: Tile) -> Num:
    support = sum(a.strength * a.health_frac / (1 + dist(a.pos, t)) for a in allies() if a.is_champion and dist(a.pos, t) <= 6 and a.pos != me().pos)
    return max(0, threat_decay(t) - 0.5 * support)

@gene('Z477a', "threat at a tile doubled, so enemy champions near a move's destination penalize it twice as hard", parents=['Z104a'])
def near_threat(t: Tile) -> Num:
    return 2 * threat_decay(t)

@gene('Z635a', 'near threat at a tile, amplified when my health is low and eased when allied champions stand within three tiles', parents=['Z477a'])
def near_threat_adj(t: Tile) -> Num:
    base = near_threat(t)
    allies_near = count(u.is_champion and dist(u.pos, t) <= 3 for u in allies())
    hp_mult = 1 + 0.6 * (1 - me().health_frac)
    return base * hp_mult / (1 + 0.25 * max(0, allies_near - 1))
