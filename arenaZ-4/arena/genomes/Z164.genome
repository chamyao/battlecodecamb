"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene("s1", "value of doing this option now: moves scored by doubled progress toward goals discounted by health-weighted champion threat (direct reach plus distance-decayed, net of allied support); recall at low health", parents=["s1", "Z9a", "Z104a"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2
    if o.kind == BUY:
        return 92 if o.item == 6 else 0
    if o.kind == RECALL:
        return 120 if me().health_frac < 0.25 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 85
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        threat = threat_at(o.tile) + net_threat_decay(o.tile)
        return max(1, 58 - 18 * threat / max(1, me().strength * me().health_frac))
    return 0

@gene("s2", "walk targets: altars with gems, else living camp groups with gold, else any living group", parents=["s2", "Z187a"])
def goal_pick() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals chosen by goal_pick", parents=["s3"])
def goal_field() -> Field:
    return field(goal_pick())

@gene("s4", "how much closer a step brings me to the goals, gains doubled, minus one for camp tiles", parents=["s4", "Z143a"])
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    if d > 0:
        d = d * 2
    if t in camp_tiles():
        d = d - 1
    return d

@gene("Z9a", "health-weighted strength of enemy champions that can reach a tile next turn", parents=["Z9a"])
def threat_at(t: Tile) -> Num:
    return sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed)

@gene("Z104a", "distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health", parents=["Z104a", "Z16a"])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene("Z209a", "distance-decayed enemy champion threat at a tile minus half the distance-decayed strength of allied champions near it, floored at zero", parents=["Z209a", "Z233a"])
def net_threat_decay(t: Tile) -> Num:
    support = sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in allies() if u.is_champion and u.pos != me().pos and dist(u.pos, t) <= 8)
    return max(0, threat_decay(t) - 0.5 * support)
