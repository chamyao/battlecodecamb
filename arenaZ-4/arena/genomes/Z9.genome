"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now, with moves discounted more steeply by enemy threat at the destination')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return max(1, 60 - 20 * threat_move(o.tile) / max(1, me().strength * me().health_frac))
    return 0

@gene('s3', 'distance field to the adapted goals, walking around walls')
def goal_field() -> Field:
    return field_avoid(goals_adapted(), walls(), near(tile(-5, -5), 0))

@gene('Z22a', 'where to walk: an unlocked altar if carrying gems, else awake non-respawning camp groups with gems or gold', parents=['s2'])
def goals_adapted() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            if group_gems(g) + group_gold(g) > 0 or group_reward(g):
                acc = acc | group_tiles(g)
    if size(acc) == 0:
        for g in range(num_groups()):
            if not group_respawning(g):
                acc = acc | group_tiles(g)
    return acc

@gene('s4', 'how much closer a step brings me to the goals, with gains doubled')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 2 if d > 0 else d

@gene('Z16a', 'health-weighted strength of enemy champions that can reach a tile next turn, with one extra step of slack', parents=['Z9a'])
def threat_move(t: Tile) -> Num:
    return sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed + 1)
