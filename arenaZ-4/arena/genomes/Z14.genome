"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now, with moves discounted by enemy threat at the destination')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return max(1, 50 - 10 * threat_at(o.tile) / max(1, me().strength * me().health_frac))
    return 0

@gene('s2', 'where to walk: an altar with gems when we hold more than 3 gems, else a cleared group awaiting capture, else a living camp group')
def goals() -> Tiles:
    if gems() > 3:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    rewards = reward_goals()
    if size(rewards) > 0:
        return rewards
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'walk field to the goals, routing around enemy-occupied tiles')
def goal_field() -> Field:
    return field_avoid(goals(), walls() | enemy_tiles(), near(tile(-5, -5), 0))

@gene('Z20a', 'tiles of camp groups cleared and waiting for capture', parents=['s2'])
def reward_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z9a', 'health-weighted strength of enemy champions that can reach a tile next turn', parents=['s1'])
def threat_at(t: Tile) -> Num:
    return sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed)
