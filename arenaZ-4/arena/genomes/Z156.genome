"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now, with moves discounted by enemy champion threat at the destination offset by nearby ally support')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 90 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.1962 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return max(1, 60 - 20 * net_threat(o.tile) / max(1, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, with gains doubled')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 2 if d > 0 else d

@gene('Z177a', 'distance-decayed enemy champion threat at a tile, from the squared-falloff gene, minus half the distance-decayed strength of nearby allied champions, floored at zero', parents=['Z104a'])
def net_threat(t: Tile) -> Num:
    support = sum(a.strength * a.health_frac / (1 + dist(a.pos, t)) for a in allies() if a.is_champion and dist(a.pos, t) <= 6 and a.pos != me().pos)
    return max(0, threat_decay_sq(t) - 0.5 * support)

@gene('Z314a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by health and falling off with squared distance', parents=['Z104a'])
def threat_decay_sq(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t) * dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)
