"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: moves scored by safe progress minus a steeper threat penalty, with a heavier camp-tile penalty; recall at low health', parents=['s1', 'Z9a', 'Z104a', 'Z16a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.5
    if o.kind == BUY:
        return 92 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.2 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 85
        return 60 if gems() == 0 else 20
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = safe_progress(o.tile)
        if p <= 0:
            return 0
        threat = focus_threat_at(o.tile) + threat_decay(o.tile)
        base = 55 - 30 * threat / max(1, me().strength)
        if o.tile in camp_tiles():
            base -= 8
        return max(1, base)
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group", parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z60a', 'goals if any, else tiles of living camp groups', parents=['s2'])
def fallback_goals() -> Tiles:
    base = goals()
    if size(base) > 0:
        return base
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, via the fallback goals gene', parents=['s3'])
def goal_field() -> Field:
    return field(fallback_goals())

@gene('s4', 'how much closer a step brings me to the goals, with approaching gains tripled and retreats doubled', parents=['s4'])
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 3 if d > 0 else d * 2

@gene('Z329a', 'progress toward the goals, halved when the destination is more threatened than my tile and cut hard when much more threatened', parents=['s4', 'Z329a'])
def safe_progress(t: Tile) -> Num:
    p = progress(t)
    mine = max(1, me().strength * me().health_frac)
    extra = threat_decay(t) - threat_decay(me().pos)
    if extra > mine * 0.5:
        return p - 2
    if extra > 0:
        return p * 0.5
    return p

@gene('Z281a', 'health-squared-weighted strength of enemy champions that can reach a tile next turn (one extra tile of reach), scaled up when several can focus it and down by healthy allies within 3 tiles', parents=['Z9a'])
def focus_threat_at(t: Tile) -> Num:
    raw = sum(u.strength * u.health_frac * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed + 1)
    n = count(u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed + 1 for u in enemies())
    helpers = count(dist(a.pos, t) <= 3 and a.health_frac > 0.5 for a in allies())
    return raw * (1 + 0.5 * max(0, n - 1)) / (1 + 0.5 * helpers)

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z104a', 'Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)
