"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: camp-aware move gain minus a stronger threat penalty at the destination; recall only at low health', parents=['s1', 'Z9a', 'Z104a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2
    if o.kind == BUY:
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.25 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 90
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = camp_step(o.tile)
        if p <= 0:
            return 0
        threat = threat_at(o.tile) + threat_decay(o.tile)
        return max(1, 60 - 25 * threat / max(1, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group", parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, via the fallback goals gene', parents=['s3'])
def goal_field() -> Field:
    return field(fallback_goals())

@gene('Z60a', 'goals if any, else tiles of living camp groups', parents=['s2'])
def fallback_goals() -> Tiles:
    base = goals()
    if size(base) > 0:
        return base
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s4', 'how much closer a step brings me to the goals, with gains doubled', parents=['s4'])
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 2 if d > 0 else d

@gene('Z254a', 'score-only step gain: zero for enemy-occupied or unreachable tiles, minus two for camp tiles, otherwise progress', parents=['Z143a'])
def camp_step(t: Tile) -> Num:
    gt = at(goal_field(), t)
    if gt > 1000000:
        return 0
    if t in enemy_tiles():
        return 0
    p = progress(t)
    if t in camp_tiles():
        return p - 2
    return p

@gene('Z9a', 'health-weighted strength of enemy champions that can reach a tile next turn', parents=['Z9a', 's1'])
def threat_at(t: Tile) -> Num:
    return sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed)

@gene('Z104a', 'distance-squared-decayed strength of enemy champions within 7 tiles of a tile, weighted by their health', parents=['Z104a', 'Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t) * dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 7)
