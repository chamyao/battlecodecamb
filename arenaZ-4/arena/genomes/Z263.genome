"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: moves gated by safe progress toward goals, discounted by focus-fire threat, capped distance-decayed threat, and doubled near-threat at the destination (from A), with a camp-tile penalty; recall at low health', parents=['s1', 'Z9a', 'Z104a', 'Z16a', 'Z423a', 'Z477a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.5
    if o.kind == BUY:
        return 92 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.2 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 85
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = safe_progress(o.tile)
        if p <= 0:
            return 0
        threat = focus_fire_v2(o.tile) + threat_scaled(o.tile) + 0.5 * near_threat(o.tile)
        base = 58 - 22 * threat / max(1.5085, me().strength * me().health_frac)
        if o.tile in camp_tiles():
            base -= 5
        return max(1, base)
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group", parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z60a', 'goals if any, else tiles of living camp groups', parents=['s2'])
def fallback_goals() -> Tiles:
    base = goals()
    if size(base) > 0:
        return base
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, via the fallback goals gene', parents=['s3'])
def goal_field() -> Field:
    return field(fallback_goals())

@gene('Z329a', 'progress toward the goals, with a goal-tile bonus, reduced when the destination is much more threatened than my current tile', parents=['s4', 'Z329a'])
def safe_progress(t: Tile) -> Num:
    p = goal_bonus_progress(t)
    mine = max(1, me().strength * me().health_frac)
    extra = threat_decay(t) - threat_decay(me().pos)
    if extra > mine:
        return p - 2
    return p

@gene('Z414a', 'cautious progress toward the goals with a bonus for a step that lands on a goal tile', parents=['s4'])
def goal_bonus_progress(t: Tile) -> Num:
    p = progress_cautious(t)
    if at(goal_field(), t) == 0:
        return p + 3
    return p

@gene('Z431a', 'how much closer a step brings me to the goals, approaching gains doubled, retreats tripled, unreachable steps heavily penalized', parents=['s4'])
def progress_cautious(t: Tile) -> Num:
    here = at(goal_field(), me().pos)
    there = at(goal_field(), t)
    if there >= 1000000:
        return -10
    d = here - there
    return d * 2 if d > 0 else d * 3

@gene('Z529a', 'focus-fire threat at a tile from enemy champions in reach within two steps, scaled up when several can focus it and reduced by healthy allies within 4 tiles', parents=['Z529a'])
def focus_fire_v2(t: Tile) -> Num:
    raw = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed + 2)
    n = count(u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed + 2 for u in enemies())
    helpers = count(dist(a.pos, t) <= 4 and a.health_frac > 0.3 for a in allies())
    return raw * (1 + 0.4 * max(0, n - 1)) / (1 + 0.4 * max(0, helpers - 1))

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z104a', 'Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene('Z423a', 'threat from threat_decay capped at 4 so one champion cannot dominate the move score', parents=['Z104a'])
def threat_scaled(t: Tile) -> Num:
    return min(threat_decay(t), 4)

@gene('Z477a', "threat at a tile doubled, so enemy champions near a move's destination penalize it twice as hard", parents=['Z104a'])
def near_threat(t: Tile) -> Num:
    return 2 * threat_decay(t)
