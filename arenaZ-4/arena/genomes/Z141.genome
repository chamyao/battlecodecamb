"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: moves scored by camp-aware step gain, discounted by net champion threat (enemy threat minus nearby ally support) at the destination; recall at low health', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        return 153 if me().health_frac < 0.25 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 90
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = step_gain(o.tile)
        if p <= 0:
            return 0
        threat = net_threat(o.tile) + threat_at(o.tile)
        return max(1, 55 - 15 * threat / max(1, me().strength * me().health_frac))
    return 0

@gene('s3', 'distance field to the goals chosen by goal_pick', parents=['s3'])
def goal_field() -> Field:
    return field(goal_pick())

@gene('Z187a', 'walk targets: altars with gems, else living camp groups with gold, else any living group', parents=['Z187a', 's2'])
def goal_pick() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z143a', 'gain from a step toward the goals using safe progress, minus one for camp tiles, zero for unreachable tiles', parents=['Z143a', 's4'])
def step_gain(t: Tile) -> Num:
    gt = at(goal_field(), t)
    if gt > 1000000:
        return 0
    p = safe_progress(t)
    if t in camp_tiles():
        return p - 1
    return p

@gene('Z237a', 'progress toward the goals, with doubled gains, reduced by the number of enemies within 3 tiles of the step', parents=['s4'])
def safe_progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    base = d * 2 if d > 0 else d
    near_e = count(dist(u.pos, t) <= 3 for u in enemies())
    return base - near_e

@gene('Z9a', 'health-weighted strength of enemy champions that can reach a tile next turn', parents=['Z9a', 's1'])
def threat_at(t: Tile) -> Num:
    return sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed)

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z104a', 'Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene('Z233a', 'enemy champion threat at a tile minus half the distance-decayed strength of allied champions near it, floored at zero', parents=['Z104a'])
def net_threat(t: Tile) -> Num:
    support = sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in allies() if u.is_champion and u.pos != me().pos and dist(u.pos, t) <= 6)
    return max(0, threat_decay(t) - 0.5 * support)
