"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: moves scored by bush-aware safe progress, discounted by adjusted enemy threat at the destination')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 90 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.1962 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 57 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = safe_progress(o.tile)
        if p <= 0:
            return 0
        return max(1, 70 + 2 * p - 20 * threat_adj(o.tile) / max(0.9715, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('Z147a', 'step progress toward goals plus bush cover, minus a light penalty per enemy within 3 tiles of the step', parents=['s4', 'Z125a'])
def safe_progress(t: Tile) -> Num:
    p = progress_fwd3(t)
    if p <= 0:
        return p
    crowd = count(dist(u.pos, t) <= 3 for u in enemies())
    return p + cover_bonus(t) - 0.25 * crowd

@gene('Z184a', 'step progress toward goals with forward gains tripled and backward steps weighted 1.5', parents=['s4'])
def progress_fwd3(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 3 if d > 0 else d * 1.5

@gene('Z125a', 'bush bonus of 0.25 per enemy unit within 4 tiles of the bush, capped at 0.75', parents=['s4'])
def cover_bonus(t: Tile) -> Num:
    if not (t in bushes()):
        return 0
    n = count(dist(u.pos, t) <= 4 for u in enemies())
    return min(n, 3) * 0.25

@gene('Z16a', 'health-weighted strength of enemy champions that can reach a tile next turn, with one extra step of slack', parents=['Z9a'])
def threat_move(t: Tile) -> Num:
    return sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed + 1)

@gene('Z157a', 'enemy threat at a tile, scaled by 1.5 with a flat 0.2 added', parents=['Z16a'])
def threat_adj(t: Tile) -> Num:
    return threat_move(t) * 1.5 + 0.2
