"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s3', 'distance field to the goals chosen by smart_goals, walking around walls')
def goal_field() -> Field:
    return field_avoid(smart_goals(), walls(), near(tile(-5, -5), 0))

@gene('Z48a', 'where to walk: an unlocked altar next to tiles when carrying gems, else living awake-free camp groups weighted toward nearby ones, else enemy spawn', parents=['s2'])
def smart_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
        for a in locked_altars():
            acc = acc | near(a, 1)
        return acc
    best_d = INF
    for g in range(num_groups()):
        if not group_respawning(g):
            d = min((dist(t, me().pos) for t in group_tiles(g)), default=INF)
            if d < best_d:
                best_d = d
    for g in range(num_groups()):
        if not group_respawning(g):
            d = min((dist(t, me().pos) for t in group_tiles(g)), default=INF)
            if d <= best_d + 6 or group_gems(g) > 0:
                acc = acc | group_tiles(g)
    if size(acc) == 0:
        acc = enemy_spawn()
    return acc

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)
