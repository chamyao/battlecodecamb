"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now, with moves gated by safe progress scaled by its size and discounted by champion reach threat at the destination')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.5
    if o.kind == BUY:
        return 90 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.22 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = safe_progress(o.tile)
        if p <= 0:
            return 0
        return max(1, 50 + min(p, 5) - 25 * threat_at_dest(o.tile) / max(1, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, with approaching gains tripled and retreats doubled')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 3 if d > 0 else d * 2

@gene('Z329a', 'progress toward the goals, reduced in proportion to how much more threatened the destination is than my current tile relative to my strength', parents=['s4'])
def safe_progress(t: Tile) -> Num:
    p = progress(t)
    mine = max(1, me().strength * me().health_frac)
    extra = threat_decay(t) - threat_decay(me().pos)
    if extra > 0.75 * mine:
        return p - 2 * extra / mine
    return p

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene('Z494a', 'enemy champion threat at a tile plus a penalty for nearby awake camps, scaled by how many enemy champions can reach it', parents=['Z104a'])
def threat_at_dest(t: Tile) -> Num:
    base = threat_decay(t)
    reach = count(u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed for u in enemies())
    campthreat = sum(u.strength * u.health_frac / (2 + dist(u.pos, t)) for u in camps() if is_awake(u) and dist(u.pos, t) <= 3)
    return base * (1 + 0.5 * reach) + campthreat
