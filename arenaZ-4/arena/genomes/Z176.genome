"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: moves scored by camp-aware safe step gain discounted by net champion threat at the destination; champion attacks favor weak targets; buy, recall at low health and tribute', parents=['s1', 'Z9a', 'Z104a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2
    if o.kind == BUY:
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        return 120 if me().health_frac < 0.2 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 90 + 10 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = step_gain(o.tile)
        if p <= 0:
            return 0
        threat = net_threat(o.tile)
        return max(1, 58 - 18 * threat / max(1, me().strength * me().health_frac))
    return 0

@gene('s3', 'distance field to the goals chosen by goal_pick', parents=['s3'])
def goal_field() -> Field:
    return field(goal_pick())

@gene('Z187a', 'walk targets: altars with gems, else living camp groups with gold, else any living group', parents=['s2'])
def goal_pick() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s4', 'how much closer a step brings me to the goals, with gains doubled', parents=['s4'])
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 2 if d > 0 else d

@gene('Z237a', 'progress toward the goals reduced by the number of enemies within 3 tiles of the step', parents=['s4', 'Z237a'])
def safe_progress(t: Tile) -> Num:
    near_e = count(dist(u.pos, t) <= 3 for u in enemies())
    return progress(t) - near_e

@gene('Z143a', 'gain from a step toward the goals using safe progress, minus one for camp tiles, zero for unreachable tiles', parents=['Z143a', 's4'])
def step_gain(t: Tile) -> Num:
    gt = at(goal_field(), t)
    if gt > 1000000:
        return 0
    p = safe_progress(t)
    if t in camp_tiles():
        return p - 1
    return p

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z104a', 'Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene('Z233a', 'enemy champion threat at a tile, raised by visible enemies able to reach it this turn, minus half the distance-decayed strength of allied champions near it, floored at zero', parents=['Z104a'])
def net_threat(t: Tile) -> Num:
    support = sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in allies() if u.is_champion and u.pos != me().pos and dist(u.pos, t) <= 6)
    return max(0, threat_decay(t) + 0.5 * reach_threat(t) - 0.5 * support)

@gene('Z348a', 'summed strength times health of visible enemy champions whose move speed plus attack range lets them hit a tile this turn', parents=['Z104a'])
def reach_threat(t: Tile) -> Num:
    return sum(u.strength * u.health_frac for u in enemies() if u.is_champion and visible(u.pos) and dist(u.pos, t) <= u.move_speed + u.attack_range)
