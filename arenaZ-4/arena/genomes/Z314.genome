"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z224a', 'cache the goal distance field once per turn', parents=['s3'])
def update() -> None:
    GF = field(fallback_goals())

@gene('Z665a', 'value of doing this option now: moves gated by safe progress toward goals, discounted by focus-fire threat, reach threat and doubled distance-decayed threat, with a camp-tile penalty; recall at low health', parents=['s1', 'Z104a', 'Z477a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.4
    if o.kind == BUY:
        return 92 if o.item == 6 else 0
    if o.kind == RECALL:
        return 80 if me().health_frac < 0.18 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 85
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = safe_progress(o.tile)
        if p <= 0:
            return 0
        threat = focus_threat_at(o.tile) + near_threat(o.tile) + 0.5 * net_threat(o.tile)
        mine = max(1, me().strength * me().health_frac)
        base = 55 - 22 * threat / mine
        if o.tile in camp_tiles():
            base -= 5
        return max(1, base)
    return 0

@gene("Z60a", "walk goals if any, else tiles of all living camp groups", parents=['s2', 'Z60a'])
def fallback_goals() -> Tiles:
    base = walk_goals()
    if size(base) > 0:
        return base
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z515a', 'walk goals: unlocked altars when carrying gems (locked ones if none), else living camp groups that hold gems', parents=['s2'])
def walk_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in locked_altars():
                acc = acc | near(a, 1)
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    return acc

@gene('Z224c', 'distance field to the goals, read from the per-turn cache', parents=['s3', 'Z224c'])
def goal_field() -> Field:
    return GF

@gene('s4', 'how much closer a step brings me to the goals, with approaching gains tripled and retreats doubled', parents=['s4'])
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 3 if d > 0 else d * 2

@gene('Z329a', 'progress toward the goals, with a goal-tile bonus, reduced when the destination is much more threatened than my current tile', parents=['s4', 'Z329a'])
def safe_progress(t: Tile) -> Num:
    p = goal_bonus_progress(t)
    mine = max(1, me().strength * me().health_frac)
    extra = threat_decay(t) - threat_decay(me().pos)
    if extra > mine:
        return p - 2
    return p

@gene('Z414a', 'progress with a bonus for a step that lands on a goal tile', parents=['s4', 'Z414a'])
def goal_bonus_progress(t: Tile) -> Num:
    p = progress(t)
    if at(goal_field(), t) == 0:
        return p + 3
    return p

@gene('Z281a', 'health-weighted strength of enemy champions that can reach a tile next turn, scaled up when several can focus it and down when allies stand nearby', parents=['Z9a', 'Z281a'])
def focus_threat_at(t: Tile) -> Num:
    raw = sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed)
    n = count(u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed for u in enemies())
    helpers = count(dist(a.pos, t) <= 4 and a.health_frac > 0.3 for a in allies())
    return raw * (1 + 0.25 * max(0, n - 1)) / (1 + 0.3 * max(0, helpers - 1))

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z104a', 'Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene('Z177a', 'distance-decayed enemy champion threat at a tile minus half the distance-decayed strength of nearby allied champions, floored at zero', parents=['Z104a', 'Z177a'])
def net_threat(t: Tile) -> Num:
    support = sum(a.strength * a.health_frac / (1 + dist(a.pos, t)) for a in allies() if a.is_champion and dist(a.pos, t) <= 6 and a.pos != me().pos)
    return max(0, threat_decay(t) - 0.5 * support)

@gene('Z477a', "threat at a tile doubled, so enemy champions near a move's destination penalize it twice as hard", parents=['Z104a', 'Z477a'])
def near_threat(t: Tile) -> Num:
    return 2 * threat_decay(t)
