"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now, with moves discounted more steeply by capped enemy champion threat at the destination')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.4229
    if o.kind == BUY:
        return 90 if o.item == 6 else 0
    if o.kind == RECALL:
        return 47 if me().health_frac < 0.1962 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return max(0.8931, 55 - 25 * threat_scaled(o.tile) / max(1.5085, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'walking distance field to the goals that routes around walls and tiles next to stronger enemy champions')
def goal_field() -> Field:
    g = goals()
    blocked = walls() | (danger_tiles() - g - near(me().pos, 0))
    return field_avoid(g, blocked, near(tile(-5, -5), 0))

@gene('Z763a', 'tiles next to enemy champions stronger than me, which the walk should avoid', parents=['s3'])
def danger_tiles() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for u in enemies():
        if u.is_champion and u.strength * u.health_frac > me().strength * me().health_frac:
            acc = acc | near(u.pos, 1)
    return acc

@gene('s4', 'how much closer a step brings me to the goals, with approaching gains tripled and retreats doubled')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 3 if d > 0 else d * 3

@gene('Z423a', 'threat from enemy champion threat doubled and capped at 3', parents=['Z104a'])
def threat_scaled(t: Tile) -> Num:
    return min(threat_quad(t) * 2, 3)

@gene('Z561a', 'threat with linear distance decay over enemy champions within 5 tiles', parents=['Z104a'])
def threat_quad(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 5)
