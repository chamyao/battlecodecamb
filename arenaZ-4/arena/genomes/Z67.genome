"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goal tiles picked for this turn')
def goal_field() -> Field:
    return field(goal_pick())

@gene('Z28a', 'goal tiles: when carrying gems, nearby altar goals first; otherwise camps that hold gems or await capture, with the base goals falling back to living camps', parents=['s2'])
def goal_pick() -> Tiles:
    base = goals_or_camps()
    if gems() > 0:
        held = near_altars()
        if size(held) > 0:
            return held
        return base
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_gems(g) > 0 or group_reward(g):
            acc = acc | group_tiles(g)
    kept = base & acc
    if size(kept) > 0:
        return kept
    return base

@gene('Z142a', 'walk targets: goals, or living camp groups when goals is empty', parents=['s2'])
def goals_or_camps() -> Tiles:
    g = goals()
    if size(g) > 0:
        return g
    acc = near(tile(-5, -5), 0)
    for k in range(num_groups()):
        if not group_respawning(k):
            acc = acc | group_tiles(k)
    return acc

@gene('Z55a', 'altars among the goal tiles, preferring those within 12 tiles of me', parents=['Z28a'])
def near_altars() -> Tiles:
    alts = goals() & altars()
    close = alts & near(me().pos, 12)
    if size(close) > 0:
        return close
    return alts

@gene('s4', 'how much closer a step brings me to the goals, minus 3 per unit of threat on the step')
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t) - 3 * threat(t)

@gene('Z4a', 'health-weighted count of enemy units whose attack reach covers a tile', parents=['s4'])
def threat(t: Tile) -> Num:
    return sum(u.health_frac for u in enemies() if dist(u.pos, t) <= u.attack_range + 1)
