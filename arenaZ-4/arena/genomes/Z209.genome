"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now, with moves discounted by net champion threat (enemy threat minus nearby ally support) at the destination')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 90 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.1962 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return max(1, 60 - 20 * net_threat(o.tile) / max(1, me().strength * me().health_frac))
    return 0

@gene('s3', 'distance field to the goals chosen by goal_pick, routing around walls and holes')
def goal_field() -> Field:
    return field_avoid(goal_pick(), walls() | holes(), near(tile(-5, -5), 0))

@gene('Z187a', 'walk targets: unlocked altars within 2 tiles when holding gems, else living camp groups with gold, else any living group', parents=['s2'])
def goal_pick() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 2)
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s4', 'how much closer a step brings me to the goals, with gains doubled')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 2 if d > 0 else d

@gene('Z104a', 'squared-distance-decayed strength of enemy champions within 8 tiles of a tile, weighted by their health', parents=['Z16a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t) * dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 8)

@gene('Z233a', 'enemy champion threat at a tile minus 0.3 times the distance-decayed strength of allied champions within 6 tiles (including me), floored at zero', parents=['Z104a'])
def net_threat(t: Tile) -> Num:
    support = sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in allies() if u.is_champion and dist(u.pos, t) <= 6)
    return max(0, threat_decay(t) - 0.3 * support)
