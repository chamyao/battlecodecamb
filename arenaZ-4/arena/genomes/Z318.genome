"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now, with moves discounted by enemy champion pressure at the destination relative to my power plus one')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.5
    if o.kind == BUY:
        return 90 if o.item == 6 else 0
    if o.kind == RECALL:
        return 60 if me().health_frac < 0.1962 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return max(1, 50 - 20 * reach_threat(o.tile) / max(1.0, me().strength * me().health_frac + 1))
    return 0

@gene('s3', 'distance field to the goals')
def goal_field() -> Field:
    return field(gem_goals())

@gene('Z672a', 'walk targets: altars when carrying gems, else living camp groups that hold gems', parents=['s2'])
def gem_goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    return acc

@gene('s4', 'how much closer a step brings me to the goals, with approaching gains tripled and retreats doubled')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    return d * 3 if d > 0 else d * 3

@gene('Z651a', 'health-weighted strength of enemy champions within 6 tiles that can reach a tile, discounted by steps beyond attack range, minus weaker nearby allied champion support', parents=['Z595a'])
def reach_threat(t: Tile) -> Num:
    foes = sum(u.strength * u.health_frac / (1 + max(0, dist(u.pos, t) - u.attack_range)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 6)
    help = sum(a.strength * a.health_frac * 0.3 for a in allies() if a.is_champion and dist(a.pos, t) <= 3 and dist(a.pos, me().pos) > 0)
    return max(0, foes - help)
