"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: moves scored by camp-aware step gain discounted by direct enemy champion threat plus flat-radius threat net of allied support; recall at low health', parents=['s1', 'Z9a', 'Z104a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 90
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = step_gain(o.tile)
        if p <= 0:
            return 0
        threat = threat_at(o.tile) + safe_threat(o.tile)
        return max(1, 55 - 15 * threat / max(1, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group", parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, routed around walls via the new goal_route gene', parents=['s3'])
def goal_field() -> Field:
    return goal_route()

@gene('Z292a', 'distance field to goals or living camp tiles, avoiding walls, with an open stop set', parents=['s3'])
def goal_route() -> Field:
    base = goals()
    acc = near(tile(-5, -5), 0)
    if size(base) > 0:
        acc = base
    else:
        for g in range(num_groups()):
            if not group_respawning(g):
                acc = acc | group_tiles(g)
    return field_avoid(acc, walls(), near(tile(-5, -5), 0))

@gene('Z143a', 'gain from a step toward the goals, minus one for camp tiles, zero for unreachable tiles', parents=['Z143a', 's4'])
def step_gain(t: Tile) -> Num:
    gt = at(goal_field(), t)
    if gt > 1000000:
        return 0
    d = at(goal_field(), me().pos) - gt
    if t in camp_tiles():
        return d - 1
    return d

@gene('Z9a', 'health-weighted strength of enemy champions that can reach a tile next turn', parents=['Z9a', 's1'])
def threat_at(t: Tile) -> Num:
    return sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed)

@gene('Z104a', 'distance-decayed strength of enemy champions within 10 tiles of a tile, weighted by their health', parents=['Z104a'])
def threat_decay(t: Tile) -> Num:
    return sum(u.strength * u.health_frac / (1 + dist(u.pos, t)) for u in enemies() if u.is_champion and dist(u.pos, t) <= 10)

@gene('Z253a', 'enemy champion threat at a tile minus half the undecayed health-weighted strength of allied champions within 6 tiles, floored at zero', parents=['Z209a'])
def safe_threat(t: Tile) -> Num:
    support = sum(u.strength * u.health_frac for u in allies() if u.is_champion and dist(u.pos, t) <= 6)
    return max(0, threat_decay(t) - 0.5 * support)
