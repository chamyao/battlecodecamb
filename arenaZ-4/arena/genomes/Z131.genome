"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now, with moves discounted more steeply by adjusted enemy threat at the destination')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 90 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.1962 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 54 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return max(1, 77 - 20 * threat_adj(o.tile) / max(0.9715, me().strength * me().health_frac))
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals and rich living camps')
def goal_field() -> Field:
    return field(camp_goals())

@gene('Z258a', 'goals plus living camp groups holding gems or gold', parents=['s3'])
def camp_goals() -> Tiles:
    acc = goals()
    for g in range(num_groups()):
        if not group_respawning(g) and (group_gems(g) > 0 or group_gold(g) > 0):
            acc = acc | group_tiles(g)
    return acc

@gene('s4', 'steps closer to the goals count at face value, minus a penalty for each enemy within 2 tiles of the step, plus bush cover when closing in')
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    pen = count(dist(u.pos, t) <= 2 for u in enemies())
    if d > 0:
        return d - 0.3 * pen + cover_bonus(t)
    return d - 0.3 * pen

@gene('Z125a', 'bush bonus of 0.25 per enemy unit within 4 tiles of the bush, capped at 0.75', parents=['s4'])
def cover_bonus(t: Tile) -> Num:
    if not (t in bushes()):
        return 0
    n = count(dist(u.pos, t) <= 4 for u in enemies())
    return min(n, 3) * 0.25

@gene('Z157a', 'enemy threat at a tile from slack-adjusted reach, scaled by 1.2 with a flat 0.1 added', parents=['Z16a'])
def threat_adj(t: Tile) -> Num:
    return threat_reach_slack(t) * 1.2 + 0.1

@gene('Z231a', 'health-weighted strength of enemy champions that can reach a tile next turn, with one tile of slack', parents=['Z198a'])
def threat_reach_slack(t: Tile) -> Num:
    return sum(u.strength * u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= u.attack_range + u.move_speed + 1)
