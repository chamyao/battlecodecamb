"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEAL: Bool = False

@gene('s1', 'value of doing this option now: pick strong champs, use abilities, focus weak targets, recall when healing and far from spawn with no enemy close, skip camps while healing')
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 5
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 2
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 109 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().pos in my_spawn():
            return 0
        if me().health_frac < 0.4:
            return 90
        if HEAL:
            home = nearest(my_spawn(), me().pos)
            if valid(home) and dist(home, me().pos) > 6:
                if not any(u.is_champion and dist(u.pos, me().pos) <= 4 for u in enemies()):
                    return 88
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 22 * (1 - o.unit.health_frac)
        if HEAL:
            return 0
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 35 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living camp group; falls back to cleared reward groups')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
        for g in range(num_groups()):
            if group_reward(g):
                acc = acc | group_tiles(g)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, or to my spawn while healing')
def goal_field(heal: Bool) -> Field:
    if heal:
        return field(my_spawn())
    return field(goals())

@gene('Z207a', 'how much closer a step brings me to the goals (cached field); 0 when unreachable; weighted by carried gems (not while healing, capped) so a heavier load pulls harder toward the altar; healing retreat pulls harder too', parents=['s4'])
def progress(t: Tile) -> Num:
    a = at(GF, me().pos)
    b = at(GF, t)
    if a > 1000 or b > 1000:
        return 0
    p = a - b
    if HEAL:
        return p * 1.5
    g = gems()
    if g > 0:
        p = p * (2 + min(g, 80) / 10)
    return p

@gene('Z26a', 'cache the goal distance field once per turn (skipped while dead); retreat home to heal when hurt (42%, 55% when carrying gems, 70% when two or more enemy champions are within 4 tiles, 35% when no enemy champion is in sight and no gems carried); hysteresis exit at 92%', parents=['s4'])
def update() -> None:
    if not alive():
        HEAL = False
        return
    hf = me().health_frac
    es = enemies()
    lim = 0.42
    if gems() > 0:
        lim = 0.55
    close = sum(1 for u in es if u.is_champion and dist(u.pos, me().pos) <= 4)
    if close >= 2 and hf < 0.7:
        lim = 0.7
    if gems() == 0 and not any(u.is_champion for u in es):
        lim = 0.35
    if hf < lim:
        HEAL = True
    if hf > 0.92:
        HEAL = False
    GF = goal_field(HEAL)

@gene('Z26b', 'value of casting an ability: damage/cc on targets (stronger on hurt enemy champions), heal when badly hurt, shield harder when enemy champions are within 3, capped dash toward goals or home when healing or healthy', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                bonus = 10 if o.unit.health_frac < 0.3 else 0
                return 85 + 15 * (1 - o.unit.health_frac) + bonus
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.5:
            return 90
        if me().health_frac < 0.7 or HEAL:
            return 78
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.8 or HEAL:
            if any(u.is_champion and dist(u.pos, me().pos) <= 3 for u in enemies()):
                return 88
            if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
                return 82
            if HEAL:
                return 76
            return 74
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if HEAL:
                if p > 0:
                    return 57 + min(3 * p, 30)
                return 0
            if me().health_frac > 0.35 and p > 0:
                return 40 + min(3 * p, 30)
        return 0
    return 0
