"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
DANGER: Tiles = None

@gene('s1', 'value of doing this option now; drafts top-ladder champions, casts in fights, prefers the best step', parents=['s1', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        g = progress(o.tile)
        return 50 + g if g > 0 else 0
    return 0

@gene('Z147a', 'recall when hurt, but not while standing on spawn (spawn already heals)', parents=['s1'])
def recall_value() -> Num:
    if me().health_frac < 0.4:
        if me().pos in my_spawn():
            return 0
        return 90
    return 0

@gene('s2', 'where to walk: unlocked altar when carrying gems; else a cleared group awaiting capture; else a living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    rew = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
        elif not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(rew) > 0:
        return rew
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'distance gain of a step on the cached goal field, discounted on enemy-threatened tiles when hurt')
def progress(t: Tile) -> Num:
    gain = at(GF, me().pos) - at(GF, t)
    if t in DANGER:
        gain -= 2
    return gain

@gene('Z136a', 'once per turn: cache the goal distance field and, when hurt, the tiles enemy champions threaten', parents=['s4'])
def update() -> None:
    GF = goal_field()
    DANGER = DANGER - DANGER
    if me().health_frac < 0.5:
        for u in enemies():
            if u.is_champion:
                DANGER = DANGER | near(u.pos, u.attack_range + 1)

@gene('Z136b', 'skip listing option kinds the policy never uses (wards, locks)', parents=['s1'])
def consider(kind: Num) -> Bool:
    return not (kind == WARD or kind == LOCK or kind == BUY_LOCK)

@gene('Z102a', 'draft preference following the top ladder drafts', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z102b', 'value of casting an ability: damage on targets, shield/heal when hurt', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_SHIELD or k == AB_HEAL:
        if me().health_frac < 0.6:
            return 85
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 78
            if o.unit.is_camp and gems() == 0:
                return 58
        return 0
    return 0
