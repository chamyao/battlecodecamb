"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEAL: Bool = False
SPF: Field
HAVE_SPF: Bool = False
NEAR: Bool = False
CLOSE: Num = 99
CHAMP_CLOSE: Num = 99

@gene('Z331a', 'value of doing this option now: pick strong champs, use abilities, focus weak targets, while retreating to heal only trade with enemy champions that are weaker than me; recall only when no enemy champion is close (recall is cancelled by damage), fight back awake monsters while carrying gems, tribute eagerly, move weighted by goal progress (higher base when carrying gems and not healing)', parents=['Z297a', 'Z331a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 7
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 109 if o.item == 6 else 0
    if o.kind == RECALL:
        if NEAR:
            return 0
        if me().pos in my_spawn():
            return 0
        if me().health_frac < 0.4:
            return 49
        if HEAL:
            home = nearest(my_spawn(), me().pos)
            if valid(home) and dist(home, me().pos) > 6:
                return 88
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEAL and o.unit.health_frac > me().health_frac + 0.1:
                return 30
            return 66 + 15 * (1 - o.unit.health_frac)
        if HEAL:
            return 0
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.health_frac < 1 and dist(o.unit.pos, me().pos) <= 0.9999:
            return 40 + 10 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if HEAL:
            base = 50
        elif gems() > 0:
            base = 45
        else:
            base = 35
        return base + 2 * p if p > 0 else 0
    return 0

@gene('Z704a', 'where to walk: altar with gems (if any unlocked), else capture-ready groups, else living groups with 10+ gems, else walk home to shop when holding 150+ gold, else living groups with gems, else groups with gold/gems, else any living group', parents=['Z704a', 's2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    ready = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            ready = ready | group_tiles(g)
    if size(ready) > 0:
        return ready
    rich = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) >= 10:
            rich = rich | group_tiles(g)
    if size(rich) > 0:
        return rich
    if gold() >= 150 and gems() == 0:
        return my_spawn()
    gemt = near(tile(-5, -5), 0)
    valued = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            acc = acc | gt
            gg = group_gems(g)
            if gg > 0:
                gemt = gemt | gt
            if gg + group_gold(g) > 0:
                valued = valued | gt
    if size(gemt) > 0:
        return gemt
    if size(valued) > 0:
        return valued
    return acc

@gene('s3', 'distance field to the goals; falls back to the spawn field when no goals exist, while healing, or when carrying gems with an enemy champion within 3', parents=['s3'])
def goal_field(heal: Bool, spf: Field) -> Field:
    if heal:
        return spf
    if gems() > 0 and CHAMP_CLOSE <= 3:
        return spf
    g = goals()
    if size(g) == 0:
        return spf
    return field(g)

@gene('Z331b', 'how much closer a step brings me to the goals (cached field); 0 when unreachable; one pass over enemies: avoid stepping within r of enemy champions (r from health/gems), avoid monsters within 2 when moderately hurt, crowd penalty for champions within 2 (within 3 when carrying gems), and carried-gem monster penalty; weighted by carried gems (capped), doubled while healing', parents=['Z297b', 'Z331b', 'Z407a'])
def progress(t: Tile) -> Num:
    a = at(GF, me().pos)
    b = at(GF, t)
    if a > 1000 or b > 1000:
        return 0
    hp = me().health_frac
    g = gems()
    r = 0
    if hp < 0.8:
        r = 3 if hp < 0.5 else 2
    if g > 0 and r < 2:
        r = 2
    avoid_mon = hp < 0.7 and not HEAL
    crowd_w = 1.0 if g > 0 else 0.5
    crowd_r = 3 if g > 0 else 2
    crowd = 0
    mon = 0
    for u in enemies():
        d = dist(u.pos, t)
        if u.is_champion:
            if r > 0 and d <= r:
                return 0
            if d <= crowd_r:
                crowd += crowd_w
        else:
            if avoid_mon and d <= 2:
                return 0
            if g > 0 and d <= 2:
                mon += 0.5
    p = a - b - crowd - mon
    if HEAL:
        return p * 2
    if g > 0:
        p = p * (2 + min(g, 80) / 10)
    return p

@gene('Z331c', 'cache the goal distance field, nearest-enemy distances, and an enemy-champion-near flag once per turn; retreat home to heal when hurt (35%, 55% with gems, 65% when carrying gems with a champion within 8, 75% when holding 150+ gold to shop, 60% with a champion within 6, 70% when two champions within 4); resume above 90%; spawn field built once when first needed', parents=['Z297a', 'Z26a', 'Z331c'])
def update() -> None:
    hf = me().health_frac
    lim = 0.35
    if gems() > 0:
        lim = 0.55
    if gold() >= 166 and gems() == 0:
        lim = 0.75
    close = 99
    anyc = 99
    close2 = 0
    mp = me().pos
    for u in enemies():
        d = dist(u.pos, mp)
        anyc = min(anyc, d)
        if u.is_champion:
            close = min(close, d)
            if d <= 4:
                close2 += 1
    CLOSE = anyc
    CHAMP_CLOSE = close
    if gems() > 0 and close <= 8 and hf < 0.8:
        lim = max(lim, 0.65)
    if close2 >= 2 and hf < 0.7:
        lim = 0.7
    NEAR = close <= 5
    if hf < 0.6 and close <= 6:
        HEAL = True
    if hf < lim:
        HEAL = True
    if hf > 0.9:
        HEAL = False
    if HEAL and not HAVE_SPF:
        SPF = field(my_spawn())
        HAVE_SPF = True
    if not HAVE_SPF:
        SPF = field(my_spawn())
        HAVE_SPF = True
    GF = goal_field(HEAL, SPF)

@gene('Z365a', 'value of casting an ability: damage/cc on targets (stronger on hurt enemy champions and close ones, AOE bonus for clusters of enemy champions, awake camps while carrying gems), heal starts at 60% health and scales with missing health, shield when hurt using cached enemy distances (saved for real threats: weak with no enemy within 8; also when a champion is close at full-ish health), no camp fights while healing, dash toward goals when healthy or healing (refused if an enemy champion is within 4 of the landing tile while healthy), dash home when healing', parents=['Z331a', 'Z26b', 'Z363b', 'Z365a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                close = 10 if dist(o.unit.pos, me().pos) <= 3 else 0
                finish = 8 if o.unit.health_frac < 0.35 else 0
                cluster = 0
                if k == AB_AOE:
                    cluster = 7 * count(u.is_champion and u.is_enemy and dist(u.pos, o.unit.pos) <= 2 for u in enemies())
                return 85 + 15 * (1.0587 - o.unit.health_frac) + close + finish + cluster + min(unit_gems(o.unit) / 5, 10)
            if o.unit.is_camp:
                if gems() == 0 and not HEAL:
                    return 65
                if gems() > 0 and is_awake(o.unit) and dist(o.unit.pos, me().pos) <= 2:
                    return 51
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.6 or HEAL:
            return 55 + 35 * (1 - me().health_frac)
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.8 or HEAL:
            if CLOSE <= 5:
                return 80
            if gems() > 0 and CLOSE <= 8:
                return 78
            if CLOSE > 8:
                return 45
            return 62
        if CHAMP_CLOSE <= 3:
            return 70
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if HEAL:
                if p > 0:
                    return 100 + 3 * p
                return 0
            if me().health_frac > 0.35 and p > 0:
                if any(dist(u.pos, o.tile) <= 4 for u in enemies() if u.is_champion):
                    return 0
                if gems() > 0:
                    return 50 + 3 * p
                return 40 + 3 * p
        return 0
    return 0
