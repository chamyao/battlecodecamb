"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 136 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3292 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 74
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt; altar once gems are worth a trip; else cleared groups awaiting capture, then living non-monolith camp groups')
def goals() -> Tiles:
    hp = me().health_frac
    if hp < 0.3 and gems() < 10:
        return my_spawn()
    if gems() >= 25 or (gems() > 0 and (hp < 0.4 or round() > 1850)):
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and not is_monolith_group(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z79a', 'once per turn: cache the distance field to the goals', parents=['s3'])
def update() -> None:
    GF = field(goals())

@gene('Z79b', 'true if a camp group contains a monolith spawn', parents=['s2'])
def is_monolith_group(g: Num) -> Bool:
    return any(spawn_type(t) == MONOLITH for t in group_tiles(g))

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)
