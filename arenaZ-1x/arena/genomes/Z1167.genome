"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEAL: Bool = False
SPF: Field
HAVE_SPF: Bool = False
NEAR: Bool = False
CLOSE: Num = 99
CHAMP_CLOSE: Num = 99
ECH: Tiles = None

@gene('Z1707a', 'value of doing this option now: pick strong champs, use abilities, focus weak targets, while retreating to heal only trade with enemy champions weaker than me; recall only when no enemy champion is close, or when carrying 20+ gems and hurt below 55%; farm camps while carrying under 30 gems (before round 1800), otherwise fight back awake monsters; tribute eagerly; move weighted by goal progress with a higher base while carrying gems (3x pull at 15+ gems), a late-game push after round 1800, and a higher empty-handed base after round 1000', parents=['Z331a', 'Z1490a', 'Z1490b'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 7
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 109 if o.item == 6 else 0
    if o.kind == RECALL:
        if NEAR:
            return 0
        if me().pos in my_spawn():
            return 0
        if me().health_frac < 0.4:
            return 49
        if gems() >= 20 and me().health_frac < 0.55:
            return 52
        if HEAL:
            home = nearest(my_spawn(), me().pos)
            if valid(home) and dist(home, me().pos) > 6:
                return 111
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEAL and o.unit.health_frac > me().health_frac + 0.1:
                return 30
            return 80 + 15 * (1 - o.unit.health_frac)
        if HEAL:
            return 0
        if gems() == 0 or (gems() < 30 and round() < 1800):
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.health_frac < 1 and dist(o.unit.pos, me().pos) <= 0.9999:
            return 40 + 10 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if HEAL:
            base = 50
        elif gems() > 0:
            base = 45
            if gems() >= 20:
                base += 10
            if round() > 1800:
                base += 8
        else:
            base = 35
            if round() > 1000:
                base = 42
        if gems() >= 15 and not HEAL:
            return base + 3 * p if p > 0 else 0
        return base + 2 * p if p > 0 else 0
    return 0

@gene('Z2036a', 'where to walk: altar when carrying 25+ gems, when tributing would win, any gems after round 1600, or 10+ gems after round 1500; else capture-ready groups, else living non-monolith groups with 8+ gems (with a nearby altar when carrying 15+ gems), else altar with any gems, else walk home to shop when holding 150+ gold, else living non-monolith groups with gems, else groups with gold/gems, else any living group (monoliths only as last resort)', parents=['Z1490b', 'Z1490a'])
def goals() -> Tiles:
    g0 = gems()
    r0 = round()
    if g0 > 0 and (g0 >= 25 or team_gems() + g0 >= 1000 or r0 >= 1600 or (g0 >= 10 and r0 >= 1500)):
        acc0 = altar_tiles()
        if size(acc0) > 0:
            return acc0
    ready = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            ready = ready | group_tiles(g)
    if size(ready) > 0:
        return ready
    mono = near(tile(-5, -5), 0)
    for t in type_spawns(MONOLITH):
        mg = spawn_group(t)
        if mg >= 0:
            mono = mono | group_tiles(mg)
    rich = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) >= 8:
            rich = rich | group_tiles(g)
    rich = rich - mono
    if size(rich) > 0:
        if g0 >= 15:
            alt = altar_tiles()
            if size(alt) > 0:
                return rich | alt
        return rich
    if g0 > 0:
        acc2 = altar_tiles()
        if size(acc2) > 0:
            return acc2
    if gold() >= 150 and g0 == 0:
        return my_spawn()
    gemt = near(tile(-5, -5), 0)
    valued = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            acc = acc | gt
            gg = group_gems(g)
            if gg > 0:
                gemt = gemt | gt
            if gg + group_gold(g) > 0:
                valued = valued | gt
    gemt = gemt - mono
    if size(gemt) > 0:
        return gemt
    valued = valued - mono
    if size(valued) > 0:
        return valued
    safe = acc - mono
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'heal walk: spawn field when hurt or threatened; healthy and far from spawn with no champion within 5 keeps pursuing goals; when carrying gems and an altar is within 8 steps (12 with 20+ gems), bank them there first; when retreating with gems and no enemy champion within 6, bank at the altar if it is closer than spawn; otherwise walk home', parents=['s3', 'Z1490c'])
def goal_field(heal: Bool, spf: Field) -> Field:
    hf = me().health_frac
    mp = me().pos
    if heal or (gems() > 0 and hf < 0.5):
        if heal and CHAMP_CLOSE <= 3 and hf > 0.5:
            return field(goals())
        if heal and hf > 0.6 and CHAMP_CLOSE > 5 and at(spf, mp) > 20:
            return field(goals())
        if gems() > 0 and CHAMP_CLOSE > 6 and hf > 0.3:
            al = altar_tiles()
            if size(al) > 0:
                af = field(al)
                if at(af, mp) < at(spf, mp):
                    return af
        return spf
    if gems() > 0 and CHAMP_CLOSE > 4:
        al2 = altar_tiles()
        if size(al2) > 0:
            af2 = field(al2)
            lim2 = 8
            if gems() >= 20:
                lim2 = 12
            if at(af2, mp) <= lim2:
                return af2
    return field(goals())

@gene('Z331b', 'how much closer a step brings me to the goals (cached field); 0 when unreachable; when below 80% health, avoid stepping within 2 tiles of enemy champions (3 when below 50%) and near monsters when moderately hurt; when carrying gems, extra penalty near enemy champions and a threat penalty for champions within 5; weighted by carried gems (capped), doubled while healing, minus a crowd penalty for enemy champions near the step scaled by their health; single pass over enemies to save fuel', parents=['Z297b', 'Z331b', 'Z407a', 'Z1490d'])
def progress(t: Tile) -> Num:
    a = at(GF, me().pos)
    b = at(GF, t)
    if a > 1000 or b > 1011:
        return 0
    hp = me().health_frac
    r = -1
    if hp < 0.8:
        r = 3 if hp < 0.5 else 2
    cr = 3 if hp < 0.5 else 2
    mon_check = hp < 0.7 and not HEAL
    g = gems()
    crowd_w = 1.0 if g > 0 else 0.5
    crowd = 0
    threat = 0
    blocked = False
    near_champ_gem = False
    camp_adj = 0
    for u in enemies():
        d = dist(u.pos, t)
        if u.is_champion:
            if d <= r:
                blocked = True
            if d <= 2:
                near_champ_gem = True
            if d <= cr:
                crowd += crowd_w * (0.5 + u.health_frac)
            if d <= 5:
                threat += 1
        else:
            if mon_check and d <= 2:
                blocked = True
            if u.is_camp and d <= 1:
                camp_adj += 1
    if blocked:
        return 0
    if g > 0 and not HEAL:
        crowd += 0.3 * camp_adj
    p = a - b - crowd
    if g > 0 and near_champ_gem:
        p = p - 3
    if g > 0 and not HEAL:
        p -= 0.5 * threat
    if HEAL:
        return p * 2
    if g > 0:
        p = p * (2 + min(g, 80) / 10)
    return p

@gene('Z1713a', 'cache the goal distance field, nearest-enemy distances, enemy champion tiles and an enemy-champion-near flag once per turn; retreat home to heal when hurt (35%, 40-44% with gems, 78% when carrying 30+ gems, 65% with gems and a champion within 7-8 below 80%, 75% when holding 150+ gold to shop, 70% when two champions within 4); resume above 90%, or above 80% with nothing within 10 and no gems; resume with gems at 60%+ when nothing is within 10 and no champion is near; spawn field cached once', parents=['Z1490e', 'Z331c', 'Z1713a'])
def update() -> None:
    hf = me().health_frac
    lim = 0.35
    if gems() > 0:
        lim = 0.4386
    if gems() >= 30:
        lim = max(lim, 0.7817)
    if gold() >= 150 and gems() == 0:
        lim = 1.2158
    close = 99
    anyc = 99
    close2 = 0
    mp = me().pos
    ech = near(mp, 0) - near(mp, 0)
    for u in enemies():
        d = dist(u.pos, mp)
        anyc = min(anyc, d)
        if u.is_champion:
            ech = ech | near(u.pos, 0)
            close = min(close, d)
            if d <= 4:
                close2 += 1
    ECH = ech
    CLOSE = anyc
    CHAMP_CLOSE = close
    if gems() > 0 and close <= 8 and hf < 0.8:
        lim = max(lim, 0.65)
    if close2 >= 2 and hf < 0.7:
        lim = 0.7
    NEAR = close <= 5 or anyc <= 2
    if hf < 0.6 and close <= 6:
        HEAL = True
    if hf < lim:
        HEAL = True
    if hf > 0.9:
        HEAL = False
    if HEAL and gems() == 0 and hf >= 0.6 and anyc > 10 and gold() < 150:
        HEAL = False
    if HEAL and gems() > 0 and hf >= 0.6 and anyc > 18 and close2 == 0:
        HEAL = False
    if hf > 0.8 and anyc > 10 and gems() == 0:
        HEAL = False
    if hf >= 0.45 and close <= 2 and gems() == 0:
        HEAL = False
    if not HAVE_SPF:
        SPF = field(my_spawn())
        HAVE_SPF = True
    GF = goal_field(HEAL, SPF)

@gene('Z1517a', 'walkable tiles beside the nearest unlocked altar, or the nearest locked altar if all are locked (tribute there hits the lock); empty if no altar', parents=['Z1517a'])
def altar_tiles() -> Tiles:
    acc = near(tile(-5, -5), 0)
    free = altars() - locked_altars()
    if size(free) == 0:
        free = altars()
    if size(free) > 0:
        a = nearest(free, me().pos)
        if valid(a):
            acc = near(a, 1)
    return acc - walls()

@gene('Z1554a', 'skip listing option kinds the policy never values (wards, locks, cancels), shop options away from spawn, moves/attacks when unable, recall when it would score 0 (also when carrying 20+ gems and hurt below 60%), tribute with no gems, to save fuel', parents=['Z1554a', 'Z1617a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop()
    if kind == MOVE:
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    if kind == RECALL:
        if NEAR:
            return False
        if HEAL or me().health_frac < 0.4:
            return True
        return gems() >= 20 and me().health_frac < 0.6
    return True

@gene('Z1707b', 'value of casting an ability: damage/cc on targets (stronger on hurt and close enemy champions; cc bonus since stun cancels tribute and recall; interrupt bonus on channeling enemies; AOE bonus for clusters using cached champion tiles; awake camps while carrying gems); heal scales with missing health; shield when a threat is near, earlier when badly hurt (A-style 74 champion-near shield); no camp fights while healing; dash toward goals when healthy (base 55 with gems, 65 with 20+ gems) or healing (refused if an enemy champion is within reach of the landing tile); dash home when healing', parents=['Z1505a', 'Z1490f', 'Z1713b', 'Z1863a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                close = 10 if dist(o.unit.pos, me().pos) <= 3 else 0
                finish = 8 if o.unit.health_frac < 0.35 else 0
                cc = 12 if k == AB_CC else 0
                interrupt = 0
                if is_tributing(o.unit) or is_recalling(o.unit):
                    interrupt = 25 if k == AB_CC else 15
                cluster = 0
                if k == AB_AOE:
                    cluster = 7 * count(dist(t, o.unit.pos) <= 2 for t in ECH)
                return 85 + 15 * (1.0587 - o.unit.health_frac) + close + finish + cc + interrupt + cluster + min(unit_gems(o.unit) / 5, 10)
            if o.unit.is_camp:
                if gems() == 0 and not HEAL:
                    return 65
                if gems() > 0 and is_awake(o.unit) and dist(o.unit.pos, me().pos) <= 3:
                    return 51
                if gems() > 0 and not HEAL and is_awake(o.unit) and dist(o.unit.pos, me().pos) <= 4:
                    return 45
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.9605 or HEAL:
            v = 55 + 35 * (1 - me().health_frac)
            if HEAL and gems() > 0:
                v += 10
            return v
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.5 and CLOSE <= 10:
            return 81
        if hf < 0.8 or HEAL:
            if CLOSE <= 5:
                return 80
            if gems() > 0 and CLOSE <= 8:
                return 78
            if CLOSE <= 8:
                return 72
            return 54
        if CHAMP_CLOSE <= 4:
            return 74
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if HEAL:
                if p > 0:
                    return 66 + 3 * p
                return 0
            hf = me().health_frac
            if hf > 0.35:
                reach = 5 if gems() > 0 else 4
                threat = False
                kill = 0
                for u in enemies():
                    if u.is_champion:
                        d = dist(u.pos, o.tile)
                        if d <= reach:
                            if hf > 0.6739 and u.health_frac < 0.3 and d <= 1.5 and dist(u.pos, me().pos) > d:
                                kill = max(kill, 82 + min(unit_gems(u) / 5, 10))
                            else:
                                threat = True
                if kill > 0:
                    return kill
                if threat or p <= 0:
                    return 0
                base = 55 if gems() > 0 else 40
                if gems() >= 20:
                    base += 10
                return base + 4 * min(p, 6)
        return 0
    return 0
