"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEAL: Bool = False
NEAR: Bool = False

@gene('Z483a', 'value of doing this option now: pick strong champs, buy items, recall when far and hurt (no enemy champion close), fight champions and hurt targets, move toward goals with extra weight while healing, use abilities', parents=['Z331a', 'Z421a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 7
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 109 if o.item == 6 else 0
    if o.kind == RECALL:
        if NEAR:
            return 0
        if me().pos in my_spawn():
            return 0
        if me().health_frac < 0.4:
            return 90
        if HEAL:
            home = nearest(my_spawn(), me().pos)
            if valid(home) and dist(home, me().pos) > 6:
                return 88
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 15 * (1 - o.unit.health_frac)
        if HEAL:
            return 0
        if gems() == 0:
            return 60 + 5 * (1.2124 - o.unit.health_frac)
        if o.unit.health_frac < 1 and dist(o.unit.pos, me().pos) <= 0.9999:
            return 40 + 10 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        base = 50 if HEAL else 35
        return base + 2 * p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems (fallback: any altar), else a living camp group (fallback: enemy spawn)", parents=["s2"])
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    if size(acc) == 0:
        acc = enemy_spawn()
    return acc

@gene('Z483b', 'distance field to the goals, or to my spawn (or a nearby altar when carrying gems) while healing', parents=['s3', 'Z421a'])
def goal_field(heal: Bool) -> Field:
    if heal:
        if gems() > 0:
            return field(my_spawn() | altars())
        return field(my_spawn())
    return field(goals())

@gene('Z483c', 'how much closer a step brings me to the goals (cached field); 0 when unreachable; when hurt, avoid stepping near enemy champions (and monsters when moderately hurt); weighted by carried gems (capped), doubled while healing', parents=['Z331b', 'Z421b'])
def progress(t: Tile) -> Num:
    a = at(GF, me().pos)
    b = at(GF, t)
    if a > 1000 or b > 1000:
        return 0
    hp = me().health_frac
    if hp < 0.5:
        if any(dist(u.pos, t) <= 3 for u in enemies() if u.is_champion):
            return 0
    if hp < 0.7 and not HEAL:
        if any(dist(u.pos, t) <= 2 for u in enemies() if not u.is_champion):
            return 0
    p = a - b
    if HEAL:
        return p * 2
    g = gems()
    if g > 0:
        p = p * (2 + min(g, 80) / 10)
    return p

@gene('Z483d', 'cache the goal field and enemy-champion-near flag once per turn (skipped while dead); retreat home to heal when hurt (42%, 55% carrying gems, 70% with two or more enemy champions within 4, 60% with one within 6, 75% when holding 150+ gold to shop); hysteresis exit at 92%', parents=['Z331c', 'Z421c'])
def update() -> None:
    if not alive():
        HEAL = False
        return
    hf = me().health_frac
    lim = 0.42
    if gems() > 0:
        lim = 0.55
    if gold() >= 150 and gems() == 0:
        lim = 0.75
    close = 99
    for u in enemies():
        if u.is_champion:
            close = min(close, dist(u.pos, me().pos))
    crowd = sum(1 for u in enemies() if u.is_champion and dist(u.pos, me().pos) <= 4)
    if crowd >= 2 and hf < 0.7:
        lim = 0.7
    NEAR = close <= 4
    if hf < 0.6 and close <= 6:
        HEAL = True
    if hf < lim:
        HEAL = True
    if hf > 0.92:
        HEAL = False
    GF = goal_field(HEAL)

@gene('Z483e', 'value of casting an ability: damage/cc on targets (stronger on hurt enemy champions, close ones and finishing blows), heal scales with missing health, shield when hurt (harder when enemies are close or gems are carried), no camp fights while healing, dash toward goals when healthy (capped) or healing, dash home when healing and far', parents=['Z365a', 'Z421d'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                close = 10 if dist(o.unit.pos, me().pos) <= 3 else 0
                finish = 8 if o.unit.health_frac < 0.35 else 0
                return 85 + 15 * (1.0587 - o.unit.health_frac) + close + finish
            if o.unit.is_camp and gems() == 0 and not HEAL:
                return 65
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.7:
            return 58 + 40 * (1 - me().health_frac)
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.8:
            if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
                return 80
            if gems() > 0 and any(dist(u.pos, me().pos) <= 8 for u in enemies()):
                return 78
            return 72
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if HEAL:
                if p > 0:
                    return 60 + 3 * p
                return 0
            if me().health_frac > 0.35 and not NEAR and p > 0:
                if gems() > 0:
                    return min(50 + 3 * p, 62)
                return min(40 + 3 * p, 62)
        return 0
    return 0
