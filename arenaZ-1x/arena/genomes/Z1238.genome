"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEAL: Bool = False
SPF: Field
HAVE_SPF: Bool = False
NEAR: Bool = False
CLOSE: Num = 99
CHAMP_CLOSE: Num = 99
ECH: Tiles = None

@gene('Z1490a', 'value of doing this option now: pick strong champs, use abilities, focus weak targets, while retreating to heal only trade with enemy champions that are weaker than me; recall only when no enemy champion is close; keep farming camps while carrying under 30 gems (before round 1800), else only fight back awake monsters; tribute eagerly, move weighted by goal progress with a stronger pull while carrying 10+ gems (strongest at 30+); moves get a bonus while carrying 20+ gems', parents=['Z331a', 'Z1490a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 7
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 109 if o.item == 6 else 0
    if o.kind == RECALL:
        if NEAR:
            return 0
        if me().pos in my_spawn():
            return 0
        if me().health_frac < 0.4:
            return 49
        if HEAL:
            home = nearest(my_spawn(), me().pos)
            if valid(home) and dist(home, me().pos) > 6:
                return 88
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if HEAL and o.unit.health_frac > me().health_frac + 0.1:
                return 30
            return 80 + 15 * (1 - o.unit.health_frac)
        if HEAL:
            return 0
        if gems() == 0 or (gems() < 30 and round() < 1800):
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.health_frac < 1 and dist(o.unit.pos, me().pos) <= 0.9999:
            return 40 + 10 * (1.4872 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        base = 50 if HEAL else 35
        if gems() >= 20 and not HEAL:
            base += 10
        if gems() >= 30 and not HEAL:
            return base + 4 * p if p > 0 else 0
        if gems() >= 10 and not HEAL:
            return base + 3 * p if p > 0 else 0
        return base + 2 * p if p > 0 else 0
    return 0

@gene('Z1490b', 'where to walk: altar when carrying 30+ gems, when tributing would win, 10+ gems after round 1500 or any gems after 1800; else capture-ready groups, else living non-monolith groups with 8+ gems, else altar with any gems, else walk home to shop when holding 150+ gold, else living non-monolith groups with gems, else groups with gold/gems, else any living group (monoliths only as last resort)', parents=['Z704a', 'Z1490b'])
def goals() -> Tiles:
    g0 = gems()
    r0 = round()
    if g0 > 0 and (g0 >= 30 or team_gems() + g0 >= 1000 or (g0 >= 10 and r0 >= 1500) or r0 >= 1800):
        acc = altar_tiles()
        if size(acc) > 0:
            return acc
    ready = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            ready = ready | group_tiles(g)
    if size(ready) > 0:
        return ready
    mono = near(tile(-5, -5), 0)
    for t in type_spawns(MONOLITH):
        mg = spawn_group(t)
        if mg >= 0:
            mono = mono | group_tiles(mg)
    rich = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) >= 8:
            rich = rich | group_tiles(g)
    rich = rich - mono
    if size(rich) > 0:
        return rich
    if g0 > 0:
        acc2 = altar_tiles()
        if size(acc2) > 0:
            return acc2
    if gold() >= 150 and g0 == 0:
        return my_spawn()
    gemt = near(tile(-5, -5), 0)
    valued = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            acc = acc | gt
            gg = group_gems(g)
            if gg > 0:
                gemt = gemt | gt
            if gg + group_gold(g) > 0:
                valued = valued | gt
    gemt = gemt - mono
    if size(gemt) > 0:
        return gemt
    valued = valued - mono
    if size(valued) > 0:
        return valued
    safe = acc - mono
    if size(safe) > 0:
        return safe
    return acc

@gene('s3', 'heal walk: spawn field when hurt or threatened; healthy (>60%) and moderately far from spawn (>20 steps) with no enemy within 6 keeps pursuing goals', parents=['s3', 'Z1490c'])
def goal_field(heal: Bool, spf: Field) -> Field:
    if heal:
        if CHAMP_CLOSE <= 3 and me().health_frac > 0.5:
            return field(goals())
        if me().health_frac > 0.6 and CLOSE > 6 and at(spf, me().pos) > 20:
            return field(goals())
        return spf
    return field(goals())

@gene('Z1490d', 'how much closer a step brings me to the goals (cached field); 0 when unreachable; when below 80% health, avoid stepping within 2 tiles of enemy champions (3 when below 50%) and near monsters when moderately hurt; weighted by carried gems, doubled while healing, minus a crowd penalty, a threat penalty and an awake-camp-adjacency penalty for gem carriers', parents=['Z331b', 'Z1490d', 'Z407a'])
def progress(t: Tile) -> Num:
    a = at(GF, me().pos)
    b = at(GF, t)
    if a > 909 or b > 1000:
        return 0
    hp = me().health_frac
    g = gems()
    r = 3 if hp < 0.5 else 2
    avoid_champ = hp < 0.8
    avoid_mon = hp < 0.7 and not HEAL
    crowd_w = 1.0 if g > 0 else 0.5
    crowd = 0
    threat = 0
    camp_adj = 0
    for u in enemies():
        d = dist(u.pos, t)
        if u.is_champion:
            if avoid_champ and d <= r:
                return 0
            if d <= 2:
                crowd += crowd_w
            if d <= 5:
                threat += 1
        else:
            if avoid_mon and d <= 2:
                return 0
            if u.is_camp and d <= 1:
                camp_adj += 1
    p = a - b - crowd
    if HEAL:
        return p * 2
    if g > 0:
        p -= 0.5 * threat + 0.3 * camp_adj
        p = p * (2 + min(g, 80) / 9)
    return p

@gene('Z1713a', 'cache the goal distance field, nearest-enemy distances, enemy champion tiles and an enemy-champion-near flag (also any enemy within 2) once per turn; retreat home to heal when hurt (35%, 44% with gems, 78% when carrying 30+ gems, 65% with gems and a champion within 7 below 80%, 75% when holding 166+ gold to shop, 70% when two champions within 4, 50% when a champion is within 3); resume above 90%, or above 80% with nothing within 10 and no gems', parents=['Z1490e', 'Z331c'])
def update() -> None:
    hf = me().health_frac
    lim = 0.35
    if gems() > 0:
        lim = 0.4386
    if gems() >= 30:
        lim = max(lim, 0.7817)
    if gold() >= 166 and gems() == 0:
        lim = 0.75
    close = 99
    anyc = 99
    close2 = 0
    mp = me().pos
    ech = near(mp, 0) - near(mp, 0)
    for u in enemies():
        d = dist(u.pos, mp)
        anyc = min(anyc, d)
        if u.is_champion:
            ech = ech | near(u.pos, 0)
            close = min(close, d)
            if d <= 4:
                close2 += 1
    ECH = ech
    CLOSE = anyc
    CHAMP_CLOSE = close
    if gems() > 0 and close <= 7 and hf < 0.8:
        lim = max(lim, 0.65)
    if close2 >= 2 and hf < 0.7:
        lim = 0.7
    if close <= 3 and hf < 0.5:
        lim = max(lim, 0.5)
    NEAR = close <= 5 or anyc <= 2
    if hf < 0.6 and close <= 6:
        HEAL = True
    if hf < lim:
        HEAL = True
    if hf > 0.9:
        HEAL = False
    if HEAL and gems() == 0 and hf > 0.6 and anyc > 12:
        HEAL = False
    if hf > 0.8 and anyc > 10 and gems() == 0:
        HEAL = False
    if hf >= 0.45 and close <= 1 and gems() == 0:
        HEAL = False
    if not HAVE_SPF:
        SPF = field(my_spawn())
        HAVE_SPF = True
    GF = goal_field(HEAL, SPF)

@gene('Z1517a', 'walkable tiles beside unlocked altars, avoiding tiles next to enemy champions when a safe one exists (falls back to all); excludes walls and holes', parents=['Z1517a'])
def altar_tiles() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for a in altars() - locked_altars():
        acc = acc | near(a, 1)
    acc = acc - walls() - holes()
    safe = acc - ECH
    if size(safe) > 0:
        return safe
    return acc

@gene('Z1554a', 'skip listing option kinds the policy never values (wards, locks, cancels), shop options away from spawn, moves/attacks when unable, recall when it would score 0 (also desperate recall below 30% health even near enemies), tribute with no gems, to save fuel', parents=['Z1554a', 'Z1617a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop()
    if kind == MOVE:
        return can_move()
    if kind == ATTACK:
        return can_attack()
    if kind == TRIBUTE:
        return gems() > 0
    if kind == RECALL:
        if NEAR and me().health_frac >= 0.3:
            return False
        if HEAL or me().health_frac < 0.4:
            return True
        return gems() >= 20 and me().health_frac < 0.6
    return True

@gene('Z1713b', 'value of casting an ability: damage/cc on targets (stronger on hurt enemy champions and close ones, CC bonus, interrupt bonus on tributing/recalling enemies, AOE bonus for clusters using cached champion tiles, awake camps while carrying gems); heal scales with missing health; shield when hurt or threatened (earlier when badly hurt); no camp fights while healing; dash toward goals when healthy (refused near healthy enemy champions, but allowed to finish a low-health champion; requires real progress, scaled 6x; extra pull when carrying 20+ gems), dash home when healing', parents=['Z1490f', 'Z1505a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                close = 10 if dist(o.unit.pos, me().pos) <= 3 else 0
                finish = 8 if o.unit.health_frac < 0.35 else 0
                cc = 12 if k == AB_CC else 0
                interrupt = 0
                if is_tributing(o.unit) or is_recalling(o.unit):
                    interrupt = 25 if k == AB_CC else 15
                cluster = 0
                if k == AB_AOE:
                    cluster = 7 * count(dist(t, o.unit.pos) <= 2 for t in ECH)
                return 85 + 15 * (1.0587 - o.unit.health_frac) + close + finish + cc + interrupt + cluster + min(unit_gems(o.unit) / 5, 10)
            if o.unit.is_camp:
                if gems() == 0 and not HEAL:
                    return 54
                if gems() > 0 and is_awake(o.unit) and dist(o.unit.pos, me().pos) <= 2:
                    return 51
                if gems() > 0 and not HEAL and is_awake(o.unit) and dist(o.unit.pos, me().pos) <= 4:
                    return 41
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.9605 or HEAL:
            v = 55 + 35 * (1 - me().health_frac)
            if HEAL and gems() > 0:
                v += 10
            return v
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.5 and CLOSE <= 10:
            return 81
        if hf < 0.8 or HEAL:
            if CLOSE <= 5:
                return 80
            if gems() > 0 and CLOSE <= 8:
                return 78
            if CLOSE <= 8:
                return 72
            return 54
        if CHAMP_CLOSE <= 4:
            return 74
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if HEAL:
                if p > 0:
                    return 100 + 3 * p
                return 0
            hf = me().health_frac
            if hf > 0.35:
                reach = 5 if gems() > 0 else 4
                threat = False
                kill = 0
                if CHAMP_CLOSE <= 12:
                    for u in enemies():
                        if u.is_champion:
                            d = dist(u.pos, o.tile)
                            if d <= reach:
                                if hf > 0.6739 and u.health_frac < 0.3 and d <= 1.5 and dist(u.pos, me().pos) > d:
                                    kill = max(kill, 82 + min(unit_gems(u) / 5, 10))
                                elif u.health_frac >= 0.5 or d <= 4:
                                    threat = True
                if kill > 0:
                    return kill
                if threat or p < 1:
                    return 0
                base = 55 if gems() > 0 else 39
                if gems() >= 20:
                    base += 10
                return base + 6 * min(p, 4)
        return 0
    return 0
