"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEAL: Bool = False

@gene('s1', 'value of doing this option now: pick strong champs, use abilities, focus weak targets, recall when healing and far from spawn with no enemy close, keep farming camps until banking gems')
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 5
        if o.champ == HEART_OF_RUIN:
            return 5
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 3
        return 1
    if o.kind == BUY:
        return 109 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().pos in my_spawn():
            return 0
        if me().health_frac < 0.4:
            return 90
        if HEAL:
            home = nearest(my_spawn(), me().pos)
            if valid(home) and dist(home, me().pos) > 6:
                if not any(u.is_champion and dist(u.pos, me().pos) <= 4 for u in enemies()):
                    return 88
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 22 * (1 - o.unit.health_frac)
        if HEAL:
            return 0
        if not banking():
            return 45 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 35 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar when banking gems; else a cleared group awaiting capture; else a living non-monolith camp group; altars as fallback when carrying')
def goals() -> Tiles:
    alt = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if banking():
            return alt
    rew = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            rew = rew | group_tiles(g)
    if size(rew) > 0:
        return rew
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    acc = acc - type_spawns(MONOLITH)
    if size(acc) == 0 and size(alt) > 0:
        return alt
    return acc

@gene('s3', 'distance field to the goals, or to my spawn while healing')
def goal_field(heal: Bool) -> Field:
    if heal:
        return field(my_spawn())
    return field(goals())

@gene('Z207a', 'how much closer a step brings me to the goals (cached field); 0 when unreachable; clamped to +-8; weighted by carried gems only when banking (not while healing, capped)', parents=['s4'])
def progress(t: Tile) -> Num:
    a = at(GF, me().pos)
    b = at(GF, t)
    if a > 1000 or b > 1000:
        return 0
    p = min(max(a - b, -8), 8)
    if not HEAL and banking():
        p = p * min(2 + gems() / 10, 7)
    return p

@gene('Z682a', 'carrying enough gems (or late game with any) that the altar is worth the walk and channel', parents=['s2'])
def banking() -> Bool:
    g = gems()
    if g >= 30:
        return True
    if g > 0 and round() > 1800:
        return True
    return False

@gene('Z26a', 'cache the goal distance field once per turn; retreat home to heal when hurt (earlier, at 50%, when carrying gems; hysteresis exit at 90%)', parents=['s4'])
def update() -> None:
    hf = me().health_frac
    lim = 0.35
    if gems() > 0:
        lim = 0.5
    if hf < lim:
        HEAL = True
    if hf > 0.9:
        HEAL = False
    GF = goal_field(HEAL)

@gene('Z26b', 'value of casting an ability: damage/cc on targets (stronger on hurt or gem-carrying enemy champions, also on awake camps while carrying), shield/heal when hurt, shield harder when enemies are close, dash toward goals or home when healing (needs a real step, scaled by distance covered) or healthy (bonus for carried gems, scaled by gems)', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85 + 15 * (1 - o.unit.health_frac) + min(unit_gems(o.unit) / 5, 10)
            if o.unit.is_camp:
                if gems() == 0:
                    return 65
                if is_awake(o.unit):
                    return 82
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.7:
            return 70
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.8826:
            if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
                return 80
            return 72
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if HEAL:
                if p >= 2:
                    return 100 + 3 * min(p, 30)
                return 0
            if me().health_frac > 0.2957 and p > 0:
                return 40 + 4 * min(p, 15) + min(gems() * 3, 40)
        return 0
    return 0
