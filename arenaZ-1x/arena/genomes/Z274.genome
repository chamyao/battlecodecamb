"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEAL: Bool = False

@gene('Z421a', 'value of doing this option now: pick strong champs, buy items, recall when healing and far from spawn with no enemy champion close, fight champions and hurt targets, move toward goals with extra weight while healing, use abilities', parents=['s1', 'Z297a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 5
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 109 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().pos in my_spawn():
            return 0
        if me().health_frac < 0.4:
            return 90
        if HEAL:
            home = nearest(my_spawn(), me().pos)
            if valid(home) and dist(home, me().pos) > 6:
                if not any(u.is_champion and dist(u.pos, me().pos) <= 4 for u in enemies()):
                    return 88
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 15 * (1 - o.unit.health_frac)
        if HEAL:
            return 0
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        base = 50 if HEAL else 35
        return base + 2 * p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, or to my spawn while healing')
def goal_field(heal: Bool) -> Field:
    if heal:
        return field(my_spawn())
    return field(goals())

@gene('Z421b', 'how much closer a step brings me to the goals (cached field); 0 when unreachable, or when hurt and stepping near enemy champions/monsters; weighted by carried gems (capped), doubled while healing', parents=['Z207a', 'Z297b'])
def progress(t: Tile) -> Num:
    a = at(GF, me().pos)
    b = at(GF, t)
    if a > 1000 or b > 1000:
        return 0
    hp = me().health_frac
    if hp < 0.5:
        if any(dist(u.pos, t) <= 3 for u in enemies() if u.is_champion):
            return 0
    if hp < 0.7 and not HEAL:
        if any(dist(u.pos, t) <= 2 for u in enemies() if not u.is_champion):
            return 0
    p = a - b
    if HEAL:
        return p * 2
    g = gems()
    if g > 0:
        p = p * (2 + min(g, 80) / 10)
    return p

@gene('Z421c', 'cache the goal distance field once per turn (skipped while dead); retreat home to heal when hurt (42%, 55% when carrying gems, 60% when carrying 20+ gems, 70% when two or more enemy champions are within 4 tiles); hysteresis exit at 92%', parents=['Z26a'])
def update() -> None:
    if not alive():
        HEAL = False
        return
    hf = me().health_frac
    lim = 0.42
    g = gems()
    if g > 0:
        lim = 0.55
    if g >= 20:
        lim = 0.6
    close = sum(1 for u in enemies() if u.is_champion and dist(u.pos, me().pos) <= 4)
    if close >= 2 and hf < 0.7:
        lim = 0.7
    if hf < lim:
        HEAL = True
    if hf > 0.92:
        HEAL = False
    GF = goal_field(HEAL)

@gene('Z421d', 'value of casting an ability: damage/cc on targets (stronger on hurt enemy champions), heal scales with missing health, shield when hurt, harder when enemies are close or gems are carried, dash toward goals or home when healing or healthy', parents=['Z26b', 'Z297b'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85 + 12 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.7:
            return 60 + 30 * (1 - me().health_frac)
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.8:
            if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
                return 80
            if gems() > 0 and any(dist(u.pos, me().pos) <= 8 for u in enemies()):
                return 78
            return 72
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if HEAL:
                if p > 0:
                    return 60 + 3 * p
                return 0
            if me().health_frac > 0.35 and p > 0:
                if gems() > 0:
                    return 50 + 3 * p
                return 40 + 3 * p
        return 0
    return 0
