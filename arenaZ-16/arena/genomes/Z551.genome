"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None
RETREAT: Bool = False
HOME_F: Field = None
HOME_SET: Bool = False

@gene('s1', 'value of doing this option now; casts damage/cc on targets and shield/heal when hurt in a fight; recalls when low, or when retreating far from home with no threats nearby', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 45 + 6 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'cached per-turn field: goals normally, my spawn while retreating (no per-pass engine calls)', parents=['s3'])
def goal_field() -> Field:
    return GOAL_F

@gene('s4', 'how much closer a step brings me to the goals: clamped against unreachable readings, urgent when retreating, doubled when healthy, weight scales with carried gems (up to +3)', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    m = me()
    d = at(f, m.pos) - at(f, t)
    if d > 2:
        d = 2
    if d < -1:
        d = -2
    if RETREAT:
        return d * 3
    w = 1
    if m.health_frac > 0.5236:
        w = 2
    g = gems()
    if g > 0:
        w = w + min(g / 10, 3)
    return d * w

@gene('Z26a', 'value of casting: hit champions (scaled up as they weaken) and camps, protect allies and self when hurt near enemies or awake camps, dash toward goals when healthy or home when retreating', parents=['s1', 'Z26a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 110 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 65
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            ne = count(dist(u.pos, o.tile) <= r for u in enemies())
            if ne > 0:
                return 110 + ne
            if gems() == 0:
                nc = count(dist(u.pos, o.tile) <= r for u in camps())
                if nc > 0:
                    return 60 + nc
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        return protect_cast_value(o)
    if k == AB_DASH:
        return dash_cast_value(o)
    return 0

@gene('X230a', 'value of a shield/heal cast: hurt allies (more near enemies), or self when hurt near enemies or awake camps', parents=['Z26a'])
def protect_cast_value(o: Option) -> Num:
    if exists(o.unit) and not o.unit.is_enemy and o.unit.pos != me().pos:
        if o.unit.health_frac < 0.6:
            if any(dist(u.pos, o.unit.pos) <= 4 for u in enemies()):
                return 87
        if o.unit.health_frac < 0.5:
            return 85
        return 0
    if me().health_frac < 0.7:
        if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            return 88
        if me().health_frac < 0.55:
            if any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                return 75
    return 0

@gene('X200a', 'value of a dash cast: escape toward spawn when retreating (even with enemies close), else toward goals when healthy (>60%) and no enemies within 5; capped progress, bonus for carried gems', parents=['Z26a'])
def dash_cast_value(o: Option) -> Num:
    if not valid(o.tile):
        return 0
    p = progress(o.tile)
    if RETREAT:
        if p >= 2:
            return 90 + 5 * min(p, 8) + 3 * min(gems(), 10)
        return 0
    if me().health_frac > 0.6:
        if not any(dist(u.pos, me().pos) <= 5 for u in enemies()):
            if p >= 3:
                return 40 + 5 * min(p, 8) + 2 * min(gems(), 10)
    return 0

@gene('Z545a', 'recall value: very low health, or retreating far from spawn (>15) with no enemies within 9 or awake camps within 6; score rises steeply with carried gems so loaded champions get home', parents=['s1'])
def recall_value() -> Num:
    if me().health_frac < 0.35:
        return 120
    if RETREAT:
        if at(goal_field(), me().pos) > 15:
            if not any(dist(u.pos, me().pos) <= 9 for u in enemies()):
                if not any(is_awake(c) and dist(c.pos, me().pos) <= 6 for c in camps()):
                    return 100 + 4 * unit_gems(me())
    return 0

@gene('Z21a', 'once per turn: retreat with hysteresis; go home below a threshold that rises with carried gems (53% empty to ~73% at 20+ gems), or below 70% when enemies at least match allies within 6 tiles; resume at 90%+; then cache the matching distance field (spawn field computed once, nothing computed while dead)', parents=['s3', 'Z21a'])
def update() -> None:
    if alive():
        h = me().health_frac
        p = me().pos
        carry = unit_gems(me())
        low = 0.3327 + 0.2 * min(carry / 20, 1)
        near_e = count(dist(u.pos, p) <= 6 for u in enemies())
        near_a = count(dist(u.pos, p) <= 6 for u in allies())
        if h < low or (h < 0.7 and near_e >= near_a):
            RETREAT = True
        elif h > 0.9:
            RETREAT = False
        if RETREAT:
            if not HOME_SET:
                HOME_F = field(my_spawn())
                HOME_SET = True
            GOAL_F = HOME_F
        else:
            GOAL_F = field(goals())
    else:
        RETREAT = False
