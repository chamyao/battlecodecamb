"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
NEN: Num = 0

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, altar with enough gems, cleared rewards, else living non-monolith camps')
def goals() -> Tiles:
    if me().health_frac < 0.3 and gems() < 10:
        return my_spawn()
    if gems() >= 10 or (gems() > 0 and round() > 1850):
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    reward = near(tile(-5, -5), 0)
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            reward = reward | group_tiles(g)
        elif not group_respawning(g):
            ts = group_tiles(g)
            t0 = best(ts, lambda x: 0)
            if valid(t0) and spawn_type(t0) == MONOLITH:
                continue_ok = False
            else:
                acc = acc | ts
    if size(reward) > 0:
        return reward
    if size(acc) == 0 and gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
    return acc

@gene('s3', 'distance field to the goals, cached once per turn in update()')
def goal_field() -> Field:
    return GF

@gene('s4', 'goal progress minus danger from nearby enemies at the target tile (cached field)')
def progress(t: Tile) -> Num:
    f = goal_field()
    gain = at(f, me().pos) - at(f, t)
    danger = 0
    if NEN > 0:
        danger = sum(u.strength * u.health_frac for u in enemies() if dist(u.pos, t) <= 2)
    return gain * 10 - danger

@gene('Z101a', 'per-turn: compute the goal distance field and enemy count once', parents=['s2', 's3', 's4'])
def update() -> None:
    GF = field(goals())
    NEN = count_units(enemies())
