"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene('s1', 'value of doing this option now; also casts damage/cc on targets and shield/heal when hurt in a fight, recalls a bit earlier', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3534 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals, cached once per turn in update()", parents=['s3'])
def goal_field() -> Field:
    return GOAL_F

@gene('s4', 'how much closer a step brings me to the goals; zero while healing on spawn so I stay until mostly healed', parents=['s4'])
def progress(t: Tile) -> Num:
    if healing():
        return 0
    f = goal_field()
    return at(f, me().pos) - at(f, t)

@gene('Z67a', 'true while I stand on my spawn and should stay there to heal before heading out again', parents=['s4'])
def healing() -> Bool:
    m = me()
    return m.health_frac < 0.85 and m.pos in my_spawn()

@gene('Z26a', 'value of casting an ability: hit champions/camps with damage, shield/heal scaled by low health in a fight, dash toward goals when safe', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 115
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if me().health_frac < 0.7:
            if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
                return 80 + (0.7 - me().health_frac) * 60
        return 0
    if k == AB_DASH:
        if valid(o.tile) and not healing():
            if count(dist(u.pos, me().pos) <= 4 for u in enemies()) == 0:
                p = progress(o.tile)
                if p > 3:
                    return 45
        return 0
    return 0

@gene("Z21a", "compute the goal distance field once at the start of each turn", parents=['s3'])
def update() -> None:
    GOAL_F = field(goals())
