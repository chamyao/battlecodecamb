"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None
RETREAT: Bool = False
E_NEAR4: Bool = False
E_NEAR5: Bool = False
AWAKE_NEAR2: Bool = False
HOME_F: Field = None
HOME_SET: Bool = False

@gene('s1', 'value of doing this option now; casts damage/cc on targets and shield/heal when hurt in a fight; attacks on enemy champions get more valuable as they weaken; recalls when low or when retreating far from home with no threats', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 30 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        base = 55 if RETREAT else 45
        return base + 6 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'cached per-turn field: goals normally, home while retreating (no per-pass engine calls)', parents=['s3'])
def goal_field() -> Field:
    return GOAL_F

@gene('Z371a', 'progress toward goals (clamped against unreachable readings) minus danger from enemy champions and nearby monsters near the step; danger weighs more when hurt or carrying gems; carriers avoid stepping 3 tiles from champions', parents=['s4', 'Z371a'])
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    if d > 3:
        d = 3
    if d < -3:
        d = -3
    danger = sum(0.244 + u.health_frac for u in enemies() if u.is_champion and dist(u.pos, t) <= 2)
    mon = sum(1 for u in enemies() if (not u.is_champion) and dist(u.pos, t) <= 2)
    if me().health_frac < 0.5:
        danger += mon
    if RETREAT:
        return d * 3 - danger * 2
    if gems() > 0:
        far = sum(2.368 for u in enemies() if u.is_champion and dist(u.pos, t) == 3)
        return d * 3 - danger * 4 - far * 2
    if me().health_frac > 0.6:
        return d * 2 - danger * 2
    return d - danger * 3

@gene('Z26a', 'value of casting: hit champions (scaled up as they weaken) and camps; area casts on enemies near the target, or on camps when carrying nothing; protect allies and self when hurt; dash toward goals or home', parents=['s1', 'Z26a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 114 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 65
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            ne = count(dist(u.pos, o.tile) <= r for u in enemies())
            if ne > 0:
                return 110 + ne
            if gems() == 0:
                nc = count(dist(u.pos, o.tile) <= r for u in camps())
                if nc > 0:
                    return 60 + nc
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        return protect_cast_value(o)
    if k == AB_DASH:
        return dash_cast_value(o)
    return 0

@gene('X230a', 'value of a shield/heal cast: hurt allies (more near enemies), or self when hurt near enemies (cached flag) or near awake camps', parents=['Z26a', 'X230a'])
def protect_cast_value(o: Option) -> Num:
    if exists(o.unit) and not o.unit.is_enemy and o.unit.pos != me().pos:
        if o.unit.health_frac < 0.6:
            if any(dist(u.pos, o.unit.pos) <= 4 for u in enemies()):
                return 87
        if o.unit.health_frac < 0.5:
            return 85
        return 0
    if me().health_frac < 0.7:
        if E_NEAR4:
            return 88
        if me().health_frac < 0.6 and AWAKE_NEAR2:
            return 75
    return 0

@gene('X200a', 'value of a dash cast: escape toward home when retreating (more when enemies close); else toward goals when healthy, no enemies close, and carrying gems, capped progress', parents=['Z26a', 'X200a'])
def dash_cast_value(o: Option) -> Num:
    if not valid(o.tile):
        return 0
    if RETREAT:
        p = progress(o.tile)
        if p >= 2:
            bonus = 0
            if E_NEAR4:
                bonus = 25
            return 90 + 5 * min(p, 8) + bonus
        return 0
    if me().health_frac > 0.45 and not E_NEAR5 and gems() > 0:
        p = progress(o.tile)
        if p >= 3:
            return 40 + 5 * min(p, 8)
    return 0

@gene('Z545a', 'recall value: very low health; or retreating far from spawn with no enemies or awake camps close so the recall will not be cancelled', parents=['s1', 'Z545a'])
def recall_value() -> Num:
    if me().health_frac < 0.35:
        return 120
    if RETREAT:
        if at(goal_field(), me().pos) > 12:
            if not any(dist(u.pos, me().pos) <= 7 for u in enemies()):
                if not any(is_awake(c) and dist(c.pos, me().pos) <= 5 for c in camps()):
                    return 100
    return 0

@gene('Z388a', 'once per turn: retreat with hysteresis (home below a threshold rising with carried gems, below 75% when outnumbered, below 70% when swarmed or matched, or carrying 10+ gems with a champion within 3); resume above 90%; cache threat flags; retreating with 5+ gems aims at home or altars; otherwise cache the home field once and the goal field per turn', parents=['Z388a', 'Z21a'])
def update() -> None:
    if alive():
        h = me().health_frac
        p = me().pos
        carry = unit_gems(me())
        low = 0.5305 + 0.2 * min(carry / 20, 1)
        near_e = count(dist(u.pos, p) <= 6 for u in enemies())
        near_a = count(dist(u.pos, p) <= 6 for u in allies())
        E_NEAR5 = any(dist(u.pos, p) <= 5 for u in enemies())
        E_NEAR4 = any(dist(u.pos, p) <= 3 for u in enemies())
        AWAKE_NEAR2 = h < 0.6 and any(is_awake(c) and dist(c.pos, p) <= 2 for c in camps())
        swarmed = near_e >= 3 and h < 0.7
        threatened = carry >= 10 and any(dist(u.pos, p) <= 3 for u in enemies() if u.is_champion)
        matched = h < 0.7 and near_e > 0 and near_e >= near_a
        if h < low or (h < 0.75 and near_e > near_a + 1) or swarmed or threatened or matched:
            RETREAT = True
        elif h > 0.9:
            RETREAT = False
        if RETREAT:
            if carry >= 5:
                GOAL_F = field(my_spawn() | altars())
            else:
                if not HOME_SET:
                    HOME_F = field(my_spawn())
                    HOME_SET = True
                GOAL_F = HOME_F
        else:
            GOAL_F = field(goals())
    else:
        RETREAT = False
        E_NEAR4 = False
        E_NEAR5 = False
        AWAKE_NEAR2 = False
