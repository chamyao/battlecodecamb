"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now; also casts damage/cc on targets and shield/heal when hurt in a fight, recalls a bit earlier')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an unlocked altar when carrying enough gems (or late game); else cleared groups awaiting capture, else living camps holding gems or gold')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    g_now = gems()
    if g_now >= 20 or (g_now > 0 and round() > 1700):
        free = altars() - locked_altars()
        src = free if size(free) > 0 else altars()
        for a in src:
            acc = acc | near(a, 1)
        return acc
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) + group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) == 0 and g_now > 0:
        free = altars() - locked_altars()
        src = free if size(free) > 0 else altars()
        for a in src:
            acc = acc | near(a, 1)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z114a', 'once per turn: cache the distance field to the goals so the loop does not recompute it every pass', parents=['s3'])
def update() -> None:
    GF = field(goals())

@gene('s4', 'how much closer a step brings me to the goals')
def progress(t: Tile) -> Num:
    f = goal_field()
    return at(f, me().pos) - at(f, t)

@gene('Z26a', 'value of casting an ability: hit champions/camps with damage, protect self when hurt near enemies', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if me().health_frac < 0.7:
            if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
                return 88
        return 0
    return 0
