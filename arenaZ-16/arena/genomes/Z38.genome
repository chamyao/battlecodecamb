"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now; also casts damage/cc on targets and shield/heal when hurt in a fight, recalls a bit earlier', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.375 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 35 + 8 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals", parents=['s3'])
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, doubled when healthy', parents=['s4'])
def progress(t: Tile) -> Num:
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    if me().health_frac > 0.6:
        return d * 2
    return d

@gene('Z26a', 'value of casting an ability: hit champions/camps (unit or ground), protect self/allies when hurt near enemies or awake camps, dash toward goals when healthy', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 85
            if o.unit.is_camp and gems() == 0:
                return 65
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            if n > 0:
                return 80 + 3 * n
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if exists(o.unit) and o.unit.is_champion and not o.unit.is_enemy:
            if o.unit.health_frac < 0.6:
                if any(dist(u.pos, o.unit.pos) <= 4 for u in enemies()):
                    return 87
        if me().health_frac < 0.7:
            if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
                return 88
            if me().health_frac < 0.55:
                if any(is_awake(c) and dist(c.pos, me().pos) <= 3 for c in camps()):
                    return 75
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.5:
            p = progress(o.tile)
            if p >= 2:
                return 40 + 6 * p
        return 0
    return 0
