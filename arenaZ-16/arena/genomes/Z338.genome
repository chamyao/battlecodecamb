"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None
RETREAT: Bool = False
ENEMY_T: Tiles = None

@gene('s1', 'value of doing this option now; drafts the ladder-favoured champions, recalls when low or when retreating far from home with no enemies close, casts via cast_value', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        if o.champ == VESPER_VALE:
            return 6
        if o.champ == HEART_OF_RUIN:
            return 5
        if o.champ == MARCELLA:
            return 4
        if o.champ == VENDETTA:
            return 3
        if o.champ == RYTH:
            return 2
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        m = me()
        if m.health_frac < 0.35:
            return 145
        if RETREAT and at(GOAL_F, m.pos) > 12 and not any(dist(e, m.pos) <= 5 for e in ENEMY_T):
            return 140
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 45 + 6 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s4', 'how much closer a step brings me to the goals: penalty for stepping near cached enemy tiles, clamped, urgent when retreating, doubled when healthy', parents=['s4'])
def progress(t: Tile) -> Num:
    m = me()
    d = at(GOAL_F, m.pos) - at(GOAL_F, t)
    if any(dist(e, t) <= 2 for e in ENEMY_T):
        d -= 2
    if d > 2:
        d = 2
    if d < -2:
        d = -2
    if RETREAT:
        return d * 3
    if m.health_frac > 0.6:
        return d * 2
    return d

@gene('Z26a', 'value of casting: hit champions (scaled up as they weaken) and camps, protect allies and self when hurt near enemies or awake camps, dash toward goals when healthy (capped, not while enemies are close)', parents=['s1', 'Z26a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 114 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 65
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            ne = count(dist(u.pos, o.tile) <= r for u in enemies())
            if ne > 0:
                return 110 + ne
            if gems() == 0:
                nc = count(dist(u.pos, o.tile) <= r for u in camps())
                if nc > 0:
                    return 60 + nc
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy and o.unit.pos != me().pos:
            if o.unit.health_frac < 0.6:
                if any(dist(u.pos, o.unit.pos) <= 4 for u in enemies()):
                    return 87
            if o.unit.health_frac < 0.5:
                return 85
            return 0
        if me().health_frac < 0.7:
            if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
                return 88
            if me().health_frac < 0.55:
                if any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                    return 75
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.45:
            if not any(dist(u.pos, me().pos) <= 5 for u in enemies()):
                p = progress(o.tile)
                if p >= 2:
                    return 40 + 5 * min(p, 8)
        return 0
    return 0

@gene('Z21a', 'once per turn: retreat state with hysteresis (53% empty to ~73% at 20+ gems, or 70% when swarmed by 3+ enemies within 6; stay until 90%); cache the matching distance field and enemy tiles', parents=['s3', 'Z21a'])
def update() -> None:
    ENEMY_T = enemy_tiles()
    if alive():
        m = me()
        h = m.health_frac
        carry = unit_gems(m)
        low = 0.5305 + 0.2 * min(carry / 20, 1)
        swarmed = count(dist(e, m.pos) <= 6 for e in ENEMY_T) >= 3
        if h < low or (swarmed and h < 0.7):
            RETREAT = True
        elif h > 0.9:
            RETREAT = False
    else:
        RETREAT = False
    if RETREAT:
        GOAL_F = field(my_spawn())
    else:
        GOAL_F = field(goals())
