"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None
SPAWN_F: Field = None
RETREAT: Bool = False

@gene('s1', 'value of doing this option now; also casts damage/cc on targets and shield/heal when hurt in a fight, recalls a bit earlier', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3534 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 55 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 35 + 8 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture; else living camp groups that hold gems or gold (any living group as fallback)', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) + group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) == 0:
        for g in range(num_groups()):
            if not group_respawning(g):
                acc = acc | group_tiles(g)
    return acc

@gene('Z195a', 'distance field to goals, or to spawn when retreating (both cached per turn in update())', parents=['s3'])
def goal_field() -> Field:
    if RETREAT:
        return SPAWN_F
    return GOAL_F

@gene('Z67a', 'true while I stand on my spawn and should stay there to heal before heading out again', parents=['s4'])
def healing() -> Bool:
    m = me()
    return m.health_frac < 0.85 and m.pos in my_spawn()

@gene('s4', 'how much closer a step brings me to the goals, doubled when healthy, reduced near enemies; zero while healing on spawn', parents=['s4'])
def progress(t: Tile) -> Num:
    if healing():
        return 0
    d = at(goal_field(), me().pos) - at(goal_field(), t)
    if count(dist(u.pos, t) <= 2 for u in enemies()) > 0:
        d = d - 2
    if me().health_frac > 0.6:
        return d * 2
    return d

@gene('Z26a', 'value of casting an ability: hit champions/camps (unit or ground), protect self/allies when hurt near enemies or awake camps, dash toward goals when healthy and safe', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 110 + 40 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 65
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            if n > 0:
                return 80 + 3 * n
            if gems() == 0:
                nc = count(dist(u.pos, o.tile) <= r for u in camps())
                if nc > 0:
                    return 60 + nc
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if exists(o.unit) and o.unit.is_champion and not o.unit.is_enemy:
            if o.unit.health_frac < 0.6:
                if any(dist(u.pos, o.unit.pos) <= 4 for u in enemies()):
                    return 87
        if me().health_frac < 0.7:
            if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
                return 88 + (0.65 - me().health_frac) * 20
            if me().health_frac < 0.55:
                if any(is_awake(c) and dist(c.pos, me().pos) <= 3 for c in camps()):
                    return 75
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.5 and not healing():
            if count(dist(u.pos, me().pos) <= 4 for u in enemies()) == 0:
                p = progress(o.tile)
                if p >= 2:
                    return 40 + 6 * p
        return 0
    return 0

@gene('Z195b', 'once per turn: decide retreat (below 35%, or below 50% with an enemy within 6) and cache the goal or spawn distance field', parents=['Z21a', 's3'])
def update() -> None:
    hf = me().health_frac
    RETREAT = hf < 0.35 or (hf < 0.5 and any(dist(u.pos, me().pos) <= 6 for u in enemies()))
    if RETREAT:
        SPAWN_F = field(my_spawn())
    else:
        GOAL_F = field(goals())
