"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now; also casts damage/cc on targets and shield/heal when hurt in a fight, recalls a bit earlier')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3534 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture; else a living camp group worth gems or gold; else any living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    val = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) + group_gold(g) > 0:
            val = val | group_tiles(g)
    if size(val) > 0:
        return val
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals; zero while healing on spawn so I stay until mostly healed')
def progress(t: Tile) -> Num:
    if healing():
        return 0
    f = goal_field()
    return at(f, me().pos) - at(f, t)

@gene('Z67a', 'true while I stand on my spawn and should stay there to heal before heading out again', parents=['s4'])
def healing() -> Bool:
    m = me()
    return m.health_frac < 0.85 and m.pos in my_spawn()

@gene('Z26a', 'value of casting an ability: damage scaled by target low health (finish wounded champions), damage on camps while clearing, shield/heal earlier in fights (also vs awake camps), dash toward goals when safe scaled by progress', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 100 + 40 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0:
                    return 65
                if is_awake(o.unit):
                    return 50
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.8:
            mp = me().pos
            if any(dist(u.pos, mp) <= 5 for u in enemies()):
                return 80 + (0.8 - hf) * 80
            if hf < 0.6:
                if any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                    return 60 + (0.6 - hf) * 60
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            if count(dist(u.pos, me().pos) <= 4 for u in enemies()) == 0:
                p = progress(o.tile)
                if p > 2:
                    return 40 + 2 * p
        return 0
    return 0
