"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None
RETREAT: Bool = False
HOME_F: Field = None
HOME_SET: Bool = False

@gene('s1', 'value of doing this option now; casts damage/cc on targets and shield/heal when hurt in a fight; recalls when low, or when retreating far from home with no threats nearby', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 45 + 6 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'cached per-turn field: goals normally, my spawn while retreating (no per-pass engine calls)', parents=['s3'])
def goal_field() -> Field:
    return GOAL_F

@gene('s4', 'how much closer a step brings me to the goals: clamped against unreachable readings, urgent when retreating, doubled when healthy, weighted up when carrying gems (extra weight at 10+ gems)', parents=['s4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    m = me()
    d = at(f, m.pos) - at(f, t)
    if d > 2:
        d = 2
    if d < -2:
        d = -3
    if RETREAT:
        return d * 4
    w = 1
    if m.health_frac > 0.6:
        w = 2
    g = gems()
    if g > 0:
        w = w + 1
    if g >= 10:
        w = w + 1
    return d * w

@gene('Z26a', 'value of casting: hit champions (scaled up as they weaken) and camps, protect allies and self when hurt near enemies or awake camps, dash toward goals when healthy or home when retreating', parents=['s1', 'Z26a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 110 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 65
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            ne = count(dist(u.pos, o.tile) <= r for u in enemies())
            if ne > 0:
                return 110 + ne
            if gems() == 0:
                nc = count(dist(u.pos, o.tile) <= r for u in camps())
                if nc > 0:
                    return 60 + nc
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        return protect_cast_value(o)
    if k == AB_DASH:
        return dash_cast_value(o)
    return 0

@gene('X230a', 'value of a shield/heal cast: hurt allies (more near enemies), or self when hurt near enemies or awake camps', parents=['Z26a'])
def protect_cast_value(o: Option) -> Num:
    if exists(o.unit) and not o.unit.is_enemy and o.unit.pos != me().pos:
        if o.unit.health_frac < 0.6:
            if any(dist(u.pos, o.unit.pos) <= 4 for u in enemies()):
                return 87
        if o.unit.health_frac < 0.5:
            return 85
        return 0
    if me().health_frac < 0.7:
        if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            return 88
        if me().health_frac < 0.55:
            if any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                return 75
    return 0

@gene('X200a', 'value of a dash cast: escape toward spawn when retreating (any progress, more when lower health), else toward goals when healthy and no enemies within 4, needs clear progress, value grows with carried gems', parents=['Z26a'])
def dash_cast_value(o: Option) -> Num:
    if not valid(o.tile):
        return 0
    if RETREAT:
        p = progress(o.tile)
        if p >= 1:
            return 80 + 5 * min(p, 8) + 10 * (1 - me().health_frac)
        return 0
    if me().health_frac > 0.5:
        if not any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            p = progress(o.tile)
            if p >= 4:
                return 40 + 5 * min(p, 8) + 2 * min(unit_gems(me()), 10)
    return 0

@gene('Z545a', 'recall value: skip when already near spawn (walking is as fast); when very low recall unless an enemy is close enough to cancel it; when retreating recall far from spawn with no enemies or awake camps close', parents=['s1'])
def recall_value() -> Num:
    hp = me().health_frac
    if hp >= 0.35 and not RETREAT:
        return 0
    d = at(HOME_F, me().pos) if HOME_SET else at(goal_field(), me().pos)
    if d <= 5:
        return 0
    if hp < 0.35:
        if not any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            if not any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                return 120
        return 0
    if d > 12:
        if not any(dist(u.pos, me().pos) <= 7 for u in enemies()):
            if not any(is_awake(c) and dist(c.pos, me().pos) <= 5 for c in camps()):
                return 100
    return 0

@gene('Z21a', 'once per turn: retreat with hysteresis; go home below a threshold that rises with carried gems (53% empty to ~73% at 20+ gems), or below 70% when nearby enemy power outweighs our side within 6 tiles (power sums only computed below 70% health); resume at 85%+; when not retreating, walk to goals, or home when there are no goals; then cache the matching distance field', parents=['s3', 'Z21a'])
def update() -> None:
    if alive():
        m = me()
        h = m.health_frac
        p = m.pos
        carry = unit_gems(m)
        low = 0.5305 + 0.2 * min(carry / 20, 1)
        danger = False
        if h < 0.7:
            e_pow = sum(u.strength * (0.3 + u.health_frac) for u in enemies() if dist(u.pos, p) <= 6)
            a_pow = m.strength * (0.3 + h) + sum(u.strength * (0.3 + u.health_frac) for u in allies() if dist(u.pos, p) <= 6 and dist(u.pos, p) > 0)
            danger = e_pow > 0 and e_pow >= a_pow
        if h < low or danger:
            RETREAT = True
        elif h > 0.85:
            RETREAT = False
        if RETREAT:
            if not HOME_SET:
                HOME_F = field(my_spawn())
                HOME_SET = True
            GOAL_F = HOME_F
        else:
            g = goals()
            if size(g) > 0:
                GOAL_F = field(g)
            else:
                if not HOME_SET:
                    HOME_F = field(my_spawn())
                    HOME_SET = True
                GOAL_F = HOME_F
    else:
        RETREAT = False
