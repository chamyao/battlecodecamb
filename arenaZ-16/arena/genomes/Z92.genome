"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now; also casts damage/cc on targets and shield/heal when hurt in a fight, recalls a bit earlier')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3534 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, routing around walls and enemy champions, searched only out to my neighbourhood')
def goal_field() -> Field:
    return field_avoid(goals(), walls() | enemy_tiles(), near(me().pos, 3))

@gene('s4', 'how much closer a step brings me to the goals; zero while healing on spawn; when low on health near an enemy champion, steps away from it count as progress')
def progress(t: Tile) -> Num:
    if healing():
        return 0
    f = goal_field()
    p = at(f, me().pos) - at(f, t)
    m = me()
    if m.health_frac < 0.4:
        e = threat_pos()
        if valid(e):
            if dist(e, m.pos) <= 4:
                p += 2 * (dist(e, t) - dist(e, m.pos))
    return p

@gene('Z67a', 'true while I stand on my spawn and should stay there to heal before heading out again', parents=['s4'])
def healing() -> Bool:
    m = me()
    return m.health_frac < 0.8 and m.pos in my_spawn()

@gene('Z91a', 'most dangerous visible enemy champion (strength times health, minus distance); invalid if none', parents=['s4'])
def threat_pos() -> Tile:
    m = me()
    u = best(enemies(), lambda x: (0 if x.is_champion else -1000) + 2 * x.strength * x.health_frac - dist(x.pos, m.pos))
    if exists(u):
        if u.is_champion:
            return u.pos
    return tile(-1, -1)

@gene('Z26a', 'value of casting an ability: crowd control and damage on enemy champions (finish wounded first), damage on camps when no gems, shield/heal scaled by low health when enemies near, dash toward goals when safe', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                bonus = 10 if k == AB_CC else 0
                return 100 + bonus + 40 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if me().health_frac < 0.7:
            if any(dist(u.pos, me().pos) <= 5 for u in enemies()):
                return 85 + (0.7 - me().health_frac) * 100
        return 0
    if k == AB_DASH:
        if valid(o.tile) and not healing():
            if count(dist(u.pos, me().pos) <= 4 for u in enemies()) == 0:
                p = progress(o.tile)
                if p > 3:
                    return 45
        return 0
    return 0
