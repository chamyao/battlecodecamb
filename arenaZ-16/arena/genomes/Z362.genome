"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None
RETREAT: Bool = False
HOME_F: Field = None
HOME_SET: Bool = False

@gene('s1', 'value of doing this option now; also casts damage/cc on targets and shield/heal when hurt in a fight, recalls earlier when retreating with many gems; attacks on enemy champions get more valuable as they weaken (finish kills)', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.275:
            return 95
        if RETREAT and gems() >= 10 and me().health_frac < 0.45:
            return 95
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 30 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        base = 55 if RETREAT else 45
        return base + 6 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'cached per-turn field: goals normally, my spawn while retreating (no per-pass engine calls)', parents=['s3'])
def goal_field() -> Field:
    return GOAL_F

@gene('Z526a', 'how much closer a step brings me to the goals (clamped against unreachable readings), minus danger from enemy champions and nearby monsters near the step; urgent when retreating, weighted when carrying gems, doubled when healthy', parents=['s4', 'Z371a'])
def progress(t: Tile) -> Num:
    f = goal_field()
    m = me()
    d = at(f, m.pos) - at(f, t)
    if d > 2:
        d = 2
    if d < -2:
        d = -2
    danger = sum(1 for u in enemies() if u.is_champion and dist(u.pos, t) <= 2)
    mon = sum(1 for u in enemies() if (not u.is_champion) and dist(u.pos, t) <= 2)
    if m.health_frac < 0.5:
        danger += mon
    if RETREAT:
        return d * 3 - danger * 2
    if gems() > 0 or unit_gems(m) >= 10:
        far = sum(1 for u in enemies() if u.is_champion and dist(u.pos, t) == 3)
        return d * 2.5 - danger * 4 - far * 2
    if m.health_frac > 0.6:
        return d * 2 - danger * 2
    return d - danger * 3

@gene('Z526b', 'value of casting: hit champions (scaled up as they weaken) and camps, protect allies and self when hurt near enemies or awake camps, dash toward goals when healthy', parents=['s1', 'Z26a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 114 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp and gems() == 0:
                return 65
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            ne = count(dist(u.pos, o.tile) <= r for u in enemies())
            if ne > 0:
                return 110 + ne
            if gems() == 0:
                nc = count(dist(u.pos, o.tile) <= r for u in camps())
                if nc > 0:
                    return 60 + nc
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        return protect_cast_value(o)
    if k == AB_DASH:
        return dash_cast_value(o)
    return 0

@gene('X230a', 'value of a shield/heal cast: hurt allies (more near enemies), or self when hurt near enemies or awake camps', parents=['Z26a'])
def protect_cast_value(o: Option) -> Num:
    if exists(o.unit) and not o.unit.is_enemy and o.unit.pos != me().pos:
        if o.unit.health_frac < 0.6:
            if any(dist(u.pos, o.unit.pos) <= 4 for u in enemies()):
                return 87
        if o.unit.health_frac < 0.5:
            return 85
        return 0
    if me().health_frac < 0.7:
        if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            return 88
        if me().health_frac < 0.6:
            if any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                return 75
    return 0

@gene('X200a', 'value of a dash cast: toward goals when healthy and no enemies close, capped progress (cap 8)', parents=['Z26a', 'X200a'])
def dash_cast_value(o: Option) -> Num:
    if valid(o.tile) and me().health_frac > 0.45:
        if not any(dist(u.pos, me().pos) <= 5 for u in enemies()):
            p = progress(o.tile)
            if p >= 2:
                return 40 + 5 * min(p, 8)
    return 0

@gene('Z526c', 'once per turn: retreat with hysteresis; home below a threshold that rises with carried gems, or below 75% when outnumbered within 6 tiles, or below 70% when swarmed, or when carrying 10+ gems with an enemy champion within 3 tiles; resume above 90%; while retreating with 5+ gems aim at spawn or altars, else at a cached spawn field', parents=['Z388a', 'Z21a'])
def update() -> None:
    carry = gems()
    if alive():
        h = me().health_frac
        p = me().pos
        low = 0.5305 + 0.2 * min(carry / 20, 1)
        near_e = sum(1 for u in enemies() if dist(u.pos, p) <= 6)
        near_a = sum(0.9364 for u in allies() if dist(u.pos, p) <= 6)
        swarmed = near_e >= 3 and h < 0.7
        threatened = carry >= 10 and any(dist(u.pos, p) <= 3 for u in enemies() if u.is_champion)
        if h < low or (h < 0.75 and near_e > near_a + 1) or swarmed or threatened:
            RETREAT = True
        elif h > 0.9:
            RETREAT = False
    else:
        RETREAT = False
    if RETREAT:
        if alive() and carry >= 5:
            GOAL_F = field(my_spawn() | altars())
        else:
            if not HOME_SET:
                HOME_F = field(my_spawn())
                HOME_SET = True
            GOAL_F = HOME_F
    else:
        GOAL_F = field(goals())
