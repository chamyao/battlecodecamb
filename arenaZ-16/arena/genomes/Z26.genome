"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now; also casts damage/cc on targets and shield/heal when hurt in a fight, recalls a bit earlier')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3534 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals')
def progress(t: Tile) -> Num:
    f = goal_field()
    return at(f, me().pos) - at(f, t)

@gene('Z26a', 'value of casting: hit champions/camps (unit or ground target), protect self when hurt near enemies or awake camps, dash toward goals', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 115
            if o.unit.is_camp and gems() == 0:
                return 65
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            ne = count(dist(u.pos, o.tile) <= r for u in enemies())
            if ne > 0:
                return 110 + ne
            if gems() == 0:
                nc = count(dist(u.pos, o.tile) <= r for u in camps())
                if nc > 0:
                    return 60 + nc
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy and o.unit.pos != me().pos:
            if o.unit.health_frac < 0.5:
                return 85
            return 0
        if me().health_frac < 0.7:
            if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
                return 88
            if any(is_awake(u) and dist(u.pos, me().pos) <= 2 for u in camps()):
                return 75
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            if p >= 2:
                return 40 + p
        return 0
    return 0
