"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None
RETREAT: Bool = False
HOME_F: Field = None
HOME_SET: Bool = False
GOAL_OK: Bool = False

@gene('Z567a', 'value of doing this option now; recall via recall_value (low health or safe far retreat); attacks on enemy champions more valuable as they weaken; retreat moves more urgent; carriers of 5+ gems push toward goals harder', parents=['s1', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 30 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        base = 55 if RETREAT else 45
        if gems() >= 5 and not RETREAT:
            base = 55
        return base + 6 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems; else cleared groups awaiting capture, else a living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'cached per-turn field: goals normally, my spawn while retreating (no per-pass engine calls)', parents=['s3'])
def goal_field() -> Field:
    return GOAL_F

@gene('Z567b', 'progress toward goals (clamped) minus danger from enemy champions and monsters near the step; healthy non-carriers also avoid stepping next to awake monsters; carriers avoid stepping 3 tiles from champions', parents=['Z371a', 's4'])
def progress(t: Tile) -> Num:
    f = goal_field()
    m = me()
    d = at(f, m.pos) - at(f, t)
    if d > 2:
        d = 2
    if d < -2:
        d = -2
    danger = 0
    mon = 0
    far = 0
    for u in enemies():
        du = dist(u.pos, t)
        if du <= 2:
            if u.is_champion:
                danger += 1
            else:
                mon += 1
        elif du == 3 and u.is_champion:
            far += 1
    if m.health_frac < 0.5:
        danger += mon
    if RETREAT:
        return d * 3 - danger * 2
    if gems() > 0:
        return d * 3 - danger * 4 - far * 2
    if m.health_frac > 0.6:
        return d * 2 - danger * 2 - mon * 0.5
    return d - danger * 3

@gene('Z26a', 'value of casting: hit champions (scaled up as they weaken, extra when nearly dead) and camps (also while carrying a few gems), protect allies and self when hurt near enemies or awake camps, dash toward goals when healthy or home when retreating', parents=['s1', 'Z26a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                bonus = 25 if o.unit.health_frac < 0.3 else 0
                return 114 + 10 * (1 - o.unit.health_frac) + bonus
            if o.unit.is_camp and gems() < 10:
                return 65
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            ne = count(dist(u.pos, o.tile) <= r for u in enemies())
            if ne > 0:
                return 110 + ne
            if gems() < 10:
                nc = count(dist(u.pos, o.tile) <= r for u in camps())
                if nc > 0:
                    return 60 + nc
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        return protect_cast_value(o)
    if k == AB_DASH:
        return dash_cast_value(o)
    return 0

@gene('X230a', 'value of a shield/heal cast: hurt allies (more near enemies), or self when hurt near enemies or awake camps', parents=['Z26a'])
def protect_cast_value(o: Option) -> Num:
    if exists(o.unit) and not o.unit.is_enemy and o.unit.pos != me().pos:
        if o.unit.health_frac < 0.6:
            if any(dist(u.pos, o.unit.pos) <= 4 for u in enemies()):
                return 87
        if o.unit.health_frac < 0.5:
            return 85
        return 0
    if me().health_frac < 0.7:
        if any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            return 88
        if me().health_frac < 0.55:
            if any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                return 75
    return 0

@gene('X200a', 'value of a dash cast: when retreating, full value if an enemy is within 6 (real escape), modest value otherwise; when healthy, toward goals if no enemies within 3, value grows with carried gems', parents=['Z26a'])
def dash_cast_value(o: Option) -> Num:
    if not valid(o.tile):
        return 0
    if RETREAT:
        p = progress(o.tile)
        if p < 1:
            return 0
        threat = any(dist(u.pos, me().pos) <= 6 for u in enemies())
        if threat:
            return 80 + 5 * min(p, 8)
        return 20 + 2 * min(p, 8)
    if me().health_frac > 0.45:
        if not any(dist(u.pos, me().pos) <= 3 for u in enemies()):
            p = progress(o.tile)
            if p >= 3:
                return 40 + 5 * min(p, 8) + 2 * min(unit_gems(me()), 10)
    return 0

@gene('Z545a', 'recall value: skip when already near spawn (walking is as fast); when carrying 10+ gems recall earlier (below 50% health); very low health recalls unless an enemy is close enough to cancel; when retreating far from spawn with no enemies or awake camps close, recall', parents=['s1', 'Z545a'])
def recall_value() -> Num:
    hp = me().health_frac
    carry = gems()
    low = 0.35
    if carry >= 10:
        low = 0.5
    if hp >= low and not RETREAT:
        return 0
    d = at(HOME_F, me().pos) if HOME_SET else at(goal_field(), me().pos)
    if d <= 5:
        return 0
    if hp < low:
        if not any(dist(u.pos, me().pos) <= 4 for u in enemies()):
            if not any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                return 120 + min(carry, 30)
        return 0
    if d > 12:
        if not any(dist(u.pos, me().pos) <= 7 for u in enemies()):
            if not any(is_awake(c) and dist(c.pos, me().pos) <= 5 for c in camps()):
                return 100
    return 0

@gene('Z783a', 'once per turn: retreat with hysteresis; threshold rises with carried gems; nearby enemy power plus adjacent awake camps counts against ours; swarmed or threatened carriers retreat; carriers of 5+ gems aim at spawn or altars when retreating, else cached spawn field; goals field cached and refreshed every other round', parents=['Z21a', 's3'])
def update() -> None:
    if alive():
        m = me()
        h = m.health_frac
        p = m.pos
        carry = unit_gems(m)
        low = 0.5305 + 0.2 * min(carry / 20, 1)
        e_pow = sum(u.strength * (0.3 + u.health_frac) for u in enemies() if dist(u.pos, p) <= 6)
        e_pow += sum(0.5 * u.strength for u in camps() if dist(u.pos, p) <= 3 and is_awake(u))
        a_pow = m.strength * (0.3 + h) + sum(u.strength * (0.3 + u.health_frac) for u in allies() if dist(u.pos, p) <= 6 and dist(u.pos, p) > 0)
        near_e = count(dist(u.pos, p) <= 6 for u in enemies())
        swarmed = near_e >= 3 and h < 0.7
        threatened = carry >= 10 and any(u.is_champion and dist(u.pos, p) <= 4 for u in enemies())
        if h < low or (h < 0.7 and e_pow > 0 and e_pow >= a_pow) or swarmed or threatened:
            RETREAT = True
        elif h > 0.85:
            RETREAT = False
        if RETREAT:
            GOAL_OK = False
            if carry >= 5:
                GOAL_F = field(my_spawn() | altars())
            else:
                if not HOME_SET:
                    HOME_F = field(my_spawn())
                    HOME_SET = True
                GOAL_F = HOME_F
        else:
            refresh = not GOAL_OK
            if not refresh:
                here = at(GOAL_F, p)
                if here <= 1 or here >= 1000000 or round() % 2 == 0:
                    refresh = True
            if refresh:
                GOAL_F = field(goals())
                GOAL_OK = True
    else:
        RETREAT = False
        GOAL_OK = False
