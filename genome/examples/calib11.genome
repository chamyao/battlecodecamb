"""Fuel calibration genome 11: spawn_type lookups and iterating group tiles (cambc 4.0.0). update() runs one probe per turn in rotation on the nearest
visible enemy champion (else ally, else me), the nearest camp and my tile. Needs GENOME_UNCALIBRATED=1
until accepted."""

@gene("c0", "score: walk to the nearest camp spawn, attack camps")
def score(o: Option) -> Num:
    if o.kind == ATTACK:
        return 60
    if o.kind == MOVE:
        return 50 - dist(o.tile, nearest(camp_spawns(), me().pos))
    if o.kind == WARD:
        return 40 + floor(round() % 7)
    if o.kind == RECALL:
        return 30 if round() % 97 == 5 else 0
    return 0

@gene("c1", "run one probe this turn (round mod #probes)")
def update() -> None:
    acc = 0
    k = round()
    slot = k % 6
    m = me()
    e = best(enemies(), lambda x: 0 - dist(x.pos, m.pos))
    al = best(allies(), lambda x: 0 - dist(x.pos, m.pos))
    u = m
    if exists(al):
        u = al
    if exists(e):
        u = e
    c = best(camps(), lambda x: 0 - dist(x.pos, m.pos))
    t = m.pos
    if slot == 0 and exists(c):
        acc += p_empty(k, c)
    if slot == 1 and exists(c):
        acc += p_st(k, c)
    if slot == 2 and exists(c):
        acc += p_gsz(k, c)
    if slot == 3 and exists(c):
        acc += p_git(k, c)
    if slot == 4 and exists(c):
        acc += p_gst(k, c)
    if slot == 5 and exists(c):
        acc += p_mono(k, c)
    write_shared(7, acc)

@gene("q0", "probe empty")
def p_empty(k: Num, c: Unit) -> Num:
    return k

@gene("q1", "spawn_type on a camp tile")
def p_st(k: Num, c: Unit) -> Num:
    return spawn_type(c.pos) + k

@gene("q2", "size of the camp's group tiles")
def p_gsz(k: Num, c: Unit) -> Num:
    return size(group_tiles(camp_group(c))) + k

@gene("q3", "any over the group's tiles (no lookup)")
def p_git(k: Num, c: Unit) -> Num:
    return k + (1 if any(dist(t, c.pos) < 0 for t in group_tiles(camp_group(c))) else 0)

@gene("q4", "any spawn_type over the group's tiles")
def p_gst(k: Num, c: Unit) -> Num:
    return k + (1 if any(spawn_type(t) == MONOLITH for t in group_tiles(camp_group(c))) else 0)

@gene("q5", "the mono_groups loop")
def p_mono(k: Num, c: Unit) -> Num:
    return size(monoloop(k)) + k

@gene("h1", "the mono_groups loop, unmemoised")
def monoloop(k: Num) -> Tiles:
    acc = camp_spawns() - camp_spawns()
    for g in range(num_groups()):
        if any(spawn_type(t) == MONOLITH for t in group_tiles(g)):
            acc = acc | group_tiles(g)
    return acc
