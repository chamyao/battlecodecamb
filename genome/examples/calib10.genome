"""Fuel calibration genome 10: sight / ward_sight on and off the map, the ward list (cambc 4.0.0). update() runs one probe per turn in rotation on the nearest
visible enemy champion (else ally, else me), the nearest camp and my tile. Needs GENOME_UNCALIBRATED=1
until accepted."""

@gene("c0", "score: walk to the nearest camp spawn, attack camps")
def score(o: Option) -> Num:
    if o.kind == ATTACK:
        return 60
    if o.kind == MOVE:
        return 50 - dist(o.tile, nearest(camp_spawns(), me().pos))
    if o.kind == WARD:
        return 40 + floor(round() % 7)
    if o.kind == RECALL:
        return 30 if round() % 97 == 5 else 0
    return 0

@gene("c1", "run one probe this turn (round mod #probes)")
def update() -> None:
    acc = 0
    k = round()
    slot = k % 6
    m = me()
    e = best(enemies(), lambda x: 0 - dist(x.pos, m.pos))
    al = best(allies(), lambda x: 0 - dist(x.pos, m.pos))
    u = m
    if exists(al):
        u = al
    if exists(e):
        u = e
    c = best(camps(), lambda x: 0 - dist(x.pos, m.pos))
    t = m.pos
    if slot == 0:
        acc += p_empty(k)
    if slot == 1:
        acc += p_siv(k)
    if slot == 2:
        acc += p_sii(k)
    if slot == 3:
        acc += p_wsv(k)
    if slot == 4:
        acc += p_wsi(k)
    if slot == 5:
        acc += p_wd(k)
    write_shared(7, acc)

@gene("q0", "probe empty")
def p_empty(k: Num) -> Num:
    return k

@gene("q1", "sight, in-bounds tile")
def p_siv(k: Num) -> Num:
    return size(sight(RYTH, tile(10, 10))) + k

@gene("q2", "sight, off-map tile")
def p_sii(k: Num) -> Num:
    return size(sight(RYTH, tile(-1, -1))) + k

@gene("q3", "ward_sight, in-bounds tile")
def p_wsv(k: Num) -> Num:
    return size(ward_sight(tile(10, 10))) + k

@gene("q4", "ward_sight, off-map tile")
def p_wsi(k: Num) -> Num:
    return size(ward_sight(tile(-1, -1))) + k

@gene("q5", "enemy wards")
def p_wd(k: Num) -> Num:
    return size(enemy_wards()) + k
