"""Fuel calibration genome 5: raw SDK reads (cooldown, ability_*, item_count, unit_gold, buff_value/turns,
channel_left, group_cooldown, lock_hits/lock_enemy). update() runs one probe per turn in rotation on the nearest
visible enemy champion (else ally, else me), the nearest camp and the nearest altar. Needs GENOME_UNCALIBRATED=1
until accepted."""

@gene("c0", "score: walk to the nearest camp spawn, attack camps")
def score(o: Option) -> Num:
    if o.kind == ATTACK:
        return 60
    if o.kind == MOVE:
        return 50 - dist(o.tile, nearest(camp_spawns(), me().pos))
    return 0

@gene("c1", "run one probe this turn (round mod #probes)")
def update() -> None:
    acc = 0
    k = round()
    slot = k % 16
    m = me()
    e = best(enemies(), lambda x: 0 - dist(x.pos, m.pos))
    al = best(allies(), lambda x: 0 - dist(x.pos, m.pos))
    u = m
    if exists(al):
        u = al
    if exists(e):
        u = e
    c = best(camps(), lambda x: 0 - dist(x.pos, m.pos))
    t = nearest(altars(), m.pos)
    if slot == 0:
        acc += p_empty(k)
    if slot == 1:
        acc += p_cd(k, u)
    if slot == 2 and exists(c):
        acc += p_ccd(k, c)
    if slot == 3 and exists(c):
        acc += p_ccd2(k, c)
    if slot == 4:
        acc += p_ab(k, u)
    if slot == 5:
        acc += p_ab2(k, u)
    if slot == 6:
        acc += p_it(k, u)
    if slot == 7:
        acc += p_it2(k, u)
    if slot == 8:
        acc += p_gold(k, u)
    if slot == 9:
        acc += p_bf(k, u)
    if slot == 10:
        acc += p_bf2(k, u)
    if slot == 11 and exists(c):
        acc += p_cbf(k, c)
    if slot == 12:
        acc += p_ch(k, u)
    if slot == 13:
        acc += p_gcd(k)
    if slot == 14:
        acc += p_lk(k, t)
    if slot == 15:
        acc += p_lk2(k, t)
    write_shared(7, acc)

@gene("q0", "probe empty")
def p_empty(k: Num) -> Num:
    return k

@gene("q1", "cooldown champion slot 0")
def p_cd(k: Num, u: Unit) -> Num:
    return cooldown(u, 0) + k

@gene("q2", "cooldown camp (fetch)")
def p_ccd(k: Num, c: Unit) -> Num:
    return cooldown(c, 0) + k

@gene("q3", "cooldown camp fetch + hit")
def p_ccd2(k: Num, c: Unit) -> Num:
    return cooldown(c, 0) + cooldown(c, 1) + k

@gene("q4", "ability_range (fetch)")
def p_ab(k: Num, u: Unit) -> Num:
    return ability_range(u, 0) + k

@gene("q5", "ability fetch + hit")
def p_ab2(k: Num, u: Unit) -> Num:
    return ability_range(u, 0) + ability_kind(u, 0) + k

@gene("q6", "item_count (fetch)")
def p_it(k: Num, u: Unit) -> Num:
    return item_count(u, 3) + k

@gene("q7", "item_count fetch + hit")
def p_it2(k: Num, u: Unit) -> Num:
    return item_count(u, 3) + item_count(u, 5) + k

@gene("q8", "unit_gold")
def p_gold(k: Num, u: Unit) -> Num:
    return unit_gold(u) + k

@gene("q9", "buff_value champion (fetch)")
def p_bf(k: Num, u: Unit) -> Num:
    return buff_value(u, 0) + k

@gene("q10", "buff fetch + hit")
def p_bf2(k: Num, u: Unit) -> Num:
    return buff_value(u, 0) + buff_turns(u, 1) + k

@gene("q11", "buff_value camp (fetch)")
def p_cbf(k: Num, c: Unit) -> Num:
    return buff_value(c, 1) + k

@gene("q12", "channel_left")
def p_ch(k: Num, u: Unit) -> Num:
    return channel_left(u) + k

@gene("q13", "group_cooldown")
def p_gcd(k: Num) -> Num:
    return group_cooldown(k % 4) + k

@gene("q14", "lock_hits (fetch)")
def p_lk(k: Num, t: Tile) -> Num:
    return lock_hits(t) + k

@gene("q15", "lock fetch + hit")
def p_lk2(k: Num, t: Tile) -> Num:
    return lock_hits(t) + (1 if lock_enemy(t) else 0) + k
