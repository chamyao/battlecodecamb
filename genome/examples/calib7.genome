"""Fuel calibration genome 7: the constructs of the arena genomes' costliest genes (walk_nearest, near unions,
set algebra, contains). update() runs one probe per turn in rotation on the nearest
visible enemy champion (else ally, else me), the nearest camp and my tile. Needs GENOME_UNCALIBRATED=1
until accepted."""

@gene("c0", "score: walk to the nearest camp spawn, attack camps")
def score(o: Option) -> Num:
    if o.kind == ATTACK:
        return 60
    if o.kind == MOVE:
        return 50 - dist(o.tile, nearest(camp_spawns(), me().pos))
    if o.kind == WARD:
        return 40 + floor(round() % 7)
    if o.kind == RECALL:
        return 30 if round() % 97 == 5 else 0
    return 0

@gene("c1", "run one probe this turn (round mod #probes)")
def update() -> None:
    acc = 0
    k = round()
    slot = k % 10
    m = me()
    e = best(enemies(), lambda x: 0 - dist(x.pos, m.pos))
    al = best(allies(), lambda x: 0 - dist(x.pos, m.pos))
    u = m
    if exists(al):
        u = al
    if exists(e):
        u = e
    c = best(camps(), lambda x: 0 - dist(x.pos, m.pos))
    t = m.pos
    if slot == 0:
        acc += p_empty(k)
    if slot == 1:
        acc += p_wn(k, t)
    if slot == 2:
        acc += p_wn2(k, t)
    if slot == 3:
        acc += p_wn3(k, t)
    if slot == 4:
        acc += p_near(k, t)
    if slot == 5:
        acc += p_ring(k, t)
    if slot == 6:
        acc += p_minus(k)
    if slot == 7:
        acc += p_or(k)
    if slot == 8:
        acc += p_in(k, t)
    if slot == 9:
        acc += p_size(k)
    write_shared(7, acc)

@gene("q0", "probe empty")
def p_empty(k: Num) -> Num:
    return k

@gene("q1", "walk_nearest to camp spawns over walls")
def p_wn(k: Num, t: Tile) -> Num:
    return walk_nearest(camp_spawns(), t, walls()).x + k

@gene("q2", "walk_nearest to altars over walls and camps")
def p_wn2(k: Num, t: Tile) -> Num:
    return walk_nearest(altars(), t, walls() | camp_tiles()).x + k

@gene("q3", "walk_nearest to my spawn over walls")
def p_wn3(k: Num, t: Tile) -> Num:
    return walk_nearest(my_spawn(), t, walls()).x + k

@gene("q4", "near r2")
def p_near(k: Num, t: Tile) -> Num:
    return size(near(t, 2)) + k

@gene("q5", "ring: union of near(.,2) over near(t,1)")
def p_ring(k: Num, t: Tile) -> Num:
    return size(ringof(near(t, 1))) + k

@gene("q6", "camp_spawns - vision")
def p_minus(k: Num) -> Num:
    return size(camp_spawns() - vision()) + k

@gene("q7", "walls | camp_tiles")
def p_or(k: Num) -> Num:
    return size(walls() | camp_tiles()) + k

@gene("q8", "t in camp_spawns")
def p_in(k: Num, t: Tile) -> Num:
    return (1 if t in camp_spawns() else 0) + k

@gene("q9", "size(walls)")
def p_size(k: Num) -> Num:
    return size(walls()) + k

@gene("h1", "every tile within 2 of a tile of s")
def ringof(s: Tiles) -> Tiles:
    acc = s - s
    for x in s:
        acc = acc | near(x, 2)
    return acc
