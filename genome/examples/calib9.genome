"""Fuel calibration genome 9: engine 2.0.0 capture_state / capture_timer against group_cooldown. update() runs one probe per turn in rotation on the nearest
visible enemy champion (else ally, else me), the nearest camp and my tile. Needs GENOME_UNCALIBRATED=1
until accepted."""

@gene("c0", "score: walk to the nearest camp spawn, attack camps")
def score(o: Option) -> Num:
    if o.kind == ATTACK:
        return 60
    if o.kind == MOVE:
        return 50 - dist(o.tile, nearest(camp_spawns(), me().pos))
    if o.kind == WARD:
        return 40 + floor(round() % 7)
    if o.kind == RECALL:
        return 30 if round() % 97 == 5 else 0
    return 0

@gene("c1", "run one probe this turn (round mod #probes)")
def update() -> None:
    acc = 0
    k = round()
    slot = k % 5
    m = me()
    e = best(enemies(), lambda x: 0 - dist(x.pos, m.pos))
    al = best(allies(), lambda x: 0 - dist(x.pos, m.pos))
    u = m
    if exists(al):
        u = al
    if exists(e):
        u = e
    c = best(camps(), lambda x: 0 - dist(x.pos, m.pos))
    t = m.pos
    if slot == 0 and exists(c):
        acc += p_empty(k, c)
    if slot == 1 and exists(c):
        acc += p_gcd(k, c)
    if slot == 2 and exists(c):
        acc += p_cst(k, c)
    if slot == 3 and exists(c):
        acc += p_ctm(k, c)
    if slot == 4 and exists(c):
        acc += p_cst2(k, c)
    write_shared(7, acc)

@gene("q0", "probe empty")
def p_empty(k: Num, c: Unit) -> Num:
    return k

@gene("q1", "group_cooldown (priced reference)")
def p_gcd(k: Num, c: Unit) -> Num:
    return group_cooldown(camp_group(c)) + k

@gene("q2", "capture_state")
def p_cst(k: Num, c: Unit) -> Num:
    return capture_state(camp_group(c)) + k

@gene("q3", "capture_timer")
def p_ctm(k: Num, c: Unit) -> Num:
    return capture_timer(camp_group(c)) + k

@gene("q4", "capture_state twice")
def p_cst2(k: Num, c: Unit) -> Num:
    return capture_state(camp_group(c)) + capture_timer(camp_group(c)) + k
