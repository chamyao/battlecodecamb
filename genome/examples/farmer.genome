"""Test genome: farm camps, bank gems, fight what is in range, buy strength. Exercises the toolchain."""

BAG: Num = 20

@gene("g1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 10 - o.champ * 0.1
    if o.kind == BUY:
        return item_strength(o.item) * 2 - item_cost(o.item) * 0.01
    if o.kind == ATTACK:
        return attack_value(o.unit)
    if o.kind == CAST:
        if slot_kind(o.slot) == AB_DAMAGE and o.unit.is_enemy:
            return 30
        return 0
    if o.kind == TRIBUTE:
        return 50
    if o.kind == RECALL:
        return 40 if me().health_frac < 0.3 else 0
    if o.kind == MOVE:
        return 5 * progress(o.tile)
    return 0

@gene("g2", "value of a basic attack on a unit")
def attack_value(u: Unit) -> Num:
    if u.is_champion:
        return 20 + 10 * (1 - u.health_frac)
    return 10

@gene("g3", "where I want to walk this turn")
def goal() -> Tiles:
    if gems() >= BAG:
        return near_altars()
    live = camp_spawns()
    return live

@gene("g4", "tiles next to an altar")
def near_altars() -> Tiles:
    acc = altars()
    for a in altars():
        acc = acc | near(a, 1)
    return acc

@gene("g5", "distance field to the goal")
def goal_field() -> Field:
    return field(goal())

@gene("g6", "how much closer a step brings me to the goal")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)
