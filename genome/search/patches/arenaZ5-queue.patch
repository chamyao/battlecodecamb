+    def queue_feedback(self):
+        """M2 feedback for the next queued request: outcomes of earlier queued children not yet reported, the
+        current ratings of the live ones, those that died since the last request, and the top 5."""
+        with self.lock:
+            fb = {"outcomes": []}
+            for r in self._read("children"):
+                if r.get("model") != "session" or r["seq"] in self.q_reported:
+                    continue
+                self.q_reported.add(r["seq"])
+                q = [x.get("queue_seq") for x in (r.get("log") or {}).get("llm", []) if isinstance(x, dict)] \
+                    if isinstance((r.get("log") or {}).get("llm"), list) else \
+                    [((r.get("log") or {}).get("llm") or {}).get("queue_seq")]
+                out = "accepted" if r.get("accepted") else "twin" if r.get("twin_of") else "invalid"
+                fb["outcomes"].append({"child_seq": r["seq"], "request": q[0] if q else None, "op": r["op"],
+                                       "outcome": out, **({"name": r["name"]} if r.get("accepted") else {}),
+                                       **({"twin_of": r["twin_of"]} if r.get("twin_of") else {}),
+                                       **({"error": (r.get("error") or "")[:160]} if out == "invalid" else {})})
+                if r.get("accepted"):
+                    self.q_alive.add(r["name"])
+            mem = self.s["members"]
+            alive = {n for n in self.q_alive if mem.get(n, {}).get("alive", True) and n in mem}
+            fb["died"] = sorted(self.q_alive - alive)
+            self.q_alive = alive
+            fb["rated"] = [[n, round(mem[n]["mu"], 2), round(mem[n]["sigma"], 2), mem[n]["games"]] for n in sorted(alive)]
+            fb["top5"] = [[m["name"], round(m["mu"], 2), m["games"]] for m in
+                          sorted(self.genomes(), key=lambda m: -m["mu"])[:5]]
+            fb["births"] = self.s["births"]
+            return fb
+
