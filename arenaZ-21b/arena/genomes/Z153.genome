"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

AF: Field = None
AK: Num = -1
CF: Field = None
CK: Num = -1

@gene('s1', 'value of doing this option now; fight awake camps while carrying; when hurt, leave reach before recalling; recall to shop with a full purse when safe and idle; chase weak enemy champions')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 3 if o.champ == MARCELLA else 1
    if o.kind == BUY:
        return jungle_shop(o.item)
    if o.kind == RECALL:
        if in_fight():
            return 0
        if me().health_frac < 0.35:
            return 90
        if gems() == 0 and gold() >= 150 and not can_shop() and at(goal_field(), me().pos) >= 3:
            return 52 if me().health_frac < 0.85 or gold() >= 300 else 0
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        if gems() == 0:
            return 60
        return 88 if is_awake(o.unit) else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if me().health_frac < 0.35 and in_fight():
            g = threat_dist(o.tile) - threat_dist(me().pos)
            return 57 + g if g > 0 else 0
        if me().health_frac > 0.6:
            w = best(enemies(), lambda u: 0 - u.health_frac)
            if exists(w) and w.health_frac < 0.4 and dist(w.pos, me().pos) <= 5:
                return 70 if dist(o.tile, w.pos) < dist(me().pos, w.pos) else 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z32a', 'distance from a tile to the nearest awake camp or visible enemy champion', parents=['Z7b'])
def threat_dist(t: Tile) -> Num:
    a = min((dist(u.pos, t) for u in camps() if is_awake(u)), default=99)
    b = min((dist(u.pos, t) for u in enemies()), default=99)
    return min(a, b)

@gene('Z17b', 'skip listing option kinds this policy never takes', parents=['s1'])
def consider(kind: Num) -> Bool:
    return not (kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL)

@gene('s2', 'where to walk: an altar with gems, else a living camp group (monolith and golem spawns only as a last resort)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    rest = acc - type_spawns(MONOLITH) - type_spawns(GOLEM)
    return rest if size(rest) > 0 else acc

@gene('s3', 'distance field to the current goals: the cached altar field while carrying gems, else the cached camp field')
def goal_field() -> Field:
    return AF if gems() > 0 else CF

@gene('Z19a', 'keep two cached walk fields, one to the altars and one to the camps; recompute either only when its goal set changes; skip while channeling or dead', parents=['s3'])
def update() -> None:
    if channeling() or not alive():
        return
    gs = goals()
    k = size(gs) * 100003 + sum(t.x * 131 + t.y for t in gs)
    if gems() > 0:
        if k != AK:
            AK = k
            AF = field(gs)
    elif k != CK:
        CK = k
        CF = field(gs)

@gene("s4", "how much closer a step brings me to the goals")
def progress(t: Tile) -> Num:
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z157a', 'worth of a purchase: the starter item first; then strength shards, Jungle family (less camp damage) first, finishing an emblem already started', parents=['s1'])
def jungle_shop(i: Num) -> Num:
    if i == 6:
        return 100
    if item_strength(i) <= 0 or item_cost(i) > 30:
        return 0
    v = 90 + item_strength(i) * 0.1
    if item_passive(i) == P_JUNGLE:
        v += 4
    n = items_owned(i)
    if n > 0 and n < 5:
        v += 2
    return v

@gene('Z7a', 'worth of casting: damage and stuns on champions and fought camps, shields and resets in fights, heals; dashes to travel or to escape when hurt', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC:
        if not exists(o.unit):
            return 0
        if o.unit.is_champion and o.unit.is_enemy:
            return 85
        if o.unit.is_camp and (gems() == 0 or is_awake(o.unit)):
            if k == AB_CC and is_awake(o.unit) and me().health_frac < 0.7:
                return 72
            return 65
        return 0
    if k == AB_AOE:
        if not valid(o.tile):
            return 0
        r = slot_radius(o.slot)
        n = count(dist(u.pos, o.tile) <= r for u in enemies())
        c = count(dist(u.pos, o.tile) <= r and (gems() == 0 or is_awake(u)) for u in camps())
        if n + c == 0:
            return 0
        return 64 + n * 3 + c
    if k == AB_SHIELD:
        return 75 if in_fight() else 0
    if k == AB_HEAL:
        if exists(o.unit) and o.unit.health_frac < 0.6:
            return 85
        return 0
    if k == AB_RESET:
        return 58 if not can_attack() and in_fight() else 0
    if k == AB_DASH:
        if not valid(o.tile):
            return 0
        if in_fight():
            if me().health_frac < 0.35 and threat_dist(o.tile) - threat_dist(me().pos) >= 2:
                return 96
            return 0
        return 52 if progress(o.tile) >= 2 else 0
    return 0

@gene('Z7b', 'an enemy champion or an awake camp is close to me', parents=['s1'])
def in_fight() -> Bool:
    p = me().pos
    if any(dist(u.pos, p) <= 4 for u in enemies()):
        return True
    return any(is_awake(u) and dist(u.pos, p) <= 5 for u in camps())
