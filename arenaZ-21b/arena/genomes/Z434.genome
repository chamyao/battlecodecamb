"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
GK: Num = -1

@gene('s1', 'value of doing this option now; draft Marcella first; shop the starter item, then strength shards with leftover gold; keep fighting camps until banking; flee then recall when hurt; recall to shop with a full purse; chase weak enemy champions')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return mrtv_order(o.champ)
    if o.kind == BUY:
        return jungle_shop(o.item)
    if o.kind == BUY_LOCK:
        return 101 if gold() >= 40 else 0
    if o.kind == LOCK:
        return lock_value(o.tile)
    if o.kind == RECALL:
        if in_fight():
            return 0
        if me().health_frac < 0.4:
            return 90
        if gems() == 0 and gold() >= 150 and not can_shop() and at(GF, me().pos) >= 3:
            return 52 if me().health_frac < 0.85 or gold() >= 300 else 0
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 73 + (1 - o.unit.health_frac) * 10 + min(unit_gems(o.unit), 30) * 0.2
        if not banking():
            return 60 + (1 - o.unit.health_frac) * 3
        return 55 if is_awake(o.unit) else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if me().health_frac < 0.4 and in_fight():
            g = threat_dist(o.tile) - threat_dist(me().pos)
            return 90 + g if g > 0 else 0
        if me().health_frac > 0.6:
            w = best(enemies(), lambda u: 0 - u.health_frac)
            if exists(w) and w.health_frac < 0.4 and dist(w.pos, me().pos) <= 5:
                return 70 if dist(o.tile, w.pos) < dist(me().pos, w.pos) else 0
        if me().health_frac > 0.7 and gems() < 10:
            p = me().pos
            e = best(enemies(), lambda u: 0 - dist(u.pos, p))
            if exists(e) and dist(e.pos, p) <= 7 and dist(e.pos, p) > 1:
                if any(dist(a.pos, e.pos) <= 4 and dist(a.pos, p) > 0 for a in allies()):
                    return 65 if dist(o.tile, e.pos) < dist(p, e.pos) else 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z98a', 'keep hunting camps while the bag is small: bank once carrying 14+ gems, when below half health, or near the end', parents=['s1'])
def banking() -> Bool:
    if gems() <= 0:
        return False
    if gems() >= 14 or me().health_frac < 0.5:
        return True
    return round() > 1900

@gene('s4', 'how much closer a step brings me to the goals (field cached until the goals change)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z17a', 'recompute the walk field only when the walk goals change; skip while channeling or dead', parents=['s4'])
def update() -> None:
    if channeling() or not alive():
        return
    gs = walk_goals()
    if round() > 1000 and not banking():
        for g in range(num_groups()):
            if not group_respawning(g):
                if size(group_tiles(g) & type_spawns(GOLEM)) > 0:
                    gs = gs | group_tiles(g)
    k = size(gs) * 100003 + sum(t.x * 131 + t.y for t in gs)
    if k != GK:
        GK = k
        GF = field(gs)

@gene('Z98b', 'where to walk: free altars while carrying gems, plus living camp groups (monolith and golem spawns only as a last resort) unless banking; skip a cleared group an ally is already capturing', parents=['s2'])
def walk_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if banking():
            return acc
    p = me().pos
    camps_t = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            ts = group_tiles(g)
            taken = False
            if group_reward(g) and not (p in ts):
                taken = any((a.pos in ts) and dist(a.pos, p) > 0 for a in allies())
            if not taken:
                camps_t = camps_t | ts
    rest = camps_t - type_spawns(MONOLITH) - type_spawns(GOLEM)
    if size(rest) > 0:
        return acc | rest
    return acc | camps_t

@gene('Z17b', 'skip listing option kinds this policy never takes, and shopping away from spawn', parents=['s1'])
def consider(kind: Num) -> Bool:
    if kind == BUY:
        return can_shop()
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == BUY_LOCK:
        return can_shop() and not has_lock()
    if kind == LOCK:
        return has_lock() and size(enemy_tiles()) > 0
    return not (kind == WARD or kind == CANCEL)

@gene('Z310a', 'worth of locking this altar: an enemy champion is tributing at it (the lock cancels the channel), or a visible enemy carrying 10+ gems is about to bank there', parents=['s1'])
def lock_value(a: Tile) -> Num:
    if not valid(a):
        return 0
    if any(is_tributing(u) and dist(u.pos, a) <= 1 for u in enemies()):
        return 98
    if any(unit_gems(u) >= 10 and dist(u.pos, a) <= 2 for u in enemies()):
        return 75
    return 0

@gene('Z190a', 'worth of a purchase: the starter item first; then strength shards, Jungle family (less camp damage) first, finishing an emblem already started', parents=['s1'])
def jungle_shop(i: Num) -> Num:
    if i == 6:
        return 100
    if item_strength(i) <= 0 or item_cost(i) > 30:
        return 0
    v = 90 + item_strength(i) * 0.103
    if item_passive(i) == P_JUNGLE:
        v += 4
    n = items_owned(i)
    if n > 0 and n < 5:
        v += 2
    return v

@gene('Z190b', 'draft order: Marcella, then Cassi and Issac (two bodies for one pick), Tavi, Ryth, then the default order', parents=['s1'])
def mrtv_order(c: Num) -> Num:
    if c == MARCELLA:
        return 5
    if c == CASSI or c == ISSAC:
        return 4
    if c == TAVI:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z7a', 'worth of casting: stun enemy tributes first; resets only with a target in reach; damage and stuns on champions and fought camps, shields and resets in fights, heals; dashes to travel or to escape when hurt', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC:
        if not exists(o.unit):
            return 0
        if o.unit.is_champion and o.unit.is_enemy:
            if k == AB_CC and is_tributing(o.unit):
                return 97
            return 85 + (1 - o.unit.health_frac) * 5
        if o.unit.is_camp and (gems() == 0 or is_awake(o.unit)):
            if k == AB_CC and is_awake(o.unit) and me().health_frac < 0.7:
                return 72
            return 65 + (1 - o.unit.health_frac) * 4
        return 0
    if k == AB_AOE:
        if not valid(o.tile):
            return 0
        r = slot_radius(o.slot)
        n = count(dist(u.pos, o.tile) <= r for u in enemies())
        c = count(dist(u.pos, o.tile) <= r and (gems() == 0 or is_awake(u)) for u in camps())
        if n + c == 0:
            return 0
        return 64 + n * 3 + c
    if k == AB_SHIELD:
        return 75 if in_fight() else 0
    if k == AB_HEAL:
        if exists(o.unit) and o.unit.health_frac < 0.6:
            return 85
        return 0
    if k == AB_RESET:
        if can_attack():
            return 0
        p = me().pos
        rng = me().attack_range
        if any(dist(u.pos, p) <= rng for u in enemies()):
            return 62
        return 58 if any(dist(u.pos, p) <= rng and (gems() == 0 or is_awake(u)) for u in camps()) else 0
    if k == AB_DASH:
        if not valid(o.tile):
            return 0
        if in_fight():
            if me().health_frac < 0.4 and threat_dist(o.tile) - threat_dist(me().pos) >= 2:
                return 96
            return 0
        return 51 if progress(o.tile) >= 2 else 0
    return 0

@gene('Z7b', 'an enemy champion or an awake camp is close to me', parents=['s1'])
def in_fight() -> Bool:
    p = me().pos
    if any(dist(u.pos, p) <= 4 for u in enemies()):
        return True
    return any(is_awake(u) and dist(u.pos, p) <= u.attack_range + 1 for u in camps())

@gene('Z27a', 'distance from a tile to the nearest awake camp or visible enemy champion', parents=['Z7b'])
def threat_dist(t: Tile) -> Num:
    a = min((dist(u.pos, t) for u in camps() if is_awake(u)), default=99)
    b = min((dist(u.pos, t) for u in enemies()), default=99)
    return min(a, b)
