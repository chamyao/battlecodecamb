"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
GK: Num = -1

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        if gems() == 0:
            return 60
        return 55 if is_awake(o.unit) else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s4', 'how much closer a step brings me to the goals (field cached until the goals change)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z17a', 'pick and share a team target group when none is live; recompute the walk field only when the goal set changes', parents=['s4'])
def update() -> None:
    if channeling() or not alive():
        return
    if gems() == 0:
        g = read_shared(0) - 1
        if g < 0 or g >= num_groups() or group_respawning(g):
            write_shared(0, nearest_group() + 1)
    gs = goal_set()
    k = size(gs) * 100003 + sum(t.x * 131 + t.y for t in gs)
    if k != GK:
        GK = k
        GF = field(gs)

@gene('Z22a', 'where to walk: altars when carrying, else the team target group from shared byte 0 (monolith and golem excluded), else all safe goals', parents=['s3'])
def goal_set() -> Tiles:
    gs = goals()
    if gems() > 0:
        return gs
    g = read_shared(0) - 1
    if g >= 0 and g < num_groups() and not group_respawning(g):
        return group_tiles(g)
    rest = gs - type_spawns(MONOLITH) - type_spawns(GOLEM)
    return rest if size(rest) > 0 else gs

@gene('Z33a', 'the living camp group nearest to me, monolith and golem spawns excluded (-1 if none)', parents=['Z17a'])
def nearest_group() -> Num:
    p = me().pos
    bd = INF
    bg = -1
    for h in range(num_groups()):
        if not group_respawning(h):
            ts = group_tiles(h) - type_spawns(MONOLITH) - type_spawns(GOLEM)
            if size(ts) > 0:
                d = dist(nearest(ts, p), p)
                if d < bd:
                    bd = d
                    bg = h
    return bg

@gene('Z17b', 'skip listing option kinds this policy never takes', parents=['s1'])
def consider(kind: Num) -> Bool:
    return not (kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL)

@gene('Z7a', 'worth of casting an ability: damage and stuns on champions and fought camps, shields and heals when in a fight', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_CC:
        if not exists(o.unit):
            return 0
        if o.unit.is_champion and o.unit.is_enemy:
            return 85
        if o.unit.is_camp and (gems() == 0 or is_awake(o.unit)):
            return 65
        return 0
    if k == AB_AOE:
        if not valid(o.tile):
            return 0
        r = slot_radius(o.slot)
        n = count(dist(u.pos, o.tile) <= r for u in enemies())
        c = count(dist(u.pos, o.tile) <= r and (gems() == 0 or is_awake(u)) for u in camps())
        if n + c == 0:
            return 0
        return 64 + n * 3 + c
    if k == AB_SHIELD:
        return 75 if in_fight() else 0
    if k == AB_HEAL:
        if exists(o.unit) and o.unit.health_frac < 0.6:
            return 85
        return 0
    if k == AB_RESET:
        return 58 if not can_attack() and in_fight() else 0
    return 0

@gene('Z7b', 'an enemy champion or an awake camp is close to me', parents=['s1'])
def in_fight() -> Bool:
    p = me().pos
    if any(dist(u.pos, p) <= 4 for u in enemies()):
        return True
    return any(is_awake(u) and dist(u.pos, p) <= 5 for u in camps())
