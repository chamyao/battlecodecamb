"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('Z219a', 'value of doing this option now: casts (incl. attack resets and ground AoE), eager fight-back on awake camps, focus the weakest champion, treasure-then-power build, recall at 12% or to shop with a full purse', parents=['Z201a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 18 and items_owned(19) == 0:
            return 100
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        if me().health_frac < 0.12:
            return 90
        if gems() == 0 and gold() >= 150 and count_units(enemies()) == 0:
            return 75
        return 0
    if o.kind == CAST:
        extra = extra_cast(o)
        if extra > 0:
            return extra
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 8 * (1 - o.unit.health_frac)
        return 79 if gems() == 0 or is_awake(o.unit) else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('Z201b', 'skip listing option kinds the score never takes (wards, locks, cancels), casts while both slots cool down, shopping off spawn and tributes without gems', parents=['Z47a'])
def consider(kind: Num) -> Bool:
    if kind == CAST:
        return slot_ready(0) or slot_ready(1)
    if kind == BUY:
        return can_shop()
    if kind == TRIBUTE:
        return gems() > 0
    return kind != WARD and kind != LOCK and kind != BUY_LOCK and kind != CANCEL

@gene('Z219b', 'where to walk: altar (or a cleared camp) with gems; else cleared camps, an ally fight to join, prey (weak gem carriers, nearly dead enemies close by), then living non-monolith camps (no golems before round 400)', parents=['Z47b', 'Z86a'])
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    if size(acc) > 0:
        return acc
    hf = me().health_frac
    if hf > 0.4:
        rally = rally_tile()
        if valid(rally):
            return near(rally, 1)
    if hf > 0.5:
        here = me().pos
        for u in enemies():
            if u.is_champion:
                if unit_gems(u) >= 5 and u.health_frac < hf:
                    acc = acc | near(u.pos, 0)
                elif u.health_frac < 0.3 and dist(u.pos, here) <= 4:
                    acc = acc | near(u.pos, 0)
        if size(acc) > 0:
            return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    acc = acc - type_spawns(MONOLITH)
    if round() < 400:
        acc = acc - type_spawns(GOLEM)
    return acc

@gene('s3', 'distance field to the goals')
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (by a path that avoids enemy champions while hurt)')
def progress(t: Tile) -> Num:
    f = safe_field()
    return at(f, me().pos) - at(f, t)

@gene('Z116a', 'distance field to the goals (to my spawn when nearly dead); while hurt the path avoids tiles near visible enemy champions (terrain still blocks)', parents=['s3'])
def safe_field() -> Field:
    hf = me().health_frac
    if hf < 0.5:
        danger = near(tile(-5, -5), 0)
        for u in enemies():
            if u.is_champion:
                danger = danger | near(u.pos, 2)
        danger = danger - near(me().pos, 1)
        dest = my_spawn() if hf < 0.3 and gems() == 0 else goals()
        if size(danger) > 0:
            return field_avoid(dest, danger | walls() | holes() | altars() | enemy_spawn(), near(tile(-5, -5), 0))
        if hf < 0.3 and gems() == 0:
            return field(dest)
    return goal_field()

@gene('Z52a', 'value of casting: stun tributing enemies, damage/cc on enemy champions or camps we fight, heal the most hurt target, shield when hurt, dash toward goals', parents=['Z18a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy and not o.unit.is_camp:
            return 88 if o.unit.health_frac < 0.6 else 0
        return 88 if hf < 0.537 else 0
    if k == AB_SHIELD:
        return 86 if hf < 0.75 and count_units(enemies()) > 0 else 0
    if k == AB_DASH:
        if valid(o.tile) and not exists(o.unit):
            return 38 if progress(o.tile) >= 2 else 0
        return 0
    if not exists(o.unit):
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if o.unit.is_champion and o.unit.is_enemy:
            if k == AB_CC and is_tributing(o.unit):
                return 96
            return 92
        if o.unit.is_camp and (gems() == 0 or is_awake(o.unit)):
            return 62
    return 0

@gene('Z139a', 'value of casts the score ignores: an attack reset after attacking with a target in range, a ground AoE that hits an enemy champion or an awake camp pack', parents=['s1'])
def extra_cast(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_RESET:
        if can_attack():
            return 0
        here = me().pos
        reach = me().attack_range
        if any(dist(u.pos, here) <= reach for u in enemies()):
            return 83
        if gems() == 0 and any(dist(u.pos, here) <= reach for u in camps()):
            return 63
        return 0
    if (k == AB_AOE or k == AB_DAMAGE or k == AB_CC) and not exists(o.unit) and valid(o.tile):
        r = slot_radius(o.slot)
        if any(u.is_champion and dist(u.pos, o.tile) <= r for u in enemies()):
            return 84
        if k == AB_AOE and gems() == 0:
            if count(dist(u.pos, o.tile) <= r and is_awake(u) for u in camps()) >= 2:
                return 63
    return 0

@gene('Z247a', 'after acting: announce a fight with an enemy champion (tile + round) in shared bytes 0-2 so allies can join', parents=['Z47b'])
def after() -> None:
    if acted(ATTACK):
        t = acted_tile(ATTACK)
        if valid(t) and t in enemy_tiles():
            write_shared(0, t.x + 1)
            write_shared(1, t.y + 1)
            write_shared(2, round() % 250 + 1)

@gene('Z247b', 'tile of a fresh ally fight beacon (3 rounds) within 18 tiles (invalid if none)', parents=['Z47b'])
def rally_tile() -> Tile:
    stamp = read_shared(2)
    if stamp == 0:
        return tile(-5, -5)
    age = (round() % 250 + 1 - stamp + 250) % 250
    if age > 3:
        return tile(-5, -5)
    t = tile(read_shared(0) - 1, read_shared(1) - 1)
    d = dist(t, me().pos)
    if d <= 1 or d > 18:
        return tile(-5, -5)
    return t
