"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('Z19a', 'value of doing this option now: casts, fight-back on awake camps, treasure-then-power build, earlier recall with gems', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 18 and items_owned(19) == 0:
            return 100
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        limit = 0.45 if gems() > 0 else 0.35
        return 90 if me().health_frac < limit else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 or is_awake(o.unit) else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: altar (or a cleared camp) with gems, else a weak enemy carrying gems, else a living non-monolith camp group')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    prey = prey_tiles()
    if size(prey) > 0:
        return prey
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc - type_spawns(MONOLITH)

@gene('s3', 'distance field to the goals')
def goal_field() -> Field:
    return field(goals())

@gene('Z27a', 'tiles of visible enemy champions carrying gems that are weaker than me', parents=['s2'])
def prey_tiles() -> Tiles:
    acc = near(tile(-5, -5), 0)
    hf = me().health_frac
    for u in enemies():
        if u.is_champion and unit_gems(u) >= 5 and u.health_frac < hf and hf > 0.5:
            acc = acc | near(u.pos, 0)
    return acc

@gene('s4', 'how much closer a step brings me to the goals; never step next to an enemy champion while hurt')
def progress(t: Tile) -> Num:
    f = goal_field()
    gain = at(f, me().pos) - at(f, t)
    if gain > 0 and me().health_frac < 0.5:
        if any(u.is_champion and dist(u.pos, t) <= 2 for u in enemies()):
            return 0
    return gain

@gene('Z18a', 'value of casting: stun tributing enemies, damage/cc on enemy champions (weakest first) or camps we fight, heal/shield when hurt', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_HEAL:
        return 88 if hf < 0.6 else 0
    if k == AB_SHIELD:
        return 86 if hf < 0.75 and count_units(enemies()) > 0 else 0
    if not exists(o.unit):
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if o.unit.is_champion and o.unit.is_enemy:
            if k == AB_CC and is_tributing(o.unit):
                return 96
            return 85 + 4 * (1 - o.unit.health_frac)
        if o.unit.is_camp and (gems() == 0 or is_awake(o.unit)):
            return 62
    return 0
