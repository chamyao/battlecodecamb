"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_FIELD: Field = None

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar (or a cleared gem camp) with gems, else a living, farmable camp group or a cleared one to capture')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        for g in range(num_groups()):
            if group_reward(g) and group_gems(g) > 0:
                acc = acc | group_tiles(g)
        return acc
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
        elif not group_respawning(g) and not hard_group(g):
            acc = acc | group_tiles(g)
    if size(acc) == 0:
        for g in range(num_groups()):
            if not group_respawning(g):
                acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn)')
def goal_field() -> Field:
    return GOAL_FIELD

@gene('s4', 'how much closer a step brings me to the goals')
def progress(t: Tile) -> Num:
    f = goal_field()
    return at(f, me().pos) - at(f, t)

@gene('Z2a', "once per turn: the distance field to this turn's goals", parents=['s3'])
def update() -> None:
    GOAL_FIELD = field(goals())

@gene('Z2b', 'true if a camp group is too strong to farm now: monoliths always, golems before round 600', parents=['s2'])
def hard_group(g: Num) -> Bool:
    early = round() < 600
    for t in group_tiles(g):
        k = spawn_type(t)
        if k == MONOLITH:
            return True
        if k == GOLEM and early:
            return True
    return False
