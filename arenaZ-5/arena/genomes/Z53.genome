"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: starter rules plus casts, fight-back on awake camps, treasure-then-power build')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 18 and items_owned(19) == 0:
            return 100
        return 95 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 or is_awake(o.unit) else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: altar (or a cleared camp) with gems; else cleared camps, a weak enemy carrying gems, then living non-monolith camps no other ally is already at (no golems before round 600)')
def goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    if size(acc) > 0:
        return acc
    hf = me().health_frac
    if hf > 0.5:
        for u in enemies():
            if u.is_champion and unit_gems(u) >= 5 and u.health_frac < hf:
                acc = acc | near(u.pos, 0)
        if size(acc) > 0:
            return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    acc = acc - type_spawns(MONOLITH)
    if round() < 600:
        acc = acc - type_spawns(GOLEM)
    free = acc - ally_claims()
    if size(free) > 0:
        return free
    return acc

@gene('s3', 'distance field to the goals')
def goal_field() -> Field:
    return field(goals())

@gene('Z61a', 'camp tiles near other allies (claimed by them), so allies spread over camps', parents=['s2'])
def ally_claims() -> Tiles:
    here = me().pos
    busy = near(tile(-5, -5), 0)
    for u in allies():
        if dist(u.pos, here) > 2:
            busy = busy | near(u.pos, 2)
    return busy

@gene('s4', 'how much closer a step brings me to the goals; when badly hurt with an enemy champion close, how much farther from it')
def progress(t: Tile) -> Num:
    here = me().pos
    if me().health_frac < 0.35:
        foe = threat_tile()
        if valid(foe):
            return dist(t, foe) - dist(here, foe)
    f = goal_field()
    return at(f, here) - at(f, t)

@gene('Z18a', 'value of casting: damage/cc on enemy champions or camps we fight, heal the most hurt target, shield when hurt, dash toward goals', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy and not o.unit.is_camp:
            return 88 if o.unit.health_frac < 0.6 else 0
        return 88 if hf < 0.6 else 0
    if k == AB_SHIELD:
        return 86 if hf < 0.75 and count_units(enemies()) > 0 else 0
    if k == AB_DASH:
        if valid(o.tile) and not exists(o.unit):
            return 38 if progress(o.tile) >= 2 else 0
        return 0
    if not exists(o.unit):
        return 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if o.unit.is_champion and o.unit.is_enemy:
            return 85
        if o.unit.is_camp and (gems() == 0 or is_awake(o.unit)):
            return 62
    return 0

@gene('Z65a', 'position of the nearest visible enemy champion within 4 tiles (invalid if none)', parents=['s4'])
def threat_tile() -> Tile:
    here = me().pos
    foe = tile(-5, -5)
    best_d = 5
    for u in enemies():
        if u.is_champion:
            d = dist(u.pos, here)
            if d < best_d:
                best_d = d
                foe = u.pos
    return foe
