"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
EN: Num = 0
NEAR_EN: Num = 0

@gene('Z375a', 'once per turn: cache visible enemy count (EN), enemies within 6 of me (NEAR_EN), then the goal field', parents=['Z139a', 'Z160a'])
def update() -> None:
    EN = sum(1 for u in enemies())
    mp = me().pos
    NEAR_EN = count(dist(u.pos, mp) <= 6 for u in enemies()) if EN > 0 else 0
    GF = goal_field()

@gene('Z503a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (below 60% once carrying 20-23+), attacks prefer low-health champions, fight awake camps even when carrying gems, MOVE scales with progress with a gem-carry bonus, abilities via cast_value', parents=['Z188a', 'Z559a', 'Z503a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 20:
            thr = 0.4
        if gems() >= 23:
            thr = 0.6
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 63
        if o.unit.is_camp and is_awake(o.unit):
            return 50
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = 9 if gems() > 0 else 0
            bonus += 0.2 * min(gems(), 30)
            return 30 + 5 * min(p, 6) + bonus
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems (locked ones as fallback), else a living camp group with gems or a reward, else one with gold, else any living group', parents=['s2', 'Z463a'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    acc = near(tile(-5, -5), 0)
    gacc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) > 0 or group_reward(g):
                gacc = gacc | group_tiles(g)
            elif group_gold(g) > 0:
                acc = acc | group_tiles(g)
    if size(gacc) > 0:
        return gacc
    if size(acc) > 0:
        return acc
    return fallback

@gene('s3', 'distance field to the goals; retreat home when badly hurt (<35%), or hurt while carrying gems (A thresholds: 10+ gems below 60%, or below 80% with enemies visible); on spawn heal to 90% before leaving', parents=['s3', 'Z559b'])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    on_home = me().pos in home
    if on_home and hf < 0.9:
        return field(home)
    if hf < 0.35:
        return field(home)
    if hf < 0.5 and gems() > 0 and (NEAR_EN > 0 or gems() >= 20):
        return field(home)
    if gems() >= 10 and (hf < 0.6 or (hf < 0.8 and EN > 0) or (EN >= 3 and hf < 0.9)):
        return field(home)
    g = goals()
    if size(g) == 0:
        return field(home)
    return field(g)

@gene('Z650a', 'progress toward goals (cached field); early out when no enemies visible; threat radius widens to 5 when carrying 20+ gems; penalty grows as health falls (1x at 50%, 3x at 0%), ally cover softens it; enemies adjacent to me penalised, scaled up when carrying gems; small ally bonus near target', parents=['Z443a', 's4'])
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    support = count(dist(a.pos, t) <= 2 for a in allies())
    if EN == 0:
        return p + 0.5 * support
    hf = me().health_frac
    radius = 4
    if gems() >= 20:
        radius = 5
    threats = sum(0.4 + 0.6 * u.health_frac for u in enemies() if dist(u.pos, t) <= radius)
    near_me = count(dist(u.pos, me().pos) <= 2 for u in enemies())
    carry = 1.0 + gems() / 30.0
    p -= 0.6 * near_me * carry
    if hf < 0.5:
        mult = 1 + (0.5 - hf) * 4
        cover = 0.5992 / (1.0 + 0.7 * support)
        p -= 3 * mult * threats * cover
    else:
        if threats > 0:
            cover = 0.7692 / (1.0 + 0.7 * support)
            if gems() >= 30:
                p -= 1.8 * threats * cover
            else:
                p -= 0.9 * threats * cover
        p += 0.5 * support
    return p

@gene('Z650b', 'value of casting: stuns on enemy champions valued above damage (they cancel tributes), focus hurt enemy champions, damage awake camps we fight, shield when enemies within 6 below 95% (more when carrying 20+ gems), heal below 70% when threatened or low out of combat, dash for real progress when healthy (more with gems)', parents=['Z375b', 'Z559c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if k == AB_CC:
                    return 78 + 30 * (1 - o.unit.health_frac)
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile) and EN > 0:
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            return 72 + 6 * min(n, 3) if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.95:
            if NEAR_EN > 0:
                return 65 + 10 * (1 - hf) + (10 if gems() >= 20 else 0)
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                return 60
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.7:
            if NEAR_EN > 0:
                return 70
            if any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                return 62
            if hf < 0.45:
                return 40
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            need = 2
            if EN > 0:
                need = 4
            if p >= need:
                bonus = 8 if gems() > 0 else 0
                bonus += min(gems(), 30) / 4.0
                return 35 + 2 * min(p, 5) + bonus
        return 0
    return 0
