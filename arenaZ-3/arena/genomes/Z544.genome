"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
EN: Num = 0
NEAR_EN: Num = 0
ALLY_N: Num = 0
NEAR2: Num = 0
AWAKE2: Num

@gene('Z375a', 'once per turn: cache visible enemy count (EN), enemies within 6 (NEAR_EN) and within 2 (NEAR2) of me, allies within 6 (ALLY_N), awake camps within 2 (AWAKE2), then the goal field', parents=['Z139a', 'Z160a'])
def update() -> None:
    EN = sum(1 for u in enemies())
    mp = me().pos
    NEAR_EN = count(dist(u.pos, mp) <= 6 for u in enemies()) if EN > 0 else 0
    NEAR2 = count(dist(u.pos, mp) <= 2 for u in enemies()) if EN > 0 else 0
    ALLY_N = count(dist(a.pos, mp) <= 6 for a in allies())
    AWAKE2 = count(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps())
    GF = goal_field()

@gene('Z503a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (below 60% once carrying 30+), attacks prefer low-health champions, fight awake camps even when carrying gems, MOVE scales with progress with a gem-carry bonus (from A), abilities via cast_value', parents=['Z188a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 20:
            thr = 0.4
        if gems() >= 30:
            thr = 0.6
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60
        if o.unit.is_camp and is_awake(o.unit):
            return 50
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = 10 if gems() > 0 else 0
            bonus += 0.2 * min(gems(), 30)
            return 30 + 5 * min(p, 6) + bonus
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems (locked ones as fallback), else a living camp group with gems, else gold or reward groups, else any living group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    acc = near(tile(-5, -5), 0)
    gacc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) > 0:
                gacc = gacc | group_tiles(g)
            elif group_gold(g) > 0 or group_reward(g):
                acc = acc | group_tiles(g)
    if size(gacc) > 0:
        return gacc
    if size(acc) > 0:
        return acc
    return fallback

@gene('s3', 'distance field to the goals; heal on spawn to 95% when no enemies near; retreat home when badly hurt (<35% alone, <25% with an ally near), when hurt (<50%) carrying gems, when below 65% carrying 10+ gems with any enemy visible, or when below 45% alone with an enemy within 6', parents=['s3'])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    on_home = me().pos in home
    if on_home and hf < 0.95 and NEAR_EN == 0:
        return field(home)
    if hf < 0.35 and ALLY_N < 2:
        return field(home)
    if hf < 0.25:
        return field(home)
    if hf < 0.5 and gems() > 0 and (NEAR_EN > 0 or gems() >= 20):
        return field(home)
    if hf < 0.65 and gems() >= 10 and EN > 0:
        return field(home)
    if hf < 0.45 and NEAR_EN > 0 and ALLY_N == 0:
        return field(home)
    return field(goals())

@gene('s4', 'progress toward goals; faster commit when no enemies visible (1.5x progress); stronger ally-support bonus when healthy near enemies; otherwise same enemy penalty scaling with health and gem carry (uses cached NEAR2)', parents=['s4'])
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    support = count(dist(a.pos, t) <= 3 for a in allies())
    if EN == 0:
        return 1.5 * p + 0.5 * support
    hf = me().health_frac
    threats = count(dist(u.pos, t) <= 4 for u in enemies())
    carry = 1.0 + gems() / 30.0
    p -= 0.6 * NEAR2 * carry
    cover = 0.9852 / (1.0 + 0.7 * support + 0.25 * ALLY_N)
    if hf < 0.5:
        mult = 1 + (0.5 - hf) * 4
        p -= 3 * mult * threats * cover
    else:
        if threats > 0:
            if gems() >= 30:
                p -= 1.8 * threats * cover
            else:
                p -= 0.9 * threats * cover
        p += 0.8 * support
    return p

@gene('Z649a', 'value of casting: focus hurt enemy champions, damage awake camps we fight, shield when enemies within 6 below 95% (more with 20+ gems), heal below 70% when threatened or low, dash for progress with B-style health and progress thresholds and gem bonus, or escape home when low and enemies are near', parents=['Z375b', 'Z492c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile) and EN > 0:
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            return 72 + 6 * min(n, 3) if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.95:
            if NEAR_EN > 0:
                return 65 + 10 * (1 - hf) + (10 if gems() >= 20 else 0)
            if hf < 0.7 and AWAKE2 > 0:
                return 60
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.7:
            if NEAR_EN > 0:
                return 70
            if AWAKE2 > 0:
                return 62
            if hf < 0.45:
                return 40
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            hf = me().health_frac
            need = 0.45
            minp = 2
            if EN > 0:
                need = 0.65
                minp = 3
            if gems() >= 20:
                need = need - 0.05
            if hf > need:
                p = progress(o.tile)
                if p >= minp:
                    bonus = min(gems(), 30) / 3.0
                    base = 37 if EN == 0 else 32
                    return base + 3 * min(p, 6) + bonus
            elif hf < 0.4 and EN > 0 and NEAR_EN > 0:
                d = at(GF, me().pos) - at(GF, o.tile)
                if d >= 2:
                    return 50 + 2 * min(d, 5)
        return 0
    return 0
