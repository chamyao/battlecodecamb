"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('Z188a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (protect the drop), attacks prefer low-health champions, MOVE scales more strongly with progress (cap 8) and gets a bonus that grows with gems carried, abilities via cast_value', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 20:
            thr = 0.4
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = 0.5 * min(gems(), 30)
            return 30 + 8 * min(p, 8) + bonus
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems (locked ones as fallback), else a living camp group with gems or a reward, else one with gold, else any living group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    gem_acc = near(tile(-5, -5), 0)
    gold_acc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) > 0 or group_reward(g):
                gem_acc = gem_acc | group_tiles(g)
            elif group_gold(g) > 0:
                gold_acc = gold_acc | group_tiles(g)
    if size(gem_acc) > 0:
        return gem_acc
    if size(gold_acc) > 0:
        return gold_acc
    return fallback

@gene('s3', 'distance field to the goals; retreat home below 40% health (up to 70% when carrying 30+ gems to protect the drop), stay on spawn until 90% full, and fall back to home when there are no goals', parents=['s3'])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    retreat = 0.4 + min(gems(), 30) / 100
    if hf < retreat or (hf < 0.9 and me().pos in home):
        return field(home)
    g = goals()
    if size(g) == 0:
        return field(home)
    return field(g)

@gene("Z139a", "once per turn: cache the goal distance field in GF so progress() does not rebuild it every pass", parents=["s3"])
def update() -> None:
    GF = goal_field()

@gene('s4', 'progress toward goals (cached field), cheaper: one enemies()/allies() read; near-enemy count only when threatened or close to target; enemy penalty grows as health falls (1x at 50%, 3x at 0%), ally cover softens it; small bonus for allies near target when healthy; extra penalty for enemies adjacent to me, scaled by gems carried', parents=['s4'])
def progress(t: Tile) -> Num:
    m = me()
    mp = m.pos
    p = at(GF, mp) - at(GF, t)
    hf = m.health_frac
    es = enemies()
    threats = count(dist(u.pos, t) <= 5 for u in es)
    near_me = 0
    if threats > 0 or dist(mp, t) <= 6:
        near_me = count(dist(u.pos, mp) <= 2 for u in es)
    support = count(dist(a.pos, t) <= 2 for a in allies())
    g = gems()
    carry = 1.0 + g / 30.0
    p -= 0.6 * near_me * carry
    cover = 1.0 / (1.0 + 0.7 * support)
    if hf < 0.5:
        mult = 1 + (0.5 - hf) * 4
        p -= 3 * mult * threats * cover
    else:
        if threats > 0:
            if g >= 30:
                p -= 1.8 * threats * cover
            else:
                p -= 0.9 * threats * cover
        p += 0.5 * support
    return p

@gene('Z49a', 'value of casting an ability: focus hurt enemy champions, damage awake camps we fight, shield/heal when threatened, dash for real progress (stronger bonus when carrying gems) while health above 40%', parents=['Z49a', 'Z38a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            return 72 + 6 * min(n, 3) if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.9:
            mp = me().pos
            if count(dist(u.pos, mp) <= 5 for u in enemies()) > 0:
                bonus = 0
                if gems() >= 20:
                    bonus = 8
                return 65 + 10 * (1 - hf) + bonus
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 60
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.6:
            mp = me().pos
            if count(dist(u.pos, mp) <= 6 for u in enemies()) > 0:
                return 70
            if any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 62
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            if p >= 2:
                return 35 + 2 * min(p, 5) + min(gems(), 30) / 3.0
        return 0
    return 0
