"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
NEAR_EN: Num = 0
ANY_EN: Bool = False

@gene('Z160a', 'cache the goal field (home when hurt, else goals), nearby-enemy count and any-enemy flag once per turn', parents=['Z59a', 'Z92a', 's3'])
def update() -> None:
    GF = goal_field()
    NEAR_EN = count(dist(u.pos, me().pos) <= 4 for u in enemies())
    ANY_EN = count_units(enemies()) > 0

@gene('Z92b', 'value of doing this option now; attacks prefer low-health champions; graded moves; recall when low; casts abilities', parents=['s1', 'Z92b'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.34 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 40 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            return 40 + 5 * min(p, 6)
        return 0
    return 0

@gene('Z217a', 'where to walk: an altar with gems (locked as fallback), else a living camp group with loot (any living group as fallback)', parents=['s2', 's2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.5607)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.5607)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) + group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) == 0:
        for g in range(num_groups()):
            if not group_respawning(g):
                acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; go home to heal when badly hurt and stay on spawn until nearly full', parents=['s3'])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    if hf < 0.3 or (hf < 0.95 and me().pos in home):
        return field(home)
    return field(goals())

@gene('Z160b', 'progress toward goals; strength-weighted danger near destination offset by my power and allies; early exit uses cached enemy flags', parents=['Z160b', 's4'])
def progress(t: Tile) -> Num:
    m = me()
    p = at(GF, m.pos) - at(GF, t)
    if NEAR_EN == 0 and not ANY_EN:
        return p
    danger = 0
    near_count = 0
    for u in enemies():
        if dist(u.pos, t) <= 4:
            danger += u.strength * u.health_frac
            near_count += 1
    if near_count > 0:
        support = count(dist(a.pos, t) <= 4 for a in allies())
        mine = m.strength * m.health_frac
        net = danger - 0.5 * mine
        if net < 0:
            net = 0
        net = net / (1 + 0.5 * support)
        p -= net * (1 + 2 * (1 - m.health_frac))
        if m.health_frac < 0.5:
            p -= 2
    return p

@gene('Z160c', 'value of casting: unit or ground damage, shield on cooldown in fights, heal when hurt or fighting, safe dash', parents=['Z92d', 'Z38a', 'Z49a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                return 85
            if o.unit.is_camp:
                return 65 if gems() == 0 else 30
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            return 78 if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        if NEAR_EN > 0 and me().health_frac < 0.95:
            return 75
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.7 and NEAR_EN > 0:
            return 75
        if me().health_frac < 0.6:
            return 72
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.5 and progress(o.tile) >= 2:
            return 55
        return 0
    return 0
