"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
NEAR_EN: Num = 0

@gene('s1', 'value of doing this option now; also uses abilities (damage, shield/heal, dash)')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 50 + p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.5607)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'progress toward goals (cached field); discounted by strength of enemies near the target, more when hurt; refuses targets guarded while nearly dead')
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    danger = sum(u.strength * u.health_frac for u in enemies() if dist(u.pos, t) <= 3)
    if danger > 0:
        if me().health_frac < 0.3:
            return -1
        if me().health_frac < 0.5:
            p -= 2 * danger
        elif NEAR_EN > 2:
            p -= danger
    return p

@gene('Z38a', 'value of casting an ability option; shield on cooldown in fights', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                return 85
            if o.unit.is_camp:
                return 65 if gems() == 0 else 30
        return 0
    if k == AB_SHIELD:
        if NEAR_EN > 0 and me().health_frac < 0.95:
            return 75
        return 0
    if k == AB_HEAL:
        if me().health_frac < 0.7 and NEAR_EN > 0:
            return 75
        if me().health_frac < 0.5:
            return 72
        return 0
    if k == AB_DASH:
        if valid(o.tile) and progress(o.tile) > 1:
            return 55
        return 0
    return 0

@gene('Z59a', 'cache the goal distance field and nearby-enemy count once per turn', parents=['s4'])
def update() -> None:
    GF = goal_field()
    NEAR_EN = count(dist(u.pos, me().pos) <= 4 for u in enemies())
