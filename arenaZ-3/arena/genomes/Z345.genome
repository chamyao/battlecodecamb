"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
EN: Num = 0
AT: Tiles = None
ET: Tiles = None

@gene('Z188a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (protect the drop: below 60% health once carrying 30+), attacks prefer low-health champions, fight back against awake camps even when carrying gems, MOVE scales with progress and gets a bonus when carrying gems, abilities via cast_value', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 20:
            thr = 0.4
        if gems() >= 30:
            thr = 0.6
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60
        if o.unit.is_camp and is_awake(o.unit):
            return 50
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = 10 if gems() > 0 else 0
            return 30 + 5 * min(p, 6) + bonus
        return 0
    return 0

@gene("s2", "where to walk: an altar with gems (locked ones as fallback), else a living camp group worth taking (gems/gold/reward), else any living group", parents=["s2"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    acc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) + group_gold(g) > 0 or group_reward(g):
                acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    return fallback

@gene("s3", "distance field to the goals; go home to heal when badly hurt and stay on spawn until nearly full", parents=["s3"])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    if hf < 0.3 or (hf < 0.95 and me().pos in home):
        return field(home)
    return field(goals())

@gene('Z139a', 'once per turn: cache the goal distance field in GF, visible enemy tiles in ET (EN = their count) and ally tiles (excluding me) in AT, so progress() and cast_value() avoid repeated unit scans', parents=['s3'])
def update() -> None:
    GF = goal_field()
    ET = enemy_tiles()
    EN = size(ET)
    AT = ally_tiles() - near(me().pos, 0)

@gene('s4', 'progress toward goals (cached field); ally/enemy positions from cached tile sets; early out when no enemies; enemy penalty grows as health falls, threats capped at 3, enemies near me penalised more when carrying gems, ally cover softens the penalty; small bonus for allies near target when healthy', parents=['s4'])
def progress(t: Tile) -> Num:
    mp = me().pos
    p = at(GF, mp) - at(GF, t)
    support = count(dist(a, t) <= 2 for a in AT)
    if EN == 0:
        return p + 0.5 * support
    hf = me().health_frac
    threats = min(count(dist(e, t) <= 4 for e in ET), 3)
    near_me = count(dist(e, mp) <= 2 for e in ET)
    carry = 1.0 + gems() / 20.0
    p -= 0.8 * near_me * carry
    cover = 1.0 / (1.0 + 0.7 * support)
    if hf < 0.5:
        mult = 1 + (0.5 - hf) * 4
        p -= 3 * mult * threats * cover
    else:
        mult2 = 2 if gems() >= 30 else 1
        p -= 0.9 * threats * cover * mult2
        p += 0.5 * support
    return p

@gene('Z49a', 'value of casting an ability: focus hurt enemy champions, damage awake camps we fight, shield/heal when threatened (cached enemy tiles), heal when low out of combat, dash for real progress', parents=['Z49a', 'Z38a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile) and EN > 0:
            r = max(slot_radius(o.slot), 1)
            n = count(dist(e, o.tile) <= r for e in ET)
            return 72 + 6 * min(n, 3) if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.9:
            mp = me().pos
            if EN > 0 and any(dist(e, mp) <= 5 for e in ET):
                return 65 + 10 * (1 - hf)
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 60
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.6:
            mp = me().pos
            if EN > 0 and any(dist(e, mp) <= 6 for e in ET):
                return 70
            if any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 62
            if hf < 0.45:
                return 40
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            if p >= 2:
                bonus = 8 if gems() > 0 else 0
                return 35 + 2 * min(p, 5) + bonus
        return 0
    return 0
