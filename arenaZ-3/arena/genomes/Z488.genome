"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
EN: Num = 0
NEAR_EN: Num = 0
NEAR2: Num = 0
NEAR_AWAKE: Num = 0
AWAKE6: Num = 0
ALLY_N: Num = 0

@gene('Z375a', 'once per turn: cache visible enemy count (EN), enemies within 6 (NEAR_EN) and within 2 (NEAR2), allies within 6 (ALLY_N), awake camps within 2 (NEAR_AWAKE) and within 6 (AWAKE6), then the goal field', parents=['Z139a', 'Z160a'])
def update() -> None:
    EN = sum(1 for u in enemies())
    mp = me().pos
    NEAR_EN = count(dist(u.pos, mp) <= 6 for u in enemies()) if EN > 0 else 0
    NEAR2 = count(dist(u.pos, mp) <= 2 for u in enemies()) if EN > 0 else 0
    ALLY_N = count(dist(a.pos, mp) <= 6 for a in allies())
    NEAR_AWAKE = 0
    AWAKE6 = 0
    for c in camps():
        if is_awake(c):
            d = dist(c.pos, mp)
            if d <= 6:
                AWAKE6 += 1
                if d <= 2:
                    NEAR_AWAKE += 1
    GF = goal_field()

@gene('Z503a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (below 60% once carrying 30+), attacks prefer low-health champions, fight awake camps even when carrying gems, MOVE scales with progress with a gem-carry bonus, abilities via cast_value', parents=['Z188a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 20:
            thr = 0.4
        if gems() >= 30:
            thr = 0.6
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60
        if o.unit.is_camp and is_awake(o.unit):
            return 50
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = 10 if gems() > 0 else 0
            bonus += 0.2 * min(gems(), 30)
            return 30 + 5 * min(p, 6) + bonus
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems (locked ones as fallback), else a living camp group with gems, else gold or reward groups, else any living group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    acc = near(tile(-5, -5), 0)
    gacc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) > 0:
                gacc = gacc | group_tiles(g)
            elif group_gold(g) > 0 or group_reward(g):
                acc = acc | group_tiles(g)
    if size(gacc) > 0:
        return gacc
    if size(acc) > 0:
        return acc
    return fallback

@gene('s3', 'distance field to the goals; retreat home when badly hurt (<35%), when carrying 20+ gems and hurt (<60%), when outnumbered (3+ visible, 2+ near, <70%), when alone (no allies near) with 2+ enemies near and hurt (<60%), or hurt (<50%) while carrying gems (any amount with enemies near, or 20+ gems); on spawn heal to 90% before leaving', parents=['s3'])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    on_home = me().pos in home
    if on_home and hf < 0.9:
        return field(home)
    if hf < 0.35:
        return field(home)
    if gems() >= 20 and hf < 0.6:
        return field(home)
    if EN >= 3 and NEAR_EN >= 2 and hf < 0.7:
        return field(home)
    if ALLY_N == 0 and NEAR_EN >= 2 and hf < 0.6:
        return field(home)
    if hf < 0.5 and gems() > 0 and (NEAR_EN > 0 or gems() >= 20):
        return field(home)
    return field(goals())

@gene('s4', 'progress toward goals; faster commit when no enemies visible (1.5x progress); enemy penalty starts below 60% health and grows as health falls, scaled by gem carry and near-count, softened by ally cover (ALLY_N, support); stronger ally-support bonus when healthy near enemies', parents=['s4'])
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    support = count(dist(a.pos, t) <= 3 for a in allies())
    if EN == 0:
        return 1.5 * p + 0.5 * support
    hf = me().health_frac
    threats = count(dist(u.pos, t) <= 4 for u in enemies())
    carry = 1.0 + gems() / 30.0
    p -= 0.6 * NEAR2 * carry
    cover = 0.9852 / (1.0 + 0.7 * support + 0.25 * ALLY_N)
    if hf < 0.6:
        mult = 1 + (0.6 - hf) * 4
        p -= 3 * mult * threats * cover
    else:
        if threats > 0:
            if gems() >= 30:
                p -= 1.8 * threats * cover
            else:
                p -= 0.9 * threats * cover
        p += 0.8 * support
    return p

@gene('Z375b', 'value of casting: focus hurt enemy champions, damage awake camps we fight, ground AoE on enemies or awake camp packs, shield when enemies within 6 or fighting camps hurt (more when carrying 20+), heal when threatened or low, dash for real progress (needs 3+ progress and 40%+ health when enemies near)', parents=['Z49a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            n = 0
            if EN > 0:
                n = count(dist(u.pos, o.tile) <= r for u in enemies())
            if n > 0:
                return 72 + 6 * min(n, 3)
            if AWAKE6 > 0:
                m = count(is_awake(c) and dist(c.pos, o.tile) <= r for c in camps())
                if m >= 2:
                    return 56 + 3 * min(m, 4)
                if m == 1:
                    return 50
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.95:
            if NEAR_EN > 0:
                return 65 + 10 * (1 - hf) + (10 if gems() >= 20 else 0)
            if hf < 0.75 and NEAR_AWAKE > 0:
                return 60
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.7:
            if NEAR_EN > 0:
                return 70
            if NEAR_AWAKE > 0:
                return 62
            if hf < 0.45:
                return 40
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            if NEAR_EN > 0 and (p < 3 or me().health_frac < 0.4359):
                return 0
            if p >= 2:
                bonus = 8 if gems() > 0 else 0
                bonus += min(gems(), 30) / 4.0
                return 35 + 2 * min(p, 5) + bonus
        return 0
    return 0
