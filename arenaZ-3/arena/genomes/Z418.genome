"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
EN: Num = 0

@gene('Z188a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (protect the drop), attacks prefer low-health champions, MOVE scales with progress and gets a bonus scaled by gems carried (capped), abilities via cast_value', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 16:
            thr = 0.4
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = min(gems(), 30) / 3.0
            return 30 + 5 * min(p, 6) + bonus
        return 0
    return 0

@gene('Z463a', 'where to walk: an altar with gems (locked ones as fallback), else a living camp group with gems or a reward (gem groups first), else one with gold, else any living group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    gem_acc = near(tile(-5, -5), 0)
    gold_acc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) > 0 or group_reward(g):
                gem_acc = gem_acc | group_tiles(g)
            elif group_gold(g) > 0:
                gold_acc = gold_acc | group_tiles(g)
    if size(gem_acc) > 0:
        return gem_acc
    if size(gold_acc) > 0:
        return gold_acc
    return fallback

@gene('Z492a', 'distance field to the goals; retreat home below 35% health or below 50% while carrying gems; stay on spawn until 90% health', parents=['s3'])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    if hf < 0.35 or (hf < 0.5 and gems() > 0) or (hf < 0.9 and me().pos in home):
        return field(home)
    g = goals()
    if size(g) == 0:
        return field(home)
    return field(g)

@gene('Z139a', 'once per turn: cache the goal distance field in GF and the visible enemy count in EN so progress() can skip threat math when no enemies are seen', parents=['s3'])
def update() -> None:
    GF = goal_field()
    EN = sum(1 for u in enemies())

@gene('Z492b', 'progress toward goals (cached field); early out when no enemies visible; one enemies()/allies() read; enemy penalty grows as health falls, ally cover softens it, solo threats cost extra; penalty for adjacent enemies scaled by gems carried', parents=['s4'])
def progress(t: Tile) -> Num:
    m = me()
    mp = m.pos
    p = at(GF, mp) - at(GF, t)
    support = count(dist(a.pos, t) <= 2 for a in allies())
    if EN == 0:
        return p + 0.5 * support
    hf = m.health_frac
    es = enemies()
    threats = count(dist(u.pos, t) <= 4 for u in es)
    near_me = 0
    if threats > 0 or dist(mp, t) <= 6:
        near_me = count(dist(u.pos, mp) <= 2 for u in es)
    g = gems()
    carry = 1.0 + g / 30.0
    p -= 0.5321 * near_me * carry
    cover = 1.0 / (1.0 + 0.7 * support)
    if hf < 0.5:
        mult = 1 + (0.5 - hf) * 4
        p -= 3 * mult * threats * cover
    else:
        if threats > 0:
            solo = 1.0 if support == 0 else 0.6
            if g >= 30:
                p -= 1.8 * threats * cover * solo
            else:
                p -= 0.9 * threats * cover * solo
        p += 0.5 * support
    return p

@gene('Z492c', 'value of casting: focus hurt enemy champions, damage awake camps, shield (weighted up with gems)/heal when threatened, dash for progress when healthy (higher when no enemies visible, stricter with enemies visible, bonus scaled by gems carried) or to escape home when low and threatened', parents=['Z49a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            return 72 + 6 * min(n, 3) if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.9:
            mp = me().pos
            if EN > 0 and count(dist(u.pos, mp) <= 5 for u in enemies()) > 0:
                bonus = 12 if gems() >= 20 else 0
                return 65 + 10 * (1 - hf) + bonus
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 60
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.6:
            mp = me().pos
            if EN > 0 and count(dist(u.pos, mp) <= 6 for u in enemies()) > 0:
                return 70
            if any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 62
        return 0
    if k == AB_DASH:
        if valid(o.tile):
            hf = me().health_frac
            need = 0.45
            minp = 2
            if EN > 0:
                need = 0.65
                minp = 3
            if gems() >= 20:
                need = need - 0.05
            if hf > need:
                p = progress(o.tile)
                if p >= minp:
                    bonus = min(gems(), 30) / 3.0
                    base = 37 if EN == 0 else 32
                    return base + 3 * min(p, 6) + bonus
            elif hf < 0.4 and EN > 0:
                mp = me().pos
                if any(dist(u.pos, mp) <= 4 for u in enemies()):
                    d = at(GF, mp) - at(GF, o.tile)
                    if d >= 2:
                        return 50 + 2 * min(d, 5)
        return 0
    return 0
