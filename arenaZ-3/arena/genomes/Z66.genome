"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now; also casts abilities (damage/cc on enemies and camps, shield/heal when hurt, dash toward goals)')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3146 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.5607)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'progress toward goals; penalised per nearby enemy at the target tile when hurt')
def progress(t: Tile) -> Num:
    f = goal_field()
    p = at(f, me().pos) - at(f, t)
    if me().health_frac < 0.7:
        p -= 2 * count(dist(u.pos, t) <= 3 for u in enemies())
    return p

@gene('Z49a', 'value of casting an ability option; finishes low-health enemy champions, shields earlier, dashes only for clear progress', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 75 + (20 if o.unit.health_frac < 0.4 else 0)
            if o.unit.is_camp and (gems() == 0 or k == AB_CC):
                return 55
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            return 72 if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        if me().health_frac < 0.85 and count(dist(u.pos, me().pos) <= 3 for u in enemies()) > 0:
            return 70
        return 0
    if k == AB_HEAL:
        return 65 if me().health_frac < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.6 and progress(o.tile) >= 3:
            return 50
        return 0
    return 0
