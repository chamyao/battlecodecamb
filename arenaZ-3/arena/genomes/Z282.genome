"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
EN: Num = 0

@gene('Z188a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (protect the drop: below 60% health once carrying 30+), attacks prefer low-health champions, fight back against awake camps even when carrying gems, MOVE scales with progress and gets a bonus when carrying gems, abilities via cast_value', parents=['Z188a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 20:
            thr = 0.4
        if gems() >= 30:
            thr = 0.6
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60
        if o.unit.is_camp and is_awake(o.unit):
            return 50
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = 10 if gems() > 0 else 0
            return 30 + 5 * min(p, 6) + bonus
        return 0
    return 0

@gene("s2", "where to walk: an altar with gems (locked ones as fallback), else a living camp group worth taking (gems/gold/reward), else any living group", parents=["s2"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    acc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) + group_gold(g) > 0 or group_reward(g):
                acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    return fallback

@gene("s3", "distance field to the goals; retreat home below 35% health, stay on spawn until 95% full, and fall back to home when there are no goals", parents=["s3", "s3"])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    if hf < 0.35 or (hf < 0.95 and me().pos in home):
        return field(home)
    g = goals()
    if size(g) == 0:
        return field(home)
    return field(g)

@gene('Z139a', 'once per turn: cache the goal distance field in GF and the visible enemy count in EN so progress() can skip threat math when no enemies are seen', parents=['Z139a', 's3'])
def update() -> None:
    GF = goal_field()
    EN = sum(1 for u in enemies())

@gene('s4', 'progress toward goals (cached field); early out when no enemies are visible (cached count); otherwise enemy penalty grows as health falls (1x at 50%, 3x at 0%), enemies near target discount it, ally cover softens the penalty; small bonus for allies near target when healthy; extra penalty for enemies already adjacent to me, scaled up when carrying gems', parents=['s4'])
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    support = count(dist(a.pos, t) <= 2 for a in allies())
    if EN == 0:
        return p + 0.5 * support
    hf = me().health_frac
    threats = count(dist(u.pos, t) <= 4 for u in enemies())
    near_me = count(dist(u.pos, me().pos) <= 2 for u in enemies())
    carry = 1.0 + gems() / 30.0
    p -= 0.6 * near_me * carry
    if hf < 0.5:
        mult = 1 + (0.5 - hf) * 4
        cover = 1.0 / (1.0 + 0.7 * support)
        p -= 3 * mult * threats * cover
    else:
        if threats > 0:
            cover = 1.0 / (1.0 + 0.7 * support)
            if gems() >= 30:
                p -= 1.8 * threats * cover
            else:
                p -= 0.9 * threats * cover
        p += 0.5 * support
    return p

@gene('Z49a', 'value of casting an ability: focus hurt enemy champions, damage awake camps we fight, shield/heal when threatened (skip enemy scans when none are visible via cached EN), heal when low out of combat, dash for real progress', parents=['Z49a', 'Z38a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile) and EN > 0:
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            return 72 + 6 * min(n, 3) if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.9:
            mp = me().pos
            if EN > 0 and count(dist(u.pos, mp) <= 5 for u in enemies()) > 0:
                return 65 + 10 * (1 - hf)
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 60
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.6:
            mp = me().pos
            if EN > 0 and count(dist(u.pos, mp) <= 6 for u in enemies()) > 0:
                return 70
            if any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 62
            if hf < 0.45:
                return 40
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            if p >= 2:
                bonus = 8 if gems() > 0 else 0
                return 35 + 2 * min(p, 5) + bonus
        return 0
    return 0
