"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
EN: Num = 0
NEAR_EN: Num = 0
CAMP_FIGHT: Bool = False

@gene('Z375a', 'once per turn: cache visible enemy count (EN), enemies within 6 of me (NEAR_EN), whether an awake camp is within 2 (CAMP_FIGHT), then the goal field', parents=['Z139a', 'Z160a'])
def update() -> None:
    EN = sum(1 for u in enemies())
    mp = me().pos
    NEAR_EN = count(dist(u.pos, mp) <= 6 for u in enemies()) if EN > 0 else 0
    CAMP_FIGHT = any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps())
    GF = goal_field()

@gene('Z503a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (below 60% once carrying 30+), attacks prefer low-health champions, attack camps for 67 when empty-handed, fight awake camps even when carrying gems, MOVE scales with progress (weight 6, cap 8) plus a gem bonus up to 40 gems, abilities via cast_value', parents=['Z188a', 'Z559a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 20:
            thr = 0.568
        if gems() >= 23:
            thr = 0.6
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 67
        if o.unit.is_camp and is_awake(o.unit):
            return 50
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = 0.5 * min(gems(), 40)
            return 30 + 6 * min(p, 8) + bonus
        return 0
    return 0

@gene('s2', 'where to walk: an altar with gems (locked ones as fallback), else a living camp group with gems or a reward (gem groups first), else gold groups, else any living group', parents=['s2', 'Z463a'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    acc = near(tile(-5, -5), 0)
    gacc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) > 0 or group_reward(g):
                gacc = gacc | group_tiles(g)
            elif group_gold(g) > 0:
                acc = acc | group_tiles(g)
    if size(gacc) > 0:
        return gacc
    if size(acc) > 0:
        return acc
    return fallback

@gene('s3', 'distance field to the goals; on spawn heal to 90% before leaving; retreat home when badly hurt (<35%), or hurt (<50%) while carrying gems (any amount with enemies near, 20+ gems regardless)', parents=['s3'])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    on_home = me().pos in home
    if on_home and hf < 0.9:
        return field(home)
    if hf < 0.35:
        return field(home)
    if hf < 0.5 and gems() > 0 and (NEAR_EN > 0 or gems() >= 20):
        return field(home)
    return field(goals())

@gene('s4', 'progress toward goals (cached field); early out when no enemies are visible; threat radius widens to 5 when carrying 20+ gems; health-weighted threats near target; penalty grows as health falls (1x at 50%, 3x at 0%), ally cover softens it; ally support near target when healthy; extra penalty for enemies adjacent to me, scaled up when carrying gems', parents=['s4', 'Z443a'])
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    support = count(dist(a.pos, t) <= 2 for a in allies())
    if EN == 0:
        return p + 0.5 * support
    hf = me().health_frac
    radius = 4
    if gems() >= 20:
        radius = 5
    threats = sum(0.4 + 0.6 * u.health_frac for u in enemies() if dist(u.pos, t) <= radius)
    near_me = count(dist(u.pos, me().pos) <= 2 for u in enemies())
    carry = 1.0 + gems() / 30.0
    p -= 0.6 * near_me * carry
    cover = 1.0 / (1.0 + 0.7 * support)
    if hf < 0.5:
        mult = 1.0671 + (0.5 - hf) * 4
        p -= 2 * mult * threats * cover
    else:
        if threats > 0:
            if gems() >= 30:
                p -= 1.8 * threats * cover
            else:
                p -= 0.9 * threats * cover
        p += 0.5 * support
    return p

@gene('Z375b', 'value of casting: stuns on enemy champions above damage, focus hurt champions, damage awake camps; ground AoE on enemies or on awake camps we fight; shield/heal use cached NEAR_EN and CAMP_FIGHT; dash for real progress when healthy (bonus with gems)', parents=['Z375b', 'Z559c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if k == AB_CC:
                    return 78 + 30 * (1 - o.unit.health_frac)
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            if EN > 0:
                n = count(dist(u.pos, o.tile) <= r for u in enemies())
                if n > 0:
                    return 72 + 6 * min(n, 3)
            if CAMP_FIGHT:
                m = count(is_awake(c) and dist(c.pos, o.tile) <= r for c in camps())
                if m > 0:
                    return 52 + 4 * min(m, 3)
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.95:
            if NEAR_EN > 0:
                return 65 + 10 * (1 - hf) + (10 if gems() >= 20 else 0)
            if hf < 0.7 and CAMP_FIGHT:
                return 69
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.7:
            if NEAR_EN > 0:
                return 70
            if CAMP_FIGHT:
                return 62
            if hf < 0.45:
                return 40
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            if p >= 2:
                bonus = 8 if gems() > 0 else 0
                bonus += min(gems(), 30) / 4.0
                return 35 + 2 * min(p, 5) + bonus
        return 0
    return 0
