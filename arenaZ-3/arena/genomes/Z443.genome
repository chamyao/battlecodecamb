"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
EN: Num = 0
NEAR_EN: Num = 0
AWK: Num = 0
NEAR2: Num

@gene('Z375a', 'once per turn: cache visible enemy count (EN), enemies within 6 (NEAR_EN) and within 2 (NEAR2) of me, awake camps within 2 of me when hurt (AWK), then the goal field', parents=['Z139a', 'Z160a'])
def update() -> None:
    EN = sum(1 for u in enemies())
    mp = me().pos
    NEAR_EN = count(dist(u.pos, mp) <= 6 for u in enemies()) if EN > 0 else 0
    NEAR2 = count(dist(u.pos, mp) <= 2 for u in enemies()) if EN > 0 else 0
    AWK = 0
    if me().health_frac < 0.7:
        AWK = count(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps())
    GF = goal_field()

@gene('Z559a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (below 60% health once carrying 30+), attacks prefer low-health champions, fight back against awake camps even when carrying gems, MOVE scales with progress plus a bonus scaled by gems carried (capped), abilities via cast_value', parents=['Z188a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 20:
            thr = 0.4
        if gems() >= 30:
            thr = 0.6
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60
        if o.unit.is_camp and is_awake(o.unit):
            return 50
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = min(gems(), 30) / 3.0
            return 30 + 5 * min(p, 6) + bonus
        return 0
    return 0

@gene('Z463a', 'where to walk: an altar with gems (locked ones as fallback), else a living camp group with gems or a reward (gem groups first), else one with gold, else any living group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    gem_acc = near(tile(-5, -5), 0)
    gold_acc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) > 0 or group_reward(g):
                gem_acc = gem_acc | group_tiles(g)
            elif group_gold(g) > 0:
                gold_acc = gold_acc | group_tiles(g)
    if size(gem_acc) > 0:
        return gem_acc
    if size(gold_acc) > 0:
        return gold_acc
    return fallback

@gene('s3', 'distance field to the goals; retreat home when badly hurt (<35%), or hurt (<50%) while carrying gems (any amount with enemies near, 20+ gems regardless); on spawn heal to 90% before leaving', parents=['s3'])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    on_home = me().pos in home
    if on_home and hf < 0.9:
        return field(home)
    if hf < 0.35:
        return field(home)
    if hf < 0.5 and gems() > 0 and (NEAR_EN > 0 or gems() >= 20):
        return field(home)
    return field(goals())

@gene('s4', 'progress toward goals (cached field); early out when no enemies are visible (cached count); otherwise enemy penalty grows as health falls (1x at 50%, 3x at 0%), enemies near target discount it, ally cover softens the penalty; small bonus for allies near target when healthy; extra penalty for enemies already adjacent to me, scaled up when carrying gems', parents=['s4'])
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    support = count(dist(a.pos, t) <= 2 for a in allies())
    if EN == 0:
        return p + 0.5 * support
    hf = me().health_frac
    threats = count(dist(u.pos, t) <= 4 for u in enemies())
    near_me = count(dist(u.pos, me().pos) <= 2 for u in enemies())
    carry = 1.0 + gems() / 30.0
    p -= 0.6 * near_me * carry
    if hf < 0.5:
        mult = 1 + (0.5 - hf) * 4
        cover = 1.0 / (1.0 + 0.7 * support)
        p -= 3 * mult * threats * cover
    else:
        if threats > 0:
            cover = 1.0 / (1.0 + 0.7 * support)
            if gems() >= 30:
                p -= 1.8 * threats * cover
            else:
                p -= 0.9 * threats * cover
        p += 0.5 * support
    return p

@gene('Z559c', 'value of casting an ability: focus hurt enemy champions, damage awake camps we fight, shield/heal when threatened (heal and shield weighted up when enemies are adjacent or gems are carried), heal when low out of combat (uses cached AWK), dash for real progress when healthy (more readily with gems; more progress and health needed when enemies are visible)', parents=['Z49a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile) and EN > 0:
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            return 72 + 6 * min(n, 3) if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if hf < 0.9:
            if NEAR_EN > 0:
                bonus = 12 if gems() >= 20 else 0
                if NEAR2 > 0:
                    bonus += 8
                return 65 + 10 * (1 - hf) + bonus
            if hf < 0.7 and AWK > 0:
                return 60
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.6:
            if NEAR_EN > 0:
                bonus = 0
                if gems() >= 10:
                    bonus += 10
                if NEAR2 > 0:
                    bonus += 8
                return 70 + bonus
            if AWK > 0:
                return 62
            if hf < 0.45:
                return 40
        return 0
    if k == AB_DASH:
        hf = me().health_frac
        if valid(o.tile):
            need = 0.4
            minp = 2
            if EN > 0:
                need = 0.6
                minp = 4
            if gems() >= 20:
                need = need - 0.05
            if hf > need:
                p = progress(o.tile)
                if p >= minp:
                    bonus = 10 if gems() > 0 else 0
                    return 32 + 3 * min(p, 6) + bonus
        return 0
    return 0
