"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now; attacks prefer low-health champions; MOVE scales with progress; also uses abilities (damage, shield/heal, dash)')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3132 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        return 40 + 1.5 * p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, an altar when carrying enough gems, else living non-monolith camp groups (plus spawn when rich)')
def goals() -> Tiles:
    if me().health_frac < 0.3:
        return my_spawn()
    g0 = gems()
    if g0 >= 12 or (g0 > 0 and round() > 1850):
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.5607)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    if round() < 1000:
        acc = acc - type_spawns(MONOLITH)
    if gold() >= 150:
        acc = acc | my_spawn()
    if size(acc) == 0 and g0 > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.5607)
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('s4', 'progress toward goals; enemy danger (champions weighted 1.5x, radius 4) at the destination offset by my power and nearby allies, scaled up when hurt')
def progress(t: Tile) -> Num:
    f = goal_field()
    m = me()
    here = at(f, m.pos)
    there = at(f, t)
    p = 0
    if here < 1000000 and there < 1000000:
        p = here - there
    danger = 0
    near_count = 0
    for u in enemies():
        d = dist(u.pos, t)
        if d <= 4:
            w = 1
            if u.is_champion:
                w = 1.5
            danger += w * u.strength * u.health_frac
            near_count += 1
    if near_count > 0:
        support = count(dist(a.pos, t) <= 3 for a in allies())
        mine = m.strength * m.health_frac
        net = danger - 0.5 * mine
        if net < 0:
            net = 0
        net = net / (1 + 0.5 * support)
        p -= net * (1 + 2 * (1 - m.health_frac))
        if m.health_frac < 0.5:
            p -= 2
    return p

@gene('Z139a', 'once per turn: cache the distance field to the goals so it is not rebuilt every pass', parents=['s3'])
def update() -> None:
    GF = field(goals())

@gene('Z38a', 'value of casting an ability option', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                return 85
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if me().health_frac < 0.9659 and count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0:
            return 75
        return 0
    if k == AB_DASH:
        if valid(o.tile) and progress(o.tile) > 1:
            return 55
        return 0
    return 0
