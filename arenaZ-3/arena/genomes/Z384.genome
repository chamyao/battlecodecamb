"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
EN: Num = 0
NEAR_EN: Num = 0
N5: Num = 0
N6: Num = 0
AC: Bool = False

@gene('Z188a', 'value of doing this option now: PICK fixed, BUY items, RECALL earlier when carrying gems (below 60% once carrying 30+), attacks prefer low-health and gem-carrying champions, awake camps still fought while carrying gems, MOVE scales with progress and a gem bonus, abilities via cast_value', parents=['Z188a', 's1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        thr = 0.3146
        if gems() >= 20:
            thr = 0.4
        if gems() >= 30:
            thr = 0.6
        return 90 if me().health_frac < thr else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 50 * (1 - o.unit.health_frac) + 0.2 * min(unit_gems(o.unit), 50)
        if gems() == 0:
            return 60
        if is_awake(o.unit):
            return 50
        return 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p > 0:
            bonus = 0.5 * min(gems(), 40)
            return 30 + 6 * min(p, 8) + bonus
        return 0
    return 0

@gene("s2", "where to walk: an altar with gems (locked ones as fallback), else a living camp group worth taking (gems/gold/reward), else any living group", parents=["s2"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.9749)
        if size(acc) == 0:
            for a in altars():
                acc = acc | near(a, 0.9749)
        return acc
    acc = near(tile(-5, -5), 0)
    fallback = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            fallback = fallback | group_tiles(g)
            if group_gems(g) + group_gold(g) > 0 or group_reward(g):
                acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    return fallback

@gene('s3', 'distance field to the goals; retreat home below 40% health (50% when carrying gems), stay on spawn until 90% full, and fall back to home when there are no goals', parents=['s3'])
def goal_field() -> Field:
    hf = me().health_frac
    home = my_spawn()
    limit = 0.4
    if gems() > 0:
        limit = 0.5
    if hf < limit or (hf < 0.9 and me().pos in home):
        return field(home)
    g = goals()
    if size(g) == 0:
        return field(home)
    return field(g)

@gene('Z139a', 'once per turn: cache goal field GF, visible enemy count EN, enemies within 10 (NEAR_EN), within 5/6 of me (N5/N6) and whether an awake camp is within 2 (AC) so per-option scans are skipped', parents=['Z139a'])
def update() -> None:
    GF = goal_field()
    EN = count_units(enemies())
    mp = me().pos
    NEAR_EN = count(dist(u.pos, mp) <= 10 for u in enemies())
    if EN > 0:
        N5 = count(dist(u.pos, mp) <= 5 for u in enemies())
        N6 = count(dist(u.pos, mp) <= 6 for u in enemies())
    else:
        N5 = 0
        N6 = 0
    AC = any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps())

@gene('Z443a', 'progress toward goals (cached field); quick exit when no enemy was near at turn start; otherwise one enemies() query per call; threat radius 5 when carrying 20+ gems, health-weighted threats near target; penalty grows as health falls, ally cover softens it; small bonus for allies near target when healthy; extra penalty for enemies adjacent to me scaled by gems', parents=['Z443a', 's4'])
def progress(t: Tile) -> Num:
    p = at(GF, me().pos) - at(GF, t)
    if NEAR_EN == 0:
        return p
    es = enemies()
    if count_units(es) == 0:
        return p
    hf = me().health_frac
    g = gems()
    radius = 4
    if g >= 20:
        radius = 5
    mp = me().pos
    threats = sum(0.4 + 0.6 * u.health_frac for u in es if dist(u.pos, t) <= radius)
    near_me = count(dist(u.pos, mp) <= 2 for u in es)
    support = count(dist(a.pos, t) <= 2 for a in allies())
    carry = 1.0 + g / 30.0
    p -= 0.6 * near_me * carry
    if hf < 0.5:
        mult = 1 + (0.5 - hf) * 4
        cover = 1.0 / (1.0 + 0.7 * support)
        p -= 3 * mult * threats * cover
    else:
        if threats > 0:
            cover = 0.7055 / (1.0 + 0.7 * support)
            if g >= 30:
                p -= 1.8 * threats * cover
            else:
                p -= 0.9 * threats * cover
        p += 0.5 * support
    return p

@gene('Z49a', 'value of casting an ability: focus hurt enemy champions, damage awake camps we fight, shield on cooldown in close fights and heal when threatened (cached N5/N6/AC), heal when low out of combat, dash for real progress; defensive casts valued higher while carrying gems', parents=['Z49a', 'Z38a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    carrying = 1 if gems() > 0 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 65 + 30 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0 or is_awake(o.unit):
                    return 55 + 10 * (1 - o.unit.health_frac)
            return 0
        if valid(o.tile) and EN > 0:
            r = max(slot_radius(o.slot), 1)
            n = count(dist(u.pos, o.tile) <= r for u in enemies())
            return 72 + 6 * min(n, 3) if n > 0 else 0
        return 0
    if k == AB_SHIELD:
        hf = me().health_frac
        if N5 > 0:
            if hf < 0.9:
                return 65 + 10 * (1 - hf) + 12 * carrying
            if N5 >= 2 or carrying > 0:
                return 50 + 12 * carrying
            return 0
        if hf < 0.7 and AC:
            return 60 + 8 * carrying
        return 0
    if k == AB_HEAL:
        hf = me().health_frac
        if hf < 0.6:
            if N6 > 0:
                return 70 + 12 * carrying
            if AC:
                return 62 + 8 * carrying
            if hf < 0.45:
                return 40 + 10 * carrying
        return 0
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            p = progress(o.tile)
            g = gems()
            if g >= 10 and p >= 1:
                return 40 + 2 * min(p, 5) + min(g, 30) / 2.0
            if p >= 2:
                return 35 + 2 * min(p, 5) + min(g, 30) / 10.0
        return 0
    return 0
