"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now; attacks prefer low-health champions; also uses abilities (damage, shield/heal, dash); movement weighted by progress and health')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1.2288
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 40 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        if me().health_frac >= 0.7:
            return 30 + 3 * p
        return 20 + p
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.5607)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'progress toward goals; enemy danger (champions weighted 1.5x, radius 4) at the destination vs my power plus allies nearby, scaled up when hurt; progress worth 1.5x while carrying gems')
def progress(t: Tile) -> Num:
    f = goal_field()
    m = me()
    p = at(f, m.pos) - at(f, t)
    danger = 0
    near_count = 0
    for u in enemies():
        d = dist(u.pos, t)
        if d <= 4:
            w = 1
            if u.is_champion:
                w = 1.5
            danger += w * u.strength * u.health_frac
            near_count += 1
    if near_count > 0:
        support = count(dist(a.pos, t) <= 3 for a in allies())
        mine = m.strength * m.health_frac * (1 + 0.5 * support)
        net = max(danger - mine, 0)
        p -= net * (1 + 2 * (1 - m.health_frac))
        if m.health_frac < 0.5:
            p -= 2
    if gems() > 0:
        p = p * 1.5
    return p

@gene('Z38a', 'value of casting an ability option', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_enemy and o.unit.is_champion:
                return 85
            if o.unit.is_camp and gems() == 0:
                return 65
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if me().health_frac < 0.7 and count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0:
            return 75
        return 0
    if k == AB_DASH:
        if valid(o.tile) and progress(o.tile) > 1:
            return 55
        return 0
    return 0
