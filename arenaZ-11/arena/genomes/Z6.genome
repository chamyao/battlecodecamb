"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return 40 + 15 * p
    return 0

@gene('s2', 'where to walk: home when low, altar when carrying enough gems, else cleared groups to capture, else living non-monolith camps')
def goals() -> Tiles:
    if low_health():
        return my_spawn()
    if gems() >= 25 or (gems() > 0 and round() > 1850):
        acc = altar_tiles()
        if size(acc) > 0:
            return acc
    reward = reward_tiles()
    if size(reward) > 0:
        return reward
    acc = open_camp_tiles()
    if size(acc) > 0:
        return acc
    if gems() > 0:
        return altar_tiles()
    return my_spawn()

@gene('X10a', 'true when hurt badly and carrying few gems, so go home', parents=['s2'])
def low_health() -> Bool:
    return me().health_frac < 0.3 and gems() < 10

@gene('X10b', 'empty tile set used as the base for unions', parents=['s2'])
def no_tiles() -> Tiles:
    return near(tile(-5, -5), 0)

@gene('X10c', 'tiles next to every altar that is not locked by the enemy', parents=['s2'])
def altar_tiles() -> Tiles:
    acc = no_tiles()
    for a in altars() - locked_altars():
        acc = acc | near(a, 1)
    return acc

@gene('X10d', 'tiles of cleared groups that are waiting for capture', parents=['s2'])
def reward_tiles() -> Tiles:
    reward = no_tiles()
    for g in range(num_groups()):
        if not group_respawning(g) and group_reward(g):
            reward = reward | group_tiles(g)
    return reward

@gene('X10e', 'tiles of living non-monolith camp groups that are not yet cleared for capture', parents=['s2'])
def open_camp_tiles() -> Tiles:
    mono = type_spawns(MONOLITH)
    acc = no_tiles()
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if not group_reward(g) and size(gt & mono) == 0:
                acc = acc | gt
    return acc

@gene('s3', 'distance field to the goals (cached once per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z12a', 'once per turn: cache the distance field to the goals', parents=['s3'])
def update() -> None:
    GF = field(goals())

@gene('s4', 'how much closer a step brings me to the goals, minus danger from enemy champions when hurt')
def progress(t: Tile) -> Num:
    p = at(goal_field(), me().pos) - at(goal_field(), t)
    if me().health_frac < 0.5:
        p -= 3 * sum(1 for u in enemies() if u.is_champion and dist(u.pos, t) <= 2)
    return p
