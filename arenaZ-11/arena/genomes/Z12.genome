"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if not carrying_enough() else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'altar when carrying enough gems; else a cleared group awaiting capture; else a living non-monolith camp group')
def goals() -> Tiles:
    if carrying_enough():
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    cap = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            cap = cap | group_tiles(g)
    if size(cap) > 0:
        return cap
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    acc2 = acc - type_spawns(MONOLITH)
    if size(acc2) > 0:
        return acc2
    if gems() > 0:
        alt = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        return alt
    return acc

@gene('s4', 'how much closer a step brings me to the goals (cached field)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z33a', 'once per turn: cache the distance field to the goals', parents=['s1', 's2', 's3', 's4'])
def update() -> None:
    GF = field(goals())

@gene('Z33b', 'carry enough gems that a trip to the altar is worth it', parents=['s2'])
def carrying_enough() -> Bool:
    g = gems()
    if g <= 0:
        return False
    return g >= 25 or round() > 1800 or me().health_frac < 0.5
