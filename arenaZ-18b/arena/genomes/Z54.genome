"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now: cast spells, focus weak enemy champions, recall when out of reach, walk home when hurt with enemies near')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 54 if me().health_frac < 0.35 else 0
    if o.kind == CAST:
        return spell_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 5 * (1 - o.unit.health_frac)
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if me().health_frac < 0.3 and count_units(enemies()) > 0:
            return 95 if progress(o.tile) > 0 else 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: home when hurt, an altar with gems, else the camp group (not monolith or golem) with the best loot for its distance')
def goals() -> Tiles:
    if me().health_frac < 0.35:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    bestv = -1
    for g in range(num_groups()):
        if not group_respawning(g):
            ts = group_tiles(g)
            n = nearest(ts, me().pos)
            k = spawn_type(n)
            if k != MONOLITH and k != GOLEM:
                v = (group_gems(g) + group_gold(g) / 20 + 2) / (dist(n, me().pos) + 6)
                if v > bestv:
                    bestv = v
                    acc = ts
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, or to my spawn when hurt')
def progress(t: Tile) -> Num:
    if me().health_frac < 0.3:
        h = field(my_spawn())
        return at(h, me().pos) - at(h, t)
    return at(goal_field(), me().pos) - at(goal_field(), t)

@gene('Z9a', 'value of a spell: damage, aoe and cc on the weakest enemy champions or camps, shield and heal early, dash toward the goal', parents=['s1'])
def spell_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if not exists(o.unit):
            return 0
        if o.unit.is_champion and o.unit.is_enemy:
            return 85 + 5 * (1 - o.unit.health_frac)
        if o.unit.is_camp and gems() == 0:
            return 65
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        return 88 if me().health_frac < 0.7726 else 0
    if k == AB_DASH:
        if valid(o.tile) and progress(o.tile) >= 2:
            return 55
        return 0
    return 0
