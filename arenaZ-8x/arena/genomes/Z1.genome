"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HOME: Tiles = None

@gene('s1', 'value of doing this option now; heal on spawn before leaving')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() < 20 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if me().health_frac < 0.9 and me().pos in HOME:
            return 0
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar once carrying enough gems, else cleared groups to capture and living camp groups')
def goals() -> Tiles:
    camps_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g) or not group_respawning(g):
            camps_acc = camps_acc | group_tiles(g)
    if gems() >= 20 or (gems() > 0 and (size(camps_acc) == 0 or round() > 1850)):
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    return camps_acc

@gene('s4', 'how much closer a step brings me to the goals')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z3a', 'once per turn: cache the goal distance field and home tiles', parents=['s1', 's2', 's3', 's4'])
def update() -> None:
    GF = field(goals())
    HOME = my_spawn()
