"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False
GSIG: Num = -1
GAGE: Num = 0

@gene('Z212a', 'value of doing this option now: safe recall when retreating, finish low enemies (ranged retreaters only finish nearly dead ones), attack camps while not banking, keep hitting awake camps that fight us', parents=['Z103a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if LOW and me().attack_range > 1 and o.unit.health_frac > 0.25:
                return 0
            return 80 + 10 * (1 - o.unit.health_frac)
        if LOW:
            return 0
        if not banking():
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.is_camp and is_awake(o.unit) and me().health_frac > 0.35:
            return 50
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('Z147a', 'skip listing option kinds the policy never values (wards, altar locks) to save fuel', parents=['Z103a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK:
        return False
    return True

@gene('Z30b', 'whether I should head to an altar with my gems now: a big bag (smaller later in the game), a winning tribute, a cheap top-up when an altar is very close, or hurt while carrying a worthwhile bag', parents=['s2'])
def banking() -> Bool:
    g = gems()
    if g <= 0:
        return False
    if team_gems() + g >= 1000:
        return True
    r = round()
    if g >= 20:
        return True
    if g >= 12 and r > 1000:
        return True
    if g >= 6 and r > 1500:
        return True
    if r > 1800:
        return True
    m = me()
    hf = m.health_frac
    if g >= 5:
        a = nearest(altars(), m.pos)
        if valid(a) and dist(a, m.pos) <= 4:
            return True
    if g >= 8:
        return hf < 0.75
    return hf < 0.55

@gene('Z212b', 'where to walk: an altar when banking, else a cleared group to capture, else gem- or (before round 1200) gold-carrying non-monolith groups (any group early or when none carry loot), else explore camp spawns', parents=['Z30c'])
def goals() -> Tiles:
    if banking():
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    rich = near(tile(-5, -5), 0)
    ready = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    early = round() < 300
    goldok = round() < 1200
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(gt & mono) == 0:
                acc = acc | gt
                if group_gems(g) > 0 or (goldok and group_gold(g) > 0):
                    rich = rich | gt
                if group_reward(g):
                    ready = ready | gt
    if size(ready) > 0:
        return ready
    if not early and size(rich) > 0:
        return rich
    if size(acc) == 0 and gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
    if size(acc) == 0:
        acc = camp_spawns() - mono
    return acc

@gene('s3', 'distance field to the given goals')
def goal_field(g: Tiles) -> Field:
    return field(g)

@gene('Z107a', 'cheap fingerprint of a tile set (with a product term to cut collisions) so the goal field is rebuilt only when goals change', parents=['s3'])
def goal_signature(g: Tiles) -> Num:
    return size(g) * 7919 + sum(t.x * 131 + t.y * 17 + t.x * t.y * 3 for t in g)

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields); 0 when either end is unreachable')
def progress(t: Tile) -> Num:
    f = HF if LOW else GF
    a = at(f, me().pos)
    b = at(f, t)
    if a >= 100000000 or b >= 100000000:
        return 0
    return a - b

@gene('Z4a', 'skip all work while dead; home field cached once at start; goal field rebuilt when goals change (or every 15 turns, saving fuel since the map is static); skip goal work while channeling; retreat home at 42% (50% with many gems) with hysteresis, back out at 85%', parents=['s4'])
def update() -> None:
    if not alive():
        return
    if not HSET:
        HF = field(my_spawn())
        HSET = True
    hf = me().health_frac
    if LOW:
        if hf > 0.85:
            LOW = False
            GSIG = -1
    else:
        lim = 0.42
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    if not LOW:
        if channeling():
            return
        g = goals()
        sig = goal_signature(g)
        GAGE += 1
        if sig != GSIG or GAGE >= 15:
            GF = goal_field(g)
            GSIG = sig
            GAGE = 0

@gene('Z147b', 'cast value: stun tributers, finish low enemy champions, CC to escape when retreating, focus damaged camps unless banking (keep fighting awake adjacent camps while banking), shield vs threats, heal lowest ally, escape dash when low, dash toward goals/home, dash onto weak enemies', parents=['Z126a', 'Z4b'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    mp = m.pos
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if k == AB_CC and is_tributing(o.unit):
                    return 95
                if o.unit.health_frac < 0.4:
                    return 85 + 10 * (1 - o.unit.health_frac)
                if k == AB_CC and LOW:
                    return 88
                return 75 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp and not LOW:
                bonus = 4 * (1 - o.unit.health_frac)
                if not banking():
                    return 55 + 10 * (1 - o.unit.health_frac)
                if is_awake(o.unit) and hf > 0.35:
                    if dist(o.unit.pos, mp) <= 2:
                        return 53 + bonus
                    return 50
        return 0
    if k == AB_SHIELD:
        if hf < 0.9:
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 72
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 72
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 + 5 * (1 - o.unit.health_frac) if o.unit.health_frac < 0.6 else 0
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if hf < 0.35 and not LOW:
                if any(u.is_champion and dist(u.pos, mp) <= 5 for u in enemies()):
                    home = nearest(my_spawn(), mp)
                    if valid(home):
                        gain = dist(mp, home) - dist(o.tile, home)
                        if gain >= 2:
                            return 74 + gain
                return 0
            p = progress(o.tile)
            if LOW:
                return 74 + p if p >= 2 else 0
            if hf > 0.6:
                if any(u.is_champion and u.health_frac < 0.35 and dist(u.pos, o.tile) <= 1 for u in enemies()):
                    return 70
            if p >= 2 and (hf > 0.5 or gems() > 0):
                return 45 + p
        return 0
    return 0

@gene('Z50a', 'recall when retreating (or to shop when rich and worn) if far from home and no enemy champion or awake camp close enough to interrupt it', parents=['s1'])
def recall_value() -> Num:
    mp = me().pos
    hd = at(HF, mp)
    if LOW:
        if hd <= 5:
            return 0
        val = 90
    else:
        if gold() < 120 or hd <= 12 or me().health_frac > 0.75 or banking():
            return 0
        val = 85
    if any(u.is_champion and dist(u.pos, mp) <= 5 for u in enemies()):
        return 0
    if any(is_awake(u) and dist(u.pos, mp) <= 3 for u in camps()):
        return 0
    return val
