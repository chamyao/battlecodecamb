"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False
SAFE: Bool = False
SHOP: Bool = False

@gene('Z167a', 'value of doing this option now; draft prefers ladder-meta champions, attacks focus the weakest target, no camp pulls while retreating, retreating ranged champs keep walking unless the kill is near; shop treasure shards first (bulk), then strength shards once the treasure emblems are built', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return buy_value(o)
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if LOW and me().attack_range > 1 and o.unit.health_frac > 0.25:
                return 30
            return 80 + 10 * (1 - o.unit.health_frac)
        if LOW:
            return 0
        return 60 + 5 * (1 - o.unit.health_frac) if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('Z171a', 'skip listing option kinds the policy never takes (wards, locks, lock purchases, cancels) to save fuel', parents=['Z167a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    return True

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields), with a tiny bonus for landing near the goal; 0 when either end is unreachable')
def progress(t: Tile) -> Num:
    f = HF if LOW else GF
    a = at(f, me().pos)
    b = at(f, t)
    if a >= 100000000 or b >= 100000000:
        return 0
    d = a - b
    if d > 0:
        return d + 0.1 / (1 + b)
    return d

@gene('Z105a', 'draft preference following the top ladder drafts', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == HEART_OF_RUIN:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z213a', 'shop value: treasure shards (item 6) first, bought in bulk; after 10 treasure shards switch to strength shards', parents=['Z167a'])
def buy_value(o: Option) -> Num:
    treasure = items_owned(6)
    capped = item_passive(6) == P_TREASURE and treasure >= 10
    if o.item == 6:
        if capped:
            return 0
        return 100 + o.count
    if capped and item_strength(o.item) > 0 and item_passive(o.item) != P_TREASURE:
        return 90 + item_strength(o.item) + o.count
    return 0

@gene('Z4a', 'goal field once per turn; retreat home at 40% (50% with many gems) with hysteresis; home field cached; recall safety computed once per turn when retreating or when holding enough gold to buy an emblem', parents=['s4'])
def update() -> None:
    hf = me().health_frac
    if LOW:
        if hf > 0.9:
            LOW = False
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    SHOP = False
    if not LOW and gold() >= 150 and not channeling():
        SHOP = True
    SAFE = False
    if LOW or SHOP:
        if not HSET:
            HF = field(my_spawn())
            HSET = True
        mp = me().pos
        if at(HF, mp) > 6:
            if not any(u.is_champion and dist(u.pos, mp) <= 5 for u in enemies()):
                if LOW:
                    if not any(is_awake(c) and dist(c.pos, mp) <= 3 for c in camps()):
                        SAFE = True
                else:
                    if not any(dist(c.pos, mp) <= 4 for c in camps()):
                        SAFE = True
    if not LOW:
        GF = goal_field()

@gene('Z167b', 'value of casting an ability option; CC tributers first, finish low enemy champions, CC to escape when retreating, focus damaged camps but never wake sleeping camps while retreating, shield in close fights, heal the lowest target, dash toward goals or home, dash onto weak enemies when healthy', parents=['Z4b'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    mp = m.pos
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if k == AB_CC and is_tributing(o.unit):
                    return 90
                if o.unit.health_frac < 0.4:
                    return 85 + 5 * (1 - o.unit.health_frac)
                if k == AB_CC and LOW:
                    return 88
                return 75 + 5 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                bonus = 4 * (1 - o.unit.health_frac)
                awake = is_awake(o.unit)
                if LOW:
                    if awake and dist(o.unit.pos, mp) <= 2 and o.unit.health_frac < 0.3:
                        return 55 + bonus
                    return 0
                if gems() == 0:
                    return 55 + bonus
                if awake and dist(o.unit.pos, mp) <= 2:
                    return 55 + bonus
        return 0
    if k == AB_SHIELD:
        if hf < 0.9:
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 72
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 72
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 + 5 * (1 - o.unit.health_frac) if o.unit.health_frac < 0.6 else 0
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            p = progress(o.tile)
            if LOW:
                return 50 + p if p >= 2 else 0
            if hf > 0.6:
                if any(u.is_champion and u.health_frac < 0.35 and dist(u.pos, o.tile) <= 1 for u in enemies()):
                    return 70
            if hf > 0.5:
                return 42 + p if p >= 2 else 0
        return 0
    return 0

@gene('Z50a', 'recall when retreating and safe; also recall to spend a large gold pile on shards when safe and away from camps', parents=['s1'])
def recall_value() -> Num:
    if LOW and SAFE:
        return 90
    if SHOP and SAFE:
        return 40
    return 0
