"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar once carrying 10+ gems (or late, or nothing else to do), else living non-monolith camp groups (monoliths only after round 1000)')
def goals() -> Tiles:
    alt = near(tile(-5, -5), 0)
    if gems() > 0:
        for a in altars() - locked_altars():
            alt = alt | near(a, 1)
        if gems() >= 10 or round() > 1850:
            return alt
    acc = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    late = round() >= 1000
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if late or size(gt & mono) == 0:
                acc = acc | gt
    if size(acc) == 0 and gems() > 0:
        return alt
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields)')
def progress(t: Tile) -> Num:
    if LOW:
        return at(HF, me().pos) - at(HF, t)
    return at(GF, me().pos) - at(GF, t)

@gene('Z4a', 'compute the goal field once per turn; retreat home earlier (40%, or 50% when carrying many gems) with hysteresis; home field cached once', parents=['s4'])
def update() -> None:
    hf = me().health_frac
    if LOW:
        if hf > 0.9:
            LOW = False
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    if LOW:
        if not HSET:
            HF = field(my_spawn())
            HSET = True
    else:
        GF = goal_field()

@gene('Z4b', 'value of casting an ability option', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 75
            if o.unit.is_camp and gems() == 0:
                return 55
        return 0
    if k == AB_SHIELD:
        if hf < 0.7 and count_units(enemies()) > 0:
            return 72
        return 0
    if k == AB_HEAL:
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile) and hf > 0.5:
            return 45 if progress(o.tile) >= 2 else 0
        return 0
    return 0
