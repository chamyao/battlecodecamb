"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False
GSIG: Num = -1
GAGE: Num = 0
ENEAR4: Bool = False
ENEAR5: Bool = False
EWEAK: Bool = False
AWAKE2: Bool = False
BANK: Bool = False
HAD: Num = -1
ERECALL: Bool = False
WEAKT: Tiles = None

@gene('Z400a', 'value of doing this option now: meta draft, treasure shards then strength (bruiser) shards once treasure is stacked, safe recall when retreating, finish low enemies (prefer gem carriers; ranged retreaters only finish nearly dead ones), attack camps while not banking (cached), keep hitting awake camps that fight us; when retreating or banking near enemies, prefer progressing steps away from enemy champions', parents=['Z212a', 'Z284a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        if o.item == 6:
            return 100
        if items_owned(6) >= 10 and item_strength(o.item) > 0:
            return 40 + item_strength(o.item)
        return 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if LOW and me().attack_range > 1 and o.unit.health_frac > 0.25:
                return 0
            return 80 + 10 * (1 - o.unit.health_frac) + min(8, unit_gems(o.unit) / 10)
        if LOW:
            return 0
        if not BANK:
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.is_camp and is_awake(o.unit) and me().health_frac > 0.35:
            return 50
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return 49 + p - step_danger(o.tile)
    return 0

@gene('Z147a', 'skip listing option kinds the policy never values or cannot use this turn (wards, locks, cancel, buys off-shop, tribute without gems, attacks/moves when unable) to save fuel', parents=['Z103a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop()
    if kind == TRIBUTE:
        return gems() > 0
    if kind == ATTACK:
        return can_attack()
    if kind == MOVE:
        return can_move()
    return True

@gene('Z105a', 'draft preference in the order of the top ladder drafts (Vesper Vale, Heart of Ruin, Marcella, Vendetta, Ryth), slight bonus for a champion we do not yet have', parents=['s1'])
def pick_value(c: Num) -> Num:
    v = 1
    if c == VESPER_VALE:
        v = 6
    elif c == HEART_OF_RUIN:
        v = 5.5
    elif c == MARCELLA:
        v = 4
    elif c == VENDETTA:
        v = 3
    elif c == RYTH:
        v = 2
    if not picked_by_us(c):
        v += 0.25
    return v

@gene('Z30b', 'whether I should head to an altar with my gems now (cached once per turn in update)', parents=['s2'])
def banking() -> Bool:
    return BANK

@gene('Z212b', 'where to walk: an altar when banking, else a cleared group to capture, else gem- or (before round 1200) gold-carrying non-monolith groups (any group early or when none carry loot), else explore camp spawns', parents=['Z30c'])
def goals() -> Tiles:
    if banking():
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    rich = near(tile(-5, -5), 0)
    ready = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    early = round() < 300
    goldok = round() < 1200
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(gt & mono) == 0:
                acc = acc | gt
                if group_gems(g) > 0 or (goldok and group_gold(g) > 0):
                    rich = rich | gt
                if group_reward(g):
                    ready = ready | gt
    if size(ready) > 0:
        return ready
    if not early and size(rich) > 0:
        return rich
    if size(acc) == 0 and gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
    if size(acc) == 0:
        acc = camp_spawns() - mono
    return acc

@gene('s3', 'distance field to the given goals')
def goal_field(g: Tiles) -> Field:
    return field(g)

@gene('Z107a', 'cheap fingerprint of a tile set (size plus position-mixed sum, fewer collisions) so the goal field is rebuilt only when goals change', parents=['s3'])
def goal_signature(g: Tiles) -> Num:
    return size(g) * 104729 + sum(t.x * 211 + t.y * 3 + t.x * t.y for t in g)

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields), with a tiny bonus for landing near the goal; 0 when either end is unreachable')
def progress(t: Tile) -> Num:
    f = HF if LOW else GF
    a = at(f, me().pos)
    b = at(f, t)
    if a >= 100000000 or b >= 100000000:
        return 0
    d = a - b
    if d > 0:
        return d + 0.1 / (1 + b)
    return d

@gene('Z299a', 'small penalty for stepping near enemy champions while retreating or banking with enemies close (only evaluated when the cached near-enemy flag is set)', parents=['Z212a'])
def step_danger(t: Tile) -> Num:
    if not ENEAR5:
        return 0
    if not (LOW or BANK):
        return 0
    d = min((dist(u.pos, t) for u in enemies() if u.is_champion), default=99)
    if d >= 5:
        return 0
    return 0.15 * (5 - d)

@gene('Z400b', 'per-turn caches: home field and home-altar distance once per game, threat flags incl. range-scaled recall threat and tiles next to weak enemy champions, banking with hysteresis; retreat with hysteresis; goal field rebuilt only on goal change or every 6 turns, skipped while channeling', parents=['Z4a', 'Z284b'])
def update() -> None:
    hf = me().health_frac
    mp = me().pos
    if not HSET:
        HF = field(my_spawn())
        HSET = True
    if HAD < 0:
        HAD = home_altar_dist(mp)
    ENEAR4 = False
    ENEAR5 = False
    EWEAK = False
    ERECALL = False
    WEAKT = WEAKT - WEAKT
    for u in enemies():
        if u.is_champion:
            d = dist(u.pos, mp)
            if d <= 5:
                ENEAR4 = True
                ENEAR5 = True
            elif d <= 6:
                ENEAR5 = True
            if d <= 3 + u.attack_range:
                ERECALL = True
            if u.health_frac < 0.35 and d <= 7:
                EWEAK = True
                WEAKT = WEAKT | near(u.pos, 1)
    AWAKE2 = any(is_awake(c) and dist(c.pos, mp) <= 3 for c in camps())
    BANK = bank_now()
    if LOW:
        if hf > 0.9:
            LOW = False
            GSIG = -1
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    if not LOW:
        if channeling():
            return
        g = goals()
        sig = goal_signature(g)
        GAGE += 1
        if sig != GSIG or GAGE >= 6:
            GF = goal_field(g)
            GSIG = sig
            GAGE = 0

@gene('Z334a', 'banking rule computed once per turn with hysteresis (keep heading to an altar once committed), threshold scaled by altar distance, winning tribute, late game, hurt while carrying a real bag (any bag when badly hurt), or a small bag with an altar close by', parents=['Z286a'])
def bank_now() -> Bool:
    g = gems()
    if g <= 0:
        return False
    if team_gems() + g >= 1000:
        return True
    if BANK and g >= 3:
        return True
    mp = me().pos
    a = nearest(altars(), mp)
    d = 99
    if valid(a):
        d = dist(a, mp)
    lim = 15
    if d > 25:
        lim = 20
    if g >= lim:
        return True
    if g >= 8 and round() > 1500:
        return True
    if round() > 1800:
        return True
    hf = me().health_frac
    if hf < 0.6 and g >= 3:
        return True
    if hf < 0.45:
        return True
    if g >= 5 and d <= 6:
        return True
    if g >= 10 and d <= 10:
        return True
    return False

@gene('Z400c', 'cast value using cached threat flags: stun tributers, finish low enemy champions, CC to escape when retreating or protecting a bag, focus damaged camps unless banking (AoE prefers clustered camps), while retreating only finish an almost-dead adjacent awake camp, shield in fights / vs awake camps / when low under range-scaled threat, heal lowest ally, escape dash by walking distance home, dash toward goals/home, dash onto cached weak-enemy tiles', parents=['Z147b', 'Z284c'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    mp = m.pos
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if k == AB_CC and is_tributing(o.unit):
                    return 95
                if o.unit.health_frac < 0.4:
                    return 85 + 10 * (1 - o.unit.health_frac)
                if k == AB_CC and (LOW or (BANK and gems() >= 20)):
                    return 88
                return 75 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                bonus = 4 * (1 - o.unit.health_frac)
                if LOW:
                    if is_awake(o.unit) and dist(o.unit.pos, mp) <= 2 and o.unit.health_frac < 0.3:
                        return 55 + bonus
                    return 0
                extra = 0
                if k == AB_AOE:
                    r = slot_radius(o.slot)
                    tp = o.unit.pos
                    extra = min(6, 2 * count(dist(c.pos, tp) <= r and c != o.unit for c in camps()))
                if not BANK:
                    return 55 + 10 * (1 - o.unit.health_frac) + extra
                if is_awake(o.unit) and hf > 0.35:
                    if dist(o.unit.pos, mp) <= 2:
                        return 53 + bonus + extra
                    return 50 + extra
        return 0
    if k == AB_SHIELD:
        if ENEAR4:
            return 72
        if hf < 0.8 and AWAKE2:
            return 72
        if LOW and (ENEAR5 or ERECALL):
            return 72
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 + 5 * (1 - o.unit.health_frac) if o.unit.health_frac < 0.6 else 0
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if hf < 0.4 and ENEAR5:
                gain = at(HF, mp) - at(HF, o.tile)
                if gain >= 2 and gain < 50:
                    return 80 + gain
                if not LOW:
                    return 0
            p = progress(o.tile)
            if LOW:
                return 74 + p if p >= 2 else 0
            if hf > 0.6 and EWEAK:
                if o.tile in WEAKT:
                    return 70
            if p >= 2 and (hf > 0.5 or gems() > 0):
                return 45 + p
        return 0
    return 0

@gene('Z400d', 'recall when retreating, to shop when rich and worn (more eager when very rich), or to bank faster when home sits near an altar and the altar walk is long; never if an enemy champion (range-scaled) or awake camp could interrupt it', parents=['Z50a', 'Z284d'])
def recall_value() -> Num:
    if ENEAR4 or ERECALL or AWAKE2:
        return 0
    mp = me().pos
    hd = at(HF, mp)
    if LOW:
        if hd <= 5:
            return 0
        return 90
    if hd <= 12:
        return 0
    if BANK:
        if gems() >= 12 and HAD <= 8 and at(GF, mp) > 18:
            return 80
        return 0
    g = gold()
    if g >= 210 and me().health_frac <= 0.9:
        return 85
    if g >= 120 and me().health_frac <= 0.75:
        return 85
    return 0

@gene('Z231a', 'straight-line distance from my nearest spawn tile to its nearest altar (large if none)', parents=['Z50a'])
def home_altar_dist(mp: Tile) -> Num:
    sp = nearest(my_spawn(), mp)
    if not valid(sp):
        return 1000
    a = nearest(altars(), sp)
    if not valid(a):
        return 1000
    return dist(a, sp)
