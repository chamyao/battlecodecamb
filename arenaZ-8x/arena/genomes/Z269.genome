"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False
GSIG: Num = -1
GAGE: Num = 0

@gene('Z205a', 'value of doing this option now: meta draft, treasure shards until an emblem then strength/health (bruiser) shards, safe recall when retreating, finish low enemies (retreating ranged champs keep walking unless the kill is near), attack camps while not banking, keep hitting awake camps that fight us', parents=['Z103a', 'Z167a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        if o.item == 6:
            return 100 if items_owned(6) < 5 else 0
        if items_owned(6) >= 5:
            v = item_strength(o.item) + item_health(o.item) / 20
            return 90 + v if v > 0 else 0
        return 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if LOW and me().attack_range > 1 and o.unit.health_frac > 0.25:
                return 30
            return 80 + 10 * (1 - o.unit.health_frac)
        if LOW:
            return 0
        if not banking():
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.is_camp and is_awake(o.unit) and me().health_frac > 0.35:
            return 50
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('Z171a', 'skip listing option kinds the policy never takes (wards, locks, lock purchases, cancels) and purchases when not on spawn, to save fuel', parents=['Z167a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop() and gold() >= 30
    return True

@gene('Z105a', 'draft preference following the top ladder drafts', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == HEART_OF_RUIN:
        return 6
    if c == VESPER_VALE:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z30b', 'whether I should head to an altar with my gems now: enough gems (lower bar later in the game), a winning tribute, late game, hurt while carrying, or behind late with any gems', parents=['s2'])
def banking() -> Bool:
    g = gems()
    if g <= 0:
        return False
    if g >= 15:
        return True
    if team_gems() + g >= 1000:
        return True
    r = round()
    if r > 1720:
        return True
    if r > 1200 and g >= 10:
        return True
    if r > 1500 and team_gems() + g > enemy_gems() and team_gems() <= enemy_gems():
        return True
    return me().health_frac < 0.6

@gene('Z30c', 'where to walk: an altar with enough gems, else a cleared group to capture, else a living non-monolith camp group', parents=['s2'])
def goals() -> Tiles:
    if banking():
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    ready = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(gt & mono) == 0:
                acc = acc | gt
                if group_reward(g):
                    ready = ready | gt
    if size(ready) > 0:
        return ready
    if size(acc) == 0 and gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
    return acc

@gene('s3', 'distance field to the given goals')
def goal_field(g: Tiles) -> Field:
    return field(g)

@gene('Z107a', 'cheap fingerprint of a tile set (size plus position-mixed sum, fewer collisions) so the goal field is rebuilt only when goals change', parents=['s3'])
def goal_signature(g: Tiles) -> Num:
    return size(g) * 104729 + sum(t.x * 211 + t.y * 3 + t.x * t.y for t in g)

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields), with a tiny bonus for landing near the goal; 0 when either end is unreachable')
def progress(t: Tile) -> Num:
    f = HF if LOW else GF
    a = at(f, me().pos)
    b = at(f, t)
    if a >= 100000000 or b >= 100000000:
        return 0
    d = a - b
    if d > 0:
        return d + 0.1 / (1 + b)
    return d

@gene('Z4a', 'compute the goal field only when the goal set changes (or every 6 turns); retreat home earlier (40%, or 50% when carrying many gems) with hysteresis, and also retreat below 60% when outnumbered by nearby enemy champions; home field cached once', parents=['s4'])
def update() -> None:
    hf = me().health_frac
    if LOW:
        if hf > 0.9:
            LOW = False
            GSIG = -1
    else:
        lim = 0.4
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
        elif hf < 0.6 and not channeling():
            mp = me().pos
            foes = count(u.is_champion and dist(u.pos, mp) <= 5 for u in enemies())
            if foes >= 2:
                friends = count(dist(a.pos, mp) <= 5 for a in allies())
                if foes > friends:
                    LOW = True
    if LOW:
        if not HSET:
            HF = field(my_spawn())
            HSET = True
    else:
        g = goals()
        sig = goal_signature(g)
        GAGE += 1
        if sig != GSIG or GAGE >= 6:
            GF = goal_field(g)
            GSIG = sig
            GAGE = 0

@gene('Z205b', 'cast value: stun tributers, finish low enemy champions, CC to escape when retreating, focus damaged camps unless banking, while retreating only finish an almost-dead awake adjacent camp, shield vs threats, heal lowest ally, escape dash when low, dash toward goals/home, dash onto weak enemies', parents=['Z147b', 'Z167b'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    mp = m.pos
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if k == AB_CC and is_tributing(o.unit):
                    return 95
                if o.unit.health_frac < 0.4:
                    return 85 + 10 * (1 - o.unit.health_frac)
                if k == AB_CC and LOW:
                    return 88
                return 75 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                bonus = 4 * (1 - o.unit.health_frac)
                if LOW:
                    if is_awake(o.unit) and dist(o.unit.pos, mp) <= 2 and o.unit.health_frac < 0.3:
                        return 55 + bonus
                    return 0
                if not banking():
                    return 55 + 10 * (1 - o.unit.health_frac)
                if is_awake(o.unit) and hf > 0.35:
                    if dist(o.unit.pos, mp) <= 2:
                        return 53 + bonus
                    return 50
        return 0
    if k == AB_SHIELD:
        if hf < 0.9:
            if any(u.is_champion and dist(u.pos, mp) <= 4 for u in enemies()):
                return 72
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, mp) <= 2 for c in camps()):
                return 72
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 + 5 * (1 - o.unit.health_frac) if o.unit.health_frac < 0.6 else 0
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if hf < 0.35 and not LOW:
                if any(u.is_champion and dist(u.pos, mp) <= 5 for u in enemies()):
                    home = nearest(my_spawn(), mp)
                    if valid(home):
                        gain = dist(mp, home) - dist(o.tile, home)
                        if gain >= 2:
                            return 74 + gain
                return 0
            p = progress(o.tile)
            if LOW:
                return 74 + p if p >= 2 else 0
            if hf > 0.6:
                if any(u.is_champion and u.health_frac < 0.35 and dist(u.pos, o.tile) <= 1 for u in enemies()):
                    return 70
            if p >= 2 and (hf > 0.5 or gems() > 0):
                return 45 + p
        return 0
    return 0

@gene('Z50a', 'recall when retreating (or to shop when rich and worn) if far from home and no enemy champion or awake camp close enough to interrupt it; threat radius scales with enemy attack range, rich shop recall a bit more eager', parents=['s1'])
def recall_value() -> Num:
    mp = me().pos
    hd = at(HF, mp)
    if LOW:
        if hd <= 5:
            return 0
        val = 90
    else:
        if hd <= 12 or banking():
            return 0
        g = gold()
        if g < 120:
            return 0
        if g >= 210:
            if me().health_frac > 0.9:
                return 0
        elif me().health_frac > 0.75:
            return 0
        val = 85
    if any(u.is_champion and dist(u.pos, mp) <= 3 + u.attack_range for u in enemies()):
        return 0
    if any(is_awake(u) and dist(u.pos, mp) <= 3 for u in camps()):
        return 0
    return val
