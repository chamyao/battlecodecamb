"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
HEALING: Bool = False
RECALLING: Bool = False

@gene('s1', 'value of doing this option now; do not break recalls, heal up on spawn before leaving')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        if RECALLING or HEALING:
            return 0
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if me().health_frac < 0.25 and o.unit.health_frac > 0.3:
                return 0
            return 80 + unit_gems(o.unit) / 10
        if RECALLING:
            return 0
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if RECALLING or HEALING:
            return 0
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: altar when carrying enough gems, else cleared groups to capture, else living non-monolith camps')
def goals() -> Tiles:
    if want_tribute():
        return altar_goals()
    mono = type_spawns(MONOLITH)
    late = round() > 1000
    reward = near(tile(-5, -5), 0)
    camps_acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            reward = reward | group_tiles(g)
        elif not group_respawning(g):
            camps_acc = camps_acc | group_tiles(g)
    if size(reward) > 0:
        return reward
    if not late:
        camps_acc = camps_acc - mono
    if size(camps_acc) > 0:
        return camps_acc
    if gems() > 0:
        return altar_goals()
    return camps_acc

@gene('s3', 'distance field to the goals')
def goal_field() -> Field:
    return field(goals())

@gene('Z70a', 'should I go tribute now: enough gems, late game, or hurt while carrying', parents=['s2', 's3'])
def want_tribute() -> Bool:
    g = gems()
    if g <= 0:
        return False
    if g >= 40:
        return True
    if round() > 1800:
        return True
    if me().health_frac < 0.5 and g >= 10:
        return True
    return False

@gene('Z70b', 'free altar tiles to tribute at', parents=['s2'])
def altar_goals() -> Tiles:
    acc = near(tile(-5, -5), 0)
    for a in altars() - locked_altars():
        acc = acc | near(a, 1)
    return acc

@gene('s4', 'how much closer a step brings me to the goals (cached field)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z4a', 'compute the goal distance field once per turn; note recall/healing state', parents=['s4'])
def update() -> None:
    GF = goal_field()
    RECALLING = is_recalling(me())
    HEALING = me().health_frac < 0.9 and (me().pos in my_spawn())

@gene('Z4b', 'value of casting an ability option: focus low enemies, keep fighting awake camps, shield in any fight, dash toward goals', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 75 + 20 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0:
                    return 55 + 10 * (1 - o.unit.health_frac)
                if is_awake(o.unit) and hf > 0.35:
                    return 50
        return 0
    if k == AB_SHIELD:
        if hf < 0.95:
            if count(dist(u.pos, me().pos) <= 4 for u in enemies()) > 0:
                return 72
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, me().pos) <= 2 for c in camps()):
                return 70
        return 0
    if k == AB_HEAL:
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile) and hf > 0.5:
            return 45 if progress(o.tile) >= 2 else 0
        return 0
    return 0
