"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
GSIG: Num = -1

@gene('s1', 'value of doing this option now: finish low enemies, keep hitting awake camps that fight us')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80 + 10 * (1 - o.unit.health_frac)
        if gems() == 0:
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.is_camp and is_awake(o.unit) and me().health_frac > 0.35:
            return 50
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene("s2", "where to walk: an altar with gems, else a living camp group")
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreat to spawn to heal when low, routing around visible enemies')
def goal_field() -> Field:
    m = me()
    home = my_spawn()
    if m.health_frac < 0.4 and not (m.pos in home):
        foes = enemy_tiles()
        if size(foes) > 0:
            return field_avoid(home, foes, home - home)
        return field(home)
    if m.health_frac < 0.8 and m.pos in home:
        return field(home)
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals (cached field)')
def progress(t: Tile) -> Num:
    return at(GF, me().pos) - at(GF, t)

@gene('Z4a', 'compute the goal distance field only when the goal set or mode changes; skip work while dead', parents=['s4'])
def update() -> None:
    if alive():
        sig = goal_sig()
        if sig != GSIG or sig < 0:
            GF = goal_field()
            GSIG = sig

@gene('Z101a', 'signature of the current goal set and mode; negative means always recompute (threatened retreat)', parents=['s3'])
def goal_sig() -> Num:
    m = me()
    home = my_spawn()
    if m.health_frac < 0.4 and not (m.pos in home):
        if count_units(enemies()) > 0:
            return -1
        return 1
    if m.health_frac < 0.8 and m.pos in home:
        return 1
    g = goals()
    return 2 + size(g) * 7 + sum(t.x * 131 + t.y * 3 + 1 for t in g)

@gene('Z4b', 'value of casting an ability option: focus low enemies, keep fighting awake camps, shield in any fight, dash toward goals, or dash home to escape when low and threatened', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 75 + 20 * (1 - o.unit.health_frac)
            if o.unit.is_camp:
                if gems() == 0:
                    return 55 + 10 * (1 - o.unit.health_frac)
                if is_awake(o.unit) and hf > 0.35:
                    return 50
        return 0
    if k == AB_SHIELD:
        if hf < 0.95:
            if any(dist(u.pos, m.pos) <= 4 for u in enemies()):
                return 72
            if hf < 0.7 and any(is_awake(c) and dist(c.pos, m.pos) <= 2 for c in camps()):
                return 70
        return 0
    if k == AB_HEAL:
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if hf < 0.35:
                if any(dist(u.pos, m.pos) <= 5 for u in enemies()):
                    home = nearest(my_spawn(), m.pos)
                    if valid(home):
                        gain = dist(m.pos, home) - dist(o.tile, home)
                        if gain >= 2:
                            return 74 + gain
                return 0
            p = progress(o.tile)
            if p >= 2 and (hf > 0.5 or gems() > 0):
                return 45 + p
        return 0
    return 0
