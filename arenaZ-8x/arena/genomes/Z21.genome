"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None

@gene('s1', 'value of doing this option now')
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        return 49 + p if p > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems, else a living non-monolith camp group (monoliths only if nothing else)')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    mono = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if count(spawn_type(t) == MONOLITH for t in gt) > 0:
                mono = mono | gt
            else:
                acc = acc | gt
    if size(acc) == 0:
        return mono
    return acc

@gene("s3", "distance field to the goals")
def goal_field() -> Field:
    return field(goals())

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields)')
def progress(t: Tile) -> Num:
    if LOW:
        return at(HF, me().pos) - at(HF, t)
    return at(GF, me().pos) - at(GF, t)

@gene('Z4a', 'compute the goal field once per turn; when badly hurt, switch to a field toward home to heal (hysteresis)', parents=['s4'])
def update() -> None:
    hf = me().health_frac
    if LOW:
        if hf > 0.9:
            LOW = False
    else:
        if hf < 0.3 and not channeling():
            LOW = True
    if LOW:
        HF = field(my_spawn())
    else:
        GF = goal_field()

@gene('Z4b', 'value of casting an ability option; dash also used to flee home when retreating', parents=['s1'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    hf = me().health_frac
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                return 75
            if o.unit.is_camp and gems() == 0:
                return 55
        return 0
    if k == AB_SHIELD:
        if hf < 0.7 and count_units(enemies()) > 0:
            return 72
        return 0
    if k == AB_HEAL:
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if LOW:
                return 60 if progress(o.tile) >= 2 else 0
            if hf > 0.5:
                return 45 if progress(o.tile) >= 2 else 0
        return 0
    return 0
