"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
LOW: Bool = False
HF: Field = None
HSET: Bool = False
GSIG: Num = -1
GAGE: Num = 0
ENEAR4: Bool = False
ENEAR5: Bool = False
EWEAK: Bool = False
AWAKE2: Bool = False
BANK: Bool = False

@gene('Z443a', 'value of doing this option now: treasure shards first then strength (bruiser) shards, safe recall when retreating, finish low enemies (prefer gem carriers; ranged retreaters only finish nearly dead ones), attack camps while not banking, keep hitting awake camps that fight us; when retreating or banking near enemies, prefer progressing steps that keep away from enemy champions', parents=['Z212a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        if o.item == 6:
            return 100 if items_owned(6) < 5 else 0
        if items_owned(6) >= 5 and item_strength(o.item) > 0:
            return 90 + min(item_strength(o.item), 9)
        return 0
    if o.kind == RECALL:
        return recall_value()
    if o.kind == ATTACK:
        if o.unit.is_champion:
            if LOW and me().attack_range > 1 and o.unit.health_frac > 0.25:
                return 0
            return 80 + 10 * (1 - o.unit.health_frac) + min(8, unit_gems(o.unit) / 10)
        if LOW:
            return 0
        if not banking():
            return 60 + 5 * (1 - o.unit.health_frac)
        if o.unit.is_camp and is_awake(o.unit) and me().health_frac > 0.35:
            return 50
        return 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        p = progress(o.tile)
        if p <= 0:
            return 0
        return 49 + p - step_danger(o.tile)
    return 0

@gene('Z147a', 'skip listing option kinds the policy never values or cannot use this turn (wards, locks, cancel, buys off-shop, tribute without gems, attacks/moves when unable) to save fuel', parents=['Z103a'])
def consider(kind: Num) -> Bool:
    if kind == WARD or kind == LOCK or kind == BUY_LOCK or kind == CANCEL:
        return False
    if kind == BUY:
        return can_shop()
    if kind == TRIBUTE:
        return gems() > 0
    if kind == ATTACK:
        return can_attack()
    if kind == MOVE:
        return can_move()
    return True

@gene('Z30b', 'whether I should head to an altar with my gems now (cached once per turn in update)', parents=['s2'])
def banking() -> Bool:
    return BANK

@gene('Z212b', 'where to walk: an altar when banking, else a cleared group to capture, else loot groups (gem groups preferred after round 600, gold only before 1200), any group early or when none carry loot, else explore camp spawns; golem groups are skipped before round 500 unless already cleared', parents=['Z30c'])
def goals() -> Tiles:
    if banking():
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    rich = near(tile(-5, -5), 0)
    gemrich = near(tile(-5, -5), 0)
    ready = near(tile(-5, -5), 0)
    mono = type_spawns(MONOLITH)
    r = round()
    early = r < 300
    goldok = r < 1200
    avoidgolem = r < 500
    golem = type_spawns(GOLEM)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(gt & mono) == 0:
                rw = group_reward(g)
                if rw:
                    ready = ready | gt
                if rw or not avoidgolem or size(gt & golem) == 0:
                    acc = acc | gt
                    if group_gems(g) > 0:
                        gemrich = gemrich | gt
                        rich = rich | gt
                    elif goldok and group_gold(g) > 0:
                        rich = rich | gt
    if size(ready) > 0:
        return ready
    if r > 600 and size(gemrich) > 0:
        return gemrich
    if not early and size(rich) > 0:
        return rich
    if size(acc) == 0 and gems() > 0:
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
    if size(acc) == 0:
        acc = camp_spawns() - mono
        if avoidgolem:
            ng = acc - golem
            if size(ng) > 0:
                acc = ng
    return acc

@gene('s3', 'distance field to the given goals')
def goal_field(g: Tiles) -> Field:
    return field(g)

@gene('Z107a', 'cheap fingerprint of a tile set (size plus two mixed coordinate sums) so the goal field is rebuilt only when goals change, with fewer collisions between different sets', parents=['s3'])
def goal_signature(g: Tiles) -> Num:
    return size(g) * 7919 + sum(t.x * 131 + t.y * 17 + t.x * t.y * 3 for t in g)

@gene('s4', 'how much closer a step brings me to the goals, or home when retreating (cached fields); 0 when either end is unreachable')
def progress(t: Tile) -> Num:
    f = HF if LOW else GF
    a = at(f, me().pos)
    b = at(f, t)
    if a >= 100000000 or b >= 100000000:
        return 0
    return a - b

@gene('Z299a', 'small penalty for stepping near enemy champions while retreating or banking with enemies close (only evaluated when the cached near-enemy flag is set)', parents=['Z212a'])
def step_danger(t: Tile) -> Num:
    if not ENEAR5:
        return 0
    if not (LOW or BANK):
        return 0
    d = min((dist(u.pos, t) for u in enemies() if u.is_champion), default=99)
    if d >= 5:
        return 0
    return 0.15 * (5 - d)

@gene('Z443b', 'skip all work while dead; home field cached once; cache threat flags and banking decision once per turn; retreat home at 40% (45% with 20+ gems, 50% with 40+) with hysteresis; goal field rebuilt only when goals change (or every 6 turns); skip goal work while channeling', parents=['Z4a'])
def update() -> None:
    if not alive():
        return
    if not HSET:
        HF = field(my_spawn())
        HSET = True
    hf = me().health_frac
    mp = me().pos
    ENEAR4 = False
    ENEAR5 = False
    EWEAK = False
    for u in enemies():
        if u.is_champion:
            d = dist(u.pos, mp)
            if d <= 5:
                ENEAR4 = True
                ENEAR5 = True
            elif d <= 6:
                ENEAR5 = True
            if u.health_frac < 0.35 and d <= 7:
                EWEAK = True
    AWAKE2 = any(is_awake(c) and dist(c.pos, mp) <= 3 for c in camps())
    BANK = bank_now()
    if LOW:
        if hf > 0.9:
            LOW = False
            GSIG = -1
    else:
        lim = 0.4
        if gems() >= 20:
            lim = 0.45
        if gems() >= 40:
            lim = 0.5
        if hf < lim and not channeling():
            LOW = True
    if not LOW:
        if channeling():
            return
        g = goals()
        sig = goal_signature(g)
        GAGE += 1
        if sig != GSIG or GAGE >= 6:
            GF = goal_field(g)
            GSIG = sig
            GAGE = 0

@gene('Z443c', 'full banking rule computed once per turn: a big bag (smaller later in the game), a winning tribute, a cheap top-up when an altar is close, a worthwhile bag with an enemy champion nearby, or hurt while carrying', parents=['Z286a', 'Z30b'])
def bank_now() -> Bool:
    g = gems()
    if g <= 0:
        return False
    if team_gems() + g >= 1000:
        return True
    r = round()
    if g >= 20:
        return True
    if g >= 15 and r > 600:
        return True
    if g >= 12 and r > 1000:
        return True
    if g >= 6 and r > 1500:
        return True
    if r > 1800:
        return True
    hf = me().health_frac
    if g >= 5:
        a = nearest(altars(), me().pos)
        if valid(a) and dist(a, me().pos) <= 5:
            return True
    if g >= 10 and ENEAR4:
        return True
    if g >= 8:
        return hf < 0.75
    return hf < 0.55

@gene('Z147b', 'cast value using per-turn cached threat flags: stun tributers, finish low enemy champions, CC to escape when retreating, focus damaged camps unless banking, shield on cooldown in champion fights or hurt vs awake camps, heal lowest ally, escape dash when low, dash toward goals/home, dash onto weak enemies', parents=['Z126a', 'Z4b'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    m = me()
    hf = m.health_frac
    mp = m.pos
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(o.unit):
            if o.unit.is_champion and o.unit.is_enemy:
                if k == AB_CC and is_tributing(o.unit):
                    return 95
                if o.unit.health_frac < 0.4:
                    return 85 + 10 * (1 - o.unit.health_frac)
                if k == AB_CC and LOW:
                    return 88
                return 75 + 10 * (1 - o.unit.health_frac)
            if o.unit.is_camp and not LOW:
                bonus = 4 * (1 - o.unit.health_frac)
                if not BANK:
                    return 55 + 10 * (1 - o.unit.health_frac)
                if is_awake(o.unit) and hf > 0.35:
                    if dist(o.unit.pos, mp) <= 2:
                        return 53 + bonus
                    return 50
        return 0
    if k == AB_SHIELD:
        if ENEAR4:
            return 72
        if hf < 0.8 and AWAKE2:
            return 72
        return 0
    if k == AB_HEAL:
        if exists(o.unit) and not o.unit.is_enemy:
            return 72 + 5 * (1 - o.unit.health_frac) if o.unit.health_frac < 0.6 else 0
        return 72 if hf < 0.6 else 0
    if k == AB_DASH:
        if valid(o.tile):
            if hf < 0.35 and not LOW:
                if ENEAR5:
                    home = nearest(my_spawn(), mp)
                    if valid(home):
                        gain = dist(mp, home) - dist(o.tile, home)
                        if gain >= 2:
                            return 74 + gain
                return 0
            p = progress(o.tile)
            if LOW:
                return 74 + p if p >= 2 else 0
            if hf > 0.6 and EWEAK:
                if any(u.is_champion and u.health_frac < 0.35 and dist(u.pos, o.tile) <= 1 for u in enemies()):
                    return 70
            if p >= 2 and (hf > 0.5 or gems() > 0):
                return 45 + p
        return 0
    return 0

@gene('Z443d', 'recall when retreating, to shop when rich and worn or very rich and far from home, or to bank faster when home sits near an altar and the walk to an altar is long; never if an enemy champion or awake camp is close enough to interrupt it', parents=['Z50a'])
def recall_value() -> Num:
    mp = me().pos
    hd = at(HF, mp)
    if LOW:
        if hd <= 5:
            return 0
        val = 90
    else:
        if hd <= 12:
            return 0
        val = 0
        if banking():
            if gems() >= 12 and at(GF, mp) > 18 and home_altar_dist(mp) <= 8:
                val = 80
        else:
            g = gold()
            if (g >= 120 and me().health_frac <= 0.75) or (g >= 300 and hd > 18):
                val = 85
        if val <= 0:
            return 0
    if ENEAR4:
        return 0
    if AWAKE2:
        return 0
    return val

@gene('Z231a', 'straight-line distance from my nearest spawn tile to its nearest altar (large if none)', parents=['Z50a'])
def home_altar_dist(mp: Tile) -> Num:
    sp = nearest(my_spawn(), mp)
    if not valid(sp):
        return 1000
    a = nearest(altars(), sp)
    if not valid(a):
        return 1000
    return dist(a, sp)
