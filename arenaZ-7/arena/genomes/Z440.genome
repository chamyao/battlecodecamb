"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
ECT: Tiles = None

@gene("s1", "value of doing this option now; uses abilities (damage/cc/shield/heal/dash); champion attacks first", parents=["s1"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_enemy and o.unit.is_champion:
                    return 113
                if o.unit.is_camp and gems() == 0:
                    return 97
            return 0
        if k == AB_SHIELD:
            return 84 if enemy_close() or me().health_frac < 0.6 else 0
        if k == AB_HEAL:
            return 88 if me().health_frac < 0.4 else 0
        if k == AB_DASH:
            if valid(o.tile) and me().health_frac > 0.4:
                return 44 if progress(o.tile) > 0.8266 else 0
            return 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 47 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: altar with gems, else cleared-camp capture tiles, else living gem-bearing camp groups, then gold camps, then any living group", parents=["s2", "Z38a"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "cached per-turn distance field to the goals, routed around walls, holes, threatened tiles and non-goal camps (from update); falls back to spawn", parents=["s3"])
def goal_field() -> Field:
    return GF

@gene('s4', 'distance gained toward goals (doubled when carrying gems), robust to unreachable field values, minus a health-scaled threat-zone penalty, doubled when retreating', parents=['s4', 'Z109a'])
def progress(t: Tile) -> Num:
    gf = goal_field()
    cur = at(gf, me().pos)
    nxt = at(gf, t)
    gain = 0
    if cur >= 100000000 and nxt >= 100000000:
        gain = 0
    elif cur >= 100000000:
        gain = 3
    elif nxt >= 100000000:
        gain = -3
    else:
        gain = cur - nxt
    if gems() > 0:
        gain = gain * 2
    risk = 1 if t in enemy_champ_tiles() else 0
    penalty = 2 + 6 * (1 - me().health_frac)
    if gems() > 0:
        penalty += 4
    if RETREAT:
        penalty = penalty * 2
    return gain - penalty * risk

@gene('Z109a', 'threat zone: cached ECT plus a radius-2 ring around each healthy visible enemy champion, so progress penalises tiles within striking distance', parents=['s4', 'Z109a'])
def enemy_champ_tiles() -> Tiles:
    z = ECT
    for u in enemies():
        if u.is_champion and u.health_frac > 0.1:
            z = z | near(u.pos, 2)
    return z

@gene("Z109b", "true when a threatening enemy champion (health above 10%, not recalling) could reach within 7 + its range of me next turn", parents=["Z109b"])
def enemy_close() -> Bool:
    p = me().pos
    return any(u.is_champion and u.health_frac > 0.1 and dist(u.pos, p) <= 7 + u.attack_range and not is_recalling(u) for u in enemies())

@gene("Z12a", "per-turn threat zone cache; goal field routed with field_avoid, threat zones and non-goal camps avoided unless retreating with gems; retreat home with hysteresis when hurt or carrying gems while hurt, or when no goals exist; resume goals once healed", parents=["s3", "s2", "Z12a"])
def update() -> None:
    if alive():
        ECT = compute_threat()
        h = me().health_frac
        if h < 0.35 or (gems() >= 15 and h < 0.6) or (gems() > 0 and h < 0.45):
            RETREAT = True
        elif h > 0.85:
            RETREAT = False
        g = goals()
        danger = walls() | holes()
        if not RETREAT or gems() == 0:
            danger = danger | ECT
            danger = danger | (camp_tiles() - g)
        stop = near(tile(-5, -5), 0)
        if RETREAT or size(g) == 0:
            GF = field_avoid(my_spawn(), danger, stop)
        else:
            GF = field_avoid(g, danger, stop)

@gene("Z455a", "compute the enemy champion threat zone once per turn: tiles a visible, non-recalling enemy champion that is not clearly weaker than me can reach and hit next turn (healthy champions include move speed)", parents=["Z109a", "Z109b", "Z455a"])
def compute_threat() -> Tiles:
    m = me()
    ts = near(m.pos, 0) - near(m.pos, 0)
    for u in enemies():
        if u.is_champion and u.health_frac > 0.1 and not is_recalling(u):
            weak = u.health < m.health * 0.4 and u.strength <= m.strength
            if not weak:
                if u.health_frac > 0.3:
                    ts = ts | near(u.pos, u.attack_range + u.move_speed)
                else:
                    ts = ts | near(u.pos, u.attack_range + 1)
    return ts
