"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
THREAT: Tiles = None

@gene('Z466a', 'value of doing this option now; uses abilities (damage/cc/shield/heal/dash); champion attacks first; champion-target casts high, tribute ranked above recall-free actions, dash only when reasonably healthy; never wakes a sleeping monolith', parents=['s1', 'Z466a', 'Z676b'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_enemy and o.unit.is_champion:
                    return 113
                if o.unit.is_camp and gems() == 0:
                    return 0 if bad_camp(o.unit) else 97
            return 0
        if k == AB_SHIELD:
            return 84 if enemy_close() or me().health_frac < 0.6 else 0
        if k == AB_HEAL:
            return 88 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and me().health_frac > 0.45:
                return 44 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        if gems() == 0:
            return 0 if bad_camp(o.unit) else 98
        return 0
    if o.kind == TRIBUTE:
        return 94
    if o.kind == MOVE:
        return 43 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: altar with gems, else cleared-camp capture tiles, else living non-monolith gem camps, then gold camps, then any non-monolith living group, then anything", parents=["s2", "Z38a"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    mono = type_spawns(MONOLITH)
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            gt = group_tiles(g)
            if size(gt & mono) == 0:
                acc = acc | gt
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            gt = group_tiles(g)
            if size(gt & mono) == 0:
                acc = acc | gt
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            if size(gt & mono) == 0:
                acc = acc | gt
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'cached per-turn distance field to the goals, routed around walls, holes and threatened tiles (from update); falls back to spawn', parents=['s3'])
def goal_field() -> Field:
    return GF

@gene('s4', 'distance gained toward goals (capped) minus a health-scaled threat penalty; the penalty shrinks when allies outnumber nearby threats; heavier when retreating', parents=['s4', 'Z109a'])
def progress(t: Tile) -> Num:
    gf = goal_field()
    gain = at(gf, me().pos) - at(gf, t)
    if gain > 6:
        gain = 6
    if gain < 0:
        gain = 0
    if not (t in enemy_champ_tiles()):
        return gain
    hf = me().health_frac
    penalty = 10
    if hf > 0.7:
        penalty = 2
    elif hf > 0.4:
        penalty = 4
    mates = count(dist(a.pos, me().pos) <= 4 for a in allies()) - 1
    if mates >= 1 and hf > 0.5:
        penalty = penalty / 2
    if RETREAT:
        penalty = 10
    return gain - penalty

@gene('Z109a', 'threat zone: healthy champions (above 70%) ignore the cached threat zone so they press toward goals; hurt ones avoid it', parents=['s4', 'Z109a'])
def enemy_champ_tiles() -> Tiles:
    if me().health_frac > 0.7 and not RETREAT:
        return THREAT - THREAT
    return THREAT

@gene('Z109b', 'true when a threatening enemy champion (health above 10%, not recalling) could reach within 7 + attack range of me next turn', parents=['s4', 'Z109b'])
def enemy_close() -> Bool:
    p = me().pos
    return any(u.is_champion and u.health_frac > 0.1 and dist(u.pos, p) <= 7 + u.attack_range and not is_recalling(u) for u in enemies())

@gene('Z12a', 'per-turn goal field routed with field_avoid; threat zone computed once per turn into a keep; threat zones avoided only when not retreating; walk home with hysteresis when hurt or carrying gems while hurt, or when no goals exist; resume goals at 75% health', parents=['s3', 's2', 'Z12a', 'Z400a'])
def update() -> None:
    if alive():
        THREAT = compute_threat()
        h = me().health_frac
        if h < 0.4 or (gems() >= 10 and h < 0.6) or (gems() > 0 and h < 0.45):
            RETREAT = True
        elif h > 0.75:
            RETREAT = False
        danger = walls() | holes()
        if not RETREAT:
            danger = danger | THREAT
        stop = near(tile(-5, -5), 0)
        g = goals()
        if RETREAT or size(g) == 0:
            GF = field_avoid(my_spawn(), danger, stop)
        else:
            GF = field_avoid(g, danger, stop)

@gene('Z676b', 'true when attacking this camp unit is unsafe: a sleeping monolith, or any sleeping camp while below half health', parents=['s1'])
def bad_camp(u: Unit) -> Bool:
    if not u.is_camp:
        return False
    if is_awake(u):
        return False
    if spawn_type(camp_spawn(u)) == MONOLITH:
        return True
    return me().health_frac < 0.5

@gene('Z512a', 'compute threat zone once per turn: tiles a nearby enemy champion (health above 20%, not recalling, within 14 tiles) can walk to and hit next turn', parents=['Z109a', 'Z400b', 'Z455a'])
def compute_threat() -> Tiles:
    p = me().pos
    ts = near(p, 0) - near(p, 0)
    for u in enemies():
        if u.is_champion and u.health_frac > 0.2 and dist(u.pos, p) <= 14 and not is_recalling(u):
            ts = ts | near(u.pos, u.move_speed + u.attack_range + 0.6314)
    return ts
