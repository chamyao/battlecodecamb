"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
ECT: Tiles = None

@gene("s1", "value of doing this option now; uses abilities (damage/cc/shield/heal/dash); champion attacks first", parents=["s1"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.4 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_enemy and o.unit.is_champion:
                    return 113
                if o.unit.is_camp and gems() == 0:
                    return 97
            return 0
        if k == AB_SHIELD:
            return 84 if enemy_close() or me().health_frac < 0.6 else 0
        if k == AB_HEAL:
            return 88 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and me().health_frac > 0.4:
                return 44 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 43 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: altar with gems, else cleared-camp capture tiles, else living gem-bearing camp groups, then gold camps, then any living group", parents=["s2", "Z38a"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "cached per-turn distance field to the goals, routed around walls, holes and threatened tiles (from update); falls back to spawn", parents=["s3"])
def goal_field() -> Field:
    return GF

@gene('s4', 'distance gained toward goals (capped by health) minus a health-scaled threat penalty per enemy champion covering the tile, shrinking when allies outnumber them', parents=['s4', 'Z109a'])
def progress(t: Tile) -> Num:
    gf = goal_field()
    gain = at(gf, me().pos) - at(gf, t)
    hf = me().health_frac
    cap = 6 if hf > 0.7 else (4 if hf > 0.4 else 2)
    if gain > cap:
        gain = cap
    if not (t in enemy_champ_tiles()):
        return gain
    threats = count(u.is_champion and u.health_frac > 0.1125 and not is_recalling(u) and dist(u.pos, t) <= u.attack_range + 1 for u in enemies())
    if threats < 1:
        threats = 1
    penalty = 2 if hf > 0.7 else (4 if hf > 0.4 else 10)
    if gems() > 0 and hf <= 0.7:
        penalty += 2
    mates = count(dist(a.pos, me().pos) <= 4 for a in allies()) - 1
    if mates >= threats:
        penalty = penalty / 2
    return gain - penalty * threats

@gene('Z109a', 'threat zone: compute_threat plus a 2-tile buffer around enemy champions within 8 tiles (dash/ability reach); recomputed per call', parents=['s4', 'Z109a'])
def enemy_champ_tiles() -> Tiles:
    ts = compute_threat()
    m = me()
    for u in enemies():
        if u.is_champion and not is_recalling(u) and dist(u.pos, m.pos) <= 8:
            ts = ts | near(u.pos, u.attack_range + u.move_speed + 2)
    return ts - near(m.pos, 0)

@gene("Z109b", "true when an enemy champion threatens to reach me within 5 tiles, or a visible enemy champion is within 6", parents=["s4", "Z109b"])
def enemy_close() -> Bool:
    if any(dist(t, me().pos) <= 5 for t in enemy_champ_tiles()):
        return True
    return any(u.is_champion and dist(u.pos, me().pos) <= 6 for u in enemies())

@gene("Z12a", "per-turn threat zone cache plus goal field routed with field_avoid; threat zones avoided only when not retreating; walk home with hysteresis when badly hurt, carrying gems while hurt, or an enemy is close and health is below 60%, or when no goals exist; resume goals once healed", parents=["s3", "s2", "Z12a"])
def update() -> None:
    if alive():
        ECT = compute_threat()
        h = me().health_frac
        if h < 0.35 or (gems() >= 20 and h < 0.6) or (gems() > 0 and h < 0.45) or (enemy_close() and h < 0.6):
            RETREAT = True
        elif h > 0.9:
            RETREAT = False
        danger = walls() | holes()
        if not RETREAT:
            danger = danger | ECT
        stop = near(tile(-5, -5), 0)
        g = goals()
        if RETREAT or size(g) == 0:
            GF = field_avoid(my_spawn(), danger, stop)
        else:
            GF = field_avoid(g, danger, stop)

@gene('Z455a', 'compute the enemy champion threat zone once per turn: tiles a visible, non-recalling enemy champion can reach (move speed plus attack range) and hit next turn; healthy ones (>20%) at any range and low-health ones only within 5 tiles', parents=['Z109a', 'Z455a'])
def compute_threat() -> Tiles:
    m = me()
    ts = near(m.pos, 0) - near(m.pos, 0)
    for u in enemies():
        if u.is_champion and dist(u.pos, m.pos) <= 12 and not is_recalling(u):
            if u.health_frac > 0.2 or dist(u.pos, m.pos) <= 5:
                ts = ts | near(u.pos, u.attack_range + u.move_speed)
    return ts - near(m.pos, 0)
