"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene('s1', 'value of doing this option now; dispatches to draft and ability valuation, shops, fights, captures', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return pick_value(o.champ)
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.3241 else 0
    if o.kind == CAST:
        return cast_value(o)
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        if progress(o.tile) <= 0:
            return 0
        return 60 if gems() > 0 else 43
    return 0

@gene('s2', 'where to walk: altar with gems, else cleared-camp capture tiles, else living gem-bearing camp groups, then gold camps, then any living group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 0.8669)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals; retreats to spawn when hurt (below 40%, or below 60% while carrying gems with an enemy close), falls back to spawn when no goal exists', parents=['s3'])
def goal_field() -> Field:
    hp = me().health_frac
    if hp < 0.4 or (hp < 0.6 and gems() > 0 and enemy_close()):
        return field(my_spawn())
    g = goals()
    if size(g) > 0:
        return field(g)
    return field(my_spawn())

@gene('s4', 'distance gained toward goals minus a penalty for steps near enemy champions (cached danger set)', parents=['s4'])
def progress(t: Tile) -> Num:
    gf = goal_field()
    gain = at(gf, me().pos) - at(gf, t)
    risk = count(dist(e, t) <= 2 for e in enemy_champ_tiles())
    return gain - 1 * risk

@gene('Z109a', 'tiles of visible enemy champions, computed once per pass', parents=['s4'])
def enemy_champ_tiles() -> Tiles:
    ts = near(me().pos, 0) - near(me().pos, 0)
    for u in enemies():
        if u.is_champion:
            ts = ts | near(u.pos, 0)
    return ts

@gene('Z109b', 'true when an enemy champion is within 5 tiles of me (earlier reaction to threats)', parents=['s4'])
def enemy_close() -> Bool:
    m = me().pos
    return any(dist(t, m) <= 5 for t in enemy_champ_tiles())

@gene('Z147a', 'draft preference: top ladder champions first', parents=['s1'])
def pick_value(c: Num) -> Num:
    if c == VESPER_VALE:
        return 6
    if c == HEART_OF_RUIN:
        return 5
    if c == MARCELLA:
        return 4
    if c == VENDETTA:
        return 3
    if c == RYTH:
        return 2
    return 1

@gene('Z147b', 'value of casting an ability now: heal/shield self or hurt allies, or in fights; damage champions/camps (more on weakened champions; CC on champions highest since stun cancels tribute); dash toward goals when healthy; ground AoE on enemies', parents=['s1', 'Z147a'])
def cast_value(o: Option) -> Num:
    k = slot_kind(o.slot)
    u = o.unit
    if k == AB_DASH:
        if valid(o.tile) and me().health_frac > 0.4:
            if progress(o.tile) > 1:
                return 55 if gems() > 0 else 45
        return 0
    if k == AB_SHIELD or k == AB_HEAL:
        if exists(u):
            if u.is_enemy:
                return 0
            if u.health_frac < 0.7:
                return 120
            if me().health_frac < 0.9 and enemy_close():
                return 110
            return 0
        if k == AB_SHIELD:
            return 81 if enemy_close() or me().health_frac < 0.6 else 0
        return 88 if me().health_frac < 0.6 else 0
    if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
        if exists(u):
            if u.is_enemy and u.is_champion:
                if k == AB_CC:
                    return 175 + 40 * (1 - u.health_frac)
                return 150 + 60 * (1 - u.health_frac)
            if u.is_camp and gems() == 0:
                return 97
            return 0
        if valid(o.tile):
            r = max(slot_radius(o.slot), 1)
            n = count(dist(e.pos, o.tile) <= r for e in enemies())
            if n > 0:
                if k == AB_CC:
                    return 150 + 6 * n
                return 140 + 5 * n
    return 0
