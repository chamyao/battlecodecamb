"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
ECT: Tiles = None

@gene('Z573a', 'value of doing this option now; uses abilities (damage/cc/shield/heal/dash); champion attacks first; recall and camp-cast thresholds blended from both parents', parents=['s1', 'Z573a'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.38 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_enemy and o.unit.is_champion:
                    return 113
                if o.unit.is_camp and gems() == 0:
                    return 93
            return 0
        if k == AB_SHIELD:
            return 84 if enemy_close() or me().health_frac < 0.6 else 0
        if k == AB_HEAL:
            return 88 if me().health_frac < 0.45 else 0
        if k == AB_DASH:
            if valid(o.tile) and me().health_frac > 0.42:
                return 44 if progress(o.tile) > 0.8266 else 0
            return 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 43 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: altar with gems (wider reach), else cleared-camp capture tiles, else living gem-bearing camp groups, then gold camps, then any living group", parents=["s2"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1.6082)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "cached per-turn distance field to the goals, routed around walls, holes and threatened tiles (from update); falls back to spawn", parents=["s3"])
def goal_field() -> Field:
    return GF

@gene('Z573b', 'distance gained toward goals (x1.5 when carrying gems) minus a health-, gem- and nearby-enemy-scaled penalty in the threat zone, softened by nearby allies (floor 0.6), doubled when retreating', parents=['s4'])
def progress(t: Tile) -> Num:
    gf = goal_field()
    gain = at(gf, me().pos) - at(gf, t)
    if gems() > 0:
        gain *= 1.5
    if not (t in enemy_champ_tiles()):
        return gain
    hf = me().health_frac
    a = count(dist(u.pos, t) <= 3 for u in allies())
    ne = count(dist(u.pos, t) <= 4 for u in enemies())
    risk = max(1 - 0.4 * (a - 1), 0.6)
    penalty = (1 if hf > 0.7 else (3 if hf > 0.4 else 8)) + gems() / 10 + 2 * ne
    if RETREAT:
        penalty *= 2
    return gain - penalty * risk

@gene("Z109a", "threat zone: cached per turn by update (enemies do not move during my turn), so progress/enemy_close pay no engine calls per pass", parents=["s4", "Z109a"])
def enemy_champ_tiles() -> Tiles:
    return ECT

@gene("Z109b", "true when a threatening enemy champion (health above 10%, not recalling) could reach within 7 + its range of me next turn", parents=["Z109b"])
def enemy_close() -> Bool:
    p = me().pos
    return any(u.is_champion and u.health_frac > 0.1 and dist(u.pos, p) <= 7 + u.attack_range and not is_recalling(u) for u in enemies())

@gene('Z573c', 'per-turn threat cache; goal field avoiding threat and non-goal camps; walk home with hysteresis when hurt or carrying gems while hurt, or no goals; resume once healed', parents=['Z12a', 'Z573c'])
def update() -> None:
    if alive():
        ECT = compute_threat()
        h = me().health_frac
        if h < 0.4 or (gems() >= 10 and h < 0.6) or (gems() > 0 and h < 0.45):
            RETREAT = True
        elif h > 0.85:
            RETREAT = False
        danger = walls() | holes() | ECT
        stop = near(tile(-5, -5), 0)
        g = goals()
        if RETREAT or h < 0.3 or size(g) == 0:
            GF = field_avoid(my_spawn(), danger, stop)
        else:
            GF = field_avoid(g, danger | (camp_tiles() - g), stop)

@gene('Z455a', 'compute the enemy champion threat zone once per turn: tiles a visible, non-recalling, non-weak enemy champion can reach (move speed plus attack range) and hit next turn', parents=['Z109a', 'Z109b', 'Z455a'])
def compute_threat() -> Tiles:
    m = me()
    ts = near(m.pos, 0) - near(m.pos, 0)
    for u in enemies():
        if u.is_champion and u.health_frac > 0.1 and not is_recalling(u):
            weak = u.health < m.health * 0.4 and u.strength <= m.strength
            if not weak:
                ts = ts | near(u.pos, u.attack_range + u.move_speed)
    return ts
