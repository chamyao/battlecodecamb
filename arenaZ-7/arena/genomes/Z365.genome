"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
ECT: Tiles = None

@gene("s1", "value of doing this option now; uses abilities (damage/cc/shield/heal/dash); champion attacks first", parents=["s1"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_enemy and o.unit.is_champion:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 93
            return 0
        if k == AB_SHIELD:
            return 82 if enemy_close() or me().health_frac < 0.6 else 0
        if k == AB_HEAL:
            return 88 if me().health_frac < 0.3908 else 0
        if k == AB_DASH:
            if valid(o.tile) and me().health_frac > 0.4:
                return 43 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 43 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: altar with gems, else cleared-camp capture tiles, else living gem-bearing camp groups, then gold camps, then any living group", parents=["s2"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1.6082)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "cached per-turn distance field to the goals, routed around walls, holes and threatened tiles (from update); falls back to spawn", parents=["s3"])
def goal_field() -> Field:
    return GF

@gene("s4", "distance gained toward goals minus a continuous health-scaled penalty for steps inside the enemy champion threat zone; halved when empty-handed so camps get contested, heavier when an enemy is close", parents=["s4"])
def progress(t: Tile) -> Num:
    gf = goal_field()
    gain = at(gf, me().pos) - at(gf, t)
    risk = 1 if t in enemy_champ_tiles() else 0
    penalty = 2 + 4 * (1 - me().health_frac)
    if gems() == 0:
        penalty = penalty * 0.5
    if enemy_close():
        penalty += 2
    return gain - penalty * risk

@gene("Z109a", "threat zone: cached per turn by update; tiles a visible enemy champion within 12 tiles can reach and hit next turn, healthy ones at any range and low-health ones within 4 tiles", parents=["s4", "Z109a"])
def enemy_champ_tiles() -> Tiles:
    return ECT

@gene("Z109b", "true when an enemy champion threatens to reach me within 5 tiles, or a visible enemy champion is within 6", parents=["s4", "Z109b"])
def enemy_close() -> Bool:
    if any(dist(t, me().pos) <= 5 for t in enemy_champ_tiles()):
        return True
    return any(u.is_champion and dist(u.pos, me().pos) <= 6 for u in enemies())

@gene("Z12a", "per-turn threat zone cache plus goal field routed with field_avoid; threat zones avoided only when not retreating; walk home with hysteresis when badly hurt or carrying gems while hurt, or when no goals exist; resume goals once healed", parents=["s3", "s2", "Z12a"])
def update() -> None:
    if alive():
        ECT = compute_threat()
        h = me().health_frac
        if h < 0.35 or (gems() >= 20 and h < 0.6) or (gems() > 0 and h < 0.45):
            RETREAT = True
        elif h > 0.9:
            RETREAT = False
        danger = walls() | holes()
        if not RETREAT:
            danger = danger | ECT
        stop = near(tile(-5, -5), 0)
        g = goals()
        if RETREAT or size(g) == 0:
            GF = field_avoid(my_spawn(), danger, stop)
        else:
            GF = field_avoid(g, danger, stop)

@gene("Z455a", "compute the enemy champion threat zone once per turn: tiles a visible, non-recalling enemy champion can reach (move speed plus attack range) and hit next turn, healthy ones at any range and low-health ones only within 4 tiles", parents=["Z109a", "Z455a"])
def compute_threat() -> Tiles:
    m = me()
    ts = near(m.pos, 0) - near(m.pos, 0)
    for u in enemies():
        if u.is_champion and dist(u.pos, m.pos) <= 12 and not is_recalling(u):
            if u.health_frac > 0.3 or dist(u.pos, m.pos) <= 3:
                ts = ts | near(u.pos, u.attack_range + u.move_speed)
    return ts - near(m.pos, 0)
