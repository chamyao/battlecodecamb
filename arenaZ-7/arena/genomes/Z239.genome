"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False

@gene("s1", "value of doing this option now; uses abilities (damage/cc/shield/heal/dash); champion attacks first", parents=["s1"])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 67 if o.item == 6 else 0
    if o.kind == RECALL:
        return 152 if me().health_frac < 0.35 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_enemy and o.unit.is_champion:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 125
            return 0
        if k == AB_SHIELD:
            return 83 if enemy_close() or me().health_frac < 0.6 else 0
        if k == AB_HEAL:
            return 88 if me().health_frac < 0.3908 else 0
        if k == AB_DASH:
            if valid(o.tile) and me().health_frac > 0.4:
                return 44 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 43 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: altar with gems, else cleared-camp capture tiles, else living gem-bearing camp groups, then gold camps, then any living group", parents=["s2"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1.6082)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "cached per-turn distance field to the goals, routed around walls, holes and threatened tiles (from update); falls back to spawn", parents=["s3"])
def goal_field() -> Field:
    return GF

@gene("Z311a", "distance gained toward goals minus a three-level health-scaled penalty for steps inside the enemy champion threat zone", parents=["s4", "Z311a"])
def progress(t: Tile) -> Num:
    gf = goal_field()
    gain = at(gf, me().pos) - at(gf, t)
    risk = 1 if t in enemy_champ_tiles() else 0
    hf = me().health_frac
    penalty = 2 if hf > 0.7 else (4 if hf > 0.4 else 8)
    if enemy_close():
        penalty += 1
    return gain - penalty * risk

@gene("Z109a", "threat zone: tiles a visible enemy champion (above 20% health) can reach and hit next turn (move speed + attack range), computed once per pass", parents=["s4", "Z109a"])
def enemy_champ_tiles() -> Tiles:
    ts = near(me().pos, 0) - near(me().pos, 0)
    for u in enemies():
        if u.is_champion and u.health_frac > 0.2:
            ts = ts | near(u.pos, u.attack_range + u.move_speed)
    return ts - near(me().pos, 0)

@gene("Z109b", "true when a threatening enemy champion is within 5 tiles of me", parents=["s4", "Z109b"])
def enemy_close() -> Bool:
    return any(dist(t, me().pos) <= 6 for t in enemy_champ_tiles())

@gene("Z12a", "per-turn goal field routed with field_avoid; walk home with hysteresis when badly hurt, carrying gems while hurt, or when an enemy champion closes in while hurt; resume goals once healed", parents=["s3", "s2", "Z12a"])
def update() -> None:
    if alive():
        h = me().health_frac
        if h < 0.35 or (gems() >= 20 and h < 0.4611) or (gems() > 0 and h < 0.5) or (h < 0.5 and enemy_close()):
            RETREAT = True
        elif h > 0.9:
            RETREAT = False
        danger = walls() | holes() | enemy_champ_tiles()
        stop = near(tile(-5, -5), 0)
        g = goals()
        if RETREAT or size(g) == 0:
            GF = field_avoid(my_spawn(), danger, stop)
        else:
            GF = field_avoid(g, danger, stop)
