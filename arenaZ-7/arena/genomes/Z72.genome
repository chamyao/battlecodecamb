"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 43 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: spawn when hurt, altar with gems, else cleared-camp capture tiles, else living non-monolith camp group')
def goals() -> Tiles:
    if me().health_frac < 0.3 and size(my_spawn()) > 0:
        return my_spawn()
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    mono = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if not group_respawning(g):
            gt = group_tiles(g)
            t0 = best(gt, lambda t: 0)
            if valid(t0) and spawn_type(t0) == MONOLITH:
                mono = mono | gt
            else:
                acc = acc | gt
    if size(acc) > 0:
        return acc
    return mono

@gene('s3', 'distance field to the goals (cached per turn in update)')
def goal_field() -> Field:
    return GF

@gene('Z121a', 'compute the goal distance field once per turn instead of once per pass', parents=['s2', 's3'])
def update() -> None:
    if alive():
        GF = field(goals())

@gene('s4', 'progress toward goals, penalised by enemy champions near the step')
def progress(t: Tile) -> Num:
    base = at(goal_field(), me().pos) - at(goal_field(), t)
    danger = sum(1 for u in enemies() if u.is_champion and dist(u.pos, t) <= 2)
    return base - 2 * danger
