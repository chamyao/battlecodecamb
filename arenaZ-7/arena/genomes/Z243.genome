"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
ECT: Tiles = None
RETREAT: Bool = False

@gene('Z284a', 'value of doing this option now; also uses abilities (damage/cc/shield/heal/dash); merged thresholds of both parents', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.37 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_enemy and o.unit.is_champion:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 97
            return 0
        if k == AB_SHIELD:
            return 85 if enemy_close() or me().health_frac < 0.6 else 0
        if k == AB_HEAL:
            return 88 if me().health_frac < 0.6 else 0
        if k == AB_DASH:
            if valid(o.tile) and me().health_frac > 0.45:
                return 44 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 43 if progress(o.tile) > 0 else 0
    return 0

@gene('Z38a', 'where to walk: altar with gems, else cleared-camp capture tiles, else living camp group with loot, else any living camp group', parents=['s2'])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) + group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene('Z284b', 'distance field to goals with hysteresis retreat; also home when carrying 10+ gems below 60% health, else home when no goal', parents=['s3', 'Z12a'])
def goal_field() -> Field:
    hp = me().health_frac
    if RETREAT or (hp < 0.5 and gems() > 0) or (hp < 0.6 and gems() >= 10):
        return field(my_spawn())
    g = goals()
    if size(g) > 0:
        return field(g)
    return field(my_spawn())

@gene('Z284c', 'distance gained toward cached goal field minus risk near cached enemy threat tiles; risk weight 1.5 when retreating or carrying gems, 0.5 when healthy, 1 otherwise', parents=['s4'])
def progress(t: Tile) -> Num:
    gain = at(GF, me().pos) - at(GF, t)
    if size(ECT) == 0:
        return gain
    risk = count(dist(e, t) <= 2 for e in ECT)
    w = 1
    if RETREAT or gems() > 0 or me().health_frac < 0.5:
        w = 1.5
    elif me().health_frac > 0.75:
        w = 0.5
    return gain - w * risk

@gene('Z109a', 'tiles around visible healthy enemy champions (radius 1), computed once per pass', parents=['s4'])
def enemy_champ_tiles() -> Tiles:
    ts = near(me().pos, 0) - near(me().pos, 0)
    for u in enemies():
        if u.is_champion and u.health_frac > 0.25:
            ts = ts | near(u.pos, 1)
    return ts

@gene('Z284d', "true when a healthy enemy champion's threat zone is within 5 tiles of me (cached set); within 7 when carrying gems", parents=['Z109b'])
def enemy_close() -> Bool:
    if size(ECT) == 0:
        return False
    r = 7 if gems() > 0 else 5
    return any(dist(t, me().pos) <= r for t in ECT)

@gene('Z284e', 'once per turn: update retreat hysteresis, cache enemy threat tiles and the goal distance field', parents=['Z12a', 'Z228a'])
def update() -> None:
    if alive():
        h = me().health_frac
        if h < 0.35:
            RETREAT = True
        elif h > 0.9:
            RETREAT = False
        ECT = enemy_champ_tiles()
        GF = goal_field()
