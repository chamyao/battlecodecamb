"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 80
        return 60 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 50 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems (fallback to camps if none open), else a camp group worth capturing')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g) or (not group_respawning(g) and group_gems(g) + group_gold(g) > 0):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, search stopped once my tile is reached (cheaper)')
def goal_field() -> Field:
    return field_avoid(goals(), walls(), near(me().pos, 0))

@gene('s4', 'how much closer a step brings me to the goals, clamped; avoid enemy reach when hurt or carrying gems')
def progress(t: Tile) -> Num:
    f = goal_field()
    d = at(f, me().pos) - at(f, t)
    d = min(max(d, -1), 1)
    if me().health_frac < 0.5 or gems() >= 30:
        if t in threat_tiles():
            d -= 1.5
    return d

@gene('Z23a', 'tiles within 2 of a visible enemy champion', parents=['s3', 's4'])
def threat_tiles() -> Tiles:
    acc = near(me().pos, 0) - near(me().pos, 0)
    for u in enemies():
        if u.is_champion:
            acc = acc | near(u.pos, 2)
    return acc
