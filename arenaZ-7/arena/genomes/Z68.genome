"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GOAL_F: Field = None

@gene("s1", "value of doing this option now")
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.35 else 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 160
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 43 if progress(o.tile) > 0 else 0
    return 0

@gene('s2', 'where to walk: an altar with gems (fallback to camps if none open), else a camp group worth capturing')
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g) or (not group_respawning(g) and group_gems(g) + group_gold(g) > 0):
            acc = acc | group_tiles(g)
    return acc

@gene('s3', 'distance field to the goals, avoiding tiles next to enemy champions')
def goal_field() -> Field:
    return GOAL_F

@gene('s4', 'how much closer a step brings me to the goals, minus a penalty for stepping near enemy champions')
def progress(t: Tile) -> Num:
    base = at(goal_field(), me().pos) - at(goal_field(), t)
    danger = sum(3 for u in enemies() if u.is_champion and dist(u.pos, t) <= 2)
    return base - danger

@gene('Z114a', 'per-turn goal field that routes around enemy champions (cached once per turn)', parents=['s3'])
def update() -> None:
    w = walls()
    for u in enemies():
        if u.is_champion:
            w = w | near(u.pos, 1)
    w = w - near(me().pos, 1)
    GOAL_F = field_avoid(goals(), w, near(me().pos, 0))
