"""The official starter bot as a genome (sim/src/bots.cpp), for checking the runtime: it should play
about even with builtin:starter. Starter rules in priority order become scores."""

GF: Field = None
RETREAT: Bool = False
ETILES: Tiles
CLOSE: Bool = False

@gene('Z379a', 'value of doing this option now; uses abilities (damage/cc/shield/heal/dash); champion attacks first; merged thresholds', parents=['s1'])
def score(o: Option) -> Num:
    if o.kind == PICK:
        return 1
    if o.kind == BUY:
        return 100 if o.item == 6 else 0
    if o.kind == RECALL:
        return 90 if me().health_frac < 0.38 else 0
    if o.kind == CAST:
        k = slot_kind(o.slot)
        if k == AB_DAMAGE or k == AB_AOE or k == AB_CC:
            if exists(o.unit):
                if o.unit.is_enemy and o.unit.is_champion:
                    return 85
                if o.unit.is_camp and gems() == 0:
                    return 97
            return 0
        if k == AB_SHIELD:
            return 83 if enemy_close() or me().health_frac < 0.6 else 0
        if k == AB_HEAL:
            return 88 if me().health_frac < 0.5 else 0
        if k == AB_DASH:
            if valid(o.tile) and me().health_frac > 0.4:
                return 44 if progress(o.tile) > 1 else 0
            return 0
        return 0
    if o.kind == ATTACK:
        if o.unit.is_champion:
            return 97
        return 98 if gems() == 0 else 0
    if o.kind == TRIBUTE:
        return 70
    if o.kind == MOVE:
        return 43 if progress(o.tile) > 0 else 0
    return 0

@gene("s2", "where to walk: altar with gems, else cleared-camp capture tiles, else living gem-bearing camp groups, then gold camps, then any living group", parents=["s2"])
def goals() -> Tiles:
    if gems() > 0:
        acc = near(tile(-5, -5), 0)
        for a in altars() - locked_altars():
            acc = acc | near(a, 1)
        if size(acc) > 0:
            return acc
    acc = near(tile(-5, -5), 0)
    for g in range(num_groups()):
        if group_reward(g):
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gems(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g) and group_gold(g) > 0:
            acc = acc | group_tiles(g)
    if size(acc) > 0:
        return acc
    for g in range(num_groups()):
        if not group_respawning(g):
            acc = acc | group_tiles(g)
    return acc

@gene("s3", "cached per-turn distance field to the goals, routed around walls, holes and threatened tiles (from update); falls back to spawn", parents=["s3"])
def goal_field() -> Field:
    return GF

@gene('Z379b', 'distance gained toward goals minus a continuous health-scaled penalty for steps inside the cached threat zone, heavier when an enemy is close', parents=['s4'])
def progress(t: Tile) -> Num:
    gf = goal_field()
    gain = at(gf, me().pos) - at(gf, t)
    risk = 1 if t in ETILES else 0
    penalty = 2 + 4 * (1 - me().health_frac)
    if CLOSE:
        penalty += 2
    return gain - penalty * risk

@gene('Z379c', 'threat zone: tiles a visible enemy champion (above 20% health, not recalling, within 12 tiles) can reach and hit next turn (move speed + attack range), excluding my own tile', parents=['Z109a'])
def enemy_champ_tiles() -> Tiles:
    p = me().pos
    ts = near(p, 0) - near(p, 0)
    for u in enemies():
        if u.is_champion and u.health_frac > 0.2 and not is_recalling(u) and dist(u.pos, p) <= 12:
            ts = ts | near(u.pos, u.attack_range + u.move_speed)
    return ts - near(p, 0)

@gene("Z109b", "true when a healthy visible enemy champion is within 6 tiles of me", parents=["s4"])
def enemy_close() -> Bool:
    p = me().pos
    return any(u.is_champion and u.health_frac > 0.3 and dist(u.pos, p) <= 6 for u in enemies())

@gene('Z379d', 'per-turn goal field via field_avoid with threat zone and closeness cached; retreat home with hysteresis (earlier when carrying gems), resume goals once healed', parents=['Z12a', 's3'])
def update() -> None:
    ETILES = enemy_champ_tiles()
    CLOSE = enemy_close()
    if alive():
        h = me().health_frac
        if h < 0.2638 or (gems() >= 20 and h < 0.6) or (gems() > 0 and h < 0.5):
            RETREAT = True
        elif h > 0.9:
            RETREAT = False
        danger = walls() | holes() | ETILES
        stop = near(tile(-5, -5), 0)
        g = goals()
        if RETREAT or size(g) == 0:
            GF = field_avoid(my_spawn(), danger, stop)
        else:
            GF = field_avoid(g, danger, stop)
